text @[Рё]
text Д-да...
setvar strS[1001] = "CGRY14D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9S1.aac
text @[Рё]
text Ах... Оказаки-кун, я возьму наши вещи.
text @[Томоя]
text Хм? Я не против.
text @[Томоя]
text Это будет выглядеть не очень хорошо, если я позволю девушке нести всё это.
setvar strS[1001] = "CGKY11C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9S2.aac
text @[Кё]
text Именно так. Пусть парень несёт твои вещи!
text @[Томоя]
text Может, это только мне так кажется, но слышать это от тебя почему-то немного раздражает...
setvar strS[1001] = "CGKY12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
