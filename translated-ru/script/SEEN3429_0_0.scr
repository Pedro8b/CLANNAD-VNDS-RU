		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Убедившись, что Фудзибаяси этого не видит, я показываю ей в ответ большой палец вверх.
setvar strS[1001] = "CGRY18E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RQ.aac
text @[Рё]
text ...думаю, я это куплю...
text Не отрывая взгляда от кулона, бормочет Фудзибаяси.
text Если я позволю ей купить его самой, весь этот план потеряет всякий смысл.
setvar strS[1001] = "CGKY21C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY21C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RR.aac
text @[Кё]
text Ах, Рё, пойдём обратно в магазин одежды!
text Похоже, Кё тоже это заметила и в спешке пытается её отвлечь.
setvar strS[1001] = "CGRY15E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RS.aac
text @[Рё]
text Э...? Ты забыла что-то купить...?
setvar strS[1001] = "CGKY16C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY16C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RT.aac
text @[Кё]
text Ах... э... эмм... ну...
text Она бросает на меня взгляд.
setvar strS[1001] = "CGKY21C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY21C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RU.aac
text @[Кё]
text Ах, да. Да, мы забыли. Мы забыли купить одежду для Томои.
text @[Томоя]
text А? Для меня?
text Внезапно разговор переключается на меня.
setvar strS[1001] = "CGRY14D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RV.aac
text @[Рё]
text Эмм....
text Услышав слова Кё, Фудзибаяси тоже смотрит в мою сторону.
text Затем её взгляд сосредотачивается на вещах, которые я держу.
setvar strS[1001] = "CGRY14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9RW.aac
text @[Рё]
text П-прости меня. Я-я думала только о себе...
sound 9RX.aac
text @[Рё]
text Прости, что заставила тебя всё это нести... Оказаки-кун.
text Теперь, когда Фудзибаяси и правда на меня посмотрела, она вернулась в своё обычное состояние.
text С растерянным, робким взглядом она смотрит то на Кё, то на меня.
text @[Томоя]
text Да брось, не переживай об этом.
sound 9RY.aac
text @[Рё]
text Но... но...
text @[Томоя]
text В любом случае, пойдём поищем что-нибудь для меня.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я начинаю идти; если оставить Фудзибаяси в таком состоянии, она может расплакаться.
setvar strS[1001] = "CGKY12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
