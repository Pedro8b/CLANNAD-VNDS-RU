text (Да, этот конкретный класс...)
label 6
text Я заглядываю внутрь через стеклянную панель на двери.
text @[Tomoya]
text (Вот она...)
text Неудивительно, в классе сидит девушка, усердно работающая над резьбой.
text Она выглядит гораздо более сосредоточенной на работе, чем в первый раз, когда я её увидел.
text @[Tomoya]
text (Полагаю, ей теперь не будет больно, теперь как раз привыкла... наверное...)
choice Leave|I'll watch her just a bit more
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s6
fi
goto 7
label s6
text @[Tomoya]
text (Она, наверное, теперь справится сама...)
text Я отворачиваюсь и покидаю здание.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
goto 10
