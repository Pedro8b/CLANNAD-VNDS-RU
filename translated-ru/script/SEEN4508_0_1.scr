sound E2R.aac
text @[Котоми]
text ...
text Кажется, я вижу, как её подбородок слегка дрогнул.
text Должно быть, это лучшее, на что она сейчас способна.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s62
fi
goto 62
label s62
setvar strS[1000] = ""
label 62
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я выхожу из этой комнаты.
text Тяжёлая деревянная дверь разделяет меня и Котоми.
text Я остаюсь один в темноте коридора.
