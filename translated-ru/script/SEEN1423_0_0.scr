sound 2BM.aac
text @[Фуко]
text И только одно...
sound 2BN.aac
text @[Ученик]
text А?
sound 2BO.aac
text @[Фуко]
text Сестра Фуко выходит замуж.
sound 2BP.aac
text @[Фуко]
text Если бы ты мог... пожалуйста, приди поздравить её.
sound 2BQ.aac
text @[Ученик]
text А? О ком ты говоришь?
sound 2BR.aac
text @[Фуко]
text Сестра Фуко. Она была учительницей изобразительных искусств в этой школе до трёх лет назад.
sound 2BS.aac
text @[Ученик]
text Три года назад... потом... я не думаю, что её знаю...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Его ответ такой же, как и мой.
text @[Томоя]
text (А... перед ней бесконечно длинная дорога...)
text Я не могу не думать об этом так.
text Она будет делать это каждый день, спрашивая каждого, кого встречает.
text Я просто оказался первым из них.
text Я не намерен благословлять свадьбу неизвестной женщины...
text Но мне кажется, было бы здорово, если бы пришли много людей...
text @[Томоя]
text (Серьёзно, где звезда, которую она мне подарила?)
if intF[133] == 0
	goto s30
fi
goto 34
label s30
if intF[132] == 0
	goto s31
fi
goto 32
label s31
text Оставив Фуко и мальчика‑студента позади, я направляюсь к обувному шкафу.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s32
fi
goto 31
label s32
setvar strS[1000] = ""
label 31
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (Если я правильно помню, оно должно быть где‑то здесь...)
text Резьба нигде не найдена.
text ...Я чувствую лёгкую вину.
text Если уборщица уже выбросила его, я действительно должен ей извиниться.
text ...Звенит школьный звонок.
goto 33
label 32
if intF[132] == 1
	goto s33
fi
goto 33
label s33
text @[Томоя]
text (Нет никакой возможности найти его в этом беспорядке...)
text ...Я чувствую лёгкую вину.
text Школьный звонок выводит меня из мыслей.
label 33
text Я спешу в класс.
goto 35
label 34
if intF[133] == 1
	goto s34
fi
goto 35
label s34
text @[Томоя]
text (Ну, с ним должно быть всё в порядке... это точно...)
text Даже если он больше не принадлежит мне.
label 35
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
