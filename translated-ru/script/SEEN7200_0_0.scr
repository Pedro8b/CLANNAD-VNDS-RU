if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QZM.aac
text @[Санаэ]
text Нагиса уже тоже вернулась.
text @[Томоя]
text Мне показалось, что пахнет чем-то другим. Значит, она сейчас готовит ужин?
sound QZN.aac
text @[Санаэ]
text Готовит. И мне было бы неловко оставлять всё на неё одну, так что я пойду ей помогу.
text @[Томоя]
text А мне что тогда делать?
setvar strS[1001] = "CGSN11HE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11HE.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QZO.aac
text @[Санаэ]
text Магазин уже закрыт, так что, если тебе не сложно, не мог бы ты пойти разнести немного хлеба?
text @[Томоя]
text Ах, ты про то, что всегда делает старик?
sound QZP.aac
text @[Санаэ]
text Да.
text @[Томоя]
text Я не против. Просто наполню сумку и пройдусь по округе.
sound QZQ.aac
text @[Санаэ]
text Пожалуйста, сделай так.
