if intA[1000] == 0
	goto s39
fi
goto 47
label s39
setvar strS[1000] = ""
label 47
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ......
sound R0V.aac
text @[Нагиса]
text ...Ты уже собираешься спать?
text Спрашивает она, наверное, потому что я замолчал.
text @[Томоя]
text Да... нам же завтра рано вставать.
sound R0W.aac
text @[Нагиса]
text Хорошо. Понимаю.
sound R0X.aac
text @[Нагиса]
text Спокойной ночи.
text @[Томоя]
text Да, спокойной ночи...
jump SEEN7200_0_1.scr 55
label 48
if intF[1089] == 1
	goto s40
fi
jump SEEN7200_0_1.scr 55
label s40
text @[Томоя]
text О чём-то непристойном.
sound R0Y.aac
text @[Нагиса]
text Ах... о чём-то непристойном...?
sound R0Z.aac
text @[Нагиса]
text Аах... что же мне делать...?
sound R10.aac
text @[Нагиса]
text ...
sound R11.aac
text @[Нагиса]
text В смысле... мы же сейчас у моих родителей, и...
text @[Томоя]
text Шучу.
sound R12.aac
text @[Нагиса]
text А?
text @[Томоя]
text Мне просто было интересно, как бы ты отреагировала, если бы я так сказал.
sound R13.aac
text @[Нагиса]
text Томоя-кун... ты ужасен.
sound R14.aac
text @[Нагиса]
text Я и правда растерялась, не зная, что делать, знаешь ли...
text @[Томоя]
text Ага, именно такую реакцию я и хотел увидеть.
sound R15.aac
text @[Нагиса]
text Томоя-кун, у тебя определённо странные вкусы.
sound R16.aac
text @[Нагиса]
text Так ты предпочитаешь вызвать у меня реакцию, вместо того чтобы правда сделать со мной что-то непристойное?
sound R17.aac
text @[Нагиса]
text Хорошо, буду знать. Запомню это.
text Она дуется, отворачиваясь к стене.
text @[Томоя]
text Говорю же тебе, это была просто шутка.
text Я вылезаю из футона и обнимаю её сзади.
sound R18.aac
text @[Нагиса]
text Ты постоянно шутишь, так что я никогда не знаю, когда это шутка, а когда нет.
text @[Томоя]
text Когда я говорю что-то, что тебе не нравится, это шутка.
sound R19.aac
text @[Нагиса]
text Это до ужаса удобно.
text @[Томоя]
text Но нет, на самом деле я всегда серьёзен.
sound R1A.aac
text @[Нагиса]
text ...
text @[Томоя]
text Мне просто становится невероятно счастливо всякий раз, когда я рядом с тобой.
sound R1B.aac
text @[Нагиса]
text Если ты так это формулируешь... я не смогу тебе ни в чём отказать.
text @[Томоя]
text Так что, ничего, если мы просто останемся так?
sound R1C.aac
text @[Нагиса]
text У тебя рука не онемеет?
text Моя правая рука зажата под её бедром.
text @[Томоя]
text Тогда только пока не онемеет.
sound R1D.aac
text @[Нагиса]
text Хорошо.
text Я прижимаюсь кончиком носа к воротнику её рубашки.
text @[Томоя]
text И если ты хочешь, чтобы я был совершенно честен, я думал о старике.
sound R1E.aac
text @[Нагиса]
text Ты думаешь о папе?
text @[Томоя]
text Да...
text @[Томоя]
text Мне всегда казалось... что он просто ходит и делает, что ему заблагорассудится...
text @[Томоя]
text ...но я наконец-то кое-что понял: он делает это не только ради себя.
sound R1F.aac
text @[Нагиса]
text Тогда ради кого он это делает?
text @[Томоя]
text Нет, ну, наверное, ни ради кого конкретно...
text @[Томоя]
text ...и сам он, наверное, всё ещё просто делает то, что ему хочется делать...
text @[Томоя]
text ...но, несмотря на всё это, он нужен очень многим людям.
music BGM08D.mp3
text Интересно, а я вёл себя похожим образом?
text Смог бы я помочь тем детям, которые стремятся стать основными игроками в своей бейсбольной команде?
text Помочь им с тренировкой в поле?
text Может быть, если бы детям это правда нравилось.
text В таком случае, интересно, смог бы я даже захотеть чинить людям водонагреватели, даже если бы они меня об этом не просили.
text Мог бы я так сделать, просто чтобы убить время?
text Нет, я — вряд ли, по крайней мере.
sound R1G.aac
text @[Нагиса]
text Папа просто хочет видеть улыбки всех вокруг.
sound R1H.aac
text @[Нагиса]
text Уверена, дело именно в этом.
text Я тоже это чувствовал, когда стоял рядом с ним.
text Наблюдая, как он заставляет других улыбаться.
text Да... это меня немного раздражает.
text И всё же...
text Это заставляет меня задуматься, насколько же тревожно Санаэ-сан должна себя чувствовать постоянно.
text Ведь в любой момент...
text ...этот тип может просто взять и уйти куда-то, чтобы заставить кого-то улыбнуться. Вот такого мужа ей приходится терпеть.
if 0 == 0
	goto s41
fi
goto 49
label s41
setvar strS[1000] = "KURO"
goto 51
label 49
if 0 == 1
	goto s42
fi
goto 50
label s42
setvar strS[1000] = "SIRO"
goto 51
label 50
setvar strS[1000] = "KURO"
label 51
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG038"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s43
fi
jump SEEN7200_0_1.scr 52
