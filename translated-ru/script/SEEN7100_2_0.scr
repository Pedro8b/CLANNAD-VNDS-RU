music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 17
label s15
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08D.mp3
sound C.aac
text Как обычно, я заканчиваю работу и сажусь на пассажирское сиденье грузовика Ёсино-сан.
text Смотрю на проплывающий пейзаж, на офисных работников и учеников, идущих домой, и рассеянно думаю о собственной ценности в обществе.
text Ёсино-сан, как обычно, молчит.
text Восполняя это, работает радио, заполняя пустоту нашего молчания.
text Это был наш обычный распорядок.
if intF[613] == 0
	goto s16
fi
goto 18
label s16
text Из динамиков вырывается мощное гитарное вступление.
text Затем вступают барабаны, вместе с криком.
text Этот голос я где-то уже слышал.
text Интересно, где...
text Пока я об этом думаю, Ёсино-сан переключает радио. После шума радио переходит на прямую трансляцию профессионального бейсбольного матча.
text На этом мои размышления и обрываются.
sound ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
label 18
text Из динамиков доносится вступление, которое я уже где-то слышал.
text Это резкий гитарный ритм, будто исполнитель просто яростно рубит по струнам.
text Затем вступают барабаны, вместе с криком.
text Ах, вот это совпадение, если такое вообще бывает...
text Смотрю на профиль Ёсино-сан.
text @[Томоя]
text ...
sound QDW.aac
text @[Ёсино]
text ...Точно. Ты же мне тогда наврал, да?
text @[Томоя]
text А?
sound QDX.aac
text @[Ёсино]
text Ты сказал, что играешь на барабанах.
text @[Томоя]
text А-а, точно...
sound QDY.aac
text @[Ёсино]
text А тот другой парень вообще никогда в жизни на гитаре не играл, я прав?
text @[Томоя]
text Верно...
sound QDZ.aac
text @[Ёсино]
text Это вообще о чём было?
text @[Томоя]
text ...
choice Ответить честно|Попытаться как-то обмануть его
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s17
fi
goto 19
label s17
goto 20
label 19
if intF[1089] == 1
	goto s18
fi
goto 20
label s18
text @[Томоя]
text Ну...
text Что бы такое сказать, чтобы его обмануть...?
text @[Томоя]
text Просто казалось, что нам придётся собрать группу для школьного фестиваля.
text @[Томоя]
text Вот и всё.
text Говорю это, вертя ручку настройки радио.
text После шума радио переходит на прямую трансляцию профессионального бейсбольного матча.
text @[Ёсино]
text ...
text Ёсино-сан больше ничего не говорит.
text Интересно, просто ли ему невзначай напомнило о прошлом.
sound ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
label 20
text @[Томоя]
text Наверное, всё так, как ты и думаешь.
sound QE0.aac
text @[Ёсино]
text Значит, это он всё затеял?
text @[Томоя]
text Да. Его младшая сестра была, судя по всему, фанаткой...
sound QE1.aac
text @[Ёсино]
text Хм...
text @[Томоя]
text Но мне тоже начало нравиться, настолько, что я даже потом купил твой диск...
text Зачем я вообще сейчас оправдываюсь...?
text Что я сказал тогда?
text Что-то вроде того, что я не фанат, так что мне всё равно, как он воспримет мои слова?
text А теперь посмотрите на меня... весь такой взволнованный...
text Вот ирония-то...
text Сейчас мы с ним профессиональные сэмпай и кохай.
text Чтобы он узнал о том, что случилось тогда, теперь, когда мы стали так близки...
sound QE2.aac
text @[Ёсино]
text Что ж, спасибо тебе.
text @[Ёсино]
text ...
text ...Как же чертовски неловко.
choice Переключить канал|Спеть
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s19
fi
goto 21
label s19
text Молча вертю ручку настройки радио.
text После шума радио переходит на прямую трансляцию профессионального бейсбольного матча.
text @[Ёсино]
text ...
text Ёсино-сан больше ничего не говорит.
text Интересно, просто ли ему невзначай напомнило о прошлом.
sound ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
goto 22
label 21
if intF[1089] == 1
	goto s20
fi
goto 22
label s20
label 22
text @[Томоя]
text Вообще-то я могу спеть всю песню по памяти.
text @[Ёсино]
text ...
text Подпеваю мелодии, доносящейся из радио.
text И правда пою, без единой ошибки.
text Хоть я и сказал, что смогу спеть, сам удивился, что у меня получилось.
text Всё началось с того, что я уничтожил кассету Сунохары...
text но после этого я так сильно им заинтересовался, что даже сам купил его диск.
text Вспоминаю то время, когда слушал его каждый день без остановки.
text @[Томоя]
text (Я и правда очень много его слушал, да...)
text Радио уже переключилось на следующую песню.
text Это хип-хоп трек, звучащий довольно популярно.
text Такой, что мог бы понравиться Сунохаре.
text @[Томоя]
text Если честно, я о нём совсем забыл, пока не услышал сейчас...
text @[Томоя]
text Но теперь мне почему-то снова хочется его послушать.
text @[Томоя]
text Хотя у меня не так уж много дисков, да и музыку я вообще не особо часто слушаю...
text @[Томоя]
text И всё же я тогда его купил, несмотря на это.
text @[Ёсино]
text ...
sound ~
text Ёсино-сан останавливает машину.
text Мы снова у станции.
sound QE3.aac
text @[Ёсино]
text ...Рассказать тебе старую историю?
text @[Томоя]
text А?
sound QE4.aac
text @[Ёсино]
text Это история об одном молодом рокере.
text @[Томоя]
text А, ладно.
text Отвечаю так, не задумываясь, но...
text Интересно, правда ли мне полагается услышать эту историю.
text Кажется, я всё-таки сам ему это доказал.
text Насколько сильно мне нравится его песня.
text Это моя собственная ответственность.
text Ответственность, которую мне следовало взять на себя ещё в прошлом году.
sound QE5.aac
text @[Ёсино]
text Тогда давай сначала возьмём кофе.
music ~
sound QE6.aac
text @[Ёсино]
text Раз уж история будет долгой.
setvar strS[1000] = "BG035AY"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s21
fi
goto 23
label s21
setvar strS[1000] = ""
label 23
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM01.mp3
sound QE7.aac
text @[Ёсино]
text Давным-давно...
sound QE8.aac
text @[Ёсино]
text В этом городе жил невоспитанный мальчишка.
sound QE9.aac
text @[Ёсино]
text У него не было родителей, так что с самого детства он учился только плохому... и делал только то, что хотел сам.
sound QEA.aac
text @[Ёсино]
text Безрассудство было для него привычным и комфортным.
sound QEB.aac
text @[Ёсино]
text Впервые он столкнулся с музыкой в тринадцать лет.
sound QEC.aac
text @[Ёсино]
text Это было время музыкального бума... и все его друзья вдруг увлеклись музыкой.
sound QED.aac
text @[Ёсино]
text Так что мальчишка выхватил у кого-то гитару и начал играть.
sound QEE.aac
text @[Ёсино]
text Он копировал разные европейские стили.
sound QEF.aac
text @[Ёсино]
text Ему даже понравилось петь.
sound QEG.aac
text @[Ёсино]
text Он врывался на чужие выступления и выхватывал микрофон.
sound QEH.aac
text @[Ёсино]
text В то время ему тоже было комфортно быть безрассудным.
sound QEI.aac
text @[Ёсино]
text Однако к тому моменту это уже не считалось чем-то плохим.
sound QEJ.aac
text @[Ёсино]
text Именно так... это и был рок как таковой.
sound QEK.aac
text @[Ёсино]
text Крики, ломание вещей, прыжки в толпу...
sound QEL.aac
text @[Ёсино]
text Что бы мальчишка ни делал, там ему прощалось любое безрассудство.
sound QEM.aac
text @[Ёсино]
text Если бы он мог просто прожить всю жизнь, держась за это, он смог бы жить, не выслушивая пересудов за спиной.
sound QEN.aac
text @[Ёсино]
text Конечно, порой он тоже давал себе волю.
sound QEO.aac
text @[Ёсино]
text Однако окружающие его люди лишь смеялись, когда он это делал.
sound QEP.aac
text @[Ёсино]
text Даже поступив в старшую школу, в то время, когда все думают только о поступлении в университет, мальчишка был погружён в музыку.
sound QEQ.aac
text @[Ёсино]
text Я буду зарабатывать на жизнь музыкой. Вот что он думал.
sound QER.aac
text @[Ёсино]
text Это было единственное, о чём он думал.
sound QES.aac
text @[Ёсино]
text Потому что если бы он занимался чем-то ещё, кроме музыки, он потерял бы почву под ногами в жизни.
sound QET.aac
text @[Ёсино]
text Даже если бы сам он никогда не считал, что потерял эту почву... общество всё равно осудило бы его за это.
sound QEU.aac
text @[Ёсино]
text Они бы решили, что то, что он делает, неправильно, и попытались бы его исправить.
sound QEV.aac
text @[Ёсино]
text Если бы он не занимался музыкой, вокруг него не осталось бы никого, кто бы смеялся.
sound QEW.aac
text @[Ёсино]
text Вот почему к концу второго курса мальчишка принял решение.
if 0 == 0
	goto s22
fi
goto 24
