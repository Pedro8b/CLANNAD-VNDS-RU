text В команде соперников тоже все парни?
sound J4N.aac
text @[Нагиса]
text А, да. Верно.
sound J4O.aac
text @[Мисаэ]
text Я буду единственной женщиной?
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4P.aac
text @[Нагиса]
text Да... Это невозможно?..
setvar strS[1001] = "CGMS15H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS15H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4Q.aac
text @[Мисаэ]
text Не знаю, достаточно ли я спортивная, чтобы заменить парня в команде.
sound J4R.aac
text @[Мисаэ]
text Может, вам лучше поискать кого-то другого?
text @[Томоя]
text Ну, у нас не так уж много друзей...
text Я вставляю реплику, где могу.
setvar strS[1001] = "CGMS13H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS13H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4S.aac
text @[Мисаэ]
text И правда, я никогда не видела, чтобы вы двое тусовались с какими-то другими парнями.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4T.aac
text @[Нагиса]
text Эм... Пожалуйста, не могли бы вы нам помочь?
text Нагиса склоняет голову.
setvar strS[1001] = "CGMS21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4U.aac
text @[Мисаэ]
text Погоди, не делай так! Как я теперь могу тебе отказать?
text @[Томоя]
text Пожалуйста, Мисаэ-сан.
text Я прошу её, держа ногу на Сунохаре, чтобы он не мог подняться.
setvar strS[1001] = "CGMS13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4V.aac
text @[Мисаэ]
text Ты же понимаешь, что у меня на самом деле не так уж много свободного времени?
text @[Томоя]
text Это не займёт много времени. Всего минут двадцать от начала до конца.
sound J4W.aac
text @[Мисаэ]
text Я... понятно.
sound J4X.aac
text @[Мисаэ]
text Ну же, подними голову.
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J4Y.aac
text @[Нагиса]
text А, хорошо...
sound J4Z.aac
text @[Нагиса]
text Так вы присоединитесь?..
setvar strS[1001] = "CGMS13H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS13H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J50.aac
text @[Мисаэ]
text Что мне ещё остаётся? Не то чтобы я могла отказать...
sound J51.aac
text @[Нагиса]
text Большое спасибо!
setvar strS[1001] = "CGMS21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J52.aac
text @[Мисаэ]
text Эй, я же вроде говорила тебе не кланяться мне.
setvar strS[1001] = "CGMS20H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS20H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J53.aac
text @[Мисаэ]
text А... Что я вообще делаю...
setvar intF[833] = 1
jump SEEN6428_0_2.scr 111
jump SEEN6428_0_2.scr 105
jump SEEN6428_0_2.scr
