text text @[Суногара]
text text Чёрт... Вот почему я так ненавижу находиться рядом с детьми!
music ~
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text text Принудительно сдерживая гнев, Суногара с силой опускает задницу на стул.
setvar intF[121] = 1
goto 26
label 25
if intF[1089] == 4
	goto s21
fi
goto 26
label s21
music ~
delay 60
setvar intF[123] = 1
label 26
music BGM08B.mp3
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
