text На этот раз я слышу крики снаружи.
sound H28.aac
text @[Голос]
text Просто обуза, да...?!
sound H29.aac
text @[Голос]
text Я люблю его...!
text ......
text В комнате повисает тишина.
text И сколько мне ещё тут ждать?
bgload KURO.jpg 55
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGAK18E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK18E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2A.aac
text @[Акио]
text Чёрт... Не смог её догнать...
text Старик возвращается один, видимо, отказавшись от погони за Санаэ-сан.
setvar strS[1001] = "CGAK19E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2B.aac
text @[Акио]
text О, ты всё ещё здесь?
text @[Томоя]
text Я ещё не закончил.
setvar strS[1001] = "CGAK25E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK25E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2C.aac
text @[Акио]
text "Не закончил"...? Хочешь сказать, ты здесь, чтобы...
text @[Томоя]
text Нет.
setvar strS[1001] = "CGAK19E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2D.aac
text @[Акио]
text Тогда чего ты хочешь?
text @[Томоя]
text Я же только что спрашивал у Санаэ-сан, забыл? Я хочу узнать, как дела у Фурукавы.
setvar strS[1001] = "CGAK13E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2E.aac
text @[Акио]
text А, так это всё...?
text @[Томоя]
text У неё температура или что-то такое?
sound H2F.aac
text @[Акио]
text Агх...
text Он делает глубокую затяжку сигаретой и выдыхает дым.
setvar strS[1001] = "CGAK14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2G.aac
text @[Акио]
text У неё небольшая температура. Ничего страшного. Санаэ с ней, так что не переживай.
text Нет, я думаю, Санаэ-сан сейчас где-то бродит в слезах.
text Но по их дурацкой перепалке со стариком я понял, что с Фурукавой ничего серьёзного.
text Раз уж он так говорит, я перестаю волноваться.
text @[Томоя]
text Так она сможет прийти в школу завтра?
setvar strS[1001] = "CGAK13E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H2H.aac
text @[Акио]
text Хмф. Значит, хочешь, чтобы Нагиса пошла в школу? Чтобы там с ней флиртовать и заигрывать?
setvar strS[1001] = "CGAK12E"
setvar intF[1113] = intF[1112]
