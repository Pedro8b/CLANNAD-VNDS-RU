	fi
fi
text Я ухожу, пока снова не застрял здесь один.
label 4
music ~
if 0 == 0
	goto s4
fi
goto 5
label s4
setvar strS[1000] = "KURO"
goto 7
label 5
if 0 == 1
	goto s5
fi
goto 6
label s5
setvar strS[1000] = "SIRO"
