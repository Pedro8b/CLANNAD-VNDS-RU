text Томоё протягивает руку и вытирает уголок моего рта указательным пальцем.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5UD.aac
text @[Томоё]
text Пойдём?
text Затем она встаёт.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s22
fi
goto 24
label s22
setvar strS[1000] = ""
label 24
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG021"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 25
label s23
setvar strS[1000] = ""
label 25
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08C.mp3
text Мы наконец добираемся до класса как раз в тот момент, когда звенит звонок.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5UE.aac
text @[Сунохара]
text ...
sound 5UF.aac
text @[Сунохара]
text Слушай, Оказаки...
text @[Томоя]
text А?
sound 5UG.aac
text @[Сунохара]
text Как вообще так вышло?
text @[Томоя]
text Я встретил её в коридоре, и вот так всё и вышло.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5UH.aac
text @[Сунохара]
text И... это всё?
text @[Томоя]
text Ага, это всё.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5UI.aac
text @[Сунохара]
text Это... поистине удивительный поворот событий, разве нет?
sound 5UJ.aac
text @[Сунохара]
text Такое случается раз в жизни, да?
sound 5UK.aac
text @[Сунохара]
text Нам так повезло~...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сунохара нетвёрдой походкой идёт на своё место.
text Это было довольно жалкое зрелище.
setvar intF[213] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
