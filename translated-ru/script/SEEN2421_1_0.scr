setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text И прямо перед моими глазами — лицо Томоё.
sound 5QU.aac
text @[Томоё]
text Конечно же, ты тоже идёшь.
text Говорит Томоё, наши лица находятся на расстоянии всего одного дыхания друг от друга.
