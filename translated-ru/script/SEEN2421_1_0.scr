music ~
setvar strS[1000] = "BG017"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s8
fi
goto 10
label s8
setvar strS[1000] = ""
label 10
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM06.mp3
text Я направляюсь в столовую один.
text Впереди я вижу группу девушек, идущих мне навстречу.
text Среди них я замечаю Томоё.
text Она идёт уверенно, о чём-то говорит, улыбаясь.
text Похоже, у неё нет никаких проблем с тем, чтобы вписаться в компанию. Наоборот, мне кажется, что она — сам центр этой группы.
text Хотя у неё и есть буйная сторона, её обаяние, наверное, затмевает это с лихвой.
text Теперь я это как-то начинаю понимать.
text Вот почему мне жаль, что я обидел её, заметив, что она не особо женственная.
text @[Томоя]
text (Наверное, стоит притвориться, что мы не знакомы. По крайней мере, пока я один...)
text Как только я об этом подумал, наши взгляды встретились.
text @[Томоя]
text (Игнорируй её, просто игнорируй...)
text Я отвожу взгляд и пытаюсь пройти мимо неё.
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5QK.aac
text @[Томоё]
text Оказаки, ты как раз идёшь обедать?
text ...Она внезапно заговаривает со мной.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Ученица]
text ...
text Подруги Томоё замирают на месте и одновременно смотрят на моё лицо.
text ...Некоторые из них с очень удивлёнными выражениями лица.
