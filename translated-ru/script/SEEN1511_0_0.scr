setvar strS[1001] = "CGFU12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Кивок*
text Как только я увижу, как Фуко делает мне большой кивок, я отправляюсь.
setvar strS[1000] = "BG015A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s38
fi
goto 49
label s38
setvar strS[1000] = ""
label 49
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Несмотря на то, что до переднего ворот еще есть расстояние, я уже распознал человека, который там ждёт.
text @[Томоя]
text Коко-сан!
text Я зову её, когда подхожу ближе.
setvar strS[1001] = "CGKO10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4KE.aac
text @[Коко]
text Добрый день, Окадзаки-сан!
text @[Томоя]
text Добрый день. Ты долго ждёшь?
sound 4KF.aac
text @[Коко]
text Не совсем, я только что приехал сюда.
text @[Томоя]
text Понимаю. Тогда всё в порядке.
setvar strS[1001] = "CGKO12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4KG.aac
text @[Коко]
text Я с нетерпением ждал провести сегодня день с вами двумя.
sound 4KH.aac
text @[Коко]
text Мне уже немного застарел, чтобы бегать, но я надеюсь, что вы насладитесь фестивалем вместе.
setvar strS[1001] = "CGKO11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4KI.aac
text @[Коко]
text Мне достаточно радостно просто наблюдать.
text @[Томоя]
text Понимаю.
setvar strS[1001] = "CGKO10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4KJ.aac
text @[Коко]
text И... где Нагиса-чан?
text Она смотрит за мной.
text @[Томоя]
text Эм...
text @[Томоя]
text Да, она разговаривала с другом...
text @[Томоя]
text Но она скоро должна прийти сюда.
sound 4KK.aac
text @[Коко]
text Надеюсь, я не мешаю ей.
text @[Томоя]
text Куко-сан, она действительно к тебе симпатична... Никак она не будет думать о тебе таким образом.
sound 4KL.aac
text @[Коко]
text ...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text В ответ Куко-сан просто стоит в молчании.
text В течение короткого времени я переключаюсь на шум и гам других студентов.
text Теперь мне остается только ждать, пока {$lnmA} привезет Фуко сюда.
music ~
text Да... осталось всего несколько минут, и они снова встретятся.
text От этой мысли кровь приливает к груди.
text @[Томоя]
text (Скорее приходи, {$lnmA}...)
text @[Томоя]
text (Пока Коко-сан не передумала и не ушла...)
text @[Томоя]
text (Хотя, я точно знаю, что Коко-сан ни за что не уйдёт, не повидавшись сперва с {$lnmA}...)
setvar strS[1000] = "FGFU03A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s39
fi
goto 50
label s39
setvar strS[1000] = ""
label 50
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
music BGM01.mp3
sound 4KM.aac
text @[Коко]
text ...
sound 4KN.aac
text @[Коко]
text Слушай... Окадзаки-сан.
text @[Томоя]
text Да?
sound 4KO.aac
text @[Коко]
text Ты слышал слух?
text @[Томоя]
text Слух?
sound 4KP.aac
text @[Коко]
text Да...
sound 4KQ.aac
text @[Коко]
text Прямо сейчас, где-то здесь, в школе, Фуко...
sound 4KR.aac
text @[Коко]
text Бегает повсюду, полная энергии...
sound 4KS.aac
text @[Коко]
text И ещё... она вместе со своими друзьями.
text @[Томоя]
text Коко-сан, дело в том...
text Как раз когда я собирался сказать ей правду...
text Звук шагов позади меня заставляет замолчать.
setvar strS[1000] = "FGFU04B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s40
fi
goto 51
label s40
setvar strS[1000] = ""
label 51
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text Коко-сан по-прежнему смотрит прямо перед собой.
sound 4KT.aac
text @[Коко]
text ...
sound 4KU.aac
text @[Коко]
text Конечно, я понимаю, что такого не может быть.
sound 4KV.aac
text @[Коко]
text Ведь ещё сегодня утром я видела, как мирно она спит...
sound 4KW.aac
text @[Коко]
text ...
text Вот она...
music ~
text ...прямо перед ней.
text @[Томоя]
text Коко...-сан...
text Тогда почему...
music BGM18A.mp3
text Ну почему же...
text Как она может быть такой спокойной...
text Словно бы...
text Она не видит Фуко...
text Хотя та стоит прямо здесь...
text Сейчас они должны бы уже говорить друг с другом...
text О чувствах, о любви, которую силой сдерживали эти два года...
text ──«Потому что Фуко не может её встретить...»
text ──«Фуко не может донести до неё свои слова...»
text ──«Именно поэтому Фуко здесь...»
text Почему всё это вообще происходит?..
text Это тот человек, которого Фуко хочет видеть больше всех на свете...
text Человек, с которым она больше всего на свете хочет поговорить...
text ...Как такое вообще может происходить?
if 0 == 0
	goto s41
fi
jump SEEN1511_0_1.scr 52
label s41
setvar strS[1000] = "KURO"
jump SEEN1511_0_1.scr 54
jump SEEN1511_0_1.scr
