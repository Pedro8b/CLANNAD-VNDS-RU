music ~
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM14.mp3
text Я иду по привычной дороге совсем один.
text Вокруг никого в такой же форме, как у меня.
text Ну, конечно. Первый урок уже начался.
text Я чаще вижу эту дорогу пустой, чем заполненной школьниками в форме.
text @[Томоя]
text ...
text Может, стоит просто прогулять и где-нибудь потусоваться.
text Если пойду в школу, всё равно просплю весь урок...
text @　　　
setvar intA[1000] = 1380
setvar intA[1001] = 13
if 50 <= 80
	goto s1
fi
goto 2
label s1
setvar intA[1001] + 1
label 2
text *Врррум*
text Хотя в форме особо никуда на людях не пойдёшь...
text @　　
setvar intA[1000] = 1840
setvar intA[1001] = 18
if 50 <= 40
	goto s2
fi
goto 3
label s2
setvar intA[1001] + 1
label 3
text *Врррум*
text Зайти к Сунохаре убить время было бы неплохим вариантом...
text @　
setvar intA[1000] = 2300
setvar intA[1001] = 23
if 50 <= 0
	goto s3
fi
goto 4
label s3
setvar intA[1001] + 1
label 4
text *Врррум*
text Но если засну на уроке, меня хотя бы отметят присутствующим.
text *Врррум*
music ~
bgload SIRO.jpg 0
setvar intA[1000] = 4600
setvar intA[1001] = 46
if 50 <= 0
	goto s4
fi
goto 5
label s4
setvar intA[1001] + 1
label 5
text *Бам*
text @[Томоя]
text Аргх!
text Внезапно что-то врезается мне в спину.
text И удар был весьма ощутимым.
text На мгновение я не могу дышать, а в глазах мелькают искры.
text Спина горит огнём. Оборачиваюсь, хватаясь за неё рукой, и вижу...
setvar strS[1000] = "FGKY01A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s5
fi
goto 6
label s5
setvar strS[1000] = ""
label 6
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
music BGM03A.mp3
sound 8I0.aac
text @[Кё]
text А, извини!
text @[Томоя]
text Т-ты...! Только не говори, что это ты меня сбила этой штукой!
sound 8I1.aac
text @[Кё]
text Ахахаха! Если честно, я ещё не очень привыкла на нём ездить!
sound 8I2.aac
text @[Кё]
text Я же только на прошлой неделе получила права!
sound 8I3.aac
text @[Кё]
text Конечно, сдала с первого раза! Вот и купила себе новый байк! Новый байк!♪
sound 8I4.aac
text @[Кё]
text Ну как? Крутой, правда?
text @[Томоя]
text Сначала извинись как следует, а потом уже хвастайся!
sound 8I5.aac
text @[Кё]
text А? Я же только что сказала «извини», разве нет?
text @[Томоя]
text Это, по-твоему, искренность? Прояви её как-нибудь более ощутимо!
text @[Томоя]
text Загляни в словарь и посмотри значение слова «возмещение»!
setvar strS[1000] = "FGKY01B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s6
fi
goto 7
label s6
setvar strS[1000] = ""
label 7
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8I6.aac
text @[Кё]
text Ты о чём вообще? Сам виноват, что идёшь прямо посреди дороги!
text @[Томоя]
text Я беззащитный пешеход! У тебя отберут права за то, что покалечила человека!
sound 8I7.aac
text @[Кё]
text Ну и нытик же ты.
sound 8I8.aac
text @[Кё]
text Если ты такой беззащитный, то и иди по краю дороги, как и положено беззащитному пешеходу.
sound 8I9.aac
text @[Кё]
text Полез в драку с тем, кто сильнее тебя, а теперь, проиграв, строишь из себя жертву?
sound 8IA.aac
text @[Кё]
text Не будь таким мелочным.
text Так, погоди-ка. С чего это я должен тут стоять и выслушивать эту чушь?
text Я не пытался драться с мотоциклом.
text Она вообще-то въехала в меня сзади. Жертва тут на все сто процентов я.
text @[Томоя]
text ...Ладно.
sound 8IB.aac
text @[Кё]
text Что такое?
text @[Томоя]
text Я позвоню в полицию и скажу, что здесь произошло ДТП.
text @[Томоя]
text Какая бы ни была причина, у тебя точно отберут права.
text @[Томоя]
text Приятного тебе времяпрепровождения — целый день на скучных лекциях в автошколе.
sound 8IC.aac
text @[Кё]
text Только попробуй — превращу тебя в дорожное пятно.
text @[Томоя]
text ...
text Её глаза совсем не смеются.
text @[Томоя]
text Я просто пошутил.
setvar strS[1000] = "FGKY01C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s7
fi
goto 8
label s7
setvar strS[1000] = ""
label 8
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8ID.aac
text @[Кё]
text А вот я — нет.
text Ещё бы...
text @[Томоя]
text ...Кстати... что ты вообще тут делаешь так поздно?
text @[Томоя]
text И вообще, разве приезжать в школу на мотоцикле не запрещено правилами?
setvar strS[1000] = "FGKY01A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s8
fi
goto 9
label s8
setvar strS[1000] = ""
label 9
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8IE.aac
text @[Кё]
text Именно потому что опаздываю, я и еду на байке!
sound 8IF.aac
text @[Кё]
text Вокруг почти никого нет, я спешу, и так гораздо быстрее!
text @[Томоя]
text Ну, ты всё равно опаздываешь. Какая разница, как быстро ты едешь, если в итоге всё равно опоздаешь?
sound 8IG.aac
text @[Кё]
text С таким ленивым мышлением ты всю жизнь протратишь впустую.
text @[Томоя]
text А разве ездить в школу на байке, потому что так быстрее, не делает тебя такой же лентяйкой?
sound 8IH.aac
text @[Кё]
text Транспорт — плод человеческого разума! Вершина цивилизации! И он существует только затем, чтобы им пользовались!
text Что за ужасная логика...
text @[Томоя]
text Тогда хотя бы подвези меня до школы.
sound 8II.aac
text @[Кё]
text Этот байк рассчитан только на одного.
text @[Томоя]
text Если я втиснусь, места хватит на двоих.
setvar strS[1000] = "FGKY01C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s9
fi
goto 10
label s9
setvar strS[1000] = ""
label 10
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8IJ.aac
text @[Кё]
text Что? Уж не хочешь ли ты... обнять меня?
text @[Томоя]
text Ты хочешь сказать, что это можно?
sound 8IK.aac
text @[Кё]
text Если ты не против питаться на обед одной рисовой кашей.
text @[Томоя]
text ...
sound 8IL.aac
text @[Кё]
text А, я имела в виду, что сломаю тебе челюсть, если попробуешь.
text @[Томоя]
text Мне не нужны такие подробные объяснения!
setvar strS[1000] = "FGKY01A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s10
fi
goto 11
label s10
setvar strS[1000] = ""
label 11
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8IM.aac
text @[Кё]
text Ладно, тогда я поехала!
text @[Томоя]
text Ага, ладно.
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s11
fi
goto 12
label s11
setvar strS[1000] = ""
label 12
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я подхожу к байку Кё сзади и сажусь на заднее крыло.
text @[Томоя]
text Поехали!
text *Хлобысь*
text Её шлем безжалостно бьёт меня по подбородку.
text @[Томоя]
text Это же больно!
setvar strS[1000] = "FGKY01B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 13
label s12
setvar strS[1000] = ""
label 13
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8IN.aac
text @[Кё]
text Ты вообще куда уселся? Сломаешь крыло — сломаю тебе нос!
text @[Томоя]
text Разве ты не говорила, что можно, если я тебя не обнимаю?
sound 8IO.aac
text @[Кё]
text Тогда садись на сиденье и держи руки поднятыми в воздухе.
text @[Томоя]
text Меня же сбросит с байка!
sound 8IP.aac
text @[Кё]
text Я не буду ехать так быстро.
text @[Томоя]
text Тогда дай мне побольше места на сиденье.
sound 8IQ.aac
text @[Кё]
text Тьфу ты... слезь с байка на секунду.
text @[Томоя]
text Ладно...
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 14
label s13
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Соскальзываю с заднего крыла и встаю рядом с байком.
text @[Томоя]
text Так, теперь освободи мне мес─
text *Врррум*
text @[Томоя]
text Эй, ты куда это собралась?!
sound 8IR.aac
text @[Кё]
text Ахахахахаха! Какой же ты наивный дурачок!
text Оскорбления Кё стихают вдали, пока она уезжает от меня.
text @[Томоя]
text В следующий раз, как увижу твой байк, залеплю жвачкой замочную скважину!
text С визгом шин Кё вдруг разворачивается на месте вдалеке.
text и мчится прямо сюда!
setvar intA[1000] = 4600
setvar intA[1001] = 46
if 50 <= 0
	goto s14
fi
goto 15
label s14
setvar intA[1001] + 1
label 15
text *Бам*
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Ай!
setvar strS[1000] = "FGKY01B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 16
label s15
setvar strS[1000] = ""
label 16
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound 8IS.aac
text @[Кё]
text ...Сделаешь это — воткну тебе палочки под ногти.
text @[Томоя]
text Учту...
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 17
label s16
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Одарив меня взглядом, Кё разворачивает байк и снова уезжает.
text Ну и не умеет же она шутить.
text Перевожу дух, глядя, как удаляется задний фонарь её байка.
text ......
text Кстати... предсказание Фудзибаяси...
text Меня ждёт сильное столкновение с доброй девушкой...?
text И тело, и дух обновятся...?
text ...Чёрт возьми... вот же дурочка...
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN3417_1_0.scr
