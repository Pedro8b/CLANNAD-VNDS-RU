setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 24E.aac
text text @[Фуко]
text text Такой глупый зверь не существует.
text text @[Томоя]
text text Ну, если так говоришь. В любом случае, я понял, насколько ты его любишь.
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
