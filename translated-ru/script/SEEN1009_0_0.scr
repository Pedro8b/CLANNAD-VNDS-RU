setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 24Q.aac
text текст @[Акио]
text текст Тсс... Значит, ты пришёл просить остатки...
sound 24R.aac
text текст @[Акио]
text текст Как насчёт иногда приходить покупать, как обычный клиент?
text текст @[Томоя]
text текст Не могу ли я получить немного?
