		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 24W.aac
text text @[Акио]
text text @A Радуга...
delay 74
text text для тебя.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text text Оставив загадочную фразу, старик исчезает в кухню.
text text Я решаю вернуться в комнату.
setvar strS[1000] = "BG002N1"
setvar intA[1000] = 1
