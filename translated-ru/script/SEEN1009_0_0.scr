		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 24N.aac
text текст @[Фуко]
text текст Это слишком девичево для тебя?
setvar strS[1001] = "CGFU30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU30.png
if intF[1113] == 1
