text текст Если это то, что ты пытаешься сказать, Фуко ничего не скажет в ответ.
text текст @[Томоя]
text текст Просто чтобы ты знал, я ничего такого не говорил.
setvar intF[104] + 1
if intF[104] == 2
	goto s19
fi
goto 19
