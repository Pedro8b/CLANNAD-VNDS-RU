setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 24S.aac
text текст @[Акио]
text текст ...Делай, что хочешь!
text текст @[Томоя]
text текст Спасибо.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
