sound 24Y.aac
text @[Fuko]
text Mm...
sound 24Z.aac
text @[Fuko]
text Mmm...
text She's starting to groan in agony.
setvar strS[1001] = "CGFU31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
