setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L23.aac
text @[Нагиса]
text Остальную часть истории.
text @[Томоя]
text Расскажи мне.
sound L24.aac
text @[Нагиса]
text Хорошо.
sound L25.aac
text @[Нагиса]
text Девочка и кукла решают покинуть этот мир.
text @[Томоя]
text Почему?
sound L26.aac
text @[Нагиса]
text Потому что кукла знала, что далеко-далеко есть другой мир.
sound L27.aac
text @[Нагиса]
text Тёплый мир, полный людей.
sound L28.aac
text @[Нагиса]
text И тогда они вдвоём дают друг другу обещание сбежать из своего одинокого мира и отправиться в путешествие.
text @[Томоя]
text А что было дальше...?
setvar strS[1001] = "CGNG36A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG36A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L29.aac
text @[Нагиса]
text Ну...
sound L2A.aac
text @[Нагиса]
text После долгого путешествия...
text @[Томоя]
text И что потом?
setvar strS[1001] = "CGNG10AZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10AZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2B.aac
text @[Нагиса]
text Они поют песню.
text @[Томоя]
text Песню?
sound L2C.aac
text @[Нагиса]
text Да. Песню.
text @[Томоя]
text Ты серьёзно...?
setvar strS[1001] = "CGNG23AZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23AZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2D.aac
text @[Нагиса]
text Серьёзно. Поэтому и было логично, что я спела песню в конце спектакля.
sound L2E.aac
text @[Нагиса]
text Это была следующая часть истории.
text @[Томоя]
text Погоди, но...
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2F.aac
text @[Нагиса]
text Да.
text @[Томоя]
text Не могла же та девочка спеть песню "Большой семьи Данго".
sound L2G.aac
text @[Нагиса]
text Я хотела спеть её, потому что она мне нравится.
text @[Томоя]
text Это я понял. С чего бы ещё тебе её петь?
text @[Томоя]
text Знаешь, весь спектакль прошёл отлично... но когда в самом конце ты спела эту песню, все чуть со стульев не попадали.
text @[Томоя]
text Ты смазала всё эмоциональное впечатление.
setvar strS[1001] = "CGNG23A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2H.aac
text @[Нагиса]
text Но мне казалось, что это трогательно.
text @[Томоя]
text Ну, может, и так, но...
text @[Томоя]
text ...А, ладно, неважно.
text @[Томоя]
text Твой спектакль был потрясающим.
setvar strS[1001] = "CGNG14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2I.aac
text @[Нагиса]
text Правда?
text @[Томоя]
text Ага. И я не делаю комплименты, когда не имею их в виду. Ты же знаешь.
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2J.aac
text @[Нагиса]
text Да, знаю.
setvar strS[1001] = "CGNG23A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2K.aac
text @[Нагиса]
text Именно поэтому мне так приятно.
setvar strS[1001] = "CGNG25A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2L.aac
text @[Нагиса]
text Хе-хе.
text На лице Нагисы беззаботная улыбка.
text Значит ли это, что ей удалось справиться с грустью?
text Поверила ли она словам своего отца?
text Или эта борьба ещё впереди?
text Но сейчас я собираюсь просто наслаждаться этим моментом.
text В конце концов, мы шли к этому целый месяц.
text @[Томоя]
text Эй, Нагиса.
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2M.aac
text @[Нагиса]
text Да?
text Нагиса смотрит на меня.
text Я приближаю своё лицо к её лицу.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2N.aac
text @[Голос]
text Какого чёрта ты творишь, сопляк?
text В голосе клокочет неприкрытая агрессия.
sound L2O.aac
text @[Нагиса]
text Ой, папа!
text Не понимая, что я вообще пытался сделать, Нагиса оборачивается.
setvar strS[1001] = "CGAK11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2P.aac
text @[Акио]
text Ты же только что пытался поцеловать Нагису, да?
setvar strS[1001] = "CGAK13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2Q.aac
text @[Акио]
text Слушай сюда. Она изначально была тем, что вышло из меня там, внизу, просто теперь сильно выросла.
setvar strS[1001] = "CGAK22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2R.aac
text @[Акио]
text Ну и что ты на это скажешь? Аж мурашки, поцеловать теперь не можешь, да?
text То, что происходит между ног у этого парня — поистине загадка.
setvar strS[1001] = "CGAK23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2S.aac
text @[Акио]
text В общем, время ужинать. К тому же сегодня твой праздник, так что давайте есть, пить и веселиться!
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2T.aac
text @[Нагиса]
text Хорошо. Не могу дождаться!
setvar strS[1001] = "CGNG23A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2U.aac
text @[Нагиса]
text Пойдём, Томоя-кун.
text @[Томоя]
text Конечно.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s62
fi
goto 75
label s62
setvar strS[1000] = ""
label 75
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text И вот так этот день, полный боли, грусти и радости, подходит к концу.
if 0 == 0
	goto s63
fi
goto 76
label s63
setvar strS[1000] = "KURO"
goto 78
label 76
if 0 == 1
	goto s64
fi
goto 77
