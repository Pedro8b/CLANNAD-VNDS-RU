	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CB.aac
text @[Сунохара]
text О, это?
sound CC.aac
text @[Сунохара]
text На самом деле, это было какое-то представление.
text @[Томоя]
text Что ты имеешь в виду под этим?
sound CD.aac
text @[Сунохара]
text Оказывается, она перевелась только этой весной. Она пытается стать популярной или чем-то таким.
setvar strS[1001] = "CGSH25B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CE.aac
text @[Сунохара]
text У нее, должно быть, была ужасная удача с парнями в ее старой школе.
sound CF.aac
text @[Сунохара]
text Кто использует такие грязные трюки, чтобы стать популярным?
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CG.aac
text @[Сунохара]
text Если бы она была парнем, я бы пошел и преподал ей урок.
text Я не имею представления, о чем он говорит.
setvar strS[1001] = "CGSH12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CH.aac
text @[Сунохара]
text Но, она девушка, поэтому я на данный момент отпущу ее.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CI.aac
text @[Сунохара]
text Тем не менее, если она начинает привлекать к себе слишком много внимания, я не собираюсь просто оставить ее в покое.
text Похоже, я был дураком, что попросил его объяснить что-то.
jump SEEN0415_0_2.scr 105
jump SEEN0415_0_2.scr
