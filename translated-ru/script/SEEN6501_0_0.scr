music BGM15.mp3
text Аах...
text Сначала я делаю это, чтобы сгладить ситуацию, но теперь я правда чувствую, что не могу остановиться...
text Нагиса выглядит так мило, когда я вижу её вот такой тоже...
text Ну, она всегда милая, но...
text Я приближаю своё лицо ещё ближе.
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound K41.aac
text @[Нагиса]
text А...?
text Тело Нагисы напрягается.
text Она могла бы отступить, но не делает этого...
text Знаешь, мысль о том, что наш первый раз произойдёт в клубной комнате, звучит не так уж плохо...
text Я продолжаю приближаться, пока не прижимаю свои губы к губам Нагисы, и...
music ~
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
