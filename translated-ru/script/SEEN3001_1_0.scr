text @[Томоя]
text Здравствуйте, я пришёл забрать свою дочь.
setvar strS[1001] = "CGKY12I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8CU.aac
text @[Кё]
text Привет, ты неплохо потрудился.
text Кё поднимает руку в знак приветствия и идёт ко мне.
text @[Томоя]
text Где Усио?
setvar strS[1001] = "CGKY11I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8CV.aac
text @[Кё]
text Играет с Ботаном.
text @[Томоя]
text С Ботаном?
sound 8CW.aac
text @[Кё]
text Ей нравится скатываться с его спины, как с горки.
text @[Томоя]
text И он не против?
setvar strS[1001] = "CGKY10K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY10K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8CX.aac
text @[Кё]
text Хм... кажется, ему это тоже нравится — вроде как массирует спину.
text @[Томоя]
text Понятно.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Кё возвращается внутрь детского сада и зовёт Усио.
sound 8CY.aac
text @[Кё]
text Усио-тян, этот никчёмный пришёл тебя забрать!
text @[Томоя]
text Вот же ты... так и называешь родителя перед его собственным ребёнком?
setvar strS[1001] = "CGKY15I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8CZ.aac
text @[Кё]
text Но ведь это правда, разве нет?
text @[Томоя]
text Я сейчас стараюсь изо всех сил.
setvar strS[1001] = "CGKY12I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D0.aac
text @[Кё]
text Если продолжишь в том же духе, я перестану тебя так называть.
text @[Томоя]
text Очень на это надеюсь...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Топ* *Топ* *Топ* *Топ* ... *Обнимашки*
text Усио подбегает ко мне и обнимает мою ногу.
text Видя, какая моя дочь милая, я невольно расплываюсь в улыбке.
setvar strS[1001] = "CGUS19K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS19K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D1.aac
text @[Усио]
text С возвращением.
text @[Томоя]
text Ага, я вернулся... так нормально?
setvar strS[1001] = "CGKY11I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D2.aac
text @[Кё]
text Всё в порядке, разве нет?
text @[Томоя]
text Ну ладно. Я вернулся. Ты хорошо себя вела?
setvar strS[1001] = "CGUS19K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS19K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D3.aac
text @[Усио]
text Ага.
text @[Томоя]
text Эта тётя тебя не обижала?
setvar strS[1001] = "CGKY13I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D4.aac
text @[Кё]
text На кого это ты показываешь?
text Усио качает головой из стороны в сторону.
setvar strS[1001] = "CGUS18K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS18K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D5.aac
text @[Усио]
text Она очень добрая.
text @[Томоя]
text ...
setvar strS[1001] = "CGKY14I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY14I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D6.aac
text @[Кё]
text Что это за выражение лица? Тебе что-то не нравится?
text @[Томоя]
text Нет... просто как вспомню, что было в старшей школе...
setvar strS[1001] = "CGKY13I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D7.aac
text @[Кё]
text Ну, то же самое я могу сказать про тебя — ты теперь выглядишь как вполне взрослый отец.
text @[Томоя]
text Правда, что ли?
setvar strS[1001] = "CGKY17I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY17I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D8.aac
text @[Кё]
text Ты прямо как любящий родитель — вон как расплылся в улыбке.
text Услышав это, я тут же тянусь рукой к своему лицу.
setvar strS[1001] = "CGKY12I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8D9.aac
text @[Кё]
text Усио-тян, разве не раздражает, что папа такой размазня?
text Усио качает своей маленькой головкой из стороны в сторону.
setvar strS[1001] = "CGUS18K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS18K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DA.aac
text @[Усио]
text Папа очень крутой.
setvar strS[1001] = "CGKY25I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY25I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DB.aac
text @[Кё]
text О?
text @[Томоя]
text Ха-ха-ха, похоже, у неё хороший вкус на мужчин.
setvar strS[1001] = "CGKY26I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY26I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DC.aac
text @[Кё]
text Страшно то, к чему привыкание может привести...
text Кё вздыхает.
setvar strS[1001] = "CGKY15I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DD.aac
text @[Кё]
text А, точно, сегодня мы раздавали листовки.
text @[Томоя]
text М? А, вот как?
text Я смотрю на Усио, которая в ответ кивает.
setvar strS[1001] = "CGKY11I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DE.aac
text @[Кё]
text Это объявление про спортивный праздник. Там будут и конкурсы для родителей, так что обязательно подготовься.
sound 8DF.aac
text @[Кё]
text А, на следующей неделе будет собрание для родителей.
text @[Томоя]
text Не уверен, что смогу прийти на него. Наверное, буду на работе.
setvar strS[1001] = "CGKY12I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DG.aac
text @[Кё]
text Но на само мероприятие уж постарайся прийти.
text Усио хватает меня за штанину и тянет.
text @[Томоя]
text Что такое?
setvar strS[1001] = "CGUS19K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS19K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DH.aac
text @[Усио]
text ...Я хочу посмотреть.
text @[Томоя]
text Посмотреть на что?
sound 8DI.aac
text @[Усио]
text Какой папа классный.
text @[Томоя]
text Ага, конечно. Покажу тебе.
text @[Томоя]
text Может, по мне и не скажешь, но бегаю я довольно быстро.
text @[Томоя]
text Ну, по крайней мере, так было в старшей школе.
setvar strS[1001] = "CGKY15I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DJ.aac
text @[Кё]
text Да ну, неужели?
text @[Томоя]
text ...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Кё отворачивается под моим взглядом.
text @[Томоя]
text В любом случае, раз я каждый день занимаюсь физической работой, вряд ли я растерял форму.
text @[Томоя]
text К тому же, я довольно молод для родителя, разве нет? Уверен, не уступлю тем родителям среднего возраста.
setvar strS[1001] = "CGKY24I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY24I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DK.aac
text @[Кё]
text Сомневаюсь.
text @[Томоя]
text Это ты о чём вообще?
setvar strS[1001] = "CGKY12I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DL.aac
text @[Кё]
text Неважно. В общем, не опозорься перед Усио-тян.
text @[Томоя]
text Всё будет нормально.
setvar strS[1001] = "CGUS11K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS11K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DM.aac
text @[Усио]
text Жду с нетерпением.
text @[Томоя]
text Ага, жди с нетерпением.
text @[Томоя]
text И ещё... я бы хотел, чтобы пришли Санаэ-сан и старик.
text @[Томоя]
text Хочу, чтобы они увидели, как ты стараешься.
setvar strS[1001] = "CGUS19K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS19K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DN.aac
text @[Усио]
text Ага.
text @[Томоя]
text О, точно. Наверное, самое время купить новую камеру.
text @[Томоя]
text Наделаю кучу твоих фотографий.
sound 8DO.aac
text @[Усио]
text Ага.
text @[Томоя]
text Спортивный праздник, значит? Думаю, смогу наснимать много хороших кадров.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я представляю, как она будет выглядеть.
text Усио выглядит очень мило, когда старается, так что тут уж ничего не поделаешь.
text @[Томоя]
text Если отправлю эти фото на телеканалы, уверен, её сразу же возьмут.
text @[Томоя]
text А потом за неё начнут бороться все модельные агентства.
text @[Томоя]
text Хотя как у родителя у меня от этого будут смешанные чувства.
text @[Томоя]
text Усио, начинай уже тренировать автограф, пока есть время.
text @[Томоя]
text Обязательно подари мне самый первый.
setvar strS[1001] = "CGKY25I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY25I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DP.aac
text @[Кё]
text Ну и любящий же родитель...
text @[Томоя]
text А? Это же вполне естественно, разве нет?
setvar strS[1001] = "CGKY26I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY26I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DQ.aac
text @[Кё]
text И к тому же ещё и придурковатый.
setvar strS[1001] = "CGUS10K"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS10K.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8DR.aac
text @[Усио]
text ...?
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
