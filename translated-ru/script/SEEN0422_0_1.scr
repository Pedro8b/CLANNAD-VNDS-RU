	fi
fi
sound 03E.aac
text @[Отец]
text Это ты сделал, Томоя-кун?
text @[Томоя]
text Что сделал...?
text Я прищуриваюсь.
text У него в руках... деревянная звезда.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
