bgload {$strS[1000]}.jpg 30
setimg CGAK13H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O8S.aac
text @[Акио]
text А, моя вина. Не переживай и иди себе.
sound O8T.aac
text @[Мужчина]
text Мне только что было больно из-за тебя!
sound O8U.aac
text @[Акио]
text Ага, малец, а я только что извинился.
sound O8V.aac
text @[Мужчина]
text Ах ты...!
text Он замахивается.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Но старик уклоняется и снова подставляет ему подножку.
text *ТРАХ*
text Мужчина врезается в стол, за которым мы только что сидели. Наши стаканы падают, разливая воду повсюду.
text @[Томоя]
text Старик!
setvar strS[1001] = "CGAK19H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O8W.aac
text @[Акио]
text Хм? Это только что был я?
text @[Томоя]
text А кто ещё это мог быть?!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O8X.aac
text @[Голос]
text Что-то случилось?
text Через мгновение вмешивается мужчина. Похоже, это управляющий.
text Но у меня и не было никакого намерения продолжать разбираться с этой компанией парней, в любом случае.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s729
fi
goto 873
label s729
setvar strS[1000] = ""
label 873
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG047Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s730
fi
goto 874
label s730
setvar strS[1000] = ""
label 874
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08D.mp3
text Как раз когда ресторан пустеет перед закрытием, я оказываюсь сидящим за столиком напротив управляющего.
text Что касается старика...
sound O8Y.aac
text @[Акио]
text Разберись с этим сам! Пока, не хотел бы быть на твоём месте!
text Он убегает с этими прощальными словами.
text @[Томоя]
text (Поверить не могу...)
text @[Томоя]
text (Так теперь меня будут отчитывать в одиночку?..)
sound O8Z.aac
text @[Управляющий]
text Меня зовут Исигата. Я здесь управляющий.
text Он протягивает мне свою визитку.
text @[Томоя]
text Я Оказаки.
sound O90.aac
text @[Управляющий]
text Так, судя по тому, что я слышал...
sound O91.aac
text @[Управляющий]
text Вы муж Оказаки-кун, верно?
text @[Томоя]
text Оказаки-кун?
text Это моя фамилия.
sound O92.aac
text @[Управляющий]
text Ох... извините, это, наверное, звучало запутанно.
sound O93.aac
text @[Управляющий]
text Как там было её имя?.. Ах, точно, Нагиса-кун.
text Ах... значит, здешний управляющий называет Нагису «Оказаки-кун».
text Мне немного стыдно от того, что он привычнее к этой фамилии, чем я сам.
text @[Томоя]
text Простите, что устроил такой беспорядок.
sound O94.aac
text @[Управляющий]
text Нет, что вы, вовсе нет. Вы наверняка расстроились, увидев, как кто-то заигрывает с вашей дорогой женой вот так.
sound O95.aac
text @[Управляющий]
text Оказаки-кун — симпатичная девушка, так что подобное случалось и раньше.
sound O96.aac
text @[Управляющий]
text Но до сих пор ей удавалось справляться со всем этим самой.
text @[Томоя]
text Понятно...
sound O97.aac
text @[Управляющий]
text Да, она умнее, чем может показаться.
sound O98.aac
text @[Управляющий]
text Простите, это, наверное, прозвучало грубо.
text @[Томоя]
text Нет...
sound O99.aac
text @[Управляющий]
text И хотя из её заявления следовало, что у неё слабое здоровье, на работе она выглядит просто образцом здоровья.
sound O9A.aac
text @[Управляющий]
text На самом деле, она работает усерднее любого, кого можно назвать здоровым сотрудником.
text Это на неё похоже, всегда выкладывается по полной...
sound O9B.aac
text @[Управляющий]
text Так что, думаю, вам не о чем волноваться, Оказаки-сан.
text Ах... теперь понимаю.
text Вот что он хотел мне сказать.
text Он здесь не для того, чтобы отчитывать меня за причинённые проблемы.
text Он хочет успокоить меня, мужа Нагисы.
text Какой хороший человек.
sound O9C.aac
text @[Управляющий]
text И хотя по мне не скажешь, я сам довольно неплохой боец.
text Добавляет он, вероятно, из-за моего молчания.
text @[Томоя]
text Ах, да... мне гораздо спокойнее после разговора с вами.
text Отвечаю я поспешно.
text @[Томоя]
text Хоть я и знаю, что она далека от совершенства... пожалуйста, позаботьтесь о ней.
text Я завершаю разговор поклоном.
jump SEEN6800_7_0.scr
