sound 4QP.aac
text @[Сунохара]
text Хотя бы нормальные люди издают звук, когда идут! Что ты? Призрак?
text @[Томоя]
text ...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
