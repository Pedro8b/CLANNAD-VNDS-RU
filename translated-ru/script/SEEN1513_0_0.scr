fi
text Я вошёл в комнату и сел на своё обычное место.
text @[Томоя]
text Слушай, Сунохара...
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4QQ.aac
text @[Сунохара]
text Что случилось?
text @[Томоя]
text После того, спросил ли ты его?
setvar strS[1001] = "CGSH20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4QR.aac
text @[Сунохара]
text Что?
text @[Томоя]
text Разве ты не пошёл за тем парнем, который игнорировал Фуко?
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 4QS.aac
text @[Сунохара]
text Да...
text Сунохара отвечает мне неопределённо, как будто колеблется, чтобы что‑то сказать.
text @[Томоя]
text …Что-то случилось?
sound 4QT.aac
text @[Сунохара]
text Тот парень только что сказал что‑то безумное. Слишком много хлопот, чтобы объяснять.
text Не уверена, что хочу услышать, что он скажет дальше.
text Но если сейчас не спрошу его, я никогда не узнаю, что на самом деле происходит.
text В конце концов, мы можем потерять драгоценное время, которое нам дано.
text @[Томоя]
text Расскажи мне подробно.
text Я набираю в себе смелости и говорю ему.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
