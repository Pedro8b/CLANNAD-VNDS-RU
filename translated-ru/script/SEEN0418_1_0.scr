text @[Томоя]
text Ты такой трус.
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TM.aac
text @[Сунохара]
text Хм? Что это такое...? Попробуй сказать это снова.
text @[Томоя]
text Чего? Ладно, ты такой извращенец.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TN.aac
text @[Сунохара]
text Это не то, что ты сказал в первый раз!
sound TO.aac
text @[Сунохара]
text Ты назвал меня трусом, да?
text @[Томоя]
text Ах да, это было именно так.
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TP.aac
text @[Сунохара]
text Хорошо, я покажу тебе! Завтра я буду поздно приходить в школу!
text @[Томоя]
text Тебе至少 следует взять день отпуска.
text @[Томоя]
text Да, может быть, неделю отпуска... Нет, месяц отпуска...!
text @[Томоя]
text На самом деле, просто не приходи в школу больше.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TQ.aac
text @[Сунохара]
text Это будет равноценно тому, чтобы бросить школу!
text @[Томоя]
text Ну, да, можно и так сказать.
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TR.aac
text @[Сунохара]
text Ха... Я покажу тебе, как я неординарный человек!
text @[Томоя]
text Во-первых, кто так говорит? Во-вторых, я тебя уже и не считаю человеком. Итак...
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TS.aac
text @[Сунохара]
text Что это значит?!
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s80
fi
goto 82
label s80
setvar strS[1000] = ""
label 82
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG046N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s81
fi
goto 83
label s81
setvar strS[1000] = ""
label 83
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Хорошо, пора мне уходить.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TT.aac
text @[Сунохара]
text О, пора спать Томое-чану?
text @[Томоя]
text Ты останешься?
setvar strS[1001] = "CGSH25B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TU.aac
text @[Сунохара]
text Конечно. Я читаю книги-moduleName до утра. Пора для захватывающего путешествия!
text @[Томоя]
text Похоже, ты здесь ребенок.
text @[Томоя]
text *Зевок* Мне действительно хочется спать.
text @[Томоя]
text До свидания. Тебе тоже пора спать.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
