setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5C2.aac
text @[Сунохара]
text Что...?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5C3.aac
text @[Сунохара]
text Чёрт!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сунохара вытягивает руки в обороне, но это бесполезно.
text Она проскальзывает между ними, оставляя их стоять лицом к лицу.
text Затем, используя инерцию, накопленную во время рывка...
text ...она обрушивает на него мощный шквал ударов ногами.
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text О-о-ох! Его реально уносит в воздух.
setvar strS[1001] = "CGTM18H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5C4.aac
text @[Томоё]
text Чужак, открывай мусоропровод!
text @[Томоя]
text А? О! 
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я быстро подбегаю к мусоропроводу в стене и открываю крышку.
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*БАМ* 
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Фвump*
text Последним ударом Сунохара влетает головой вперед в открытую дыру в стене.
sound 5C5.aac
text @[Сунохара]
text Ува-а-а! Помогите!
music ~
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5C6.aac
text @[Томоё]
text Ой, да просто расслабь плечи.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10B.mp3
text Шаг за шагом он проскальзывает всё глубже.
sound 5C7.aac
text @[Сунохара]
text Э-это не может быть правдой! Окадзаки, спаси меня!
text *Шлюп*
text Его тело погружается всё глубже и глубже в стену.
text Если не знать ситуации, могло показаться, что нижняя половина чьего-то тела прилеплена к стене. Выглядит крайне жутко.
text *Шлюююп*
sound 5C8.aac
text @[Сунохара]
text А, гваааа!!
text Видны только носки его ботинок, цепляющиеся за край стены.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5C9.aac
text @[Томоё]
text Если я подвину твои ноги, ты упадёшь. Сделать это?
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CA.aac
text @[Томоё]
text А, значит ты хочешь упасть. Хорошо. Понимаю.
sound 5CB.aac
text @[Сунохара]
text Я ничего такого не говорил!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Одним щелчком пальца Томоё убирает хватку Сунохары с жёлоба.
sound 5CC.aac
text @[Сунохара]
text А как же пощада?! Погоди, воааа!
music ~
sound TCY.aac
text ААААРГХХХХХХ──────...
text Его предсмертный вопль медленно затихает вдали.
text Внезапно её тело напрягается.
music BGM14.mp3
setvar strS[1001] = "CGTM34"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM34.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CD.aac
text @[Томоё]
text ...
sound 5CE.aac
text @[Томоё]
text Это плохо...
sound 5CF.aac
text @[Томоё]
text Он мог погибнуть...
text @[Томоя]
text Не-а... Мы же говорим о нём. С ним всё будет отлично!
text Я отвечаю ей бодро и вдобавок показываю большой палец вверх.
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CG.aac
text @[Томоё]
text Правда? Какое облегчение.
text @[Томоя]
text Кстати, это утверждение вообще ни на чём не основано!
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CH.aac
text @[Томоё]
text Ха-ха.
text @[Томоя]
text Ха-ха-ха!
text Мы смеёмся вместе, словно в каком‑то подростковом драме.
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CI.aac
text @[Томоё]
text Ну, с этим, я уверена, он наконец‑то усвоил урок.
text @[Томоя]
text Простите, но он не тот парень, который так просто усвоит урок.
setvar strS[1001] = "CGTM14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CJ.aac
text @[Томоё]
text Это тревожно, если так. Пожалуйста, поговори с ним и заставь его прекратить.
text @[Томоя]
text Было бы здорово, если бы он был тем типом, кто действительно слушает меня.
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CK.aac
text @[Томоё]
text Вы же друзья, не так ли?
text @[Томоя]
text Хм… я действительно не уверен.
text @[Томоя]
text Я провожу с ним время только потому, что мне весело наблюдать, как он сходит с ума.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CL.aac
text @[Томоё]
text То есть ты говоришь, что это будет продолжаться…?
text @[Томоя]
text По крайней мере, пока он не устанет.
setvar strS[1001] = "CGTM14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CM.aac
text @[Томоё]
text Я, кажется, действительно запуталась в этой неприятной ситуации, не так ли…
text @[Томоя]
text Если это действительно начнёт тебя беспокоить, просто скажи.
setvar strS[1001] = "CGTM12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CN.aac
text @[Томоё]
text Это уже меня довольно сильно беспокоит.
text @[Томоя]
text Честно говоря, ты не выглядишь особо обеспокоенной.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CO.aac
text @[Томоё]
text *Шмыг*
text Возможно, беспокоясь, что вспотела, она оттягивает воротник водолазки и подносит нос поближе.
text Сделав глубокий вдох, она поправляет воротник обратно.
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CP.aac
text @[Томоё]
text Но всё же...
sound 5CQ.aac
text @[Томоё]
text Глядя на вас двоих, я вспоминаю былые времена.
sound 5CR.aac
text @[Томоё]
text Думаю, это здорово — уметь вытворять такие безумства.
text ...Хотя ты и сама тут вытворяла довольно безумные вещи, между прочим.
text @[Томоя]
text (Более того, судя по слухам, в прошлом ты вытворяла вещи и похлеще...)
text @[Томоя]
text (Интересно, пытается ли она в последнее время сдерживать себя...)
sound 5CS.aac
text @[Томоё]
text Если у тебя есть хоть капля совести, пожалуйста, заставь его остановиться.
text @[Томоя]
text Может быть, если будет настроение.
sound 5CT.aac
text @[Томоё]
text Ага...
sound 5CU.aac
text @[Томоё]
text Буду на это надеяться.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сказав это, она уходит.
setvar intF[203] = 1
setvar intF[202] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2416_2_0.scr
