setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08A.mp3
text Класс окончен, и уже после уроков.
text Сунохара подходит ко мне, пробираясь сквозь учеников, направляющихся домой.
