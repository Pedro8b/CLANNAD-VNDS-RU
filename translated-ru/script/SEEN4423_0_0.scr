if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (Пора...)
text Тридцать минут спустя я действую.
text Учитель занят уроком.
text Однако, несмотря на то, что он пишет на доске, спиной к классу, очевидно, что он настороже.
text Если я попытаюсь пробраться, меня сразу же заметят.
text Мне следует делать это дерзко.
text Я встаю.
text Как будто это совершенно естественно, я спокойно и молча направляюсь к двери.
text Все, включая учителя, смотрят на меня.
