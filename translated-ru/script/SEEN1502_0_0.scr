text Я сейчас ухожу.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она выходит из комнаты.
text Это как бы разочаровывает.
goto 24
label 23
if intF[136] == 1
	goto s21
fi
goto 24
label s21
text Мы позволяем нашим головам слегка касаться, глядя вниз и просматривая список.
sound 3XZ.aac
text @[Нагиса]
text Мне взять на себя список и просто назвать вам номера?
text Я почти чувствую её дыхание на своей коже, когда она это говорит. Мы так близки друг к другу.
setvar strS[1001] = "CGNG13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3Y0.aac
text @[Нагиса]
text Ах...
text Внезапно Нагиса поднимает взгляд на часы.
text @[Томоя]
text Что случилось?
setvar strS[1001] = "CGNG16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3Y1.aac
text @[Нагиса]
text Почти пора мне идти помогать с ужином.
text @[Томоя]
text Так... значит...
sound 3Y2.aac
text @[Нагиса]
text Прости, Томоя-кун, но тебе придётся взять это на себя отсюда.
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3Y3.aac
text @[Нагиса]
text Взамен я позабочусь, чтобы ужин пришёлся тебе по вкусу.
text @[Томоя]
text Конечно. Я с нетерпением жду этого.
sound 3Y4.aac
text @[Нагиса]
text Я сейчас ухожу.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она выходит из комнаты.
text @[Томоя]
text (Ну... Всё это ради Фуко. Нужно разобраться с приоритетами...)
label 24
text Я отгоняю свои не совсем чистые мысли и снова смотрю вниз на список.
text Но в конце концов, есть только один учитель, к которому я достаточно близок, чтобы спросить.
text @[Томоя]
text (Кумура, Кумура... вот он.)
text Я нахожу имя в справочнике учителей и набираю номер.
text *Бип* *Буп* *Бип* *Буп*
text *Рииииинг*
text ......
text *Клик*
sound 3Y5.aac
text @[Голос]
text Здравствуйте, это Кумура.
text Это голос дедушки.
text @[Томоя]
text Дедушка, это я. Мне что-то нужно. Приходи в школу завтра, ок? Gracias!
text @[Кумура]
text ...
sound 3Y6.aac
text @[Кумура]
text ...Подожди.
text @[Томоя]
text Что это? Ты не можешь прийти завтра?
sound 3Y7.aac
text @[Кумура]
text Это не совсем невозможно, если постараюсь, но...
text @[Томоя]
text Gracias!
text @[Кумура]
text ...
sound 3Y8.aac
text @[Кумура]
text ...Подожди.
text @[Томоя]
text Только что именно ты хочешь?
sound 3Y9.aac
text @[Кумура]
text У меня есть планы на каникулы...
text @[Томоя]
text Это всё ради твоего милого ученика. Немного отложи их.
sound 3YA.aac
text @[Коумура]
text Но планы ради моего милого внука.
text @[Томоя]
text Я объективно милее.
sound 3YB.aac
text @[Коумура]
text Так ты, наконец, забыл, как чувствовать стыд.
text @[Томоя]
text О, как приятно...
sound 3YC.aac
text @[Коумура]
text Ну, дело не в том, что я не могу отложить свои планы на один день...
text Если я продолжу настойчиво добиваться, Коумура, скорее всего, примет мою просьбу. Но если это значит, что у него будет на один день меньше, чтобы быть со своим внуком, я буду испытывать огромную вину.
choice Try another teacher|Keep on pushing
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s22
fi
goto 25
label s22
text @[Томоя]
text Ладно. Я найду кого‑то другого.
text @[Коумура]
text ...
sound 3YD.aac
text @[Коумура]
text ...Подожди.
text @[Томоя]
text Что на этот раз?
sound 3YE.aac
text @[Коумура]
text Это совсем не похоже на тебя.
text @[Томоя]
text Ты просто себе всё придумываешь.
sound 3YF.aac
text @[Коумура]
text Хм... Теперь я ещё более обеспокоен.
text @[Томоя]
text Я же сказал, что всё в порядке, не так ли? Я сейчас вешаю трубку.
text @[Коумура]
text ...
sound 3YG.aac
text @[Коумура]
text @...Wa─
text *KA-CHING*
text Он пытался что‑то сказать, но я уже повесил трубку.
text @[Томоя]
text Ну, я не знаю, куда ты идёшь, но наслаждайся временем там.
text @[Томоя]
text Не говоря уже о том, что мы бы предпочли молодую учительницу, а не старика‑дедушку в любой день.
text Я снова начинаю просматривать справочник, на этот раз сосредотачиваясь на женских именах.
text @[Томоя]
text (Нет никого, кому я мог бы просто так попросить...)
text @[Томоя]
text (И теперь, когда я об этом думаю, я вообще ни с кем, кроме дедушки, не разговаривал...)
text ...Миссия провалена.
text @[Томоя]
text (К сожалению, Коуко‑сан была бы идеальной кандидатурой для этой задачи...)
text Но после всего, через что мы прошли, мы не можем просто так позволить ей встретиться с Фуко.
text Других кандидатов нет.
text @[Томоя]
text (Ничего не поделаешь...)
text @[Томоя]
text (Кому‑то из нас придётся сыграть роль учителя...)
text Если всё дошло до этого, думаю, учитель не обязан быть взрослым. Главное, чтобы это ощущалось как настоящий урок.
goto 26
label 25
if intF[1089] == 1
	goto s23
fi
goto 26
label s23
text @[Томоя]
text Пожалуйста. Вы — всё, что у меня есть!
sound 3YH.aac
text @[Коумура]
text Хм...
sound 3YI.aac
text @[Коумура]
text Ну...
sound 3YJ.aac
text @[Коумура]
text Это...
sound 3YK.aac
text @[Коумура]
text …Хм.
text Я не могу понять, согласился ли он с этим или нет.
text @[Томоя]
text Тебе это удобно?
sound 3YL.aac
text @[Коумура]
text Хм...
sound 3YM.aac
text @[Коумура]
text …Если старик вроде меня может быть полезен…
text @[Томоя]
text Да, ты в порядке. Главное, чтобы ты мог двигаться.
sound 3YN.aac
text @[Коумура]
text Я постараюсь изо всех сил.
text @[Томоя]
text Отлично. Тогда я буду ждать тебя в школе завтра.
sound 3YO.aac
text @[Коумура]
text Что мы будем делать?
text @[Томоя]
text Класс. Просто стой на кафедре, как всегда.
sound 3YP.aac
text @[Коумура]
text То есть это классический урок литературы?
text @[Томоя]
text Нет. Ты также будешь преподавать английский, математику, науку и современный японский.
sound 3YQ.aac
text @[Коумура]
text Кстати, в старшей школе нет предмета, просто названного «наукой».
text @[Томоя]
text И не только один урок. Я хочу, чтобы ты преподавал весь день по расписанию.
sound 3YR.aac
text @[Коумура]
text Ну... это не невозможно, пока у меня есть учебники, но...
text @[Томоя]
text Вот это я люблю слышать. Я тогда подожду.
sound 3YS.aac
text @[Коумура]
text ...Но─
text *КА-ЧИНГ*
text Кажется, он хотел что‑то сказать, но неостановимая инерция уже заставила меня положить приёмник.
text ...Давай притворимся, что я ничего не заметила.
text Теперь мы можем провести занятие. Я не могу не радоваться завтрашнему дню.
setvar intF[140] = 1
label 26
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 27
label s24
setvar strS[1000] = ""
label 27
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
