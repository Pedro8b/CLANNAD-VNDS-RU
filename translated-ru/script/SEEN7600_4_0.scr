text @[Сунохара]
text П-почему-то от вашего разговора меня прямо бросает в дрожь...
setvar strS[1001] = "CGKP13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UX5.aac
text @[Каппэй]
text Тьфу! Эй, слуга! Из-за твоей колы я теперь реально взбешён!
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UX6.aac
text @[Сунохара]
text А? А-а... э-э, ум... прости!
setvar strS[1001] = "CGKP14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UX7.aac
text @[Каппэй]
text Докажи, что ты это искренне!
sound UX8.aac
text @[Каппэй]
text Или извиняйся, пока голос не сорвёшь!
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Услышав это, тело Сунохары мгновенно каменеет, будто в него ударила молния.
text Затем, со слезами на глазах, он поворачивается ко мне.
text @[Томоя]
text Достал уже. Не смотри на меня.
setvar strS[1001] = "CGSH22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UX9.aac
text @[Сунохара]
text У-а-а-ах! А я думал, что набрал очков!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text И вот так, продолжая выкрикивать всякую чушь, Сунохара убегает.
text @[Томоя]
text ...
text Он так и ушёл, продолжая думать, что Каппэй — девушка...
setvar strS[1001] = "CGKP13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXA.aac
text @[Каппэй]
text Тьфу, какой невоспитанный слуга. В следующий раз, как увижу его, отделаю до полусмерти!
text @[Томоя]
text Знаешь, а язык-то у тебя довольно грязный...
setvar strS[1001] = "CGKP18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXB.aac
text @[Каппэй]
text А? Правда? Мне часто говорят, что я довольно искренний человек.
text @[Томоя]
text Понятно... кстати, у тебя сегодня собеседование?
setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXC.aac
text @[Каппэй]
text А, точно. Как раз иду в офис.
text @[Томоя]
text И что за работа на этот раз?
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXD.aac
text @[Каппэй]
text Транспортная компания, переезды.
text @[Томоя]
text Физический труд, значит...? Думаешь, справишься?
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXE.aac
text @[Каппэй]
text Всё точно будет отлично! Главное — баланс и тайминг.
setvar strS[1001] = "CGKP16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXF.aac
text @[Каппэй]
text К тому же, разве физический труд — это не по-настоящему мужественно?
sound UXG.aac
text @[Каппэй]
text На нём просто написано «мужественность»!
sound UXH.aac
text @[Каппэй]
text К тому же, платят в тот же день, как поработал. Звучит довольно круто, нет?
sound UXI.aac
text @[Каппэй]
text Даже у рекрутёра такая мужественная аура!
text @[Томоя]
text Ага... держись там.
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXJ.aac
text @[Каппэй]
text Ага, как только получу деньги, угощу тебя чем-нибудь в благодарность за то, что помог мне вытереться.
text @[Томоя]
text Ага.
sound UXK.aac
text @[Каппэй]
text Ну, до встречи!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Готов поспорить, собеседование он всё равно провалит...
text Прячу свои настоящие мысли за улыбкой и смотрю, как Каппэй уходит на собеседование.
music ~
if 0 == 0
	goto s17
fi
goto 18
label s17
setvar strS[1000] = "KURO"
goto 20
label 18
if 0 == 1
	goto s18
fi
goto 19
label s18
setvar strS[1000] = "SIRO"
goto 20
label 19
setvar strS[1000] = "KURO"
label 20
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
jump SEEN7600_5_0.scr
