setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s6
fi
goto 7
label s6
setvar strS[1000] = ""
label 7
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG027"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s7
fi
goto 8
label s7
setvar strS[1000] = ""
label 8
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы заходим в библиотеку и ощущаем знакомые ароматы.
text Мы были здесь только в пятницу, но кажется, будто мы её давно оставили.
text Котомия вытирает пол и снимает носки.
text Естественно, она достаёт свою обычную подушку.
text @[Томоя]
text Ты действительно любишь библиотеку, правда?
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI4.aac
text @[Котомия]
text Да. Я её люблю.
sound EI5.aac
text @[Котомия]
text Сегодня я снова счастлива, окружённая книгами.
text Она произносит это с обычной широкой улыбкой.
text @[Томоя]
text А ты собираешься читать прямо сейчас?
sound EI6.aac
text @[Котомия]
text Да.
text Она улыбается от уха до уха.
text @[Томоя]
text И что мне теперь делать?
setvar strS[1001] = "CGKT11C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT11C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI7.aac
text @[Котомия]
text ??
sound EI8.aac
text @[Котомия]
text Эм...
sound EI9.aac
text @[Котомия]
text ...
text Она задумалась о чем‑то.
setvar strS[1001] = "CGKT10C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EIA.aac
text @[Котомия]
text ...
text Чем больше надо о нём думать, тем более жалко меня это заставляет чувствовать.
setvar strS[1001] = "CGKT10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EIB.aac
text @[Котомия]
text Почему бы нам не читать вместе?
text Она такая предсказуемая.
text @[Томоя]
text Дайте мне передохнуть...
sound EIC.aac
text @[Котомі]
text ...
text Она выглядит слегка разочарованной.
text Теперь я начинаю чувствовать вину...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Как только я собираюсь ответить, мой желудок урчит.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EID.aac
text @[Котомі]
text Томоя-кун, ты голоден?
text @[Томоя]
text Наверное, да. Я пропустил завтрак...
sound EIE.aac
text @[Котомі]
text Тогда давай пообедаем.
text @[Томоя]
text Слишком рано, но звучит здорово.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Котомі начинает готовить.
text Я сажусь и жду, пока стол будет готов к обеду.
jump SEEN4904_4_0.scr
