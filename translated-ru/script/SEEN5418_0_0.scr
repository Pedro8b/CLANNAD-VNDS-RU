setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EL5.aac
text @[Миядзава]
text Пожалуйста, приходите ещё.
text Она что, пытается создать кружок любителей старых книг?
text @[Томоя]
text Может быть, когда будет настроение.
text С этими словами ухожу, оставляя справочную комнату позади.
music ~
setvar intF[502] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
