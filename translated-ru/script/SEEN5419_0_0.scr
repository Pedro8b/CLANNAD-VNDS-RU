	fi
fi
sound ELA.aac
text @[Miyazawa]
text Что-то не так?
text @[Tomoya]
text Итак... ты читала мангу?
setvar strS[1001] = "CGYK10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK10.png
if intF[1113] == 1
