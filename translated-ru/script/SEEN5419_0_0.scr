if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ELG.aac
text @[Miyazawa]
text Понятно.
text Я смотрю в окно. Тяжёлые облака намекают на неизбежный дождь.
text @[Томоя]
text Скоро будет дождь. Думаю, тебе стоит уйти домой пораньше.
sound ELH.aac
text @[Миязава]
text Да, именно так я и думаю сегодня.
text @[Томоя]
text Ну, мне пора. Спасибо за кофе.
