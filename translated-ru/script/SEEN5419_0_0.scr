sound ELI.aac
text @[Миязава]
text Конечно, заходи в любое время.
text @[Томоя]
text Да.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Правда, здесь я нахожу столько покоя, это… как бы опасно.
text Как только ты привыкаешь, возникает какая‑то волшебная сила, которая удерживает тебя здесь.
text Не только о кофе. Мне кажется, в ней есть то, что позволяет тебе быть по-настоящему собой.
text @[Томоя]
text (Хм, может, я просто… легко становлюсь одиноким.)
text Эта мысль остаётся, пока я иду наружу, оставляя комнату с образцами позади.
setvar intF[503] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
