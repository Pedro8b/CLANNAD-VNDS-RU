		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ELE.aac
text @[Miyazawa]
text А, пожалуйста, возьми это.
text Она протягивает мне пакет салфеток.
text Я вынимаю несколько листов, чтобы очистить рот и стол.
setvar strS[1001] = "CGYK12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ELF.aac
text @[Miyazawa]
text Хочешь прочитать? Я полностью рекомендую.
text Чтение манги здесь только повысило бы её статус как кафе.
text @[Tomoya]
text Ни... я уже почти каждый день читаю мангу и журналы в другом месте.
setvar strS[1001] = "CGYK10"
setvar intF[1113] = intF[1112]
