		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ELB.aac
text @[Miyazawa]
text Да. Это просто старый комикс, хотя.
text @[Tomoya]
text Почему бы что-то вроде этого было здесь...
sound ELC.aac
text @[Miyazawa]
text Манга и журналы, конфискованные у студентов, тоже хранятся здесь.
text @[Tomoya]
text О, теперь понимаю...
setvar strS[1001] = "CGYK11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK11.png
if intF[1113] == 1
