bgload {$strS[1000]}.jpg 30
setimg CGKY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CY8.aac
text @[Кё]
text Ну, пойдем.
text @[Томоя]
text Куда? Я здесь.
setvar strS[1001] = "CGKY12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CY9.aac
text @[Кё]
text Я возьму холодный чай и специальный гигантский шоколадный парфе.
text @[Томоя]
text …
text Это акт вымогательства.
text @[Томоя]
text У меня действительно нет денег.
setvar strS[1001] = "CGKY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYA.aac
text @[Кё]
text Просто отнесись ко мне. Я расскажу тебе кое-что приятное в обмен.
text @[Томоя]
text Сомневаюсь, что это стоит того.
setvar strS[1001] = "CGKY10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYB.aac
text @[Кё]
text …
setvar strS[1001] = "CGKY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYC.aac
text @[Кё]
text Она, наверное, действительно тебя любит.
sound CYD.aac
text @[Кё]
text В том смысле, что ты для неё незаменима.
text Ветки деревьев колышутся на том же ветру, что шевелит волосы Кью.
text Не смог ответить, я тихо смотрю на Кью.
text Через мгновение она снова становится своей привычной, шутливой.
setvar strS[1001] = "CGKY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYE.aac
text @[Кё]
text Ну что ж, этот гигантский парфе не сам себя съест!
text @[Томоя]
text Кью...
setvar strS[1001] = "CGKY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYF.aac
text @[Кё]
text Да?
text @[Томоя]
text Можешь хотя бы заказать маленький? Ты превратишься в свинью.
setvar strS[1001] = "CGKY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound CYG.aac
text @[Кё]
text Спасибо за предупреждение, но я не услышал ни слова сказанного тобой.
label 18
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 19
label s18
setvar strS[1000] = ""
label 19
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN4501_0_0.scr
