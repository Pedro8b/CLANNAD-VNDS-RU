setvar intF[1112] = 0
bgload SFWEC00.jpg 60
delay 8
setimg SFWEC21.png 148 172
delay 287
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s11
fi
goto 12
label s11
setvar strS[1000] = ""
label 12
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG302"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 13
label s12
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM26B.mp3
text Затем я вижу пол.
text Я смотрю прямо на него.
text Что это было? Такое чувство, будто я что-то делал.
text Я поднимаю свою «голову», чтобы сменить угол обзора.
setvar strS[1000] = "BG301"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 14
label s13
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я вижу её.
text Девочку, что наблюдала за мной.
text Её рука тянется ко мне.
text Я тянусь к ней своей «рукой».
text Наши руки соприкасаются.
text Хотя я ничего не чувствую... я всё же знаю, что они вместе.
text В этот момент я кое-что осознаю:
text Я действительно родился в этом мире.
text В итоге я всё же существую.
text Она может коснуться меня.
text Это грустный мир.
text Но она добрая.
text Когда я касаюсь её руки, моё «сердце» одновременно наполняется и грустью, и добротой.
text Я родился в этом месте, потому что искал её.
text ...Пожертвовав своей жизнью в новом мире, счастьем, которое мог бы обрести, и всем остальным.
text Она тянет меня за руку, помогая встать, а затем снова отходит.
text Отойдя на несколько шагов вперёд, она хлопает в ладоши.
text Я начинаю идти к ней.
text Точно... я учился ходить; вот чем я занимался раньше.
text Моя память вялая.
text Я не могу ничего вспомнить, не прилагая усилий.
text Она всё ещё хлопает в ладоши.
text Мне нужно идти.
text Но ноги не слушаются меня так, как хотелось бы.
text Я снова падаю вперёд.
text Но даже так она снова берёт меня за руку и поднимает на ноги.
text Сколько раз я уже пытался ходить?
text Наконец мне удаётся добраться до неё.
text Она берёт на руки моё тело, ростом не больше половины её собственного.
text ...«Ты молодец.»
text Тепло.
text Единственный источник тепла в этом мире.
text Тепло, которое я искал.
text Хотя моё тело из хлама не может почувствовать её тепло.
text Я смотрю на её лицо снизу вверх.
text Мне хочется задать ей так много вопросов.
text Но у меня нет рта, поэтому я не могу говорить.
text Я поворачиваю своё «лицо» к окну.
text Сквозь него постоянно льётся свет.
text Я хочу увидеть внешний мир.
text Я хочу увидеть конец света своими собственными «глазами».
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s14
fi
goto 15
label s14
setvar strS[1000] = ""
label 15
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6900_3_0.scr
