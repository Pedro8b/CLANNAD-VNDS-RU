text Я пересекаю холм за холмом в погоне за ним.
setvar strS[1000] = "BG308"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s37
fi
goto 38
label s37
setvar strS[1000] = ""
label 38
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Впереди я нахожу её — она ждёт, держа в руках ещё одного из зверьков.
text Когда я подхожу, она благодарит зверька и опускает его обратно на землю.
text Два зверька воссоединяются и вместе взбираются на небольшой холм.
text На его вершине ждёт ещё один такой же.
text Все трое бегут бок о бок, будто семья.
text Я смотрю им вслед, почти не веря своим глазам.
text ...«Тебе было страшно?»
text Она кладёт руку мне на голову.
text Я киваю в знак согласия.
text ...«Мне тоже.»
text ...«Но я так рада.»
text ...«Нам нужно поблагодарить этих малышей.»
text Я снова киваю.
text Значит, такое действительно случается.
text ...«Разве это не удивительно?»
text Действительно.
text ...«От них словно веяло чем-то ласковым.»
text Её профиль выглядит таким добрым, когда она произносит эти слова.
music ~
