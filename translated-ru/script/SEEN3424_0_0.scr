setvar strS[1000] = "BG018"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text *Тук* *Тук* *Тук* *Тук*
text @[Томоя]
text ...
text Я иду по коридору один.
text *Тук* *Тук* *Тук* *Тук*
text @[Томоя]
text *Вздох*
text В руках у меня что-то, завёрнутое в цветастый платок.
text *Тук* *Тук* *Тук* *Тук*
text @[Томоя]
text ...
text Я останавливаюсь и оглядываюсь — вдалеке стоит Кё.
text Она упёрла руку в бок и смотрит на меня.
text Нехотя я снова иду вперёд.
text *Тук* *Тук* *Тук* *Тук*
text @[Томоя]
text *Вздох*
text Я не могу перестать вздыхать.
text Цветастый свёрток в моей руке... кажется ужасно тяжёлым.
text Внутри — коробка с обедом.
text Судя по всему, её приготовила Кё...
text ...Интересно, можно ли вообще есть то, что внутри...
text Нет, дело не в этом.
text Проблема в том...
text @[Томоя]
text Двор, значит...?
text Я вслух называю пункт назначения и снова вздыхаю.
text Как вообще до этого дошло...?
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Примерно десять минут назад─
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN3424_1_0.scr
