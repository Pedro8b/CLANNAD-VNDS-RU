		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VBP.aac
text @[Каппэй]
text Томоя-кун... И-Извини, но не мог бы ты забрать мою сумку за меня...?
text @[Томоя]
text Да, заберу.
sound VBQ.aac
text @[Каппэй]
text С-Спасибо...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Говоря это, Каппэй сползает вниз и садится на землю.
text @[Томоя]
text Ты в порядке...?
sound VBR.aac
text @[Каппэй]
text Да... так что, пожалуйста...
text @[Томоя]
text Да.
text Я отворачиваюсь от вымотанного Каппэя и иду в сторону рамен-забегаловки.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s63
fi
goto 68
label s63
setvar strS[1000] = ""
label 68
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сумка прямо рядом с нашими местами, там, где были наши ноги.
text Я беру сумку и закидываю её на плечо.
text *Рассыпаются вещи* ...
text @[Томоя]
text А?
text Похоже, сумка была открыта, из-за чего содержимое высыпалось наружу.
text @[Томоя]
text Чёрт...
text В панике я начинаю собирать вещи.
text Тут полотенце, карта, э... компас...? Также тут зубная щётка, кружка... даже консервы и нижнее бельё.
text У него правда есть всё необходимое на каждый день, забитое в эту сумку...
text @[Томоя]
text Хм...?
text Я замечаю что-то смутно знакомое...
text Блистер с таблетками...? Это лекарство?
text @[Томоя]
text Наверное, невежливо с моей стороны разглядывать чужие вещи.
text Я запихиваю вещи обратно в сумку и выхожу из магазина, чтобы вернуться туда, где Каппэй.
setvar strS[1000] = "BG035N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s64
fi
goto 69
