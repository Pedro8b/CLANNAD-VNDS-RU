text @[Мисаэ]
text Почему ты плачешь?
text За всю свою жизнь... не думаю, что я когда-либо знал, что слёзы могут быть такими тёплыми.
sound UOQ.aac
text @[Сима]
text Ничего страшного...
setvar strS[1001] = "CGMS33H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS33H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UOR.aac
text @[Мисаэ]
text Я и правда не могу оставить тебя одного, да...
sound UOS.aac
text @[Мисаэ]
text Вот, вытри слёзы.
sound UOT.aac
text @[Сима]
text Точно...
sound UOU.aac
text @[Сима]
text Мисаэ-сан...
setvar strS[1001] = "CGMS37"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS37.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UOV.aac
text @[Мисаэ]
text Хм?
sound UOW.aac
text @[Сима]
text Спасибо тебе... правда, спасибо тебе...
setvar strS[1001] = "CGMS42"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS42.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UOX.aac
text @[Мисаэ]
text Ага.
setvar strS[1001] = "CGMS31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UOY.aac
text @[Мисаэ]
text Ну что ж, мне пора возвращаться.
sound UOZ.aac
text @[Сима]
text Ага.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Пока я смотрел, как спина человека, которого я по-настоящему люблю, скрывается из виду...
text ...я продолжал плакать.
delay 30
if 0 == 0
	goto s171
fi
goto 190
label s171
setvar strS[1000] = "KURO"
goto 192
label 190
if 0 == 1
	goto s172
fi
goto 191
label s172
setvar strS[1000] = "SIRO"
goto 192
label 191
setvar strS[1000] = "KURO"
label 192
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Прощай, Мисаэ-сан.
text Я буду любить тебя до конца своей жизни.
if 0 == 0
	goto s173
fi
goto 193
label s173
setvar strS[1000] = "KURO"
jump SEEN7500_3_1.scr 195
label 193
if 0 == 1
	goto s174
fi
jump SEEN7500_3_1.scr 194
label s174
setvar strS[1000] = "SIRO"
jump SEEN7500_3_1.scr 195
jump SEEN7500_3_1.scr
