setvar strS[1000] = "BG008C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Небо покрыто облаками.
text Моё настроение падает, как кузнечный молот, вылетающий из окна третьего этажа.
text @[Томоя]
text (Возможно, это вина погоды...)
setvar strS[1000] = "BG033AC"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я слышу приближающиеся шаги.
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GUZ.aac
text @[Фурукава]
text Оказаки-сан!
sound GV0.aac
text @[Фурукава]
text Доброе утро.
text Фурукава естественно подходит рядом со мной.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Да, «утро»...
text Это единственные слова, которые я говорю ей, прежде чем замолчать.
setvar strS[1000] = "BG011C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV1.aac
text @[Фурукава]
text У меня предложение, Оказаки-сан.
text Когда мы спускаемся к подножию холма, Фурукава начинает говорить.
text @[Томоя]
text Что это?
sound GV2.aac
text @[Фурукава]
text Нам стоит сыграть в баскетбол после школы сегодня.
text @[Томоя]
text Что? Кто такой «мы»?
sound GV3.aac
text @[Фурукава]
text Ты и я, Оказаки-сан.
text @[Томоя]
text А?
sound GV4.aac
text @[Фурукава]
text Я буду ждать тебя у спортивных площадок после школы.
sound GV5.aac
text @[Фурукава]
text Я буду там, держа в руках баскетбольный мяч.
text Какая глупая идея.
text @[Томоя]
text Что ты, идиот?
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV6.aac
text @[Фурукава]
text Я могу и не выглядеть так, но на самом деле я довольно спортивна.
text @[Томоя]
text Это не то, что я имел в виду...
sound GV7.aac
text @[Фурукава]
text Я даже могу бросать мяч, если бросать его снизу.
sound GV8.aac
text @[Фурукава]
text И если я стою на месте, я тоже могу вести мяч.
text @[Томоя]
text ...
text @[Томоя]
text ...Это сделает тебя совсем не спортивной.
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV9.aac
text @[Фурукава]
text Что? Серьёзно?
text @[Томоя]
text Да...
text @[Томоя]
text Так что не утруждай себя. Ты не способна на это.
text @[Томоя]
text Просто сосредоточься на драмклубе.
setvar strS[1001] = "CGNG18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GVA.aac
text @[Фурукава]
text Но я тоже хочу, чтобы ты знал.
text @[Томоя]
text Знать что?
sound GVB.aac
text @[Фурукава]
text Что ты можешь отдать всё себе в чём‑то.
text Концепция, которая отдалена от моей жизни больше, чем почти всё, что я могу представить.
text Идея упорной работы ради чего-то после того, что я пережил, кажется мне непостижимой.
text Кто из нас здесь остался без ничего, чтобы продемонстрировать свои усилия?
text Эта мысль отвращает меня.
text @[Томоя]
text Если хочешь играть, играй сам.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GVC.aac
text @[Фурукава]
text Нет, я бы предпочла играть вместе.
text @[Томоя]
text Сегодня я сразу домой иду, всё в порядке?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text После того, как я ей это сказал, я иду в класс.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6419_1_0.scr
