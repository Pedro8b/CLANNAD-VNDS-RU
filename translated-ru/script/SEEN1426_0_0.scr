text @[Фуко]
text Хм... что такое?
text @[Томоя]
text Я слышал, ты попала в аварию. Это правда?
sound 2BW.aac
text @[Фуко]
text Да...
text @[Томоя]
text И тебе пришлось долго лежать в больнице, так? Это, наверное, было ужасно. Мне тебя искренне жаль.
setvar strS[1001] = "CGFU19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU19.png
if intF[1113] == 1
