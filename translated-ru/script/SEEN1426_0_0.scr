		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2BX.aac
text @[Фуко]
text Ну...
text @[Томоя]
text Но вот чего я не понимаю: почему ты никому не рассказываешь о своём выздоровлении и просто продолжаешь вот так бродить по школе.
text @[Томоя]
