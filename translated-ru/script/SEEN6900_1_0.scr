setvar intF[1112] = 0
bgload SFWEC00.jpg 60
delay 8
setimg SFWEC20.png 148 172
delay 229
bgload SIRO.jpg 47
text Я смотрю на него.
text На далёкий мир.
music BGM26B.mp3
setvar strS[1000] = "BG301"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 4
label s3
setvar strS[1000] = ""
label 4
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Это тусклое, тёмное место.
text Где я могу находиться?
text Кажется, я внутри какой-то комнаты.
text Хотя она пустынна.
text По крайней мере, я вижу стол.
text Там должен был бы кто-то сидеть, но никого нет.
text Здесь ничто не движется...
text Только время неумолимо идёт вперёд.
text ......
text Если бы я был новой жизнью, ищущей место для рождения...
text Думаю, это было бы неправильным местом для выбора.
text Этот мир пугает меня.
text Я уже давно кое-что осознал:
text Этот мир уже подошёл к концу.
text Здесь больше ничто не родится и ничто не умрёт.
text Даже времени не существует в этом месте.
text Здесь не может закончиться ничего нового.
text Когда-то здесь родилась жизнь, но на этом всё и закончилось.
text Стоит оказаться запертым в этом бесконечном мире, и выбраться из него уже невозможно.
text Не в силах умереть и не в силах родиться заново в новом мире.
text Именно такой застывший мир я сейчас вижу.
text Я просто закрою глаза и покину это место...
text По крайней мере, так я думаю.
text Пожалуйста... пусть в следующий раз, когда я проснусь, это будет не здесь...
text Пусть это будет лучший, более тёплый мир.
text Я перевожу взгляд...
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
