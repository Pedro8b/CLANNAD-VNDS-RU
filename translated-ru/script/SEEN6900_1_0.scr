	fi
fi
text И отрезаю себя от этого мира.
text ......
setvar strS[1000] = "BG301"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s5
fi
goto 6
label s5
setvar strS[1000] = ""
label 6
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text И тут я вижу мимолётную вспышку света.
text Что-то шевельнулось.
text Я не знаю, что это.
text Но я уверен, что здесь, рядом со мной, что-то есть.
text Может, это место всё-таки не подошло к концу...?
text ...Или это просто нечто, что уже давно здесь живёт?
text Свет проникает через окно и достигает стены передо мной.
text Что-то движется в его тенях.
text Возможно, я бы разглядел это, если бы мог двигать своими «глазами».
text Но я всё ещё не знаю, что это на самом деле.
text Оно движется медленно...
text В конце концов свет на стене возвращается к своей исходной форме...
text Но затем, будто ниоткуда, передо мной появляется девочка.
text Я вижу, что она всё ещё невинна.
text Её взгляд прикован ко мне.
text Она меня видит?
text Она протягивает руку.
text ...Но она не касается меня. Вместо этого рука проходит прямо сквозь.
text Да...
text Я ещё не рождён в этом мире.
text Поэтому меня нельзя коснуться.
text Но в таком случае... как девочка вообще меня заметила?
text Может, я просто видим, и всё?
text Если это ДЕЙСТВИТЕЛЬНО так, то как я выгляжу?
text Девочка убирает руку и теперь машет мне.
text Затем она уходит.
text Я больше её не вижу.
text ...Здесь кто-то был. В этом месте.
text Что она вообще делает в уже завершившемся мире?
text Как она живёт; чем она питается?
text Что, если вообще что-то, позволяет ей оставаться в живых?
text Почему-то я не могу перестать думать о ней.
text Может, дело в том, насколько это место отличается от прочих...?
text Мне всё ещё страшно.
text ...Это не тот мир, в который стоит рождаться.
text Но в нём живёт девочка.
text Может, именно поэтому...?
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
