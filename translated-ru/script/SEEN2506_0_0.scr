text Ах...
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7HK.aac
text @[Томоё]
text Так вот оно как...
sound 7HL.aac
text @[Томоё]
text Так ты делал это ради меня...
text @[Томоя]
text Не переживай об этом.
text @[Томоя]
text В смысле, это ведь ты сама всё сделала.
text @[Томоя]
text Всё, что сделал я, — это наблюдал.
sound 7HM.aac
text @[Томоё]
text Томоя...
sound 7HN.aac
text @[Томоё]
text Спасибо.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Эй, вы там! Просто чтобы вы знали, Томоё — кандидат в председатели ученического совета!
text @[Томоя]
text Вам лучше это запомнить!
label 43
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s37
fi
goto 44
label s37
setvar strS[1000] = ""
label 44
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2507_0_0.scr
