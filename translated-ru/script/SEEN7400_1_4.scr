text @[Санаэ]
text Хорошо.
text Она, должно быть, почувствовала, насколько серьёзно я к этому отношусь.
text Она кивает с серьёзным выражением лица.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
