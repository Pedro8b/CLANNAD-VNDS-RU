		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound SZP.aac
text @[Санаэ]
text Извините, Оказаки-сан.
text @[Томоя]
text Ах, вовсе нет...
text @[Томоя]
text Кто были эти дети только что?
sound SZQ.aac
text @[Санаэ]
text Вы их не помните?
text @[Томоя]
text Нет. Хотите сказать, мы где-то встречались?
setvar strS[1001] = "CGSN11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound SZR.aac
text @[Санаэ]
text Не помните? Это было, когда мы ходили на прогулку с Ёхэем-куном и Мэй-тян.
sound SZS.aac
text @[Санаэ]
text Там была девочка, над которой издевались.
text @[Томоя]
text А, я это помню.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound SZT.aac
text @[Санаэ]
text Эти дети как раз и были теми мальчиками, что над ней издевались.
text @[Томоя]
text А?
text @[Томоя]
text Погодите, но почему вы с ними разговаривали?
sound SZU.aac
text @[Санаэ]
text Потому что мне показалось, что так будет лучше всего.
sound SZV.aac
text @[Санаэ]
text Если бы я этого не сделала, это, вероятно, не решило бы основную проблему.
text @[Томоя]
text Так значит только что вы...
sound SZW.aac
text @[Санаэ]
text ...немного их отчитывала.
setvar strS[1001] = "CGSN11H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound SZX.aac
text @[Санаэ]
text Но все они хорошие дети.
sound SZY.aac
text @[Санаэ]
text Все они дети, с которыми можно договориться.
text @[Томоя]
text Так вот, значит, чем вы занимались...
text Как всегда, эта женщина...
text Она заставляет меня восхищаться и поражает меня.
