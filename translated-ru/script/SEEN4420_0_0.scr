text @[Томоя]
text Мне стоит пойти в комнату Сунохары.
text В итоге я всегда оказываюсь в том же положении, делая одни и те же вещи.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG034"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Когда я вижу общежитие, я останавливаюсь на месте.
text У меня выходной. Это просто не вдохновляет.
text Тогда… как насчёт того, чтобы пойти в школу?
text Если я проникну на кампус, смогу скоротать время в пустом классе.
text @[Томоя]
text (Не совсем отличается от любого другого дня, правда.)
text Думая об этом плане, я иронично смеюсь над собой.
text Я начинаю подниматься по пустынному холму.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
