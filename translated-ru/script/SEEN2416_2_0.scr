music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s11
fi
goto 13
label s11
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG016"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 14
label s12
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CV.aac
text @[Sunohara]
text Aren't garbage chutes supposed to be made so people can't fall in?
text @[Tomoya]
text Didn't you just dislocate your joints there?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CW.aac
text @[Sunohara]
text As if I'd fall in just because of that!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CX.aac
text @[Sunohara]
text Anyway... Okazaki.
text He brings his face towards me.
text @[Tomoya]
text What, man...?
sound 5CY.aac
text @[Sunohara]
text That girl is seriously strong.
text @[Tomoya]
text Yeah, I actually noticed that a while ago.
sound 5CZ.aac
text @[Sunohara]
text ...
text @[Tomoya]
text Well, I guess this means that the legendary girl really does exist.
setvar strS[1001] = "CGSH21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D0.aac
text @[Sunohara]
text She does not!
text @[Tomoya]
text You still don't believe it?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D1.aac
text @[Sunohara]
text It's impossible for a woman to be stronger than a man.
text @[Tomoya]
text You've just made yourself an enemy of every woman in this country.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D2.aac
text @[Sunohara]
text I mean, you saw how she looked, right?
text @[Tomoya]
text Ну, я согласен по этому поводу с той девушкой Томойо, хотя.
sound 5D3.aac
text @[Сунохара]
text Верно...? Это почти абсурдно.
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D4.aac
text @[Сунохара]
text Может ли быть...
text @[Томоя]
text Что?
sound 5D5.aac
text @[Сунохара]
text Может ли быть, что она на самом деле парень?
text @[Томоя]
text Я действительно начинаю беспокоиться за твою жизнь сейчас.
sound 5D6.aac
text @[Сунохара]
text Почему?
text @[Томоя]
text Просто попробуй сказать то же самое прямо перед ней.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D7.aac
text @[Сунохара]
text ...
text Он, наверное, воображает это.
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D8.aac
text @[Сунохара]
text ...
text Он, вероятно, сейчас летит по небу.
setvar strS[1001] = "CGSH22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D9.aac
text @[Сунохара]
text ...
text А теперь, вероятно, его кремируют.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DA.aac
text @[Сунохара]
text …Не будем так делать.
text @[Томоя]
text Тебе не нравится быть пеплом?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DB.aac
text @[Сунохара]
text Ты действительно думаешь, что я воображала это так далеко?!
sound 5DC.aac
text @[Sunohara]
text I only went up until around the part where I jump out of the casket in a panic!
text @[Tomoya]
text That means you came back to life. That's impossible, you know.
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DD.aac
text @[Sunohara]
text What? Really?
text @[Tomoya]
text Just suck it up and burn.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DE.aac
text @[Sunohara]
text Why does any of this even frickin' matter?!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DF.aac
text @[Sunohara]
text At any rate, I'm going to go check.
text @[Tomoya]
text Going to check whether you can be resurrected from ashes?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DG.aac
text @[Sunohara]
text Why would I test something so dangerous with my own body?!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DH.aac
text @[Sunohara]
text I mean, go test whether she's a man or not.
text @[Tomoya]
text "She," as in Tomoyo?
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DI.aac
text @[Sunohara]
text Yeah.
text @[Tomoya]
text How?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DJ.aac
text @[Sunohara]
text There's plenty of ways. And I'm going to check until I know for sure.
text At this point in time, Sunohara had yet to realize...
text @[Tomoya]
text ...that he had begun to walk the path of the pervert.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DK.aac
text @[Sunohara]
text Я так полностью слышал это, знаешь.
text @[Томоя]
text Просто представь, что ты этого не слышал. Станет гораздо интереснее.
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DL.aac
text @[Суногаха]
text Как будто бы я сделал бы что-то инцестное!
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DM.aac
text @[Суногаха]
text Не волнуйся, всё будет хорошо.
text @[Томоя]
text Ну, обязательно будь осторожен. Мне хочется слышать твои находки.
sound 5DN.aac
text @[Суногаха]
text Не низкийставь меня.
text Я думаю, ты теряешь право говорить об этом, после того как получил мозоль в бою.
text В общем, я сейчас брошу попытки отговорить его.
text Я обращаюсь к Суногахе и хватаюсь за кулаки взмахом.
text @[Томоя]
text Отличная речь! (Я буду молиться за твою пошлость!)
text Я говорю это максимально свежо, как можно.
setvar strS[1001] = "CGSH25"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DO.aac
text @[Суногаха]
text Да!
text Суногаха принял это как пожелание доброй удачи и ответил мне так же свежо и ярко.
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
