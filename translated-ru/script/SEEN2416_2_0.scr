music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s11
fi
goto 13
label s11
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG016"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 14
label s12
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CV.aac
text @[Сунохара]
text Разве мусоропроводы не должны быть сделаны так, чтобы туда нельзя было упасть?
text @[Томоя]
text Ты разве не вывихнул там себе суставы?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CW.aac
text @[Сунохара]
text Как будто я бы упал туда только из-за этого!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5CX.aac
text @[Сунохара]
text В общем... Окадзаки.
text Он приближает своё лицо ко мне.
text @[Томоя]
text Чего, мужик...?
sound 5CY.aac
text @[Сунохара]
text Эта девчонка серьёзно сильная.
text @[Томоя]
text Ага, я вообще-то это заметил ещё некоторое время назад.
sound 5CZ.aac
text @[Сунохара]
text ...
text @[Томоя]
text Ну, похоже, это значит, что легендарная девушка и правда существует.
setvar strS[1001] = "CGSH21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D0.aac
text @[Сунохара]
text Вовсе нет!
text @[Томоя]
text Ты всё ещё не веришь?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D1.aac
text @[Сунохара]
text Невозможно, чтобы женщина была сильнее мужчины.
text @[Томоя]
text Ты только что нажил себе врага в лице каждой женщины в этой стране.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D2.aac
text @[Сунохара]
text В смысле, ты же видел, как она выглядела, да?
text @[Томоя]
text Ну, я согласен по этому поводу с той девушкой Томойо, хотя.
sound 5D3.aac
text @[Сунохара]
text Верно...? Это почти абсурдно.
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D4.aac
text @[Сунохара]
text Может ли быть...
text @[Томоя]
text Что?
sound 5D5.aac
text @[Сунохара]
text Может ли быть, что она на самом деле парень?
text @[Томоя]
text Я действительно начинаю беспокоиться за твою жизнь сейчас.
sound 5D6.aac
text @[Сунохара]
text Почему?
text @[Томоя]
text Просто попробуй сказать то же самое прямо перед ней.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D7.aac
text @[Сунохара]
text ...
text Он, наверное, воображает это.
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D8.aac
text @[Сунохара]
text ...
text Он, вероятно, сейчас летит по небу.
setvar strS[1001] = "CGSH22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5D9.aac
text @[Сунохара]
text ...
text А теперь, вероятно, его кремируют.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DA.aac
text @[Сунохара]
text …Не будем так делать.
text @[Томоя]
text Тебе не нравится быть пеплом?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DB.aac
text @[Сунохара]
text Ты действительно думаешь, что я воображала это так далеко?!
sound 5DC.aac
text @[Сунохара]
text Я дошёл только примерно до момента, где в панике выпрыгиваю из гроба!
text @[Томоя]
text Это значит, что ты вернулся к жизни. Это же невозможно, знаешь ли.
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DD.aac
text @[Сунохара]
text Что? Серьёзно?
text @[Томоя]
text Просто смирись и сгори уже.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DE.aac
text @[Сунохара]
text Да какая вообще, чёрт возьми, разница?!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DF.aac
text @[Сунохара]
text В любом случае, я пойду проверю.
text @[Томоя]
text Проверить, можно ли воскреснуть из пепла?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DG.aac
text @[Сунохара]
text С чего бы мне проверять что-то настолько опасное на собственном теле?!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DH.aac
text @[Сунохара]
text Я имею в виду, иди проверь, мужчина она или нет.
text @[Томоя]
text «Она» — то есть Томойо?
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DI.aac
text @[Сунохара]
text Ага.
text @[Томоя]
text Как?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DJ.aac
text @[Сунохара]
text Есть куча способов. И я буду проверять, пока не узнаю наверняка.
text В этот момент Сунохара ещё не осознавал...
text @[Томоя]
text ...что он уже встал на путь извращенца.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DK.aac
text @[Сунохара]
text Я так полностью слышал это, знаешь.
text @[Томоя]
text Просто представь, что ты этого не слышал. Станет гораздо интереснее.
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DL.aac
text @[Сунохара]
text Как будто бы я сделал бы что-то инцестное!
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DM.aac
text @[Сунохара]
text Не волнуйся, всё будет хорошо.
text @[Томоя]
text Ну, обязательно будь осторожен. Мне хочется слышать твои находки.
sound 5DN.aac
text @[Сунохара]
text Не низкийставь меня.
text Я думаю, ты теряешь право говорить об этом, после того как получил мозоль в бою.
text В общем, я сейчас брошу попытки отговорить его.
text Я обращаюсь к Суногахе и хватаюсь за кулаки взмахом.
text @[Томоя]
text Отличная речь! (Я буду молиться за твою пошлость!)
text Я говорю это максимально свежо, как можно.
setvar strS[1001] = "CGSH25"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5DO.aac
text @[Сунохара]
text Да!
text Суногаха принял это как пожелание доброй удачи и ответил мне так же свежо и ярко.
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
