music BGM01.mp3
text @[Томоя]
text В средней школе я был в баскетбольной команде.
text @[Томоя]
text Я был в основном составе, но прямо перед последним матчем у меня вышла крупная ссора с отцом...
text @[Томоя]
text ...И в итоге я получил травму, так что не смог играть...
text @[Томоя]
text После этого я бросил.
text ......
text Почему я вообще рассказываю ей историю своей жизни?
text В смысле, насколько сильно мне хочется рассказать Фурукаве эту жалостливую историю о себе?
text Что, мне нужно её одобрение, что ли?
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GUW.aac
text @[Фурукава]
text В таком случае, я хочу тебе помочь.
text Меня не удивляют эти слова.
sound GUX.aac
text @[Фурукава]
text Я хочу... чтобы у тебя была надежда, пока ты учишься в старшей школе.
setvar strS[1001] = "CGNG31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GUY.aac
text @[Фурукава]
text Как и у меня.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она прячет лицо. Наверное, покраснела.
text ...Наверное, ей хочется добавить: «Благодаря тебе».
text Только сейчас я понимаю, насколько мазохистским было моё признание.
text Я никогда не хотел, чтобы она касалась этого шрама.
text Чувствую, как у меня краснеет лицо.
text @[Томоя]
text Понятно.
text @[Томоя]
text Было бы здорово, если бы так и случилось...
text Поэтому я поднимаю взгляд к небу.
text Оно сияет серебром над крышами городских зданий.
text Жду, когда ветер подует мне в лицо и остудит его.
text ...Три года назад.
text Школьная жизнь у меня складывалась отлично. Я был капитаном баскетбольной команды.
text Благодаря спорту передо мной была открыта практически любая старшая школа на выбор. Так что план был выбрать хорошую и продолжать играть в баскетбол там.
text Но этот путь внезапно оборвался.
text Из-за ссоры, которая случилась у меня с отцом.
text Началось из-за моего внешнего вида, или может из-за того, что моя обувь была разбросана у входа... в общем, что-то настолько же глупое.
text В любом случае, мы начали толкать друг друга, и это в итоге переросло в драку...
text Потом я ударился правым плечом о стену...
text Как бы ни было больно, я упрямился. Просто заперся в своей комнате, отказываясь что-либо с этим делать.
text К тому времени, как я всё-таки пошёл к врачу, было уже слишком поздно...
text Я больше никогда не смогу поднять эту руку выше плеча.
setvar intF[9] = 1
label 31
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s29
fi
goto 32
label s29
setvar strS[1000] = ""
label 32
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
