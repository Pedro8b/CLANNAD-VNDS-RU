text @[Томоё]
text Говорю тебе, это не так.
text @[Томоя]
text Ну ладно тогда... как насчёт того, что это и твоя вина, и наша тоже? Так пойдёт?
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CC.aac
text @[Томоё]
text Даже так я чувствую себя виноватой...
text @[Томоя]
text Одна-единственная девушка точно не должна нести на себе всю вину за это...
setvar strS[1001] = "CGTM32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CD.aac
text @[Томоё]
text Да... то, что ты так говоришь, тоже меня немного радует.
text @[Томоя]
text Тогда просто прими мои слова как есть.
sound 6CE.aac
text @[Томоё]
text Да.
text @[Томоя]
text И ещё, если бы дело было только во мне и Сунохаре, нас бы точно отстранили.
text @[Томоя]
text То, что этого не случилось, — благодаря тебе.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CF.aac
text @[Томоё]
text Почему?
text @[Томоя]
text Не могут же они отстранить только меня и Сунохару, оставив тебя в стороне, верно?
sound 6CG.aac
text @[Томоё]
text Что? Меня не могут отстранить?
text @[Томоя]
text Ну, у тебя нет никаких нарушений, к тому же тебя только недавно приняли в эту школу.
text @[Томоя]
text Очевидно, что с тобой захотят обойтись поаккуратнее.
setvar strS[1001] = "CGTM15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CH.aac
text @[Томоё]
text Неужели это правда так работает?..
text @[Томоя]
text Наверное.
setvar intF[216] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
label 27
text @[Томоя]
text Я вспоминаю.
text Я вспоминаю.
choice О том, что ей долго пришлось не ходить в школу|О том, что она пытается возродить театральный клуб|О том, что я видел, как она ела анпан
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 1
	goto s25
fi
goto 28
label s25
goto 30
label 28
if intF[1089] == 0
	goto s26
fi
goto 29
label s26
text Точно... она долго не ходила в школу, и ей пришлось остаться на второй год.
text Но... чем это воспоминание поможет в данной ситуации?
text @[Томоя]
text Ей пришлось куда хуже, чем мне. Она долго не ходила в школу!
text Мне что, просто выкрикнуть это вот так?
text В смысле, я же не ребёнок...
goto 24
goto 30
label 29
if intF[1089] == 2
	goto s27
fi
goto 30
label s27
text Точно... она ела анпан.
text Но... чем это воспоминание поможет в данной ситуации?
text Этот факт никак не подсказывает мне оправдание, которое помогло бы выпутаться из этого положения...
goto 24
label 30
text @[Томоя]
text Это... пьеса.
sound 6CI.aac
text @[Учитель]
text Повтори-ка?
text @[Томоя]
text Мы только что репетировали пьесу.
if intF[2] == 1
	goto s28
fi
goto 31
label s28
text @[Томоя]
text Как тебе, Фурукава?!
sound 6CJ.aac
text @[Учитель]
text Фурукава?..
text Все наши взгляды устремляются к окну школы, где всё ещё стоит Фурукава.
text @[Томоя]
text Хорошо ли получилась сцена с фехтованием на мечах?!
text @[Фурукава]
text ...
text Фурукава бросает на меня растерянный взгляд, но, когда я киваю, кивает в ответ.
goto 32
label 31
if intF[2] == 0
	goto s29
fi
goto 32
label s29
text @[Томоя]
text Я громко кричу.
text Я громко кричу.
sound 6CK.aac
text @[Учитель]
text Хм?..
text Все наши взгляды устремляются к окну школы, где всё ещё стоит та девушка.
text @[Томоя]
text Хорошо ли получилась сцена с фехтованием на мечах?!
text @[Девушка]
text ...
text Она бросает на меня растерянный взгляд, но, когда я киваю, кивает в ответ.
label 32
text @[Томоя]
text Вообще-то мы состоим в театральном клубе.
sound 6CL.aac
text @[Учитель]
text Ты говоришь правду?
text @[Томоя]
text Как ещё, по-вашему, мы могли бы сражаться против такого числа людей, если это не постановка?
sound 6CM.aac
text @[Учитель]
text Ну, пожалуй...
sound 6CN.aac
text @[Учитель]
text Тогда что с этим?
text Учитель указывает на Сунохару, лежащего на земле.
text @[Томоя]
text Он притворяется мёртвым.
text @[Томоя]
text Эй, Томоё. Помоги ему встать.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CO.aac
text @[Томоё]
text Ага.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она кивает и опускается на колени рядом с Сунохарой.
text *ХРУСТЬ*
text Я слышу тревожный звук.
sound 6CP.aac
text @[Томоё]
text Вот он.
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CQ.aac
text @[Сунохара]
text ...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CR.aac
text @[Учитель]
text Он вообще... сам-то стоит?
text @[Томоя]
text Эти закатившиеся глаза — вообще-то его сильная сторона.
sound 6CS.aac
text @[Учитель]
text ...
text Учитель немного отступает.
sound 6CT.aac
text @[Учитель]
text ...Ну, ладно.
sound 6CU.aac
text @[Учитель]
text Полагаю, такие лица тоже бывают... на этот раз поверю вам.
sound 6CV.aac
text @[Учитель]
text В следующий раз не делайте того, что заставляет людей неправильно всё понимать.
music ~
text Бросив на нас последний взгляд, учитель уходит.
text Я рад, что он не был слишком настойчив.
music BGM14.mp3
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CW.aac
text @[Томоё]
text Большое спасибо...
text @[Томоя]
text Если хочешь кого-то поблагодарить, поблагодари её.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я поднимаю взгляд к окну школы, но её там уже нет.
text @[Томоя]
text О, похоже, она уже ушла...
text @[Томоя]
text Эй, Сунохара! Просыпайся!
text *Шлёп* *шлёп* *шлёп*
text Я хлопаю его по щекам.
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CX.aac
text @[Сунохара]
text Аах...!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CY.aac
text @[Сунохара]
text Ой-ой-ой... у меня всё болит...
text @[Томоя]
text Да ну. Загадочно.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6CZ.aac
text @[Сунохара]
text А? Уже всё закончилось?
text @[Томоя]
text Ага, мы отомстили за тебя!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6D0.aac
text @[Сунохара]
text Если собираетесь мстить за меня, может, лучше отомстите ей?
text Сунохара тычет пальцем в лицо Томоё.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6D1.aac
text @[Томоё]
text Что? Что ты имеешь в виду?
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6D2.aac
text @[Сунохара]
text Н-нет... просто бормочу себе под нос.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
