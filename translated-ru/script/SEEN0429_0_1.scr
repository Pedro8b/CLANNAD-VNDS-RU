bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Центральный полевой прыгает прямо назад.
text Он падает на землю в облаке пыли.
text Сунохара замедляется, бежа к второй базе.
setvar strS[1001] = "CGSH27B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1CH.aac
text @[Сунохара]
text Не может быть...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Центральный полевой медленно встаёт... подняв перчатку с белым бейсбольным мячом внутри.
if intF[845] == 0
	goto s65
fi
goto 68
label s65
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
