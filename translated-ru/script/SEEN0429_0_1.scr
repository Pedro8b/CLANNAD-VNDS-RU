	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1CI.aac
text @[Сунохара]
text ...
text Сунохара шатается обратно к скамейке, чтобы схватить свою ловческую перчатку.
setvar strS[1001] = "CGAK14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1CJ.aac
text @[Акио]
text Почему ты у нас первым бьющим? Нужно было поставить тебя девятым..
setvar strS[1001] = "CGSH26B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1CK.aac
text @[Сунохара]
text Ах...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1CL.aac
text @[Сунохара]
text Вааааааагх!
text Он хватает перчатку и убегает рыдая.
goto 69
label 68
if intF[845] == 1
	goto s66
fi
goto 69
label s66
setvar strS[1001] = "CGAK19A"
setvar intF[1113] = intF[1112]
