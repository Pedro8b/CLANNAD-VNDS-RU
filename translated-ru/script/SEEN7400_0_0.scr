text @[Томоя Сунохара]
text @Это вообще что такое?!
text Это вообще что такое?!
text Наши реплики снова прозвучали в идеальной гармонии.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound RHJ.aac
text @[Сунохара]
text Хватит уже этого...
text Я тоже уже от этого устал...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
goto 49
label 48
if intF[621] == 0
	goto s48
fi
goto 49
label s48
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
