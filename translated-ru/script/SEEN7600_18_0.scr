setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXO.aac
text @[Рё]
text А?
text @[Томоя]
text Мне вдруг позвонили и сказали срочно приехать сюда... Я подумал, что случилось что-то ужасное.
