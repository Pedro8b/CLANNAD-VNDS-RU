text @[Рё]
text А... э-э...
text @[Томоя]
text Когда?
setvar strS[1001] = "CGRY22H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXL.aac
text @[Рё]
text Э-это... три года назад...
text @[Томоя]
text Три года назад. Значит, это было ещё до того, как он вернулся сюда, да?
sound VXM.aac
text @[Рё]
text Да.
text @[Томоя]
text Ну, в общем, поздравляю.
setvar strS[1001] = "CGRY21H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY21H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXN.aac
