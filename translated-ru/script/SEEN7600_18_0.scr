music BGM25B.mp3
bgload SIRO.jpg 0
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s137
fi
goto 152
label s137
setvar strS[1000] = ""
label 152
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 120
text *Тук* ... *Тук* ... *Тук* ... *Тук* ...
setvar strS[1000] = "BG053"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s138
fi
goto 153
label s138
setvar strS[1000] = ""
label 153
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Э-э... где же это...?
sound VX5.aac
text @[Рё]
text А...
text @[Томоя]
text М?
setvar strS[1001] = "CGRY15H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VX6.aac
text @[Рё]
text Оказаки-кун.
text @[Томоя]
text Фудзи... баяси?
setvar strS[1001] = "CGRY12H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VX7.aac
text @[Рё]
text Рада снова вас видеть.
text @[Томоя]
text Ага, давно не виделись... Ого, ты только посмотри.
text @[Томоя]
text Ты и правда стала медсестрой, да?
setvar strS[1001] = "CGRY19H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VX8.aac
text @[Рё]
text А... эм... мне не идёт эта форма...?
text @[Томоя]
text Нет, ты прекрасно выглядишь. Просто немного удивлён.
setvar strS[1001] = "CGRY21H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY21H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VX9.aac
text @[Рё]
text Наверное, да. Это первый раз, когда кто-то из знакомых видит меня в этой форме.
text @[Томоя]
text Прошло уже пять лет, да?
setvar strS[1001] = "CGRY11H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXA.aac
text @[Рё]
text Да. Примерно так.
text @[Томоя]
text ...Время и правда летит быстро...
sound VXB.aac
text @[Рё]
text Думаю, это значит, что ты жил насыщенной жизнью.
text @[Томоя]
text Ну, я помню только то, что вкалывал как проклятый.
setvar strS[1001] = "CGRY12H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXC.aac
text @[Рё]
text Пойдём. Я тебя провожу.
text @[Томоя]
text Да, пожалуйста.
bgload KURO.jpg 88
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Тук* ... *Тук* ... *Тук* ... *Тук* ...
text @[Томоя]
text Работа медсестры — довольно тяжёлое дело, да?
setvar strS[1001] = "CGRY18H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXD.aac
