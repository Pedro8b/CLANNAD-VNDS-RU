text Потому что... я не одна...
text @[Томоя]
text Хвастаешься, значит... м?
text @[Томоя]
text ...Это кольцо...
setvar strS[1001] = "CGRY20I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY20I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXJ.aac
text @[Рё]
text А...
text @[Томоя]
text Понятно. Вот оно как, значит?
