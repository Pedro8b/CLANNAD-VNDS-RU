		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXG.aac
text @[Рё]
text Было тяжело, и произошло немало печального.
setvar strS[1001] = "CGRY22I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22I.png
if intF[1113] == 1
