text Его операция прошла успешно.
sound VXS.aac
text @[Рё]
text Он смог снова ходить на своих ногах и может выполнять простые упражнения.
setvar strS[1001] = "CGRY18H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXT.aac
text @[Рё]
text Однако он всё ещё не полностью выздоровел...
text @[Томоя]
text ...
setvar strS[1001] = "CGRY15H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VXU.aac
text @[Рё]
text А, вот эта палата.
text @[Томоя]
text ...Здесь...?
setvar strS[1001] = "CGRY26H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY26H.png
if intF[1113] == 1
