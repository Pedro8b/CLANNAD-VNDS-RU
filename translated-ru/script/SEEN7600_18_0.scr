text Но раз рядом был тот, кто меня поддерживал, всё было хорошо.
setvar strS[1001] = "CGRY21I"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY21I.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
