text @[Рё]
text Если его не лечить, он распространяется.
setvar strS[1001] = "CGRY17H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY17H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
