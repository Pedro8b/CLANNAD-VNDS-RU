text Все в классе переводят внимание на меня.
text @[Томоя]
text Мне нужно в туалет.
sound B2K.aac
text @[Учитель]
text Вот так? В следующий раз постарайся не так громко шуметь.
text @[Томоя]
text Прости.
text Я быстро иду к двери.
text По пути я прохожу мимо места Рё.
text Увидев, как она выглядит обеспокоенной, я поднимаю ладонь, сигнализируя: «Всё в порядке».
text Я не знаю, поняла ли она это на самом деле, но продолжаю выходить из класса.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 17
label s15
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Затем я бегу по коридору.
text После того как я переобуваюсь, я направляюсь к школьным воротам.
text Ботан бросается ко мне.
setvar strS[1000] = "BG015R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 18
label s16
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound Z.aac -1
setvar strS[1001] = "CGBT13"
bgload {$strS[1000]}.jpg 30
setimg CGBT13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound B2L.aac
text @[Ботан]
text Пухии!
text @[Томоя]
text Ботан, что случилось с Кё?
sound B2M.aac
text @[Ботан]
text Пухи! Пухихии!
text @[Томоя]
text Разве она не с тобой?
sound B2N.aac
text @[Ботан]
text Пухи, пупихупи, пухи!
text @[Томоя]
text Вы двое не пошли домой?
sound B2O.aac
text @[Ботан]
text Пухихии!
text @[Томоя]
text Я не могу тебя понять, когда ты всё время говоришь «пухи»!
text *Тян* *Тян*
text Ботан кусает одну из штанин моих брюк и пытается тянуть меня изо всех сил.
text Он говорит мне идти за ним?
sound B2P.aac
text @[Ботан]
text Пухи! Пухи!
text *Туг* *Туг*
text @[Томоя]
text Веди!
setvar strS[1001] = "CGBT10"
sound B2Q.aac
text @[Ботан]
text Пухи!
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Не знаю, понял ли он действительно, что я имел в виду...
text ...но Ботан отпускает мои брюки и начинает бежать за школьные ворота.
text Не оборачиваясь, он мчится по пропитанной дождём земле.
text И я иду за ним.
text Не обращая внимания на лужи и грязь, по которой мы пробираемся, мы продолжаем бежать под падающим дождём.
text Кё впереди нас.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 19
label s17
setvar strS[1000] = ""
label 19
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я ощущаю надежду и тревогу... уверенность и сомнение... а также беспокойство...
text Сдерживая эти чувства, я продолжаю бежать.
music ~
setvar strS[1000] = "BG082"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 20
label s18
setvar strS[1000] = ""
label 20
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text К тому моменту, как мы достигли места назначения, моё тело уже было полностью промокшим от головы до пят.
text На пустом участке земли, заросшем зеленью...
text В атмосфере, ставшей ещё тяжелее от падающего дождя...
text Там она стоит.
text Как будто она ждёт кого‑то...
text Как будто она отказывается встретиться с кем‑то...
setvar intF[1112] = 0
music BGM16B.mp3
setvar strS[1000] = "FGKY06A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s19
fi
goto 21
label s19
setvar strS[1000] = ""
label 21
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text @[Томоя]
text ...Кё...
sound B2R.aac
text @[Кё]
text ...
text Звук падающих капель, ударяющих о землю, заполняет тишину...
text Пытаясь подойти ближе, я делаю шаг вперёд.
text Тихий шуршащий звук сливается со звуком ливня.
sound B2S.aac
text @[Кё]
text Отойди...
text @[Томоя]
text ...
sound B2T.aac
text @[Кё]
text Не подходи... ближе...
sound B2U.aac
text @[Кё]
text ...Пожалуйста...
text Мне не остаётся другого выбора, как остановиться...
text Хотя звук дождя легко заглушает её тихий голос...
text ...По какой-то причине её голос резонирует ясно в моей голове... словно пронзил моё сердце.
text Мой промокший костюм прилипает к телу и постепенно отводит от меня тепло.
text Дождь капает по моей спине, заставляя дрожать от холода.
text Наверное... Кё тоже это ощущает...
text Хотя весна пришла, всё ещё май.
text И холод становится труднее переносить, когда я промокший...
text Нужно хотя бы вырваться из дождя...
text Я снова начинаю идти вперёд.
text Однако, в момент, когда я собирался идти дальше, Кё начинает говорить.
sound B2V.aac
text @[Кё]
text ...Почему... ты здесь...?
text @[Томоя]
text ...
sound B2W.aac
text @[Кё]
text Школа... ещё не закончилась, не так ли...?
text @[Томоя]
text ...Я видел Ботана в своём классе...
text @[Томоя]
text Я услышал, что ты ушёл рано, поэтому считаю это странным...
sound B2X.aac
text @[Кё]
text ...Ничего... тебе не стоит беспокоиться...
text @[Томоя]
text Не будь абсурдным...
sound B2Y.aac
text @[Кё]
text ...Разве я не говорил тебе...? Тебе просто нужно думать о своей девушке... о Рё...
text @[Томоя]
text ...
sound B2Z.aac
text @[Кё]
text Тебе не нужно... заботиться обо мне вовсе...
text @[Томоя]
text ...Как же я могу...
music ~
setvar strS[1000] = "FGKY06C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s20
fi
goto 22
label s20
setvar strS[1000] = ""
label 22
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound B30.aac
text @[Кё]
text ...Тебе нужно...!
text Внезапно её тон становится резким.
setvar strS[1000] = "FGKY06A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s21
fi
goto 23
label s21
setvar strS[1000] = ""
label 23
setvar strS[1001] = ""
