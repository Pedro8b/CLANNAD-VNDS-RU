	fi
fi
sound B4Y.aac
text @[Рё]
text ...
text Не говоря ни слова, Рё начинает идти ко мне.
text Стой...
text Не подходи ближе...
text Сейчас... я ничего не могу сказать...
text Если я что‑то скажу... это только причинит тебе боль...
setvar strS[1001] = "CGRY25"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY25.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Объятие*
text Она обнимает меня...
text Смоченная одежда прижалась к моему телу, и я ощутил дрожь, пробегающую по всему телу.
text Однако вскоре после этого я начал ощущать тепло её тела...
text Тепло Рё... окутывает моё холодное тело...
if intF[309] == 1
	if intF[312] == 1
		if intF[310] == 1
			if intF[308] == 1
				if intF[313] == 1
