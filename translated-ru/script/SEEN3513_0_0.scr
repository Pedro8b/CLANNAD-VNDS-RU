setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound B4W.aac
text @[Рё]
text Ах...
text @[Томоя]
text ...Рё...
text Это тот человек... которого я сейчас совсем не хочу видеть...
text Нет... я уверен... она ждала меня здесь.
setvar strS[1001] = "CGRY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound B4X.aac
text @[Рё]
text Томоя‑кун...
text @[Томоя]
text ...
text Я не могу смотреть ей прямо в лицо.
text Теперь, когда я действительно понял, что чувствую, смотреть в лицо Рё больно...
setvar strS[1001] = "CGRY23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY23.png
if intF[1113] == 1
	if strS[1000] < "C"
