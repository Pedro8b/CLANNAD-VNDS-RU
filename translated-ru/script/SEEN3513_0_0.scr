text Томоя...!
text Прежде чем я успел закончить фразу, Кё прерывает меня тихим, но резким голосом.
text Остановившись, не успев произнести последнее слово, я продолжаю смотреть на Кё.
sound B4R.aac
text @[Кё]
text Томоя...
sound B4S.aac
text @[Кё]
text Я... Кё Фуджибаяши.
text @[Томоя]
text ...
sound B4T.aac
text @[Кё]
text Я не Рё Фудзибаяси...
text @[Томоя]
text ...
text Когда я услышал это имя, я почувствовал, как что‑то пробежало по моему телу.
text Кажется, будто я упал на землю с высоты небес.
text Это болезненное и жаркое ощущение, будто кровь внутри меня кипит, и в то же время оно кажется холодным...
sound B4U.aac
text @[Кё]
text ...
setvar strS[1000] = "BG039R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s29
fi
goto 31
label s29
setvar strS[1000] = ""
label 31
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Медленно мои руки теряют силу...
text И тепло исчезает...
setvar strS[1000] = "FGKY06A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s30
fi
goto 32
label s30
setvar strS[1000] = ""
label 32
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Я никогда не знал, что дождь может быть таким холодным.
text Это касается не только моего тела. Моего сердца тоже...
text Каждая холодная капля кажется такой, что заморозит всё моё тело...
text По‑прежнему отвернувшись от меня, Кё закрывает глаза на мгновение.
text И вдруг, с улыбкой, она мягко произносит.
setvar strS[1000] = "FGKY06B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s31
fi
goto 33
label s31
setvar strS[1000] = ""
label 33
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound B4V.aac
text @[Кё]
text Пока‑пока...
setvar strS[1000] = "BG039R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s32
fi
goto 34
label s32
setvar strS[1000] = ""
label 34
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я... не могу ничего сказать.
text Хотя у меня так много сказать.
text Слова просто не выходят...
text Все они застряли у меня в горле.
text Хотя всё моё тело промокло от дождя, горло полностью сухо.
text Ноги не двигаются, будто они замёрзли к земле.
text Всё, что я могу сейчас, — смотреть на того, кто всё дальше и дальше уходит от меня.
setvar strS[1001] = "CGBT13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGBT13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Ботан бросает озадаченный взгляд то на Кё, то на меня.
text И спустя некоторое время он бросается бежать за Кё.
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Как только она исчезает из поля моего зрения...
text @[Томоя]
text ...Кё...
text ...я наконец смог произнести одно слово...
sound Z.aac -1
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s33
fi
goto 35
label s33
setvar strS[1000] = ""
label 35
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 301
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Как только звук дождя болезненно эхом раздаётся в моих ушах...
sound ~
setvar intF[1112] = 1
setvar strS[1000] = "BG018C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s34
fi
goto 36
label s34
setvar strS[1000] = ""
label 36
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM16C.mp3
text Моя форма промокла дождевой водой...
text Она тяжела... и создаёт иллюзию, будто я преступник, скованный кандалами.
text Я возвращаюсь в школу, чтобы забрать оставленную мной сумку.
text Поскольку занятия уже закончились, в школе осталось не так много учеников.
text К тому же... я совсем не хочу, чтобы меня кто‑нибудь видел в таком промокшем виде.
text Оставляя за собой след воды в коридоре, я вхожу в класс.
setvar strS[1000] = "BG021DC"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s35
fi
goto 37
label s35
setvar strS[1000] = ""
label 37
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
