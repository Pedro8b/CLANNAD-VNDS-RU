label rtl0
if rtf1 == ""
	setvar rtf0 = ""
fi
if rtf1 != ""
	setvar rtf1 = ""
fi
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
