text (С этим мужиком точно что-то не так в голове...)
setvar strS[1000] = "BG006N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 18
label s13
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я следую за стариком из своей комнаты.
setvar strS[1001] = "CGAK11P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11P.png
