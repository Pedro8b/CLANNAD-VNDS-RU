text Что ты имеешь в виду?
setvar strS[1001] = "CGAK20P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KH8.aac
text @[Акио]
text Ну, это уже другая история. Давай пока отложим это.
text @[Томоя]
text ...
setvar strS[1001] = "CGAK13P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KH9.aac
text @[Акио]
text В общем, жизнь Нагисы была в опасности.
sound KHA.aac
text @[Акио]
text И это была наша с Санаэ вина.
setvar strS[1001] = "CGAK20P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHB.aac
text @[Акио]
text Думаю, это было наказанием от Бога.
sound KHC.aac
text @[Акио]
text За то, что мы бросили дочь на произвол судьбы, пока сами гнались за собственными мечтами.
sound KHD.aac
text @[Акио]
text Он собирался забрать её у нас.
setvar strS[1001] = "CGAK24P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK24P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHE.aac
text @[Акио]
text Потому что мы бы не поняли, насколько она драгоценна, пока не потеряли бы её.
sound KHF.aac
text @[Акио]
text Но потом, когда Нагиса снова открыла глаза...
setvar strS[1001] = "CGAK20P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHG.aac
text @[Акио]
text Мы с Санаэ дали клятву.
sound KHH.aac
text @[Акио]
text Что никогда не покинем её.
text @[Томоя]
text ...
setvar strS[1001] = "CGAK24P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK24P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHI.aac
text @[Акио]
text Мы никогда прежде не пробовали печь хлеб. Это оказалось непросто.
sound KHJ.aac
text @[Акио]
text Но Санаэ сказала, что уверена в своих силах, когда дело касается выпечки.
setvar strS[1001] = "CGAK23P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK23P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHK.aac
text @[Акио]
text Когда она реально попробовала, ну, ты сам видел, что вышло. Так что мне пришлось учиться печь с самых азов.
sound KHL.aac
text @[Акио]
text ...Но это было весело, так что я не жаловался.
text Многие ли зашли бы так далеко?
text Или, может, я всё это время недооценивал, что на самом деле значит семья.
text Либо так, либо эта семья просто особенная.
text Понятия не имею.
setvar strS[1001] = "CGAK20P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHM.aac
text @[Акио]
text Мы не хотим, чтобы она чувствовала себя обязанной нам.
sound KHN.aac
text @[Акио]
text Зная её, она, наверное, подумает что-то вроде...
sound KHO.aac
text @[Акио]
text ...что это была её вина, что мы с Санаэ отказались от своих мечт.
setvar strS[1001] = "CGAK19P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHP.aac
text @[Акио]
text Но она начинает кое-что подозревать.
sound KHQ.aac
text @[Акио]
text Она весьма проницательна в подобных вещах.
setvar strS[1001] = "CGAK13P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHR.aac
text @[Акио]
text Вот почему я спрятал все наши памятные вещи в глубине кладовки.
sound KHS.aac
text @[Акио]
text Мне бы стоило просто всё это сжечь, но...
setvar strS[1001] = "CGAK24P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK24P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHT.aac
text @[Акио]
text Санаэ была бы убита горем, если бы я так сделал.
text Он тяжело вздыхает.
setvar strS[1001] = "CGAK20P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHU.aac
text @[Акио]
text Так что, теперь понимаешь? Вот как обстоят дела.
sound KHV.aac
text @[Акио]
text Я помогу тебе найти то, что ты ищешь.
sound KHW.aac
text @[Акио]
text Так что просто не впутывай в это Нагису.
setvar strS[1001] = "CGAK24P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK24P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHX.aac
text @[Акио]
text Понял?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Старик встаёт, закончив разговор.
setvar strS[1001] = "CGAK23P"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK23P.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KHY.aac
text @[Акио]
text Увидимся, пацан. Давай завтра повеселимся.
text @[Томоя]
text Само собой, старик.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Он издаёт раздражённый звук и уходит из комнаты.
text Теперь я один.
text @[Томоя]
text ...
text Мне немного не по себе, может быть, из-за того, что я только что услышал.
text Такой посторонний, как я, теперь в доме Фурукавы.
text Я не могу смириться с тем, что вторгаюсь в их семейное время.
text Как я могу не чувствовать себя каким-то бестактным чужаком?
text @[Томоя]
text (Может, мне стоит отказаться идти завтра...)
text Я хочу, чтобы они насладились завтрашним днём как семья. Без необходимости беспокоиться о посторонних.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 21
label s16
setvar strS[1000] = ""
label 21
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6505_0_0.scr
