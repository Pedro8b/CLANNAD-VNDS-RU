text Даже я бы... если бы признался кому-то и получил отказ...
text @[Томоя]
text Хм? Ты что-то сказал?
setvar strS[1001] = "CGKY17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9JY.aac
text @[Кё]
text Ничего. Я ничего не говорил.
text Судя по всему, дуясь, Кё надувает щёки и отворачивается.
setvar strS[1001] = "CGKY26A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY26A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9JZ.aac
text @[Кё]
text Ах... а я-то думала, Томоя наконец станет моим младшим братом.
text @[Томоя]
text Погоди секунду... насколько далеко ты вообще собираешься зайти...?
sound 9K0.aac
text @[Кё]
text Тогда я могла бы доставать тебя сколько душе угодно.
text Тебе одного Сунохары не хватает...?
setvar strS[1001] = "CGKY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9K1.aac
text @[Кё]
text Ладно, ну... я теперь побегу за Рё.
text @[Томоя]
text А? Ах, ладно... давай.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она отворачивается от меня и идёт в ту сторону, куда ушла Фудзибаяси.
sound 9K2.aac
text @[Кё]
text Ах, кстати.
text @[Томоя]
text Хм?
text Кё оглядывается на меня через плечо.
setvar strS[1001] = "CGKY22A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY22A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9K3.aac
text @[Кё]
text Ну, хоть ты и отказал ей...
sound 9K4.aac
text @[Кё]
text Не избегай Рё, ладно?
text @[Томоя]
text Не буду.
setvar strS[1001] = "CGKY21A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY21A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9K5.aac
text @[Кё]
text Ага. Я знала, что ты не из тех парней, что так поступают, и ты это только что подтвердил.
text Говорит она с улыбкой, но чуть грустным тоном.
text Ну... было немного неловко, но я не собираюсь ранить её чувства больше необходимого.
setvar strS[1001] = "CGKY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9K6.aac
text @[Кё]
text Ну, увидимся.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Кё затем смотрит на меня со своей обычной улыбкой ─ похоже, она снова взяла себя в руки ─ и уходит.
setvar intF[307] = 1
music ~
if 0 == 0
	goto s30
fi
goto 34
label s30
setvar strS[1000] = "KURO"
goto 36
label 34
if 0 == 1
	goto s31
fi
goto 35
label s31
setvar strS[1000] = "SIRO"
goto 36
label 35
setvar strS[1000] = "KURO"
label 36
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
jump SEEN0444_0_0.scr
label 37
