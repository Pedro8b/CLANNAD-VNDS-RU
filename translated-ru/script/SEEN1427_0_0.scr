text Фуко лихорадочно осматривает комнату. Похоже, она ищет вымышленное имя.
text @[Томоя]
text (Не говори, что она опять собирается взять первое попавшееся имя...)
text Её взгляд останавливается на газетном киоске.
text Там, на первой странице газеты, заголовок гласит «Замена диетвуман Тагучи Макико».
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (Наверное, «Макико» будет работать…)
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
