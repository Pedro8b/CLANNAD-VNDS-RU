text @[Томоя]
text (Отлично, {$lnmA}.)
setvar strS[1001] = "CGSN14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2U7.aac
text @[Санаэ]
text Что-то не так?
