text Ммм. Извини, это было другое имя…
sound 2UB.aac
text @[Санаэ]
text Другое имя?
setvar strS[1001] = "CGFU12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU12.png
if intF[1113] == 1
