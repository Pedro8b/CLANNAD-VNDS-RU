if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2TZ.aac
text @[Фуко]
text ...Фуко дома, потому что её оценки по искусству были не слишком хорошими.
text *fwump*
text Моё лицо прильнуло к полу.
text @[Томоя]
text Мы же здесь не говорим о твоих оценках!
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2U0.aac
text @[Фуко]
text Пожалуйста, не перебивай.
sound 2U1.aac
text @[Фуко]
text Хотя оценки Фуко по рисованию не так хороши...
sound 2U2.aac
text @[Фуко]
text Оне-чан это...
text В этот раз это случится по-настоящему!
setvar strS[1001] = "CGFU21"
setvar intF[1113] = intF[1112]
