text Да, на самом деле, её имя — …
sound 2UD.aac
text @[Фуко]
text Кимико.
sound 2UE.aac
text @[Санаэ]
text То есть Кимико-сан.
sound 2UF.aac
text @[Фуко]
text Да.
text Это другой способ прочитать символы имени «Коуко».
setvar strS[1001] = "CGSN11HE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11HE.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2UG.aac
text @[Санаэ]
text Мне бы хотелось с ней познакомиться. Пожалуйста, представь нас друг другу в следующий раз.
setvar strS[1001] = "CGFU12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2UH.aac
text @[Фуко]
text Да.
text @[Томоя]
text Но поскольку твоя сестра отправляется в путешествие с семьей, понадобится некоторое время. Верно, Фуко?
text ...Фуко кивает.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Благодаря моей последней страховке, разговор, к счастью, как‑то заканчивается.
text Не проходит и долгого, как Фуко возвращается к своей работе.
text Мы проводим весь день вместе. Надеюсь, это напомнит Фуко, что она не одна.
text Меня бы устроило, если этого достаточно, чтобы она могла сосредоточенно работать над резьбой без каких‑либо тревог.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 32
label s24
setvar strS[1000] = ""
label 32
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN1428_0_0.scr
