setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY22A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text ...
sound BBB.aac
text @[Кё]
text ...
text @[Томоя]
text ...Эй... как мне понимать эти результаты?
setvar strS[1001] = "CGKY17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BBC.aac
text @[Кё]
text ...Не о чем волноваться, разве нет?
text @[Томоя]
text ...Э?
setvar strS[1001] = "CGKY11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BBD.aac
text @[Кё]
text Гадание Рё в этот раз попадает точно в цель.
sound BBE.aac
text @[Кё]
text Это потому что ты будешь прямо рядом с ней.
text @[Томоя]
text ...
setvar strS[1001] = "CGKY12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BBF.aac
text @[Кё]
text Ладно, мне уже пора идти.
sound BBG.aac
text @[Кё]
text Мой класс переходит в другой кабинет на пятый урок, так что мне нужно подготовиться.
text @[Томоя]
text ...Ага.
setvar strS[1001] = "CGKY11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BBH.aac
text @[Кё]
text Ну что ж, увидимся!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Кё смотрит на меня с улыбкой и быстро уходит в сторону школьного здания.
text Мой взгляд следует за её спиной.
text Она ни разу не оборачивается и исчезает в здании.
text @[Томоя]
text ...Хаах...
text Я вздыхаю глубже, чем когда-либо.
text Всё, что мне остаётся — это смотреть на стену из людей вокруг Рё, пока не закончится обеденный перерыв.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s34
fi
goto 36
label s34
setvar strS[1000] = ""
label 36
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN3514_1_0.scr
