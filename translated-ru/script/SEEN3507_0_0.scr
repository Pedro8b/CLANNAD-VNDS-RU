text Может быть, я... каким-то образом заставлял себя...?
text Приносил ли я бессознательную жертву, находясь рядом с Фудзибаяси...?
text Я не знаю...
text ...И раз уж речь зашла о том, чего я не знаю — я не знаю и того, что чувствует Кё...
text Если, как и сказал Сунохара, я и правда нравлюсь Кё...
text ...то почему же она... пытается свести меня с Фудзибаяси...?
text Это почти как если бы она хотела задушить саму себя...
text Неужели её сестра настолько важна для неё...?
music ~
text Достаточно важна, чтобы подавлять собственные чувства... чтобы заставлять себя страдать...?
text Почему она ставит других выше себя вот так?
text Почему─
sound AOI.aac
text @[Голос]
text ...Ах...
text @[Томоя]
text А...?
text Услышав тихий, знакомый голос, я поднимаю голову.
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM16C.mp3
text @[Томоя]
text Фудзибаяси...?
setvar strS[1001] = "CGRY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOJ.aac
text @[Рё]
text Эм...
text @[Томоя]
text Ты ещё не пошла домой?
setvar strS[1001] = "CGRY19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOK.aac
text @[Рё]
text Т-твоя обувь всё ещё была... в шкафчике... поэтому я... подумала, что смогу увидеть тебя, если подожду здесь...
text @[Томоя]
text Неужели ты ждала тут всё это время?
setvar strS[1001] = "CGRY22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOL.aac
text @[Рё]
text Я не так уж долго ждала.
setvar strS[1001] = "CGRY21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOM.aac
text @[Рё]
text Я тоже... ну... гадала в классе до самого этого момента.
text @[Томоя]
text Понятно.
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AON.aac
text @[Рё]
text ...Эм... Оказаки-кун... что-то случилось?
text @[Томоя]
text А? П-почему ты так думаешь?
sound AOO.aac
text @[Рё]
text Ты кажешься... немного не таким, как обычно...
text @[Томоя]
text Да нет, ничего такого. Кстати, ты же сейчас идёшь домой, да?
setvar strS[1001] = "CGRY19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOP.aac
text @[Рё]
text Ах, да.
text @[Томоя]
text В таком случае, пойдём вместе... хотя, наверное, ты как раз меня из-за этого и ждала.
setvar strS[1001] = "CGRY22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AOQ.aac
text @[Рё]
text А? Ах... эм... н-ну... эмм...
text С совершенно покрасневшим лицом Фудзибаяси смотрит вниз.
text Я подхожу к Фудзибаяси, легонько похлопываю её по голове и начинаю идти.
text Она семенит следом за мной.
setvar strS[1000] = "BG034Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s19
fi
goto 21
label s19
setvar strS[1000] = ""
label 21
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Позже, по пути домой...
text ...мы идём бок о бок, болтая о разных мелочах.
text Мы говорим о том, как все были рады сеансам гадания на картах таро после уроков, и как они с ней всё это обсуждали.
text О том, что мы видели по телевизору вчера, или о книге, которую она читала перед сном.
text Это и правда просто бессмысленная болтовня.
text Обычная сцена из нашей повседневной жизни.
text Для меня такие моменты — это просто что-то естественное...
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s20
fi
goto 22
label s20
setvar strS[1000] = ""
label 22
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Убедившись, что рядом никого нет, я целую её на прощание.
text Фудзибаяси тоже отвечает мне поцелуем.
text Её лицо краснеет так сильно, что это заметно даже в лучах заходящего солнца. Затем она кланяется и уходит.
text Какое-то время я стою и смотрю, как её спина удаляется всё дальше и дальше.
text Лёгкий ветерок касается моих губ, на которых всё ещё остаётся тёплое ощущение.
text Хоть сейчас уже и весна, ветер кажется холодным... и заставляет меня чувствовать какое-то странное одиночество.
music ~
if 0 == 0
	goto s21
fi
goto 23
label s21
setvar strS[1000] = "KURO"
goto 25
label 23
if 0 == 1
	goto s22
fi
goto 24
label s22
setvar strS[1000] = "SIRO"
goto 25
label 24
setvar strS[1000] = "KURO"
label 25
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
delay 180
jump SEEN3508_0_0.scr
