text @[Томоя]
text Значит, есть и другие, кто об этом знает?
setvar strS[1001] = "CGTM32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6PW.aac
text @[Томоё]
text Было бы просто чудом, если бы только вы с Сунохарой об этом знали.
sound 6PX.aac
text @[Томоё]
text Ты легко можешь это выяснить, если просто спросишь кого-нибудь из другой школы.
text @[Томоя]
text Было бы лучше, если бы никто больше об этом не узнал.
sound 6PY.aac
text @[Томоё]
text Да... ты права.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s22
fi
goto 27
label s22
setvar strS[1000] = ""
label 27
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG033Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 28
label s23
setvar strS[1000] = ""
label 28
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6PZ.aac
text @[Томоё]
text Здесь я с тобой прощаюсь.
text @[Томоя]
text Ты живёшь тут рядом?
sound 6Q0.aac
text @[Томоё]
text Нет, мне ещё довольно далеко идти отсюда, но я иду через торговый квартал, так что опасности не будет.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q1.aac
text @[Томоё]
text ...Мне было бы нормально, даже если бы опасность была. Вот что ты думаешь. Это написано у тебя на лице.
text @[Томоя]
text Ты это сказала ещё до того, как я успел это подумать.
text @[Томоя]
text Ну, ладно, увидимся.
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q2.aac
text @[Томоё]
text Ага, значит, в следующий раз уже в понедельник, да?
text @[Томоя]
text Это довольно долго.
sound 6Q3.aac
text @[Томоё]
text Да, это так.
text @[Томоя]
text Почему-то... мне кажется, я наконец понимаю тех людей, что фотографируются в фотобудках.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q4.aac
text @[Томоё]
text В смысле?
text @[Томоя]
text В смысле, что мне бы хотелось видеть твоё лицо на фотографии, когда мы врозь.
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q5.aac
text @[Томоё]
text Вот как... Может, тогда сделаем одну? Мне бы тоже этого хотелось.
text @[Томоя]
text Не-а, давай не будем. Мне кажется, я постепенно начну становиться обычным человеком таким образом.
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q6.aac
text @[Томоё]
text Не думаю, что это было бы плохо, знаешь ли.
text @[Томоя]
text Это просто с твоей точки зрения.
sound 6Q7.aac
text @[Томоё]
text Понятно... Ну, наверное... я не буду на тебя давить.
sound 6Q8.aac
text @[Томоё]
text Люди не меняются просто потому, что им кто-то сказал...
text @[Томоя]
text Ага.
text @[Томоя]
text Тогда увидимся.
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Q9.aac
text @[Томоё]
text Хорошо.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 29
label s24
setvar strS[1000] = ""
label 29
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2428_0_0.scr
