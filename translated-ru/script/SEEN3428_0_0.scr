text Рё... если не скажешь ему сейчас, сегодня вечером у нас снова интенсивная тренировка!
setvar strS[1001] = "CGRY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NS.aac
text @[Рё]
text Н-нет...! Только не это...!
text @[Томоя]
text ...
text Фудзибаяси напугана...
text Мне уже правда интересно, что вообще такое эти тренировки...
setvar strS[1001] = "CGRY19A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NT.aac
text @[Рё]
text Эм... Оказаки-кун...
text @[Томоя]
text Да?
sound 9NU.aac
text @[Рё]
text З-з-завтра...
text @[Томоя]
text Да...?
sound 9NV.aac
text @[Рё]
text ...Завтра...
setvar strS[1001] = "CGRY20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NW.aac
text @[Рё]
text Я буду ждать тебя перед станцией в одиннадцать!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она говорит это очень быстро, а потом так же быстро убегает от меня.
text Теперь здесь остаются только Кё и Ботан.
text @[Томоя]
text ...Ну что ж...
setvar strS[1001] = "CGKY10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NX.aac
text @[Кё]
text Вот так вот.
text @[Томоя]
text Ну... это мне вообще ничего не объясняет.
setvar strS[1001] = "CGKY11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NY.aac
text @[Кё]
text Суть в том, что это свидание.
text @[Томоя]
text *Вздох* ...Свидание... значит?
setvar strS[1001] = "CGKY24A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY24A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9NZ.aac
text @[Кё]
text Ты настолько бесполезен, что ни за что бы её сам не пригласил, да?
setvar strS[1001] = "CGKY12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9O0.aac
text @[Кё]
text Вот поэтому Рё и приходится стараться вместо тебя.
text @[Томоя]
text Кого это ты назвала бесполезным?
setvar strS[1001] = "CGKY15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9O1.aac
text @[Кё]
text Так чем ты завтра занимаешься?
text @[Томоя]
text Высплюсь до полудня.
setvar strS[1001] = "CGKY26A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY26A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9O2.aac
text @[Кё]
text *Вздох*
text @[Томоя]
text Что это за вздох...?
sound 9O3.aac
text @[Кё]
text У тебя вообще-то теперь есть девушка, знаешь?
sound 9O4.aac
text @[Кё]
text Так что хватит проводить выходные в одиночку. Чёрт, хватит отсыпаться и жить как ленивец.
text @[Томоя]
text ...Блин, оказывается, иметь девушку — это довольно хлопотно...
setvar strS[1001] = "CGKY13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 9O5.aac
text @[Кё]
text Ты что-то сказал?
text @[Томоя]
text Не, ничего.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s21
fi
goto 23
label s21
setvar strS[1000] = ""
label 23
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN3429_0_0.scr
