sound 6SC.aac
text @[Томоё]
text Раз не нужно ходить в школу, тебе не придётся видеться со мной. Может, поэтому тебе и хорошо на душе...?
text @[Томоя]
text Да, наверное...
text @[Томоя]
text Это правда, с тех пор как мы стали вместе, многое изменилось.
text Это была чистая правда.
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6SD.aac
text @[Томоё]
text ...Прости, что вмешалась в твою жизнь.
sound 6SE.aac
text @[Томоё]
text Я просто хотела извиниться за это...
sound 6SF.aac
text @[Томоё]
text Вот и всё, зачем я пришла. Так что, пожалуйста, не изводи себя...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она закусывает губу и встаёт.
text Кажется, она вот-вот заплачет.
text Ах, ну почему она такая женственная... подумал я про себя.
text Уверен, сейчас она женственнее любой обычной девушки.
text @[Томоя]
text Но знаешь,
text сказал я.
text @[Томоя]
text Мне тоже будет одиноко, и это тоже правда.
text @[Томоё]
text ...
text Всё ещё держась за ручку двери, Томоё замирает, так и не обернувшись.
text @[Томоя]
text Пусть это всего три дня... я не смогу видеть тебя в школе всё это время.
text @[Томоя]
text И, наверное, без тебя будет так одиноко, что мне будет уже не до усталости.
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6SG.aac
text @[Томоё]
text Это...
sound 6SH.aac
text @[Томоё]
text ...правда?
text @[Томоя]
text Думаешь, твой парень стал бы тебе врать?
sound 6SI.aac
text @[Томоё]
text ...Но то, что ты правда устал — тоже ведь правда.
text @[Томоя]
text Просто я не привык вести правильный образ жизни, вот и всё.
setvar strS[1001] = "CGTM32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6SJ.aac
text @[Томоё]
text Но ведь со временем привыкнешь?
text @[Томоя]
text Наверное.
sound 6SK.aac
text @[Томоё]
text Так что, всё нормально, если мы будем вместе?
text @[Томоя]
text Ага. Без тебя было бы одиноко.
sound 6SL.aac
text @[Томоё]
text ...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она отпускает ручку двери и оборачивается.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6SM.aac
text @[Томоё]
text Ну и безнадёжный же ты человек...
sound 6SN.aac
text @[Томоё]
text Хорошо. Я останусь с тобой.
sound 6SO.aac
text @[Томоё]
text Буду обязательно будить тебя каждое утро, даже пока ты отстранён!
text ...Лучше бы я промолчала.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s4
fi
goto 6
label s4
setvar strS[1000] = ""
label 6
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2501_0_0.scr
