		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 650.aac
text @[Томоё]
text Что... тебя это не устраивает?
sound 651.aac
text @[Томоё]
text Понятно. Хочешь, чтобы к тебе относились как к старшему, Томоя?
text @[Томоя]
text Нет, не то чтобы я хотел, чтобы ко мне относились как к старшему, просто мне кажется, что в девушках, которые ведут себя как младшие, есть своё очарование.
sound 652.aac
text @[Томоё]
text Разве это не одно и то же?
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
