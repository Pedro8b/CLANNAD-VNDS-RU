		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 653.aac
text @[Томоё]
text Что? Если хотел этого, надо было сказать раньше.
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 654.aac
text @[Томоё]
text Ладно, отныне буду относиться к тебе как к старшему. Цени это.
text ...Она ничуточки не изменила своё отношение ко мне.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
