setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 655.aac
text @[Томоё]
text Ах да... если ты теперь мой старший, значит, мне называть тебя Оказаки-семпай?
sound 656.aac
text @[Томоё]
text И ещё разговаривать с тобой вежливо?!
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
