setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H6U.aac
text @[Сунохара]
text Это же круто, да? Я тоже хочу к этому приобщиться.
text @[Томоя]
text Извини, не выйдет. Она тебя ненавидит.
setvar strS[1001] = "CGSH20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H6V.aac
text @[Сунохара]
text Серьёзно? Да я её почти не видел!
text @[Томоя]
text Вот именно. Кажется, единственное, что она ненавидит сильнее светлых волос — это тараканы. Так что...
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H6W.aac
text @[Сунохара]
text Так вот оно что...
text Он дёргает себя за обесцвеченную чёлку.
text @[Томоя]
text И ещё она страшно раздражается на труднопроизносимые имена вроде «Сунохара».
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H6X.aac
text @[Сунохара]
text Ой, да оставь меня в покое!
text @[Томоя]
text В общем, вот как обстоят дела.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound H6Y.aac
text @[Сунохара]
text Хмф... значит, для начала надо заставить её меня полюбить...
text Похоже, он ещё не сдался.
text Надеюсь только, что это не обернётся против меня...
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
