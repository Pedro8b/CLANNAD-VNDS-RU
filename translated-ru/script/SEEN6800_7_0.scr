text Вот какое чувство у меня начинает возникать.
text Всё, что я когда-то любил, превращается в простые воспоминания, пока вокруг меня строится совершенно новый мир.
text Ничто не может оставаться прежним вечно... Всё продолжает меняться.
text И... это касается и Нагисы тоже.
text Даже Нагису унесёт волной перемен, и мы вдвоём будем отдаляться друг от друга всё дальше и дальше.
text Боль в моей груди была предчувствием того, что однажды мне придётся столкнуться с этой грустью.
text Сейчас она так близко ко мне, но со временем станет более далёкой.
text Именно поэтому я крепко обнимаю Нагису.
sound OBT.aac
text @[Нагиса]
text Что случилось, Томоя-кун?
text Пока я лежу так, встревоженный, Нагиса обращается ко мне с добротой в голосе.
text @[Томоя]
text Эй, Нагиса...
sound OBU.aac
text @[Нагиса]
text Да...?
text @[Томоя]
text Я очень тебя люблю. Так что...
sound OBV.aac
text @[Нагиса]
text Да, и я тебя тоже люблю.
text @[Томоя]
text ...
text Я не могу закончить то, что хотел сказать.
text "...всегда будь рядом со мной".
text Если облечь эти мысли в слова, их просто смоет.
text @[Томоя]
text Нагиса...
sound OBW.aac
text @[Нагиса]
text Да...?
text Нагиса поворачивается ко мне лицом... и я целую её в губы.
text Я делаю это, чтобы удержать нас двоих вместе.
music ~
text Я пальцем опускаю её подбородок и приоткрываю её губы.
text Мне хочется, чтобы наша связь стала ещё глубже.
music BGM18B.mp3
sound OBX.aac
text @[Нагиса]
text Хм...?
text Впервые мы касаемся друг друга так глубоко.
text Это ощущается пустым, как сон, настолько грустным, что хочется плакать.
if 0 == 0
	goto s755
fi
goto 901
label s755
setvar strS[1000] = "KURO"
goto 903
label 901
if 0 == 1
	goto s756
fi
goto 902
label s756
setvar strS[1000] = "SIRO"
goto 903
label 902
setvar strS[1000] = "KURO"
label 903
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Я стоял неподвижно у подножия того холма два года назад.
setvar strS[1000] = "BG011"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s757
fi
goto 904
label s757
setvar strS[1000] = ""
label 904
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я был раздосадован тем, что застрял, не в силах никуда пойти.
text Я ненавидел этот город, из которого не мог сбежать.
text Я ненавидел всё... Мне хотелось, чтобы всё изменилось.
setvar strS[1000] = "BG044A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s758
fi
goto 905
label s758
setvar strS[1000] = ""
label 905
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Но со временем я обнаружил кое-что важное для себя.
text И теперь я боюсь это потерять.
text Раньше я так сильно желал перемен...
text Но в какой-то момент я начал желать, чтобы всё оставалось прежним.
setvar strS[1000] = "BG031"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s759
fi
goto 906
label s759
setvar strS[1000] = ""
label 906
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Всё это... я хочу, чтобы ничего не менялось.
text Потому что если это произойдёт, я потеряю свою улыбку.
text Я больше не смогу любить это место...
if 0 == 0
	goto s760
fi
goto 907
label s760
setvar strS[1000] = "KURO"
goto 909
label 907
if 0 == 1
	goto s761
fi
goto 908
label s761
setvar strS[1000] = "SIRO"
goto 909
label 908
setvar strS[1000] = "KURO"
label 909
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
if 0 == 0
	goto s762
fi
goto 910
label s762
setvar strS[1000] = "KURO"
goto 912
label 910
if 0 == 1
	goto s763
fi
goto 911
label s763
setvar strS[1000] = "SIRO"
goto 912
label 911
setvar strS[1000] = "KURO"
label 912
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
delay 60
setvar strS[1000] = "BG044AH"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s764
fi
goto 913
label s764
setvar strS[1000] = ""
label 913
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OBY.aac
text @[Голос]
text Томоя-кун... уже утро.
sound OBZ.aac
text @[Голос]
text Если ты не встанешь скоро, то опоздаешь.
text Я слышу голос у самого уха...
text Я медленно открываю глаза.
setvar strS[1001] = "CGNG23E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OC0.aac
text @[Нагиса]
text Давай вставать, Томоя-кун.
text @[Томоя]
text Ага...
text Она рядом со мной... Нагиса.
text Я беру её за руку.
text Крепко её сжимаю.
setvar strS[1001] = "CGNG10E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OC1.aac
text @[Нагиса]
text Что случилось, Томоя-кун?
sound OC2.aac
text @[Нагиса]
text Тебе приснился плохой сон?
text @[Томоя]
text ...
text @[Томоя]
text Нагиса...
sound OC3.aac
text @[Нагиса]
text Да...?
text @[Томоя]
text Доброе утро.
setvar strS[1001] = "CGNG25E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OC4.aac
text @[Нагиса]
text Ох, доброе утро.
text Какие же тёплые нынче дни.
text Если бы у меня было одно желание, я бы пожелал, чтобы они длились вечно.
delay 60
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s765
fi
goto 914
