	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1.aac -1
setvar strS[1000] = "BG035R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
