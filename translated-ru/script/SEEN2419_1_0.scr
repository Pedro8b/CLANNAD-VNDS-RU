music ~
sound 5PA.aac
text @[Voice]
text Эй.
text В путь к шкафчикам для обуви меня зовёт голос.
music BGM06.mp3
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ...Это Томойо.
sound 5PB.aac
text @[Tomoyo]
text Ты действительно заставил его остановиться.
text ...Наверное, она говорит о Сунохаре.
text @[Tomoya]
text Да, теперь всё будет в порядке.
text @[Tomoya]
text (Поскольку доказано, что ты сильнее...)
text ...Интересно, какое выражение она сделает, если я скажу что‑то подобное.
sound 5PC.aac
text @[Tomoyo]
text О, спасибо большое.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PD.aac
text @[Tomoyo]
text Но, впрочем, было так живо, мне кажется, что без вас двоих я стану немного одинокой.
text @[Tomoya]
text Почему? Я имею в виду, у тебя есть свои друзья, верно?
sound 5PE.aac
text @[Tomoyo]
text Конечно, у меня есть. И все они хорошие люди.
sound 5PF.aac
text @[Tomoyo]
text И я не собираюсь говорить о них плохо.
sound 5PG.aac
text @[Tomoyo]
text ...Но они немного утончённые.
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PH.aac
text @[Tomoyo]
text А вы, ребята, милые и глупые.
text ...Это должно быть комплиментом?
text @[Tomoya]
text Разве ты не пришёл в эту школу, чтобы стать одним из них?
text @[Tomoya]
text Тебе просто следует игнорировать людей вроде нас.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PI.aac
text @[Томойо]
text Разве я уже не связана с «людьми вроде тебя»?
text @[Томоя]
text Хотя мы плохие люди?
sound 5PJ.aac
text @[Томойо]
text Хотя вы и плохие люди. Я всё же могу хотя бы поздороваться.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PK.aac
text @[Томойо]
text Кстати, я же не держу никакой обиды и ничего подобного.
text @[Томоя]
text Ты имеешь в виду Суногару?
sound 5PL.aac
text @[Томойо]
text Нет, в общем… Его тоже.
text @[Томоя]
text Ты действительно большая душой.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PM.aac
text @[Томойо]
text Верно. Очень большая душой.
sound 5PN.aac
text @[Томойо]
text Во мне переполняет материнская любовь.
sound 5PO.aac
text @[Томойо]
text Разве ты не считаешь, что это по‑настоящему девичье со стороны меня?
text @[Томоя]
text Девочка? … Нет, скорее что‑то вроде старушки.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PP.aac
text @[Томойо]
text Это довольно грубо. Я моложе тебя.
text @[Томоя]
text А, ты прав. Я совсем забыл.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PQ.aac
text @[Томойо]
text Ты, кажется, как‑то недоволен.
text @[Томоя]
text Не совсем...
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PR.aac
text @[Томойо]
text А, мне придётся оставить всё здесь.
sound 5PS.aac
text @[Томойо]
text Сегодня я иду домой с одноклассниками.
sound 5PT.aac
text @[Томойо]
text Было бы плохо заставлять их ждать.
text @[Томоя]
text Да, тебе стоит поторопиться.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PU.aac
text @[Томойо]
text Это почти звучит так, будто ты хочешь избавиться от меня. Почему бы тебе не попробовать звучать более грустно, когда речь идёт о моём уходе?
text @[Томоя]
text В таком случае, не уходи. Останься.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PV.aac
text @[Томойо]
text Да, мне стало немного легче, услышав это. К сожалению, я не могу.
sound 5PW.aac
text @[Томойо]
text Мне нужно держать своё обещание.
sound 5PX.aac
text @[Томойо]
text Увидимся позже.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она оборачивается и отходит величественно.
text Я не хочу долго стоять перед кабинетом учителей, поэтому спешу к шкафу для обуви.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
