sound UZ5.aac
text @[Каппэй]
text Может, у меня будет больше шансов снова встретить её.
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UZ6.aac
text @[Каппэй]
text Когда она увидит, как у меня на лбу сверкает пот, у неё точно ёкнет сердце, да?
sound UZ7.aac
text @[Каппэй]
text Тебе не кажется, что все работающие парни выглядят просто круто?
sound UZ8.aac
text @[Каппэй]
text Будь я на её месте, точно бы влюбился!
text @[Томоя]
text ...
text У меня просто нет слов.
setvar strS[1001] = "CGKP14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGKP14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UZ9.aac
text @[Каппэй]
text Мм! Внезапно я весь на подъёме!
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UZA.aac
text @[Каппэй]
text Постарайся, я сам! Работай изо всех сил!
text @[Томоя]
text Ага, постарайся.
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UZB.aac
text @[Каппэй]
text Ага!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Каппэй сжимает кулак и уходит.
text Глядя ему вслед, я не могу удержаться от вздоха.
music ~
if 0 == 0
	goto s23
fi
goto 26
label s23
setvar strS[1000] = "KURO"
goto 28
label 26
if 0 == 1
	goto s24
fi
goto 27
label s24
setvar strS[1000] = "SIRO"
goto 28
label 27
setvar strS[1000] = "KURO"
label 28
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
jump SEEN7600_6_0.scr
