text В конце концов… мы почти не посетили ни одной из экспозиций на фестивале.
text Мы всё время просто были вместе.
text Мы просто обнимали друг друга, опирались друг на друга и целовались…
text Мы поцеловались в последний раз, когда расходились, и к тому моменту я уже забыл, сколько раз мы целовались сегодня.
text Что, полагаю, меня успокоило, так это то, что Кё с тех пор не появлялась.
music ~
text Завтра… у меня свидание с Рё…
if 0 == 0
	goto s22
fi
goto 24
label s22
setvar strS[1000] = "KURO"
goto 26
label 24
if 0 == 1
	goto s23
fi
goto 25
label s23
setvar strS[1000] = "SIRO"
goto 26
label 25
setvar strS[1000] = "KURO"
label 26
setvar strS[1001] = ""
setvar intF[1113] = 0
