	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BI5.aac
text @[Голос]
text Томоя...
text @[Томоя]
text ...Эх...?
text Она произнесла мое имя...
text И она снова прижимает губы к моим.
text Мой ум опустошается.
text Что... она только что сказала...?
text Что... она меня называла...?
text Чья... это был голос?
text Тихо, тёплое ощущение покидает мои губы.
text Наконец, я могу ясно увидеть её лицо, покрытое слезами.
