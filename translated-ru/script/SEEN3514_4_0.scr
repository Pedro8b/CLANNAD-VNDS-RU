	fi
fi
text Ветер сильный.
text В красноокрашенном пейзаже холодный... холодный ветер бьёт моё тело.
text Как только листья вокруг нас шуршат в ветре...
text Ветер дует, будто окутывает меня... будто скользит мимо моего тела...
text ...как будто замораживает моё сердце.
setvar strS[1000] = "FGKY08"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s100
fi
goto 102
label s100
setvar strS[1000] = ""
label 102
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text Мы стоим неподвижно среди ветра.
text Не произнося ни слова, мы просто стоим там и смотрим друг на друга...
text ...как будто пытаемся разглядеть наши лица, отражённые в печальных глазах друг друга.
music ~
text В то же время я чувствую это...
text Её решимость...
music BGM18B.mp3
text @[Томоя]
text Рё...
text Я произношу её имя...
text Похоже испуганной, она кусает губы, пока её небольшие плечи слегка дрожат.
text Увидев это, моя выдержка вдруг пропадает.
text Слова, которые я должен сказать, застревают в горле...
text @[Томоя]
text ...
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s101
fi
goto 103
label s101
setvar strS[1000] = ""
label 103
