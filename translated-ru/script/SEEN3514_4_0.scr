setvar intF[1113] = 0
bgload {$strS[1000]}_SEPIA.jpg 98
text Когда мы сидели и обедали рядом друг с другом...
text Когда мы вдвоём проводили выходной, гуляя по городу...
setvar strS[1000] = "FGKY03A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s104
