	fi
fi
text Я пытаюсь закрыть глаза...
text И я вспоминаю каждый момент, проведённый с Рё...
setvar strS[1000] = "FGKY02I"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s102
fi
goto 104
label s102
setvar strS[1000] = ""
label 104
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}_SEPIA.jpg 98
text Как она выглядела, когда предсказывала мне судьбу...
text Как она быстро убежала, когда её лицо покраснело...
setvar strS[1000] = "FGKY04B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s103
fi
goto 105
label s103
setvar strS[1000] = ""
