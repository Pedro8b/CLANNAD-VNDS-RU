setvar intF[1112] = 0
bgload SFWEC00.jpg 60
delay 8
setimg SFWEC24.png 148 172
delay 287
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s27
fi
goto 28
label s27
setvar strS[1000] = ""
label 28
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG301"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s28
fi
goto 29
label s28
setvar strS[1000] = ""
label 29
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM26B.mp3
text Мы вставляем последние детали в голову — «глаза».
text Теперь кукла из хлама готова.
text ...«Готово!»
text Девочка ложится и вытягивает уставшие конечности.
text Я остаюсь на месте, глядя на куклу в ожидании, что она вот-вот начнёт двигаться.
text Да, это неуклюжая, кривобокая фигура.
text Руки у неё разной длины, а нижняя часть рта выпирает.
text Какое забавное лицо.
text И всё же это новый друг — тот, с кем можно быть вместе.
text Так что придётся просто не обращать внимания на то, что выглядит она немного нелепо.
text Я продолжаю ждать.
text Но мой новый товарищ не двигается, даже спустя долгое ожидание.
text ......
text Девочка приподнимается с пола.
text Она вместе со мной смотрит на неподвижную куклу.
text Может быть, нужно сделать что-то особенное, чтобы она начала двигаться.
text Я пытаюсь вспомнить, что я сделал первым делом.
text Точно. Я учился ходить.
text Раз это мой друг, мне кажется, что именно я должен первым научить его этому.
text Именно это я и сделаю.
text Я отхожу от неё на небольшое расстояние и хлопаю в ладоши, точно так же, как когда-то делала она для меня.
text Это сигнал, понятный даже новорождённому: иди сюда.
text Мои руки издают глухой стук, когда я хлопаю ими друг о друга.
text ......
text *Стук* *Стук*
text ......
text Кукла даже не пытается встать.
text *Стук* *Стук*
text Я продолжаю хлопать в ладоши.
text Но она по-прежнему никак не реагирует.
text Её голова низко опущена, почти как у мёртвой.
text *Стук* *Стук*
text ......
text Девочка теперь смотрит, как я хлопаю в ладоши. Не знаю, как долго она уже наблюдает.
text Она подползает ко мне на коленях и обнимает так крепко, что я чуть не падаю.
text А потом она плачет.
text ...«Прости. Прости.»
text Она повторяет эти слова снова и снова.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s29
fi
goto 30
label s29
setvar strS[1000] = ""
label 30
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6900_6_0.scr
