text текст С этими словами я покидаю класс.
music ~
setvar strS[1000] = "BG020"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s10
fi
goto 10
label s10
setvar strS[1000] = ""
label 10
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM14.mp3
text текст Из коридора я оглядываюсь в класс. Она всё ещё стоит, безысходно смотрит на своё незавершённое произведение искусства.
text текст Её слёзы почти готовы вырваться.
text текст @[Томоя]
text (Может, это было немного слишком жестко...?)
text @[Томоя]
text (Только идиот попробовал бы резать такой рукой...)
text @[Томоя]
text (Тебе стоит лучше заботиться о своём теле...)
text Переработка травмы может привести к постоянному повреждению, о котором ты пожалеешь всю оставшуюся жизнь.
text Я понимаю это лучше всех.
text @[Томоя]
text Тск...
if intF[3] == 1
	goto s11
fi
goto 11
label s11
text Повернув плечо, я смотрю в окно.
text Естественно, мой взгляд постепенно опускается вниз... И вот она.
label 11
setvar intF[130] = 1
goto 14
label 12
if intF[1089] == 0
	goto s12
fi
goto 14
label s12
text Она выглядит испуганной, так что, может, лучше оставить её в покое.
text @[Томоя]
text Извини, что испугал. Сейчас уйду.
text Оставив эти слова, я выхожу из класса.
music ~
