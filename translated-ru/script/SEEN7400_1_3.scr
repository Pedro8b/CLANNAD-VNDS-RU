		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG030"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s228
fi
goto 265
label s228
setvar strS[1000] = ""
label 265
