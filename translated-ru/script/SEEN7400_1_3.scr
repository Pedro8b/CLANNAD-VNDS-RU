text Её глаза слегка покраснели, она крепко сжимает кулаки.
text Похоже, она пытается сдержать своё разочарование.
text @[Томоя]
text ...Мэй-тян.
text Я мягко беру её маленький сжатый кулак.
text Хотел хоть немного её подбодрить.
text @[Томоя]
text Ты же идёшь к членам клуба, да?
setvar strS[1001] = "CGME19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGME19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound SWO.aac
text @[Мэй]
text ... Да.
sound SWP.aac
text @[Мэй]
text Я пойду туда и попробую с ними поговорить.
sound SWQ.aac
text @[Мэй]
text И попрошу их принять Онии-тяна обратно...
text Она крепко сжимает мою руку в ответ.
text ...Тут я ничего не могу сделать.
text Так что хотя бы хочу быть рядом с ней.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s227
fi
goto 264
