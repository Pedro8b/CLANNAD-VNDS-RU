		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3ON.aac
text @[Фуко]
text Прости...
sound 3OO.aac
text @[Female Student]
text Это твоё... Ибуки‑сан?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text Студентка, которая подняла морскую звезду, — это та же девушка, с которой Фуко разговаривала несколько дней назад... Её звали Мицуи, если я правильно помню.
music BGM08D.mp3
