		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3OM.aac
text @[Фуко]
text Аа...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мужской студент внезапно вбегает в дверь и сталкивается с Фуко, из‑за чего она роняет морскую звезду.
text Морская звезда несколько раз катается по полу, пока не добирается до ноги другого студента и не падает.
setvar strS[1001] = "CGFU32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU32.png
if intF[1113] == 1
