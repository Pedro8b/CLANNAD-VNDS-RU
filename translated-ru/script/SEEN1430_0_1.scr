text @[Фуко]
text Тебе просто нужно полностью погрузиться в мир морской звезды, вот так...
text @[Фуко]
text ...
text *Тук*
setvar strS[1001] = "CGFU17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU17.png
if intF[1113] == 1
