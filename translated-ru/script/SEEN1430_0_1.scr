text @[Фуко]
text Именно потому, что им так трудно учиться...
sound 3OK.aac
text @[Фуко]
text Им нужно расслабиться с этой морской звёздой.
setvar strS[1001] = "CGFU21A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU21A.png
if intF[1113] == 1
