text Вернее...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я осматриваю класс.
text Хотя сейчас перемена, все сидят за партами, учатся и записывают что‑то карандашом.
text @[Томоя]
text Не думаю, что они способны заботиться о других...
setvar strS[1001] = "CGFU20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20A.png
if intF[1113] == 1
