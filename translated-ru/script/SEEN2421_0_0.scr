text ...я в итоге успел вовремя.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5QH.aac
text @[Томойо]
text Похоже, твой учитель всё ещё не пришёл, так что всё вроде бы в порядке.
text It's taking everything I have just catching my breath, so I can't manage to say anything back to her.
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5QI.aac
text @[Tomoyo]
text See you later.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Tomoyo smiles in satisfaction, and gallantly runs away.
sound 5QJ.aac
text @[Boy]
text Huh? Okazaki, it's pretty unusual to see you here this early in the morning.
text @[Tomoya]
text Ah...
text Just around when morning homeroom is about to start, my eyes find themselves looking down at my palms.
text @[Tomoya]
text (Come to think of it, I just walked to school while holding hands with a girl...)
text But...
text Mysteriously, it didn't feel strange at all.
text @[Tomoya]
text (Although she'd probably feel depressed again if I actually told her that...)
setvar intF[212] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2421_1_0.scr
