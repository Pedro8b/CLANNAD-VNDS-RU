setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0NF.aac
text @[Сунохара]
text Если мы останемся здесь... нас уберут — лишь вопрос времени.
sound 0NG.aac
text @[Сунохара]
text Что нам делать...?
text @[Томоя]
text Так, посмотрим...
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0NH.aac
text @[Сунохара]
text Давай быстрее двигаться! Нельзя давать ему время!
text Ну, похоже, остаётся только спортивная площадка.
setvar strS[1000] = "BG030"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s86
fi
goto 93
label s86
setvar strS[1000] = ""
label 93
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0NI.aac
text @[Сунохара]
text Это правда нам поможет?
goto 77
label 94
setvar strS[1000] = "BG030"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s87
fi
goto 95
label s87
setvar strS[1000] = ""
label 95
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM28.mp3
text Медленно поднимается силуэт.
sound 0NJ.aac
text @[Голос]
text Неплохо... малец.
setvar strS[1001] = "CGAK22H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK22H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if intF[8] == 1
	goto s88
fi
goto 96
label s88
text Старик наконец показывается перед нами.
goto 97
label 96
if intF[8] == 0
	goto s89
fi
goto 97
label s89
text Мужчина наконец показывается перед нами.
text ...Мой последний противник.
label 97
text @[Томоя]
text Э...
text @[Томоя]
text Мне бы казалось, что я подвожу тех, кого победил, если бы сдался без боя.
sound 0NK.aac
text @[{$lnmB}]
text Много о себе возомнил, да...?
if intF[839] == 1
	goto s90
fi
goto 98
label s90
sound 0NL.aac
text @[{$lnmB}]
text Всё, что ты сделал — победил ещё трёх таких же новичков...
goto 99
label 98
if intF[839] == 0
	goto s91
fi
goto 99
label s91
sound 0NM.aac
text @[{$lnmB}]
text Всё, что ты сделал — победил ещё двух таких же новичков...
label 99
text @[Томоя]
text Ты так говоришь, но, судя по всему, тебе не удалось одолеть ни одного из нас.
sound 0NN.aac
text @[{$lnmB}]
text Не будь глупцом...
sound 0NO.aac
text @[{$lnmB}]
text На моём счету гора трупов такая высокая, что я уже сбился со счёта...
text @[Томоя]
text А...?
if intF[839] == 1
	goto s92
fi
goto 100
label s92
text @[Томоя]
text Погоди... нас же играет всего пятеро, разве нет?
sound 0NP.aac
text @[{$lnmB}]
text Хм? Какой глупец...
sound 0NQ.aac
text @[{$lnmB}]
text Нас в общей сложности 25 человек.
goto 101
label 100
if intF[839] == 0
	goto s93
fi
goto 101
label s93
text @[Томоя]
text Погоди... нас же играет всего четверо, разве нет?
sound 0NR.aac
text @[{$lnmB}]
text Хм? Какой глупец...
sound 0NS.aac
text @[{$lnmB}]
text Нас в общей сложности 24 человека.
label 101
text @[Томоя]
text ...Ты шутишь... да?
sound 0NT.aac
text @[{$lnmB}]
text Участвует практически каждый, кого я знаю из торговцев в торговом квартале.
sound 0NU.aac
text @[{$lnmB}]
text Это не новички вроде вас с парой дней опыта...
sound 0NV.aac
text @[{$lnmB}]
text Это мужчины и женщины, чьи сердца пылают жаждой мести — такой сильной, что она гнала их через суровые, изнурительные тренировки с того самого дня, как они проиграли мне год назад...
sound 0NW.aac
text @[{$lnmB}]
text И вот я стою перед вами, одолев их всех до единого!
if intF[839] == 1
	goto s94
fi
goto 102
label s94
text Значит, пока я разбирался с Сунохарой, Томоё и Кё, этот тип разобрался с двадцатью людьми...
goto 103
label 102
if intF[839] == 0
	goto s95
fi
goto 103
label s95
text Значит, пока я разбирался с Сунохарой и Кё, этот тип разобрался с двадцатью людьми...
label 103
sound 0NX.aac
text @[{$lnmB}]
text Твой опыт даже рядом не стоит с моим...
text @[Томоя]
text Ха-ха...
text Всё, на что я способен — это смех.
sound 0NY.aac
text @[{$lnmB}]
text Что ж, для новичка ты неплохо справился...
sound 0NZ.aac
text @[{$lnmB}]
text В самом конце я дам тебе честный бой.
text @[Томоя]
text Я... рад это слышать...
sound 0O0.aac
text @[Сунохара]
text Одзаки... что будем делать?
music ~
text @[Томоя]
text Ничего не делай. Дальше я сам разберусь.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM29.mp3
text Ветер поднимает облако пыли. Я почти жду, что мимо прокатится перекати-поле... Прямо как разборка на Диком Западе.
text Я так нервничаю, что даже забываю сглотнуть.
text @[Томоя]
text (Мне не сравниться с его скоростью...)
text @[Томоя]
text (Неужели нет способа создать брешь...?)
text Я поднимаю сумку, чтобы использовать её как щит.
setvar strS[1001] = "CGAK22H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK22H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0O1.aac
text @[{$lnmB}]
text Ха... эта твоя игрушка бесполезна.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if intF[8] == 1
	goto s96
fi
jump SEEN0425_0_2.scr 104
label s96
text Старик начинает двигаться.
text В этот момент я вытряхиваю содержимое сумки в воздух и бросаюсь вперёд.
music ~
text ..........
text ......
text ...Пистолет старика упирается мне в грудь.
jump SEEN0425_0_2.scr 105
jump SEEN0425_0_2.scr
