text @[Котоми]
text Томоя-кун, до завтра.
text Котоми широко мне улыбается.
text @[Томоя]
text Ага. До завтра.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
