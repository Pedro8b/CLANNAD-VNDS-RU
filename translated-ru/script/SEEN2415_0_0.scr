text @[Томоя]
text Если бы она сделала даже один неверный шаг, она бы стала просто идиотом.
sound 58B.aac
text @[Ученик]
text Если бы она была идиотом, её бы не приняли в эту школу!
text @[Томоя]
text Но дело-то не в этом...
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 58C.aac
text @[Томоё]
text Вы все тут что ли делаете... Как я собираюсь проходить через это?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Девушка пробивается сквозь зрителей и уходит.
text Я смотрю ей вслед, пока она уходит.
text Такая странная ходит в эту школу?
text Я не знал.
text Ну, я ведь весной почти не ходил в школу, так что, наверное, нормально, что я её не знаю.
text Героиня ушла, и зрители тоже начали расходиться небольшими группами по два-три человека.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 58D.aac
text @[Сунохара]
text Говорю же, это странно до невозможности.
sound 58E.aac
text @[Сунохара]
text Невозможно.
text @[Томоя]
text Я ухожу без тебя~
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 58F.aac
text @[Сунохара]
text Эй, подожди!
text И вот мы тоже ушли.
setvar intF[201] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
