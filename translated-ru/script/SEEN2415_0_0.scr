music ~
text @[Томоя]
text ...Хм?
text Что‑то появилось в моём поле зрения, чего не было несколько мгновений назад.
music BGM10B.mp3
text Не знаю, только ли они спустились с холма, но два мотоцикла остановились у ворот школы.
text Даже отсюда я вижу, что водители — молодые парни, оба без шлемов.
text Один из них машет рукой, сигнализируя другому.
text Обе мотоциклы начинают неистово мчаться по территории школы, их двигатели громко ревут.
text Слабо помню, что нечто подобное происходило в конце прошлого года.
text Тогда виновниками оказались ученики соседней промышленной школы.
text Разве они настолько злятся из‑за того, что мы лучшая школа в городе?
setvar strS[1001] = "CGSH10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 56X.aac
text @[Сунохара]
text О, что это?
text Тело Сунохары внезапно заполняет моё поле зрения.
text @[Томоя]
text Ублюдок! Не садись на мой стол!
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 56Y.aac
text @[Сунохара]
text Да ладно, всё нормально. Ого, круто! Эти мотоциклы ОЧЕНЬ громкие!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Привлечённые шумом, остальные ребята тоже стали собираться у окна, чтобы посмотреть, что происходит.
text Больше ничего не может быть более удручающим, чем это.
choice Escape|Watch how things turn out
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s0
fi
goto 2
label s0
text Я встаю со своего места.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 56Z.aac
text @[Сунохара]
text Оказаки, ты собираешься спуститься туда?
text @[Томоя]
text Никак нет. Здесь просто жарко, так что я выйду в коридор на минутку.
setvar strS[1001] = "CGSH19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 570.aac
text @[Сунохара]
text Что? Но шоу только начинается...
music ~
setvar strS[1000] = "BG018"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 1
label s1
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я жду в коридоре, пока вся ситуация успокоится.
text Зрители в классе вдруг взорвались от восторга.
text Сразу после этого весь класс наполняется пронзительными криками.
text Если бы я был там сейчас, я, вероятно, ударил бы кого‑то (скорее всего Сунохару) от чистой раздражённости.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
goto 3
label 2
if intF[1089] == 1
	goto s2
fi
goto 3
label s2
label 3
text Интересно, как учителя планируют справиться с этой ситуацией.
text Итак, я решаю остаться на месте и посмотреть, как закончится вся эта беда.
text Внезапно зрители в другом классе становятся невероятно шумными.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
