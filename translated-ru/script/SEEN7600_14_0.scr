setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VLV.aac
text @[Каппэй]
text Томоя-кун... я...
sound VLW.aac
text @[Каппэй]
text ...сирота...
text @[Томоя]
text А?
text Его слова застают меня настолько врасплох, что я смотрю на Каппэя.
text Его лицо спокойно... но в глазах мелькает намёк на одиночество.
music BGM01.mp3
sound VLX.aac
text @[Каппэй]
text По тому, что мне рассказали, меня бросили у порога приюта вскоре после рождения.
text Затем он продолжает.
sound VLY.aac
text @[Каппэй]
text Там очень много таких детей, как я.
sound VLZ.aac
text @[Каппэй]
text Настолько много, что мы порой задумывались, есть ли вообще смысл в существовании таких, как мы.
sound VM0.aac
text @[Каппэй]
text Но, думаю, мне всё же повезло больше, чем многим из них.
sound VM1.aac
text @[Каппэй]
text Потому что меня бросили, даже не дав узнать тепла родителей... тепла семьи.
setvar strS[1001] = "CGKP20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VM2.aac
text @[Каппэй]
text Есть и такие люди...
sound VM3.aac
text @[Каппэй]
text Те, с кем родители обращались жестоко, и в итоге их отдали в приют.
sound VM4.aac
text @[Каппэй]
text ...Нет, на самом деле, я бы сказал, что так было чаще, чем наоборот.
sound VM5.aac
text @[Каппэй]
text Мы все родились ни с чем... нам ничего не дали.
sound VM6.aac
text @[Каппэй]
text Жизни, которые никогда не были благословенны...
setvar strS[1001] = "CGKP21B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP21B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VM7.aac
text @[Каппэй]
text Мы были жалкими существами, которым отказали в праве жить полноценно.
setvar strS[1001] = "CGKP20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VM8.aac
text @[Каппэй]
text Однажды в наш приют приехали люди с телевидения.
sound VM9.aac
text @[Каппэй]
text Это была какая-то документальная программа — из тех, где музыкант объезжает места, где живут его фанаты.
setvar strS[1001] = "CGKP19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMA.aac
text @[Каппэй]
text Это был кто-то, кого я любил и часто слушал.
sound VMB.aac
text @[Каппэй]
text Она реально пробила меня — что значит быть живым. Вот такая это была песня.
sound VMC.aac
text @[Каппэй]
text Тогда мне удалось поговорить с этим музыкантом.
setvar strS[1001] = "CGKP10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMD.aac
text @[Каппэй]
text И он сказал мне...
sound VME.aac
text @[Каппэй]
text Что даже если это всего одна вещь, мне стоит найти что-то, во что я могу верить, и двигаться вперёд с этим.
sound VMF.aac
text @[Каппэй]
text Для него это была музыка.
sound VMG.aac
text @[Каппэй]
text Вот что он мне сказал.
setvar strS[1001] = "CGKP11B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMH.aac
text @[Каппэй]
text Он был по-настоящему убедителен.
sound VMI.aac
text @[Каппэй]
text Я сам смог увидеть, какую силу даёт вера в одну-единственную вещь.
setvar strS[1001] = "CGKP10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMJ.aac
text @[Каппэй]
text И тогда я начал думать.
sound VMK.aac
text @[Каппэй]
text Во что я могу верить?
sound VML.aac
text @[Каппэй]
text Чем я могу гордиться...?
sound VMM.aac
text @[Каппэй]
text Что есть у меня такого, что даст мне мужество и надежду, как это случилось у того человека?
setvar strS[1001] = "CGKP19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMN.aac
text @[Каппэй]
text И тогда меня осенило.
text Он кладёт руку на колени.
sound VMO.aac
text @[Каппэй]
text У меня есть эти ноги.
sound VMP.aac
text @[Каппэй]
text Сколько себя помню, я никому не уступал в беге.
sound VMQ.aac
text @[Каппэй]
text Вот почему я задумался о беге.
sound VMR.aac
text @[Каппэй]
text Бежать... и бежать быстрее всех...
sound VMS.aac
text @[Каппэй]
text Я бежал исключительно своими силами...
sound VMT.aac
text @[Каппэй]
text И потом меня хвалило множество людей.
sound VMU.aac
text @[Каппэй]
text Они признавали меня как личность.
sound VMV.aac
text @[Каппэй]
text Я по-настоящему чувствовал себя живым.
sound VMW.aac
text @[Каппэй]
text Это был, без сомнения, самый насыщенный период моей жизни...
sound VMX.aac
text @[Каппэй]
text Я любил... бег...
sound VMY.aac
text @[Каппэй]
text Раз уж у меня больше ничего не было, это было единственное, чем я мог гордиться.
setvar strS[1001] = "CGKP20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VMZ.aac
text @[Каппэй]
text Это было для меня всем.
sound VN0.aac
text @[Каппэй]
text Вот почему...
setvar strS[1001] = "CGKP21B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP21B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VN1.aac
text @[Каппэй]
text ...когда я узнал о своей болезни, я умер.
text @[Томоя]
text Умер...? Но ты же жив, разве нет?
sound VN2.aac
text @[Каппэй]
text Нет... я больше не могу бегать.
sound VN3.aac
text @[Каппэй]
text Я больше не знаю, что придаёт смысл моей жизни...
text @[Томоя]
text ...Каппэй...
sound VN4.aac
text @[Каппэй]
text ...Вместо того чтобы жить, я жду смерти...
setvar strS[1001] = "CGKP20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VN5.aac
text @[Каппэй]
text Я просто хотел провести оставшееся время...
sound VN6.aac
text @[Каппэй]
text ...Совсем небольшой срок, что у меня остался с этими ногами...
sound VN7.aac
text @[Каппэй]
text Принимая обезболивающее, даже если я не могу бегать, я всё ещё могу ходить.
sound VN8.aac
text @[Каппэй]
text Вот почему я начал путешествовать пешком из города в город.
setvar strS[1001] = "CGKP19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VN9.aac
text @[Каппэй]
text И вот я добрался до этого города и встретил тебя, Томоя-кун.
sound VNA.aac
text @[Каппэй]
text И Рё-сан тоже.
text Говорит он и смотрит на дверь.
text @[Томоя]
text А как же Фудзибаяси?
setvar strS[1001] = "CGKP18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNB.aac
text @[Каппэй]
text А?
text @[Томоя]
text Если ты умрёшь, она не сможет снова подняться.
sound VNC.aac
text @[Каппэй]
text ...
text @[Томоя]
text Разве жизнь ради неё не может стать тем, что будет тебя поддерживать?
sound VND.aac
text @[Каппэй]
text ...
setvar strS[1001] = "CGKP10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNE.aac
text @[Каппэй]
text ...Не может.
sound VNF.aac
text @[Каппэй]
text Без ног... и завися от других...
setvar strS[1001] = "CGKP11B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNG.aac
text @[Каппэй]
text Это лишь создаст проблемы Рё-сан.
sound VNH.aac
text @[Каппэй]
text Я стану для неё лишь обузой.
text @[Томоя]
text Это─
setvar strS[1001] = "CGKP10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNI.aac
text @[Каппэй]
text Томоя-кун...
setvar strS[1001] = "CGKP19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNJ.aac
text @[Каппэй]
text ...Ты сможешь оставаться рядом с человеком, которого любишь, даже зная, что это осложнит ей жизнь?
text @[Томоя]
text ...Каппэй...
sound VNK.aac
text @[Каппэй]
text Вот тебе и ответ.
text @[Томоя]
text В таком случае...
text @[Томоя]
text Зачем ты вообще стал с ней встречаться?
text @[Томоя]
text Если ты знал, что это лишь причинит ей боль, зачем ты пытался проводить с ней время?
sound VNL.aac
text @[Каппэй]
text ...Да... ты совершенно прав...
sound VNM.aac
text @[Каппэй]
text Я... всегда просто следую своим чувствам в тот момент...
sound VNN.aac
text @[Каппэй]
text Это моя дурная привычка... серьёзно...
sound VNO.aac
text @[Каппэй]
text Прости.
text @[Томоя]
text ...
sound VNP.aac
text @[Каппэй]
text Но...
sound VNQ.aac
text @[Каппэй]
text Печаль... это то, что со временем можно излечить...
sound VNR.aac
text @[Каппэй]
text Так было со всеми в приюте тоже...
text Как он может говорить такие грустные вещи... с таким взглядом...?
text С таким взглядом, будто он уже всё понял...?
music ~
text @[Томоя]
text И всё же... я хочу, чтобы ты продолжал жить...
setvar strS[1001] = "CGKP15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNS.aac
text @[Каппэй]
text ...Томоя-кун...
music BGM18B.mp3
text @[Томоя]
text Разве я могу молча смотреть, как умирает мой друг?
sound VNT.aac
text @[Каппэй]
text Друг...?
text @[Томоя]
text Именно так. Ты же первым назвал нас друзьями, разве нет?
text @[Каппэй]
text ...
text @[Томоя]
text Хотя у тебя ещё есть шанс жить...
text @[Томоя]
text Отказаться от этого...
text @[Томоя]
text Бег ведь не единственное, что у тебя есть, так?
text @[Томоя]
text Я...
text @[Томоя]
text Я не знаю тебя того, кто бегал.
text @[Томоя]
text Каппэй Хиирага, которого знаю я...
text @[Томоя]
text ...это парень, эгоистичный и делающий всё, что ему заблагорассудится, парень, который не особо ладит с людьми...
text @[Томоя]
text ...он рассказывает странные истории из прошлого...
text @[Томоя]
text ...иногда говорит как поэт...
text @[Томоя]
text ...иногда бросается прямо на тебя...
text @[Томоя]
text Мой друг... вот какой он...
text @[Каппэй]
text ...
setvar strS[1001] = "CGKP19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNU.aac
text @[Каппэй]
text ...Спасибо...
sound VNV.aac
text @[Каппэй]
text Томоя-кун, спасибо...
sound VNW.aac
text @[Каппэй]
text Точно... Томоя-кун знает только того Каппэя Хиирагу, каким я являюсь сейчас...
sound VNX.aac
text @[Каппэй]
text Хотя ты и не знал о моём прошлом, ты всё равно пришёл со мной встретиться...
sound VNY.aac
text @[Каппэй]
text ...И сказал, что я твой друг...
sound VNZ.aac
text @[Каппэй]
text Я...
sound VO0.aac
text @[Каппэй]
text ...правда счастлив.
sound VO1.aac
text @[Каппэй]
text ...Так что...
sound VO2.aac
text @[Каппэй]
text ...прости меня...
text @[Томоя]
text Каппэй!
sound VO3.aac
text @[Каппэй]
text ...Прости...
text @[Томоя]
text Угх─
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s107
fi
goto 116
label s107
setvar strS[1000] = ""
label 116
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text .........
text ......
text ...
setvar strS[1000] = "BG037N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s108
fi
goto 117
label s108
setvar strS[1000] = ""
label 117
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM16C.mp3
text Я сажусь на скамейку, опустив голову...
text Фудзибаяси сидит рядом со мной, но не говорит ни слова.
text Я... тоже не могу заставить себя заговорить...
text В итоге я так и не смог переубедить Каппэя...
text Мальчишка, который ничего не знает, только что объяснил мне, что значит жить...
text Слыша всё это от него, я по-настоящему осознаю, насколько я сам слаб.
text Как только я выхожу из палаты, Фудзибаяси начинает плакать...
text Когда я говорю ей, что мне жаль... она качает головой и извиняется сама, в ответ.
text Снова и снова она извиняется...
sound VO4.aac
text @[Рё]
text Оказаки-кун...
text Услышав её тихий голос, я поднимаю голову.
setvar strS[1001] = "CGRY24D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY24D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VO5.aac
text @[Рё]
text Можно мне... одолжить твою грудь всего на минутку...
text @[Томоя]
text ...Фудзибаяси...
setvar strS[1001] = "CGRY25D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY25D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VO6.aac
text @[Рё]
text Прошу тебя...
sound VO7.aac
text @[Рё]
text ...Всего на мгновение... этого хватит...
text @[Томоя]
text ...
text В такой ситуации я не могу отказать.
text Я слегка раскрываю объятия, и уже через мгновение она бросается ко мне на грудь.
setvar strS[1000] = "FGKY11B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s109
fi
goto 118
label s109
setvar strS[1000] = ""
label 118
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound VO8.aac
text @[Рё]
text У... э... вех... ик...
sound VO9.aac
text @[Рё]
text У-у-у-у-у-у-а-а-а-а-х!
sound VOA.aac
text @[Рё]
text Ааааааааааанн! У-у-а-а-а-а-х!!
text Её голос пронзает мою грудь...
text Её слёзы такие тяжёлые...
text Крошечные руки, которыми она сжимает мою одежду...
text Её худые, дрожащие плечи...
text Слёзы, стекающие по её щекам...
text В моих объятиях всё наполнено скорбью.
text Невольно я крепче сжимаю объятия.
text Я крепко обнимаю дрожащее тело Фудзибаяси.
text Потому что если я этого не сделаю... я и сам могу разрыдаться...
text По крайней мере... пока я здесь, чтобы её успокоить, я не могу плакать...
text ...Я не должен плакать...
text Мои глаза дрожат...
text Чтобы сдержать слёзы... я поднимаю взгляд вверх.
if intF[610] == 1
	goto s110
fi
jump SEEN7600_15_0.scr 120
label s110
jump SEEN7600_15_0.scr
