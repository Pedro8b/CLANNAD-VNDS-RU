text Н-нет... не то чтобы... но... если нас кто-то увидит...
text С влажными глазами она всё ещё беспокоится об окружающих.
text @[Томоя]
text Мы же встречаемся, так что всё в порядке, разве нет?
setvar strS[1001] = "CGRY24A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY24A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKK.aac
text @[Рё]
text Но... э-это неловко...
text @[Томоя]
text Тогда, думаешь, лучше нам больше так не делать?
setvar strS[1001] = "CGRY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGRY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKL.aac
text @[Рё]
text Нет! Я не хочу этого!
text Заявляет она без колебаний. Её глаза широко раскрываются.
setvar strS[1001] = "CGRY20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Затем она снова прикрывает рот рукой.
sound AKM.aac
text @[Рё]
text Ах... эм... то, что только что... эмм... я-я...
setvar strS[1001] = "CGRY14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKN.aac
text @[Рё]
text Я... я правда счастлива... счастлива... что мы п-поцеловались... я счастлива, но...
sound AKO.aac
text @[Рё]
text Но...
text Почти срываясь на слёзы, она смотрит на меня, потом по сторонам, а потом снова на меня.
text Я кладу руку ей на голову.
setvar strS[1001] = "CGRY19A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKP.aac
text @[Рё]
text Ах...
text @[Томоя]
text В следующий раз я подумаю, где нам это сделать.
setvar strS[1001] = "CGRY22A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKQ.aac
text @[Рё]
text Ах... н-но... ну... если ты правда хочешь этого, Оказаки-кун... эм... мы можем в любое время...
setvar strS[1001] = "CGRY20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AKR.aac
text @[Рё]
text Ах... но... но... было бы проблемой, если вокруг нас много людей.
text Говорит она с растерянным видом на покрасневшем лице.
label 28
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s26
fi
goto 29
label s26
setvar strS[1000] = ""
label 29
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN3507_0_0.scr
