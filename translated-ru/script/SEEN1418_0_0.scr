text Верни его.
goto 2
label 1
if intF[1089] == 1
	goto s1
fi
goto 2
label s1
text Когда я оборачиваюсь, она уже убегает.
text Я решаю немного подождать и наблюдаю, как она поворачивает, чтобы спрятаться за угол. Затем она высовывает часть лица из‑под стены, чтобы подглядеть за мной.
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
