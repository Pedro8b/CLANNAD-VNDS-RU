sound F85.aac
text @[Мужчина]
text Мучас грасиас, Юкинэ...
text Мужчина встаёт на ноги. Миядзава подставляет ему плечо.
sound F86.aac
text @[Миядзава]
text Я провожу его.
text @[Томоя]
text Тогда давай помогу.
text Не успеваю я сменить Миядзаву...
sound F87.aac
text @[Мужчина]
text Не трогай меня! Грязный сопляк!
text Кричит на меня мужчина.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F88.aac
text @[Сунохара]
text Ай!
text Ты слишком часто вскрикиваешь.
setvar strS[1001] = "CGYK15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK15A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F89.aac
text @[Миядзава]
text Извините. Дальше я сама разберусь.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text В итоге Миядзава сама, одна, выводит мужчину из комнаты.
bgload KURO.jpg 60
bgload {$strS[1000]}.jpg 60
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM07B.mp3
setvar strS[1001] = "CGYK10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8A.aac
text @[Миядзава]
text Извините за ожидание.
text @[Томоя]
text Отличная работа.
text @[Томоя]
text Ну что ж...
text @[Томоя]
text У меня столько вопросов, что даже не знаю, с чего начать.
setvar strS[1001] = "CGYK15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK15A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8B.aac
text @[Миядзава]
text Понимаю. Извини, что напугала вас.
sound F8C.aac
text @[Миядзава]
text Через дверь их скорее заметят учителя, поэтому мои друзья обычно заходят через окно.
text Ладно, спасибо, но это был самый неважный из моих вопросов.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8D.aac
text @[Сунохара]
text Так значит... тот парень только что... был... твоим другом?
sound F8E.aac
text @[Миядзава]
text Да.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8F.aac
text @[Сунохара]
text Серьёзно?..
setvar strS[1001] = "CGYK16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8G.aac
text @[Миядзава]
text Что не так? Разве это странно?
text «Так вот оно что», — киваем мы с Сунохарой в один голос.
text @[Томоя]
text «Странно» — может, не совсем то слово, но разве не говорят, что друзей нужно выбирать с умом...?
text @[Томоя]
text Хотя, наверное, я сам не в том положении, чтобы кому-то такое говорить...
setvar strS[1001] = "CGYK10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8H.aac
text @[Миядзава]
text Извините, но... тот мой друг... он очень хороший человек.
sound F8I.aac
text @[Миядзава]
text Он очень добрый.
text @[Томоя]
text Да, я понимаю. Правда понимаю. Но, видишь ли...
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8J.aac
text @[Сунохара]
text Разве это плохо? У тебя, должно быть, большое сердце, раз у тебя такой друг.
setvar strS[1001] = "CGYK15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8K.aac
text @[Миядзава]
text Дело не в этом.
setvar strS[1001] = "CGYK11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8L.aac
text @[Миядзава]
text Дело не в том, большое у меня сердце или нет. Просто он хороший человек.
sound F8M.aac
text @[Миядзава]
text Вот и всё.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8N.aac
text @[Сунохара]
text Правда?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Интересно, что вообще могло произойти, чтобы такая обычная девушка, как она, пересеклась с таким отморозком.
text И вообще, не могу понять, как она может оставаться настолько спокойной, видя такое.
text @[Томоя]
text (А ещё это его обожающее выражение по отношению к ней...)
music ~
if 0 == 0
	goto s10
fi
goto 13
label s10
setvar strS[1000] = "KURO"
goto 15
label 13
if 0 == 1
	goto s11
fi
goto 14
label s11
setvar strS[1000] = "SIRO"
goto 15
label 14
setvar strS[1000] = "KURO"
label 15
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG046N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 16
label s12
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08D.mp3
text Тем же вечером.
text Как обычно, я просто валяюсь в комнате Сунохары.
setvar strS[1001] = "CGSH19B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH19B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8O.aac
text @[Сунохара]
text Слушай, я сегодня общался с одним второкурсником и расспросил его кое о чём.
text @[Томоя]
text О чём?
sound F8P.aac
text @[Сунохара]
text О Юкинэ-тян.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Хм...
text Я приподнимаюсь с пола.
text @[Томоя]
text И что он сказал?
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8Q.aac
text @[Сунохара]
text Похоже, о ней ходят слухи, связанные с такими же людьми, как тот «друг», что мы сегодня видели.
sound F8R.aac
text @[Сунохара]
text Причём речь идёт не об одном-двух человеках.
sound F8S.aac
text @[Сунохара]
text У неё, похоже, довольно много таких знакомых.
text @[Томоя]
text Ну, она и сама так говорила...
sound F8T.aac
text @[Сунохара]
text Её одноклассники сплошь недоумевают насчёт её связи с этими людьми.
sound F8U.aac
text @[Сунохара]
text Понимаешь, она же совершенно обычная девушка.
text Так что вполне естественно, что все задаются вопросом.
sound F8V.aac
text @[Сунохара]
text Причём не просто обычная. У неё хорошие оценки, она настоящая отличница.
sound F8W.aac
text @[Сунохара]
text И в классе она вполне популярна.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8X.aac
text @[Сунохара]
text Но, похоже, раньше эти люди приходили прямо к ней в класс, чтобы встретиться.
sound F8Y.aac
text @[Сунохара]
text Видимо, поняли, что это уже слишком, и перешли на другое место.
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8Z.aac
text @[Сунохара]
text Ну, справочная и правда выглядит идеальным местом. Туда никто никогда не заходит, а окно выходит прямо на задний сад. Никто и не заметит, если пробраться через него.
text @[Томоя]
text Но... кто вообще станет так заморачиваться, просто чтобы встретиться с другом?
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F90.aac
text @[Сунохара]
text Может, с важным другом?
text @[Томоя]
text Для таких, как они? Аж слеза наворачивается...
sound F91.aac
text @[Сунохара]
text Ну, второкурсник ещё говорил, что это может быть что-то вроде благотворительности.
sound F92.aac
text @[Сунохара]
text Если так посмотреть, ну, это уже не так уж невозможно, да?
text @[Томоя]
text Что не так уж невозможно?
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F93.aac
text @[Сунохара]
text Постоянно строить из себя изгоя — это не спасает от одиночества. Так ведь?
text @[Томоя]
text То есть ты хочешь сказать, что они одиноки...? Они тебе на детей похожи, что ли?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text С этими словами я снова ложусь на пол.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 17
label s13
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN5426_0_0.scr
