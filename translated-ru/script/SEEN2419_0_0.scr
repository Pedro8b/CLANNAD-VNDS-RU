music ~
text Когда первый период заканчивается, Сунохара появляется с кроваво-красными глазами.
music BGM08A.mp3
setvar strS[1001] = "CGSH17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH17.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5O9.aac
text @[Сунохара]
text Ладно, пора заставить Доронджо на Томиё!
text @[Томоя]
text Ты всё дальше и дальше отдаляешься от «помщения», понимаешь?
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OA.aac
text @[Сунохара]
text Мне всё равно, что это, серьезно...
if intF[9] == 0
	goto s0
fi
goto 2
label s0
if intF[302] == 0
	goto s1
fi
goto 1
label s1
text @[Томоя]
text Чувак, ты выглядишь действительно усталым.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OB.aac
text @[Сунохара]
text Да, я всю ночь просидел, читая книги «Выбери своё приключение».
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OC.aac
text @[Сунохара]
text Ну, хотя бы это доказывает, что я не трус...
sound 5OD.aac
text @[Сунохара]
text Мне ещё предстоит очиститься от моего позора.
text Это действительно достойный дух.
goto 2
label 1
if intF[302] == 1
	goto s2
fi
goto 2
label s2
text @[Томоя]
text Э? Может, ты плакал до утра?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OE.aac
text @[Сунохара]
text Нет, я не плакал!
text Он говорит, при этом теребя глаза.
label 2
text @[Томоя]
text И? Какой план ты придумал в этот раз?
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OF.aac
text @[Сунохара]
text Ситуация с заложниками.
sound 5OG.aac
text @[Сунохара]
text В смысле, ты всё время видишь такие вещи в манге и телесериалах, не так ли?
sound 5OH.aac
text @[Сунохара]
text Вроде: «Не двигай ни одной мышки, иначе ребёнок получит…!»
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OI.aac
text @[Сунохара]
text I'm going to do that with some of her stuff.
text @[Томоя]
text So, what are you going to steal?
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OJ.aac
text @[Сунохара]
text Hmmm... How does her modern literature textbook sound?
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OK.aac
text @[Сунохара]
text It'll be like, "Don't you dare move a muscle, or this picture of Akutagawa might just suddenly sprout a mustache."
text @[Томоя]
text I think she'll just kick you without even wasting a breath, though.
sound 5OL.aac
text @[Сунохара]
text If she does that, it'll mean mustaches for all other authors too...!
text @[Томоя]
text And in return, you'll get shredded.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OM.aac
text @[Сунохара]
text ...
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5ON.aac
text @[Сунохара]
text Heheh... As long as I can take some of her stuff with me, I'll be satisfied...
text @[Томоя]
text Is your life that unimportant?!
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OO.aac
text @[Сунохара]
text Just tell me I am a terrifying man...
text @[Томоя]
text Yeah, you're terrifying, all right...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Sunohara takes a magic marker from his pen case and takes off the cap.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OP.aac
text @[Сунохара]
text Heheh...
text He then licks the tip of the marker with his tongue.
text @[Томоя]
text You're writing on your tongue, you know.
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OQ.aac
text @[Сунохара]
text Эм...?
sound 5OR.aac
text @[Сунохара]
text Чёрт, надеюсь, это отвалится...
text Это была недоделанная попытка сыграть злодея.
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OS.aac
text @[Сунохара]
text Ну что, пошли тогда!
if intF[209] == 1
	goto s3
fi
goto 6
label s3
choice Have him stop it already|Let him go
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s4
fi
goto 3
label s4
text @[Томоя]
text Просто уже сдавайся.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OT.aac
text @[Сунохара]
text А? Почему?
sound 5OU.aac
text @[Сунохара]
text Ты же не хочешь видеть, как она вопит и орёт: «Прекрати...! Всё, только не усы...!»
text …Точно, ты этого точно не увидишь.
text @[Томоя]
text Мы уже неоднократно доказали это, в любом случае.
sound 5OV.aac
text @[Сунохара]
text Что именно доказали?
text @[Томоя]
text Что она действительно сильна.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OW.aac
text @[Сунохара]
text Ну, по крайней мере, она довольно хороша.
text @[Томоя]
text А ты начал всё это лишь потому, что думал, что женщина не может быть сильнее мужчины, так зачем тогда продолжать?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OX.aac
text @[Сунохара]
text Она определённо не сильнее мужчины.
text @[Томоя]
text Разве ты только что не признал это?
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OY.aac
text @[Сунохара]
text Я лишь сказал, что она довольно хороша. Моё настоящее расследование только началось.
text @[Томоя]
text Ну, если ты дошёл до того, чтобы сделать что‑то настолько трусливое, как удержать заложника, она сильнее ТЕБЯ, по крайней мере.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OZ.aac
text @[Сунохара]
text Гу...
text @[Томоя]
text Но если ты сейчас остановишься, я думаю, ты сможешь хотя бы уйти с сохранённой гордостью.
sound 5P0.aac
text @[Сунохара]
text Т-Трус… Давай, дружок. Это была всего лишь маленькая шутка, ха-ха!
text @[Томоя]
text В таком случае прекрати. Это не смешно.
sound 5P1.aac
text @[Сунохара]
text Ха-ха… Я так думал. Я думал, это хотя бы стоит смеха, хотя.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сунохара возвращается к своему месту, падает на стол и остаётся неподвижным в таком положении некоторое время.
text Наверное, это был огромный шок, когда наконец доказали, что Томойо сильнее него.
setvar intF[211] = 1
goto 5
label 3
if intF[1089] == 1
	goto s5
fi
goto 5
label s5
label 4
text @[Томоя]
text Пожалуйста, иди один в этот раз.
setvar strS[1001] = "CGSH27"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5P2.aac
text @[Сунохара]
text Э?
sound 5P3.aac
text @[Сунохара]
text Ты не хочешь увидеть, как она кричит и вопит «Перестань…! Любое, кроме усов…!»?
text Мне как бы хочется, если бы это действительно случилось.
text @[Томоя]
text То есть… попробуй делать что‑то другое. Это стало довольно скучным.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5P4.aac
text @[Сунохара]
text Как‑то ты заставляешь это звучать так, будто меня снова будут избивать.
text @[Томоя]
text Я ошибаюсь?
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5P5.aac
text @[Сунохара]
text Ха-ха-ха… Я действительно упал довольно низко с этим, не так ли?
sound 5P6.aac
text @[Сунохара]
text Чтобы даже ты, мой лучший друг, говорил обо мне так.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5P7.aac
text @[Сунохара]
text Ну ладно, просто жди будущих рассказов о моих подвигах.
bgload KURO.jpg 88
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5P8.aac
text @[Сунохара]
text ...
text @[Томоя]
text Пожалуйста, расскажи мне всё о твоих подвигах.
sound 5P9.aac
text @[Сунохара]
text Пожалуйста, не спрашивай.
label 5
goto 7
label 6
if intF[209] == 0
	goto s6
fi
goto 7
label s6
goto 4
label 7
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2419_1_0.scr
