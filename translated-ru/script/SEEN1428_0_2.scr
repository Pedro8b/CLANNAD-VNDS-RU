setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сказав это, {$lnmA} подбегает к Фуко, пытаясь её успокоить.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3A6.aac
text @[Сунохара]
text Одзаки, у-у меня лоб...
text @[Томоя]
text Ага, предоставь это мне.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Пинок*  *Пинок*
sound 3A7.aac
text @[Сунохара]
text АРГХ! БОЛЬНО!
text Раз уж выпал такой шанс хорошенько попинать его, почему бы и нет.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3A8.aac
text @[Сунохара]
text Ааай... Почему ты вечно пинаешь меня, стоит только представиться случаю?!
text Он вскакивает как ни в чём не бывало.
text @[Томоя]
text Просто накопилась обида от того, что приходится каждый день с тобой общаться.
sound 3A9.aac
text @[Сунохара]
text Это я должен так говорить!
text @[Томоя]
text Так, успокойся. Повзрослей уже наконец, Сунохара.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3AA.aac
text @[Сунохара]
text Угх...
text @[Томоя]
text Посмотри на Фуко. Она вон уже совсем успокоилась, попивает себе сок.
sound 3AB.aac
text @[Сунохара]
text Ну конечно, пострадавший тут только Я!
sound 3AC.aac
text @[Сунохара]
text Чёрт... Вот поэтому я и терпеть не могу детей!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text С трудом сдерживая гнев, Сунохара плюхается на стул.
text Спасибо, что тебя, как обычно, так легко провести.
text @[Томоя]
text Уф...
text Я протяжно вздыхаю и снова сажусь.
label 110
setvar strS[1001] = "CGNG12Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG12Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3AD.aac
text @[{$lnmA}]
text На улице уже темно.
text {$lnmA} произносит это, глядя в окно.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (В итоге, чем мы вообще сегодня занимались...)
music ~
text Не придумав ничего другого, мы решаем на этом закончить день.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s86
fi
goto 111
label s86
setvar strS[1000] = ""
label 111
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN1429_0_0.scr
