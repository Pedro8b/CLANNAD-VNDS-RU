setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3A6.aac
text @[Sunohara]
text Оказаки, м-моё лоб...
text @[Tomoya]
text Да, оставь это мне.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Удар*  *Удар*
sound 3A7.aac
text @[Sunohara]
text ААРГ! ОУУУУ!
text У меня есть шанс нанести пару хороших ударов, так что почему бы и нет.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3A8.aac
text @[Sunohara]
text Оуууу... Почему ты продолжаешь бить меня, когда появляется шанс?!
text Он подпрыгивает, как будто ничего не случилось.
text @[Tomoya]
text Только накопилась обида от того, что я каждый день с тобой.
sound 3A9.aac
text @[Sunohara]
text Только я должен говорить об этом!
text @[Tomoya]
text Тогда успокойся. Просто вырастай уже, Сунохара.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3AA.aac
text @[Sunohara]
text Ух...
text @[Tomoya]
text Посмотри на Фуку. Она теперь спокойна, не так ли? Пьёт свой сок и всё.
sound 3AB.aac
text @[Sunohara]
text Конечно, единственная жертва здесь – Я!
sound 3AC.aac
text @[Sunohara]
text Чёрт... Вот почему я так ненавижу детей!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Принудительно подавляя гнев, Сунохара бросает задницу на стул.
text Спасибо, как обычно, за то, что ты так легко поддаёшься.
text @[Tomoya]
text Фух...
text Я глубоко вздохнул и снова сел.
label 110
setvar strS[1001] = "CGNG12Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG12Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3AD.aac
text @[{$lnmA}]
text Уже темно снаружи.
text {$lnmA} говорит, глядя в окно.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (В конце концов, что же мы сегодня сделали…)
music ~
text Не имея других планов, мы решаем закончить на сегодня.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s86
fi
goto 111
label s86
setvar strS[1000] = ""
label 111
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN1429_0_0.scr
