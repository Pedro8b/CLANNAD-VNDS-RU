		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Медленно расстояние между нами сокращается.
text @[Томоя]
text ...Рё.
setvar strS[1001] = "FGKY03A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
setimg FGKY03A.png
if intF[1113] == 1
