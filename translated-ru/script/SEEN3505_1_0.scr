	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AFM.aac
text @[Рё]
text Я хочу максимально использовать этот шанс, который дала мне сестра.
text @[Томоя]
text Да, это точно.
text @[Томоя]
text Я тоже... хочу как следует воспользоваться этим шансом, который она нам дала.
setvar strS[1001] = "CGRY19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY19.png
if intF[1113] == 1
	if strS[1000] < "C"
