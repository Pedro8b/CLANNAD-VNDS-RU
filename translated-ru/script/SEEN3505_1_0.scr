	fi
fi
sound AFN.aac
text @[Рё]
text А...
text @[Томоя]
text Кстати, может, будем звать друг друга по имени?
text Говорю я и кладу руки ей на плечи.
text Затем, едва заметно... совсем чуть-чуть, притягиваю её к себе.
setvar strS[1001] = "FGKY03C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
setimg FGKY03C.png
if intF[1113] == 1
