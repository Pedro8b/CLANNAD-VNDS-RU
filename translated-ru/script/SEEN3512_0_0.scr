text Мои губы слегка задрожали.
text Я слегка высовываю язык, задевая её зубы.
text Застигнув её врасплох, её плечи слегка дрогнули.
text Однако она не сопротивляется.
text Мой язык движется внутрь.
text ...И Рё делает то же самое.
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s21
fi
goto 22
label s21
setvar strS[1000] = ""
label 22
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text ─Кё...
text Её имя эхом звучит в моём сознании.
text Постепенно тепло исчезает.
setvar strS[1000] = "FGKY03A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s22
fi
goto 23
label s22
setvar strS[1000] = ""
label 23
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Я открываю глаза и вижу покрасневшую Рё, выглядящую смущённо... но также счастливой.
text Я отступаю на шаг назад и смотрю на её лицо.
text Несмотря ни на что, я уверен, что сейчас улыбаюсь.
text Однако это должна быть пустая фасада, которую я поднимаю, чтобы не заставлять Рё чувствовать дискомфорт.
setvar strS[1000] = "BG033N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 24
label s23
setvar strS[1000] = ""
label 24
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Рё слегка кланяется и начинает идти домой.
text Когда она всё дальше и дальше уходит, она постоянно оборачивается, чтобы посмотреть на меня.
text Пока она не исчезнет из поля моего зрения, я продолжаю махать ей в ответ.
text И когда я наконец остаюсь один...
text Я бью кулаком по ближайшей стене.
text @[Томоя]
text Я самый плохой...
text Острая боль, которую я ощущаю, остаётся не в кулаке, а в сердце.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 25
label s24
setvar strS[1000] = ""
label 25
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN3513_0_0.scr
