setvar strS[1001] = "CGKO11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 54Q.aac
text @[Коко]
text Я так и сделаю.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s62
fi
goto 64
label s62
setvar strS[1000] = ""
label 64
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
delay 120
setvar strS[1000] = "BG021B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s63
fi
goto 65
label s63
setvar strS[1000] = ""
label 65
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text Снова время перерыва.
text Как обычно, я уткнулся лицом в парту.
sound 54R.aac
text @[Мальчик А]
text Она ученица этой школы?
text Двое, сидящие передо мной, начинают разговаривать.
sound 54S.aac
text @[Мальчик Б]
text Угу.
sound 54T.aac
text @[Мальчик Б]
text Два года назад с ней случилась авария, и с тех пор она находится в коме.
sound 54U.aac
text @[Мальчик В]
text А, это. Я знаю эту историю.
text Ещё один ученик присоединяется к разговору.
sound 54V.aac
text @[Мальчик В]
text Насколько я слышал, она младшая сестра бывшего учителя нашей школы.
sound 54W.aac
text @[Мальчик А]
text Как зовут учителя?
sound 54X.aac
text @[Мальчик В]
text Ибуки.
sound 54Y.aac
text @[Мальчик В]
text Учительница искусства, я слышал.
sound 54Z.aac
text @[Мальчик А]
text Учительница?
sound 550.aac
text @[Мальчик В]
text Угу. Но она ушла три года назад, поэтому никто о ней не знает.
sound 551.aac
text @[Мальчик А]
text И...?
sound 552.aac
text @[Мальчик В]
text А что?
sound 553.aac
text @[Мальчик А]
text Я спрашиваю, если она горячая.
sound 554.aac
text @[Мальчик В]
text Я уже сказал, что никто не знает о ней!
sound 555.aac
text @[Мальчик В]
text Но слухи говорят, что она довольно красивая.
sound 556.aac
text @[Мальчик А]
text Так вот как это... Младшая сестра тоже должна быть красивой, и поэтому все в восторге от неё.
sound 557.aac
text @[Мальчик А]
text Феномен спящей красавицы.
sound 558.aac
text @[Мальчик Б]
text Ну, я слышал, что она более «милая», чем «горячая».
sound 559.aac
text @[Мальчик А]
text Кто сказал это?
sound 55A.aac
text @[Мальчик Б]
text Слух.
sound 55B.aac
text @[Мальчик А]
text Я не поверю ничему, пока не увижу её своими глазами.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s64
fi
goto 66
label s64
setvar strS[1000] = ""
label 66
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG021B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s65
fi
jump SEEN1518_1_1.scr 67
label s65
setvar strS[1000] = ""
jump SEEN1518_1_1.scr
