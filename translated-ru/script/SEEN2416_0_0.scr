setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 59V.aac
text @[Sunohara]
text Чью сторону ты занимаешь?!
text @[Томоя]
text Не твоя, это точно.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 59W.aac
text @[Сунохара]
text Ну, говори что хочешь. Я заставлю тебя переосмыслить свою позицию уже скоро... но только не влюбись в меня, ладно?
text Этот тип отвратительный.
sound 59X.aac
text @[Сунохара]
text Нападай на меня, когда захочешь.
setvar strS[1001] = "CGTM18H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 59Y.aac
text @[Томоё]
text Кстати, я бы хотел, чтобы это можно было назвать самообороной. Пожалуйста, атакуй меня.
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 59Z.aac
text @[Сунохара]
text Тебе лучше не жалеть об этих словах!
setvar strS[1001] = "CGTM18H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A0.aac
text @[Томоё]
text Да, не буду. Я уверена.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A1.aac
text @[Сунохара]
text Не задирай нос!
setvar strS[1001] = "CGSH17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH17.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A2.aac
text @[Сунохара]
setvar intA[1000] = 4140
setvar intA[1001] = 41
if 50 <= 40
	goto s3
fi
goto 4
label s3
setvar intA[1001] + 1
label 4
text DIEEEEEE─────!!!!!!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сунохара наносит удар ей после тех знаменитых последних слов.
text В тот самый момент я вспомнил.
text Я слышал слухи тут и там.
music ~
if 0 == 0
	goto s4
fi
goto 5
label s4
setvar strS[1000] = "KURO"
goto 7
label 5
if 0 == 1
	goto s5
fi
goto 6
label s5
setvar strS[1000] = "SIRO"
goto 7
label 6
setvar strS[1000] = "KURO"
label 7
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
music BGM01.mp3
text Когда-то в этом городе жила невероятно сильная девушка.
text Она бродила по городу ночью, подстерегая и охотясь на всех, кто беспокоил мирных жителей.
setvar intF[1112] = 0
setvar strS[1000] = "BG080N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s6
fi
goto 8
label s6
setvar strS[1000] = ""
label 8
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Освещённая лунным светом, она была абсолютно страшна...
text ...И абсолютно красива.
music ~
setvar intF[1112] = 1
setvar strS[1000] = "BG017"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s7
fi
goto 9
label s7
setvar strS[1000] = ""
label 9
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setimg CGSH30.png
sound 6.aac
text @*BAM* 
delay 0
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
bgload KURO.jpg 55
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text ...Это тот слух, который я слышал.
music BGM08A.mp3
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A3.aac
text @[Сунохара]
text Скажи мне это ДО того, как меня изобьют!!
setvar strS[1001] = "CGSH26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сунохара был избит до полусмерти.
text А поскольку занятия уже начались, Томойо тоже исчезла.
text @[Томоя]
text Даже если бы я тебе сказал, ты всё равно бы не остановился, верно?
sound 5A4.aac
text @[Сунохара]
text Ну, может быть, так и есть... Но всё равно!
sound 5A5.aac
text @[Сунохара]
text Чёрт, ты совсем ненадёжный друг...
text @[Томоя]
text Прости, но я не считаю нас друзьями!
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A6.aac
text @[Сунохара]
text Что?! Почему нет?!
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Ты же знаешь, что только что выглядел совсем жалко, верно? Сначала ты всё время болтаешь о том, что «на самом деле очень силён, несмотря на внешний вид»...
text @[Томоя]
text А потом, когда ты действительно вызываешь кого‑то на бой, тебя сразу же полностью разрывают? Чёрт, какой же это позорный способ проиграть.
text @[Томоя]
text Но даже так, насколько бы ты ни был жалким, я всё равно останусь твоим другом навсегда, так что не переживай!
sound 5A7.aac
text @[Сунохара]
text ...Ничего, если ты не считаешь меня своим другом.
text @[Томоя]
text Видишь?
sound 5A8.aac
text @[Сунохара]
text Чёрт... Почему всё так закончилось...
text @[Томоя]
text Потому что ты слаб.
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5A9.aac
text @[Сунохара]
text Неправда! Серьёзно, я на самом деле довольно силён физически.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Ага, вот почему, когда ты пошёл провоцировать драку, тебя сразу же полностью разорвали? Чёрт, какой же это позорный способ проиграть.
text @[Tomoya]
text But even so, no manner how pathetic you are, at the very least I alone will stay your friend forever, so don't worry!
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AA.aac
text @[Sunohara]
text Quit repeating that!
text @[Tomoya]
text But hadn't you heard those rumors too?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AB.aac
text @[Sunohara]
text Yeah, I had. But still, it's exactly that right? Just a rumor.
sound 5AC.aac
text @[Sunohara]
text I never believed such a monster actually existed.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AD.aac
text @[Sunohara]
text No, actually, I still don't believe it even now.
text @[Tomoya]
text So then, what? Do we conclude that you're far weaker than even the average girl?
sound 5AE.aac
text @[Sunohara]
text No, that's wrong. I was just rusty.
text @[Tomoya]
text Are you talking about your brain?
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AF.aac
text @[Sunohara]
text I'm talking about my skills!
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AG.aac
text @[Sunohara]
text It's because I tried to go all out so suddenly. And I hadn't yet recovered my old combat instincts, either.
text @[Tomoya]
text So... what do you plan on doing now?
setvar strS[1001] = "CGSH21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AH.aac
text @[Sunohara]
text Naturally, rezonge!
text @[Tomoya]
text You mean revenge?
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AI.aac
text @[Sunohara]
text Yeah, that. Revenge.
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5AJ.aac
text @[Sunohara]
text Okazaki... You tag along with me after school. I'll be off warming up my body until then.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text With that, he stands up and starts to walk away on unsteady feet.
text @[Tomoya]
text Don't you have anything better to do...
setvar intF[204] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2416_1_0.scr
