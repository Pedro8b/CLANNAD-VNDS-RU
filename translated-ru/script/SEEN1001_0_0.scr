choice Скучно; надо попробовать напоить её соком через нос|Продолжать ждать
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s0
fi
goto 1
label s0
setvar intF[108] = 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Давай посмотрим. Не уверен, будет ли интересно, но почему бы и нет?
text Я вставляю соломинку из полупустой упаковки сока в ноздрю Фуко.
text *Шлюрп*
setvar strS[1001] = "CGFU17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU17.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1LI.aac
text @[Фуко]
text Вах...
text Я приложила слишком много силы...
text Восстановив сознание, Фуко отшагивает назад.
sound 1LJ.aac
text @[Фуко]
text Нос... чувствует... странно!
setvar strS[1001] = "CGFU31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1LK.aac
text @[Фуко]
text *Пффф* *Пффф*
text Она отчаянно сморкает нос.
text Ну, однако ничего не выйдет.
text @[Томоя]
text Ты просто воображаешь. Не волнуйся.
text Похоже, я могу делать всё, что захочу, когда она в таком состоянии.
text Что-то, чего можно ждать в следующий раз.
setvar intF[100] = 1
goto 2
label 1
if intF[1089] == 1
	goto s1
fi
goto 2
label s1
text .....
text Я продолжаю ждать.
text @[Томоя]
text Эй, ты!
sound 1LL.aac
text @[Фуко]
text ...
text @[Томоя]
text Вернись уже сюда!
sound 1LM.aac
text @[Фуко]
text ...
text @[Томоя]
text Оооой!
sound 1LN.aac
text @[Фуко]
text ...
text @[Томоя]
text Я оставлю тебя здесь!
sound 1LO.aac
text @[Фуко]
text ...
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1LP.aac
text @[Фуко]
text На самом деле, это могло бы быть намного милее, но пока это всё, что у нас есть.
text @[Томоя]
text Не поднимай эту тему только сейчас, спустя столько времени!
setvar strS[1001] = "CGFU15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1LQ.aac
text @[Фуко]
text Да?
text По‑видимому, она даже не осознаёт, что мечтает.
text Это значит, что я могу сделать с ней всё, что захочу, когда она в таком состоянии.
text Если она снова будет мечтать передо мной, я заставлю её пережить то, чего она никогда не забудет.
setvar intF[102] = 1
label 2
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
