setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L11.aac
text @[Сунохара]
text Просто доверь это мне!
text Обменявшись парой слов, мы с Сунохарой расходимся.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я поднимаюсь по маленькой лестнице из гримёрки и направляюсь к краю сцены.
text Там я нахожу Нагису, уже в костюме.
text @[Томоя]
text Нагиса!
text Я окликаю её.
text Когда она оборачивается посмотреть на меня, я показываю ей большой палец вверх.
text Нагиса кивает мне в ответ, без всякого выражения на лице.
text Затем она снова поворачивается вперёд.
text Толпа аплодирует.
text Наша очередь.
text Нагиса выходит из-за кулис в центр сцены.
text Самодельный костюм от Санаэ-сан различим даже издалека.
text Зал оживает при появлении девушки.
text В воздухе также раздаются пронзительные возгласы.
text Я даже слышу, как позади меня организаторы фестиваля спрашивают друг друга, в каком классе учится та симпатичная девушка, которую они видят.
text Я чувствую гордость.
text Нагиса кланяется.
music ~
if 0 == 0
	goto s34
fi
goto 44
label s34
setvar strS[1000] = "KURO"
goto 46
label 44
if 0 == 1
	goto s35
fi
goto 45
label s35
setvar strS[1000] = "SIRO"
goto 46
label 45
setvar strS[1000] = "KURO"
label 46
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Вместе с этим свет гаснет.
setvar strS[1000] = "FGNG07A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s36
fi
goto 47
label s36
setvar strS[1000] = ""
label 47
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text Теперь освещена лишь одна девушка, будто парящая на сцене.
text Она стоит абсолютно неподвижно.
text ......
text ......
text ......
music BGM18B.mp3
text Она долго хранит молчание.
text Сперва зрители думают, что это часть спектакля, но тишина затягивается настолько, что они начинают чувствовать: что-то не так.
text В конце концов это перерастает в волнение, которое расходится по всему залу.
text @[Томоя]
text ...
text Я не могу оторвать взгляд от девушки, окружённой светом.
text Пожалуйста, Нагиса... играй.
text Я начинаю молиться.
text ──"Это правда моя вина, что они отказались от своих мечт".
text ──"И теперь..."
text ──"Я пытаюсь осуществить свою собственную мечту... ценой их мечты..."
text Мне кажется, я вижу, как губы Нагисы чуть заметно шевелятся.
text @　
setvar intA[1000] = 2645
setvar intA[1001] = 26
if 50 <= 45
	goto s37
fi
goto 48
label s37
setvar intA[1001] + 1
label 48
text ...Я не могу это сделать.
text И вот что я вижу, как она говорит.
setvar strS[1000] = "BG029C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s38
fi
goto 49
label s38
setvar strS[1000] = ""
label 49
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text А потом... она начинает плакать.
text Слёзы, которые она так долго сдерживала, наконец начинают течь по её щекам.
text Она плачет, как ребёнок, всхлипывая.
text Я никогда не видел её в такой боли.
text Она живёт своей собственной жизнью ценой чужих мечт.
text Боль, которую она испытывает, исходит от того, что она не знает, как реагировать, столкнувшись с такой правдой.
text Ей больно, потому что она потеряла всё, что когда-то её поддерживало.
if 0 == 0
	goto s39
fi
goto 50
label s39
setvar strS[1000] = "KURO"
jump SEEN6511_0_1.scr 52
label 50
if 0 == 1
	goto s40
fi
goto 51
label s40
setvar strS[1000] = "SIRO"
jump SEEN6511_0_1.scr 52
label 51
setvar strS[1000] = "KURO"
jump SEEN6511_0_1.scr
