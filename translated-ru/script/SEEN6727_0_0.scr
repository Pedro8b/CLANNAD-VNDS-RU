text @[Нагиса]
text Если можно. Тогда я займусь упаковкой хлеба.
text @[Томоя]
text Да, спасибо.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Позже становится настолько людно, что у меня даже нет времени поговорить с Нагисой.
text Всё, что я делаю — спрашиваю у Нагисы цену, ввожу её и отдаю сдачу.
text Этот процесс повторяется снова и снова.
