fi
sound JV3.aac
text @[Нагиса]
text И так много всего изменилось...
sound JV4.aac
text @[Нагиса]
text Нигде в школе не оставалось места, где я могла бы улыбаться...
sound JV5.aac
text @[Нагиса]
text ...вот что я чувствовала.
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound JV6.aac
text @[Нагиса]
text Но теперь я улыбаюсь.
setvar strS[1001] = "CGNG22A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG22A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound JV7.aac
text @[Нагиса]
text Рядом с тобой, Томоя-кун.
sound JV8.aac
text @[Нагиса]
text Хотя иногда я всё ещё плачу... эхехе...
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound JV9.aac
text @[Нагиса]
text Но прямо сейчас мне так весело.
sound JVA.aac
text @[Нагиса]
text Именно как ты и говорил, Томоя-кун: я открыла для себя так много интересного.
text @[Томоя]
text Ох...
text @[Томоя]
text Рад это слышать.
sound JVB.aac
text @[Нагиса]
text Да. Всё это благодаря тебе, Томоя-кун.
text @[Томоя]
text Ну...
text @[Томоя]
text Знаешь, я чувствую то же самое.
text @[Томоя]
text Я способен идти вперёд только благодаря тебе.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text В тот день, когда я встретил Нагису, встревоженную и напуганную...
text ...и мы вдвоём начали подниматься на холм вместе.
setvar strS[1001] = "CGNG10AZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10AZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound JVC.aac
text @[Нагиса]
text Я всё ещё не уверена во многих вещах.
sound JVD.aac
text @[Нагиса]
text Но пока я рядом с тобой, Томоя-кун...
sound JVE.aac
text @[Нагиса]
text ...мне кажется, что я могу продолжать стараться.
setvar strS[1001] = "CGNG22AZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG22AZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Хотя нам ещё далеко идти...
text Мне кажется, мы можем сделать что угодно, если я с ней.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s108
fi
goto 113
label s108
setvar strS[1000] = ""
label 113
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6501_0_0.scr
