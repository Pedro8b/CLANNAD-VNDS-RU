text Мы отбрасываем длинные тени, идя рядом друг с другом.
setvar strS[1001] = "CGNG31B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG31B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3M.aac
text @[Нагиса]
text Сейчас я по-настоящему счастлива.
sound L3N.aac
text @[Нагиса]
text Настолько, что хочется поделиться этим счастьем со всеми вокруг...
sound L3O.aac
text @[Нагиса]
text Но у меня такое чувство, будто я этого не заслуживаю...
sound L3P.aac
text @[Нагиса]
text Было бы такой роскошью для меня — быть способной на что-то подобное...
text @[Томоя]
text Если уж на то пошло, я в таком же положении.
text @[Томоя]
text У меня такая девушка, как ты...
text @[Томоя]
text ...Разве это не огромная привилегия?
text Ах, не могу поверить, что говорю такие смущающие вещи.
setvar strS[1001] = "CGNG32B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3Q.aac
text @[Нагиса]
text Правда?
text @[Томоя]
text Ага.
text Сколько времени прошло с тех пор, как мы начали встречаться?
text Я влюблён в Нагису даже сильнее, чем когда мы только стали парой.
setvar strS[1001] = "CGNG10BZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10BZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3R.aac
text @[Нагиса]
text Если мы оба чувствуем, что нам повезло быть вместе...
sound L3S.aac
text @[Нагиса]
text Тогда мы очень счастливая пара.
text Пара... Уже от одного того, что она способна произнести это слово вслух, я улыбаюсь.
text И эту её черту я тоже люблю.
setvar strS[1001] = "CGNG22B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG22B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3T.aac
text @[Нагиса]
text Мы идеально подходим друг другу.
sound L3U.aac
text @[Нагиса]
text ...Хе-хе.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы естественным образом берёмся за руки.
text @[Томоя]
text ...
text Её рука ужасно горячая.
text @[Томоя]
text Нагиса...?
text Я смотрю на её лицо.
setvar strS[1001] = "CGNG31B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG31B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3V.aac
text @[Нагиса]
text Да...? Что такое?
text Её лицо кажется красным. Может, это из-за солнца?
text Я осторожно прикладываю ладонь к её лбу.
text ...Горячий.
text @[Томоя]
text Нагиса... кажется, у тебя температура.
sound L3W.aac
text @[Нагиса]
text Нет, я в порядке.
text Неужели она притворялась всё это время, чтобы я не заметил?
text @[Томоя]
text И давно ты в таком жару...?
sound L3X.aac
text @[Нагиса]
text Я совершенно в порядке...
text @[Томоя]
text Не ври мне.
setvar strS[1001] = "CGNG32B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L3Y.aac
text @[Нагиса]
text Прости...
sound L3Z.aac
text @[Нагиса]
text На самом деле мне стало нехорошо ещё когда мы уходили из школы.
text @[Томоя]
text Тебе нужно говорить мне о таком раньше, глупышка...
sound L40.aac
text @[Нагиса]
text Прости...
text @[Томоя]
text Всё в порядке, хватит извиняться...
text @[Томоя]
text Давай просто пойдём домой.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text Я обхватываю руку Нагисы своей, и мы отправляемся в путь.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 19
label s15
setvar strS[1000] = ""
label 19
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG006N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 20
label s16
setvar strS[1000] = ""
label 20
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text @[Томоя]
text С ней всё будет в порядке, Санаэ-сан?
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L41.aac
text @[Санаэ]
text С ней всё будет хорошо. Пожалуйста, успокойся.
text @[Томоя]
text Простите... наверное, я заставил её слишком много бегать сегодня.
setvar strS[1001] = "CGSN11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L42.aac
text @[Санаэ]
text Не нужно извиняться. Разве она не твоя девушка?
text @[Томоя]
text Вы... знали об этом?
sound L43.aac
text @[Санаэ]
text Разве это не очевидно? В конце концов, она моя дочь.
text @[Томоя]
text Я никчёмный парень.
sound L44.aac
text @[Санаэ]
text Это неправда.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L45.aac
text @[Санаэ]
text Оказаки-сан.
text @[Томоя]
text Да?
sound L46.aac
text @[Санаэ]
text Можно я буду называть тебя Томоя-сан?
text Она всё больше становится похожа на Нагису. Хотя Нагиса обращается ко мне на "кун".
text @[Томоя]
text Да, пожалуйста.
sound L47.aac
text @[Санаэ]
text Тогда, Томоя-сан.
text @[Томоя]
text Да?
sound L48.aac
text @[Санаэ]
text Нагиса всегда была физически слабым ребёнком... но, пожалуйста, будь рядом с ней как можно дольше. Это всё, о чём я прошу.
text @[Томоя]
text Это мне следовало бы сказать вам это. Я до сих пор не понимаю, как я могу нравиться такому, как я, человеку...
setvar strS[1001] = "CGSN11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L49.aac
text @[Санаэ]
text Что за глупости. Хватит сомневаться в себе. К тому же, у тебя есть вся моя поддержка.
text @[Томоя]
text Я рад это слышать.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4A.aac
text @[Санаэ]
text Ты, наверное, тоже устал, Томоя-сан. Пожалуйста, оставь Нагису мне и отдохни немного.
text @[Томоя]
text Мне стыдно. Я ведь весь день просто развлекался.
sound L4B.aac
text @[Санаэ]
text Не говори так.
text @[Томоя]
text Ну, раз вы настаиваете, тогда спасибо.
setvar strS[1001] = "CGSN11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4C.aac
text @[Санаэ]
text Хорошо!
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 21
