setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10B.mp3
sound 5XX.aac
text @[Сунохара]
text Ну, как угодно. Если она захочет пойти с нами, то просто воспользуемся ею.
text Сунохара ставит на себя Злое Лицо.
sound 5XY.aac
text @[Сунохара]
text Если подумать, её боятся все бандиты, она самая сильная девушка в истории.
sound 5XZ.aac
text @[Сунохара]
text А эта девушка в наших руках. Она будет весьма полезна...
text @[Томоя]
text Да, она может пришить тебе одежду, когда она станет изношенной.
sound 5Y0.aac
text @[Сунохара]
text Верно... Самая сильная девочка, пришивающая мою одежду... Это будут... самые сильные вещи...
sound 5Y1.aac
text @[Сунохара]
text У них будет... самое сильное ощущение...
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y2.aac
text @[Сунохара]
text Как будто! Кто бы ни пришил их обратно, они всё равно будут обычной одеждой!
text @[Томоя]
text Почему ты так одержим этой «самой сильной» темой?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y3.aac
text @[Сунохара]
text Я имею в виду, мы говорим о самом сильном, понимаешь? Мы не можем просто оставить этот шанс пустым...
text @[Томоя]
text О, да, она действительно сказала, что может готовить обеды в коробках.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y4.aac
text @[Сунохара]
text Хех... Это будет идеально... Пусть она приготовит обед.
sound 5Y5.aac
text @[Сунохара]
text Верно, обед, приготовленный самой сильной девочкой... Это будет... самый сильный обед...
sound 5Y6.aac
text @[Сунохара]
text Он обязательно будет иметь... самый сильный вкус...
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y7.aac
text @[Сунохара]
text Как будто!! Кто бы ни приготовил, это всё равно будет обычный обед!
text @[Томоя]
text Возможно, он действительно вкусный, понимаешь?
sound 5Y8.aac
text @[Сунохара]
text Тем не менее! Это было бы просто пустой тратой использовать её так!
text @[Томоя]
text Однако я думаю, что так она будет менее напрасной.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y9.aac
text @[Сунохара]
text Просто не волнуйся и оставь всё мне. Я точно покажу тебе что-нибудь весёлое.
setvar strS[1000] = "BG021A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 13
label s12
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Через короткое время, когда занятия уже начались...
sound 5YA.aac
text @[Сунохара]
text Хехехе...
text Интересно, что он задумал, ведь я слышу, как он издаёт зловещий смех.
sound 5YB.aac
text @[Сунохара]
text Хехе... хахаха...
sound 5YC.aac
text @[Сунохара]
text ФВААХАХАХАХ!
sound 5YD.aac
text @[Учитель]
text Эй, ты! Замолчи, если не хочешь, чтобы я тебя выбрал.
sound 5YE.aac
text @[Сунохара]
text Ах, простите.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2422_2_0.scr
