		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MXJ.aac
text @[Ёсино]
text Я уже привык к тому, что ты лажаешь.
text Хотя слова Ёсино-сана — правда, ситуация меня всё равно не устраивает.
text @[Томоя]
text Н-но вы же даже потратили свой выходной...
setvar strS[1001] = "CGYS12"
setvar intF[1113] = intF[1112]
