setimg CGYS13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MXE.aac
text @[Ёсино]
text Если делаешь всё, что в твоих силах, всегда найдутся люди, которые это оценят.
sound MXF.aac
text @[Ёсино]
text Это одна из вещей, которые мне нравятся в этой работе.
setvar strS[1001] = "CGYS12"
setvar intF[1113] = intF[1112]
