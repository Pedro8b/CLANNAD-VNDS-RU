setvar intF[1110] = 0
setvar intF[1112] = 0
setvar strS[1004] = "SDTA4999"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1004] = ""
label 1
delay 120
music BGM15.mp3
setvar strS[1000] = "BG023"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Обычный будний день в школе.
text Я лежу боком в пустом классе.
text За этим пустым пространством — пустое небо.
text @[Томоя]
text В конце концов, я всё время возвращаюсь сюда…
text Даже мои шепоты пусты и лишены смысла.
text Когда же изменится моя жизнь?
text Настанет ли день, когда она изменится?
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я закрываю глаза.
text Однажды моя жизнь изменится.
text Сейчас время — мой единственный союзник.
delay 30
music ~
delay 300
delay 120
cleartext
jump main.scr
