setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O3M.aac
text @[Нагиса]
text Это папа.
text @[Томоя]
text Старик?
sound O3N.aac
text @[Нагиса]
text Да.
text Старик звонит мне? Это необычно.
text Не припомню, чтобы такое случалось раньше.
text Может, что-то случилось с Нагисой...?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Взволнованный, я беру трубку.
text @[Томоя]
text Алло?
sound O3O.aac
text @[Акио]
text «Эй, никак это мой бестолковый сынок».
text @[Томоя]
text Да, что такое?
sound O3P.aac
text @[Акио]
text «Нагиса сегодня начала работать, верно?»
text @[Томоя]
text Да, и что?
sound O3Q.aac
text @[Акио]
text «Ну, вообще-то... До меня дошёл один слух насчёт неё».
music ~
text ...Слух.
text Мне это не нравится.
text @[Томоя]
text Какой слух...?
music BGM08A.mp3
sound O3R.aac
text @[Акио]
text «Что она просто прелесть в этой форме семейного ресторана!»
text *БУХ*
text Я падаю перед телефоном.
sound O3S.aac
text @[Акио]
text «Каждый, кто заходит в магазин, мне об этом говорит».
sound O3T.aac
text @[Акио]
text «Тебе разве не любопытно?»
text @[Томоя]
text Почему бы вам самому не пойти и не посмотреть на неё?
sound O3U.aac
text @[Акио]
text «Думаешь, я способен на такую позорную вещь, идиот?!»
text @[Томоя]
text Просто сделайте это.
sound O3V.aac
text @[Акио]
text «В общем, пришли мне пару фотографий».
text @[Томоя]
text Кто их вообще будет делать...?
sound O3W.aac
text @[Акио]
text «Ты».
text @[Томоя]
text Как будто у меня есть на это время.
sound O3X.aac
text @[Акио]
text «Просто возьми выходной».
text @[Томоя]
text Меня уволят, если я так сделаю.
sound O3Y.aac
text @[Акио]
text «Ох, извини».
text @[Томоя]
text То есть вы хотите, чтобы меня уволили?!
sound O3Z.aac
text @[Акио]
text «Ладно, мой послушный сынок. Рассчитываю на тебя».
text *Щёлк* *Бииип-бииип*
text ...Он повесил трубку.
setvar strS[1001] = "CGNG13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O40.aac
text @[Нагиса]
text Что-то случилось?
sound O41.aac
text @[Нагиса]
text Мой отец опять просит о чём-то нереальном?
text @[Томоя]
text Вот же идиот этот тип.
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O42.aac
text @[Нагиса]
text Я и правда думаю, что он бывает ребячливым.
text @[Томоя]
text (Он сейчас был не «ребячливым», он был похотливым стариком.)
sound O43.aac
text @[Нагиса]
text Что он сказал?
sound O44.aac
text @[Нагиса]
text Я могу тебе помочь.
setvar strS[1001] = "CGNG23A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O45.aac
text @[Нагиса]
text Что мне делать?
text @[Томоя]
text Не переживай, можем просто проигнорировать это. Слишком глупо, чтобы воспринимать всерьёз...
setvar strS[1001] = "CGNG13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound O46.aac
text @[Нагиса]
text Правда? Спрошу его в следующий раз.
text @[Томоя]
text Не смей.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s709
fi
goto 850
label s709
setvar strS[1000] = ""
label 850
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6800_6_0.scr
