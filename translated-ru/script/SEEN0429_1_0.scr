text Huh?
text Furukawa stands dumbfounded between first and second base.
sound 1HG.aac
text @[Umpire]
text Yer out!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
