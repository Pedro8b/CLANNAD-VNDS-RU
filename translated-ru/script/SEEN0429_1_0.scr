text текст Она берёт биту и выходит в бокс бэттера.
text текст Первый бросок — кривая, падающая в сторону и внутрь, удивляет Санаэ‑сан, и она отстраняется.
text текст Следующий мяч — быстрая подача, наружная и низкая. Она быстро оказывается отстающей в счёте 0‑2.
text текст @[Томоя]
text текст (Этот парень безжалостен...)
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1E4.aac
text текст @[Санаэ]
text текст Я могу это сделать!
text текст Она подбадривает себя. Это... мило.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text текст Питчер, возможно, испытал ту же реакцию, когда его третий слайдер ускользнул и полетел прямо по центру.
text текст *КЛЭНК*
text текст Она ударила по мячу. Шар плывёт в неглубокую правую часть поля.
text текст При активной игре аутфилда правый полевой игрок успевает поймать мяч после одного отскока и отправить его прямиком домой.
text текст Томойо проходит третью базу.
setvar strS[1001] = "CGAK19A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1E5.aac
text текст @[Акио]
text текст Она берётся за это...
sound 1E6.aac
text текст @[Акио]
text Я не совсем уверен в этом.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
