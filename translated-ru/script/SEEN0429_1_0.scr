		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1DX.aac
text @[Акио]
text Эх. Она, наверное, хочет сказать, что для этого удара ей пришлось использовать технику.
text текст @[Томоя]
text текст Есть ли в этом что‑то особенно женственное?
