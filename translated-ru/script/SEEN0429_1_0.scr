setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1DS.aac
text @[Томойо]
text Да. Я постараюсь выложиться полностью в этот раз.
sound 1DT.aac
text @[Томойо]
text Я получаю такой удар, какой должна получать девушка.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она поднимает биту и уходит.
setvar strS[1001] = "CGAK18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1DU.aac
text @[Акио]
text Подожди, ты же знаешь, я имел в виду не это!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она не реагирует на него, спокойно направляясь к бэттерской коробке.
text Она наблюдает, как первый бросок — кривая — проходит мимо, будучи объявленным страйком.
text Второй бросок — ещё один разрывной мяч. Это слайдер, отклоняющийся от неё.
text Она набрасывается на удар со всей своей силой, стремясь к контакту.
setvar strS[1001] = "CGAK11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1DV.aac
text @[Акио]
text Это мяч!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *CLANK*
text Низкий лайн‑драйв пролетает над головой игрока второй базы.
text Он продолжает лететь, пока не падает в правый центр поля.
text Она получает двойной ход, такой же результат, как в первой атаке миссаэ-сан.
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1DW.aac
text @[Томойо]
text Ладно.
text Она достигает второй базы с удовлетворённым видом.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text В чём, по её мнению, разница между этим ударом и хоум‑раном?
