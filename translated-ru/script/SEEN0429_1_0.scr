	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1H8.aac
text @[Sunohara]
text Agh, she's going to hog all the glory for herself...
sound 1H9.aac
text @[Sunohara]
text And I'm not going to get another chance to bat...
text @[Tomoya]
text Just be quiet.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text The pitcher throws a fastball with all his might.
text Tomoyo's bat howls through the air.
text *CLAAAAAANG*
text Everyone looks up to the sky.
text The ball really does fly into the mountains.
sound 1HA.aac
text @[Umpire]
text Foul baaalll!
text Our momentary shouts of joy soon turn into sighs.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1HB.aac
text @[Sunohara]
text Phew, that was close...
text @[Tomoya]
text Whose side are you rooting for...?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text The second pitch is a mild curveball. She mistimes her swing for a strike.
sound 1HC.aac
text @[Tomoyo]
text ...
text Despite being behind in the count, her expression stays the exact same. She just keeps waiting for the next ball.
text The pitcher throws his third pitch.
text A low fastball... no, it dropped!
text She still goes for it. The ball hits her bat right in the center of its sweet spot.
text *CLANK*
text A low line drive to center field...
text No, it doesn't make it there. The second baseman leaps to the side to catch it. It's a splendid play.
setvar strS[1001] = "CGAK18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1HD.aac
text @[Akio]
text Crap! Go back!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Second base is right in front of him, and he steps on it.
sound 1HE.aac
text @[Umpire]
text Yer out!
text He then swings his body to the side and throws the ball to first.
music ~
text *SMACK*
setvar strS[1001] = "CGNG14Z"
