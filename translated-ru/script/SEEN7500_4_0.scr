delay 120
music BGM17A.mp3
setvar strS[1000] = "BG043A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s180
fi
goto 202
label s180
setvar strS[1000] = ""
label 202
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text .........
text Сквозь шторы в комнату льётся утренний свет.
text @[Томоя]
text (О... похоже, я вчера здесь заснул...)
text Голова тяжёлая...
text Рядом со мной сидит Мисаэ-сан, положив голову мне на плечо.
sound UQH.aac
text @[Мисаэ]
text ...Ммм...
text Её губы слегка дрожат.
sound UQI.aac
text @[Мисаэ]
text ...Сима-кун...
sound UQJ.aac
text @[Мисаэ]
text ...Почему ты ушёл...
text Слыша её слова во сне, я вспоминаю.
text Я вспоминаю настоящее имя кота, что спит у меня на руках.
text @[Томоя]
text Значит, у тебя было настоящее имя, да...
text @[Томоя]
text Слушай... это ведь ты только что показал мне тот сон, да...?
text @[Томоя]
text Ты, наверное, хотел, чтобы я сказал ей... правда...?
text @[Томоя]
text Сказать этой женщине, что будет ждать тебя вечно...
text @[Томоя]
text Что ты всегда будешь рядом с ней... навсегда...
jump SEEN7500_5_0.scr
