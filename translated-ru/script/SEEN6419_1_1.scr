	fi
fi
text ......
text А потом...
setvar strS[1001] = "CGBT13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGBT13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZO.aac
text @[Ботан]
text Хрю...
text @[Томоя]
text (И что, мне теперь возвращать эту штуку хозяину...?)
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я хватаю его и поднимаю.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6419_2_0.scr
