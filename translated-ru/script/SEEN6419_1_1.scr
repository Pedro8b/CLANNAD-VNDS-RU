text Я вижу силуэт кого-то, спешащего ко мне, без зонта.
music BGM02A.mp3
setvar strS[1001] = "CGNG25Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ0.aac
text @[Фурукава]
text Я наконец нашла его. С ним всё в порядке.
setvar strS[1001] = "CGNG33"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ1.aac
text @[Фурукава]
text Ах... как холодно.
text Фурукава возвращается, прижимая к груди какое-то животное.
sound GZ2.aac
text @[Фурукава]
text Это его ты искал?
text Глядя на то, что она держит...
text @[Томоя]
text Это же...
setvar strS[1001] = "CGBT13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGBT13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Не то...
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ3.aac
text @[Фурукава]
text Что?..
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ4.aac
text @[Фурукава]
text Ах, Оказаки-сан!
text Похоже, она наконец поняла, что её ждал я, а не тот мальчик.
sound GZ5.aac
text @[Фурукава]
text Тут был маленький ребёнок?
text @[Томоя]
text Был. Я отправил его домой, потому что становилось поздно.
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ6.aac
text @[Фурукава]
text Тогда мне нужно отдать это ему. Он же волнуется.
text @[Томоя]
text Он нашёл свою собаку. Пошёл домой со спокойной душой.
setvar strS[1001] = "CGNG14Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG14Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ7.aac
text @[Фурукава]
text Что? Тогда чьё же это?
text @[Томоя]
text Ты сняла эти слова прямо у меня с языка.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ8.aac
text @[Фурукава]
text Но он дрожал под ограждением.
text @[Томоя]
text Ну, это точно не собака...
sound GZ9.aac
text @[Фурукава]
text ...
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZA.aac
text @[Фурукава]
text В-вот оно как...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она сгибается вперёд, упираясь руками в колени. И ещё крепче прижимает дикого поросёнка к себе.
sound GZB.aac
text @[Фурукава]
text ...Какая же я дурочка.
text Она заходится кашлем.
text @[Томоя]
text Ты в порядке?
sound GZC.aac
text @[Фурукава]
text Да... я... в порядке...
text Она опускается на колени.
text @[Томоя]
text ...
text @[Томоя]
text Ты и правда дурочка...
text @[Томоя]
text Идём.
text Я поднимаю её, взяв за плечи.
sound ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s66
fi
goto 69
label s66
setvar strS[1000] = ""
label 69
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG007R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s67
fi
goto 70
label s67
setvar strS[1000] = ""
label 70
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Эй, есть кто дома?
text ......
text В доме Фурукавы никого нет.
text @[Томоя]
text (Чем там вообще занят её отец? Даже магазин бросил без присмотра...)
setvar strS[1000] = "BG006"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s68
fi
goto 71
label s68
setvar strS[1000] = ""
label 71
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я решаю войти, чтобы уложить Фурукаву спать.
text @[Томоя]
text (На самом деле, если она сразу же ляжет спать в таком виде, точно простудится...)
text Она вся насквозь промокла. Одежда наверняка мокрая до самого белья.
text Но не могу же я сам переодеть её.
sound GZD.aac
text @[Санаэ]
text Мы вернулись!
text Тут я слышу голос Санаэ-сан. Спасён.
setvar strS[1001] = "CGSN19E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN19E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZE.aac
text @[Санаэ]
text Оказаки-сан!
text @[Томоя]
text Я нашёл её. Она вся промокла, пожалуйста, переоденьте её.
setvar strS[1001] = "CGSN21E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN21E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZF.aac
text @[Санаэ]
text Хорошо, поняла.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я оставляю всё остальное на неё и начинаю уходить.
text Оставаться дольше было бы неприлично.
setvar strS[1000] = "BG007R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s69
fi
goto 72
label s69
setvar strS[1000] = ""
label 72
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я спускаюсь из коридора к прихожей.
setvar strS[1001] = "CGAK14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZG.aac
text @[Акио]
text Добро пожаловать! А, это всего лишь ты.
text Там стоит отец Фурукавы.
setvar strS[1001] = "CGAK19E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZH.aac
text @[Акио]
text И стой, ты же спускаешься из коридора, конечно, ты не покупатель... Бог, ну и дурак же я.
setvar strS[1001] = "CGAK13E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZI.aac
text @[Акио]
text Проваливай отсюда. Не хочу больше держать магазин открытым сегодня.
text С его чёлки всё ещё капает вода, пока он на меня кричит.
text Сигарета у него во рту тоже потухла.
setvar strS[1001] = "CGAK11E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZJ.aac
text @[Акио]
text Аргх! Опять столько дурацких остатков.
setvar strS[1001] = "CGAK14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZK.aac
text @[Акио]
text Хочешь забрать их домой, малец?
text @[Томоя]
text Не хочу, старик.
text Я специально делаю акцент на «старик» — в отместку за его «мальца».
setvar strS[1001] = "CGAK19E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK19E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZL.aac
text @[Акио]
text Хмф. Ты и правда нелюдимый тип, знаешь? Ладно, проваливай!
text @[Томоя]
text Ага.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я беру зонт у входа и выхожу под навес.
sound GZM.aac
text @[Акио]
text Эй, малец.
text Наверное, собирается отпустить ещё одну странную угрозу на прощание. Я его игнорирую.
text @[Акио]
text ...
music ~
if 0 == 0
	goto s70
fi
goto 73
label s70
setvar strS[1000] = "KURO"
goto 75
label 73
if 0 == 1
	goto s71
fi
goto 74
label s71
setvar strS[1000] = "SIRO"
goto 75
label 74
setvar strS[1000] = "KURO"
label 75
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Сквозь шум дождя мне будто бы слышатся последние слова благодарности.
setvar strS[1000] = "BG001R"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s72
fi
goto 76
label s72
setvar strS[1000] = ""
label 76
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
