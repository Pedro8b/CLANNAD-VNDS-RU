setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN21E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5C.aac
text @[Санаэ]
text Ты же знала, да, Нагиса?
sound R5D.aac
text @[Нагиса]
text Э... что именно вы имеете в виду?
sound R5E.aac
text @[Санаэ]
text Что Акио-сан, возможно, в этом автобусе.
setvar strS[1001] = "CGNG32A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5F.aac
text @[Нагиса]
text ...
text @[Томоя]
text Старик и правда там...?
text Спрашиваю я вместо Нагисы.
setvar strS[1001] = "CGSN21E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN21E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5G.aac
text @[Санаэ]
text Ну, тот телефонный звонок только что был от того, кто провожал Акио-сана.
sound R5H.aac
text @[Санаэ]
text И он сказал мне, что, возможно, это тот самый автобус, на который он сел.
text @[Томоя]
text Понятно...
setvar strS[1001] = "CGNG32A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5I.aac
text @[Нагиса]
text ...
text @[Томоя]
text Эм, на самом деле...
text @[Томоя]
text Нагиса слишком сильно переживала, так что смотрела это одна, чтобы вы не волновались.
setvar strS[1001] = "CGSN15E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN15E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5J.aac
text @[Санаэ]
text Понятно.
setvar strS[1001] = "CGSN11E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5K.aac
text @[Санаэ]
text Спасибо тебе, Нагиса.
sound R5L.aac
text @[Нагиса]
text Нет...
setvar strS[1001] = "CGSN10E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound R5M.aac
text @[Санаэ]
text И тебе тоже, Томоя-сан.
text @[Томоя]
text Я ничего не сделал.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s66
fi
goto 80
label s66
setvar strS[1000] = ""
label 80
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG002N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s67
fi
goto 81
label s67
setvar strS[1000] = ""
label 81
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Вместе мы продолжаем смотреть на изображения, передаваемые с вертолёта.
text Новая информация продолжает поступать одна за другой от людей, высадившихся из автобуса.
text О том, что преступник — молодой мужчина, действующий в одиночку.
text О том, как он угрожал водителю ножом, чтобы заставить того вести автобус.
text И о том, как одного мужчину порезали этим ножом, и он получил ранение.
text По всей видимости, его порезали за то, что он настойчиво пытался уговорить преступника сдаться.
text ...это Акио-сан.
text Все в комнате думают об одном и том же.
text Не может быть, чтобы этот человек просто стоял и молчал в такой ситуации.
text Его чувство справедливости обернулось против него.
text По всей видимости, преступник также отказался пускать в автобус медсестёр, чтобы его подлечить.
text Но насколько серьёзна рана?
text Если его просто полоснули, чтобы напугать, наверное, всё будет нормально.
text Но если его серьёзно ранили, и он продолжает терять кровь, не имея возможности её остановить...
text ...тогда это лишь вопрос времени, прежде чем...
text Аах, в голову приходят только плохие мысли.
text Наверное, у Санаэ-сан то же самое.
text Она пристально смотрит в телевизор, сжав руки, будто в молитве.
text Автобус снова останавливается на зоне отдыха, чтобы высадить пассажиров.
text Изображение настолько маленькое, что я не могу толком разглядеть, что происходит.
text Выходит довольно много людей.
text На этот раз среди них есть и молодые мужчины.
text А знакомого лица старика...
text ...с сигаретой во рту, всегда выглядящего так, будто вот-вот на что-то пожалуется...
text ...там нет.
text Дверь закрывается.
text Автобус снова трогается.
text После этого повторяется то же самое.
text Если бы он вышел из автобуса только что, нам бы сразу же позвонили и сказали, что он в безопасности.
text Однако... звонка не поступило.
text И снова мы получаем новую информацию от высадившихся людей.
text Единственные, кто остался внутри автобуса на данный момент — это водитель, преступник и раненый мужчина.
text И когда этого мужчину порезали во время попытки уговорить преступника, удар пришёлся в живот.
text И он даже не увернулся. После того как его ударили ножом, он просто продолжал уговаривать преступника с улыбкой, пока пот стекал по его лбу.
text @[Томоя]
text (Ах... точь-в-точь то, что мог бы сделать старик...)
text Благодаря уговорам этого мужчины ему удалось добиться того, чтобы высадили всех пассажиров.
text В обмен на это он остался внутри вместе с водителем автобуса.
text Несмотря на то что страдал от серьёзного ранения.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s68
fi
goto 82
label s68
setvar strS[1000] = ""
label 82
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы продолжаем слушать репортаж о ситуации с закрытыми глазами.
setvar strS[1000] = "BG002N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s69
fi
goto 83
label s69
setvar strS[1000] = ""
label 83
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Затем — следующая зона отдыха.
text Автобус остаётся на остановке.
text Человек, появляющийся из открытой двери...
text ...мужчина знакомого телосложения.
text Это тот самый силуэт человека с сигаретой во рту, всегда выглядящего так, будто вот-вот на что-то пожалуется.
text Однако он сутулится сильнее обычного и опирается всем весом на кузов автобуса, будто ему больно.
text Я не могу толком разглядеть его рану, потому что на нём чёрный верх, но его джинсы испачканы кровью, будто кто-то разлил по ним чёрную краску.
text Он стоит лицом к полиции, держась от них на расстоянии, пока водитель автобуса всё ещё удерживается внутри в заложниках.
text У него с ними какой-то обмен репликами, но это слишком далеко, чтобы я мог разобрать, что происходит.
text Интересно, может, им не разрешают показывать его лицо по телевизору в такой ситуации.
text Полиция несёт к автобусу мегафон (по крайней мере, мне так кажется) и бросает его в его сторону.
text Раненый мужчина медленно поднимает его.
text Он проверяет, включён ли тот, а затем начинает что-то кричать.
text Расслышать это толком не получается.
text Мужчина выглядит удовлетворённым и снова садится в автобус.
text Вместо него из автобуса выходит... водитель, в своей форме.
text В тот момент, когда водитель ступает на землю, дверь закрывается, и автобус отправляется.
text Шины скользят, когда автобус делает большой разворот, и покидает зону отдыха.
text Полицейские машины и скорые тут же следуют за ним.
text Внутри остались только... молодой мужчина и раненый.
text Так это он сейчас ведёт автобус?
text Что вообще этот человек пытается сделать?
text Мы все затаиваем дыхание и внимательно следим за происходящим.
text @[Томоя]
text ...
text Спустя несколько мгновений проигрывается видеозапись.
text Со скорректированным звуком теперь можно расслышать, что он говорил.
music ~
text ──«Мы сейчас отправляемся в путешествие!»
text Я слышу его.
text ──«У нас вообще-то сложилось взаимопонимание!»
text ──«Мы стали друзьями!»
text ──«У этого парня есть тот, кого он хочет повидать!»
text ──«Его бабушка, которая растила его в детстве!»
text ──«Он говорит, что она прикована к постели уже пять лет!»
text ──«Он не знает, как у неё дела сейчас...»
text ──«Но, несмотря на это, он собирается её повидать!»
text ──«И когда он пойдёт узнать, как у неё дела, я прослежу, чтобы быть рядом с ним, чтобы он смог через это пройти!»
text ──«Всё ясно?! Вы понимаете?!»
jump SEEN7200_1_0.scr
