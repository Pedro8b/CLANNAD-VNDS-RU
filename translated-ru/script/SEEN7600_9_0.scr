		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCP.aac
text @[Кё]
text С-совсем нет...
text @[Томоя]
text Тогда оставь её в покое.
text @[Томоя]
text Уверен, Фудзибаяси рано или поздно тебе расскажет.
setvar strS[1001] = "CGKY16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
