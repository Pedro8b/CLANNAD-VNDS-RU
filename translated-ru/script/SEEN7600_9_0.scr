text @[Кё]
text ...
text @[Томоя]
text ...М?
setvar strS[1001] = "CGKY32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGKY32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM11.mp3
sound VCH.aac
text @[Кё]
text ...Томоя.
text @[Томоя]
text Д-да?!
text Она пронзительно смотрит на меня.
sound VCI.aac
text @[Кё]
text Кто такой Хиираги-сан и чем он занимается?
text @[Томоя]
text Э-это...
sound VCJ.aac
text @[Кё]
text Где он родился?
text @[Томоя]
text Ну...
sound VCK.aac
text @[Кё]
text А образование? Годовой доход?
text @[Томоя]
text Э-э... Кё?
sound VCL.aac
text @[Кё]
text Он старший ребёнок в семье? Что за у него семья? Он здоров? У него есть какие-нибудь странные увлечения?
text @[Томоя]
text Успокойся.
setvar strS[1001] = "CGKY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCM.aac
text @[Кё]
text Как я могу успокоиться?! Он же может стать моим будущим зятем!
text @[Томоя]
text По-моему, ты слишком забегаешь вперёд...
setvar strS[1001] = "CGKY20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCN.aac
text @[Кё]
text Потому что...!
text @[Томоя]
text Я думал, это младшая сестра будет цепляться за старшую, но, похоже, у нас всё наоборот.
setvar strS[1001] = "CGKY16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCO.aac
text @[Кё]
text Э-э... парень... у Рё есть парень...
text @[Томоя]
text Удивлена, что она обогнала тебя?
setvar strS[1001] = "CGKY20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY20.png
if intF[1113] == 1
