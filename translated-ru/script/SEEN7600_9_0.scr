	fi
fi
text Внезапно кто-то хватает меня за руку и утаскивает в класс.
music BGM08A.mp3
setvar strS[1001] = "CGKY13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VC7.aac
text @[Кё]
text ...
text @[Томоя]
text ...Кё...?
sound VC8.aac
text @[Кё]
text ...
text @[Томоя]
text Что такое...?
sound VC9.aac
text @[Кё]
text ...Слушай, Томоя.
text @[Томоя]
text М?
sound VCA.aac
text @[Кё]
text Что за человек этот Хиираги-сан?
text @[Томоя]
text Что за человек? В смысле?
setvar strS[1001] = "CGKY18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCB.aac
text @[Кё]
text Рё вчера вечером была очень счастлива.
sound VCC.aac
text @[Кё]
text И она даже ухмылялась, гадая на картах при выключенном свете...
text ...Это довольно жутко...
text @[Томоя]
text Ага... они вдвоём встречаются.
setvar strS[1001] = "CGKY20B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY20B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCD.aac
text @[Кё]
text ...А?! Ты шутишь!
text @[Томоя]
text С чего бы мне шутить?
setvar strS[1001] = "CGKY16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY16A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VCE.aac
text @[Кё]
text Н-ну, Рё мне ничего не говорила...
text @[Томоя]
text Наверное, просто стесняется, нет?
sound VCF.aac
text @[Кё]
text Р-Рё... скрывает что-то от меня...?
music ~
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она тут же падает на колени, опустив голову.
text @[Томоя]
text Она твоя сестра, но не будет цепляться за тебя вечно.
setvar strS[1001] = "CGKY30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY30.png
if intF[1113] == 1
