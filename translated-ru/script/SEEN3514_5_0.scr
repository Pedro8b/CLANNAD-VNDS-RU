music BGM32A.mp3
setvar strS[1000] = "FGKY08"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s110
fi
goto 112
label s110
setvar strS[1000] = ""
label 112
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
sound BI6.aac
text @[Кё]
text ...Я тебя люблю...
text @[Томоя]
text Не говори мне... ты...
sound BI7.aac
text @[Кё]
text Я тоже тебя люблю, Томоя...
text @[Томоя]
text Ки-Кё?!
text @[Томоя]
text Подожди... а? Почему?! Что с твоими волосами...?
sound BI8.aac
text @[Кё]
text ...Не убегай...
text @[Томоя]
text Ээ...?
sound BI9.aac
text @[Кё]
text Рё сказала мне... не убегай...
text @[Томоя]
text ...Рё... сделала...?
sound BIA.aac
text @[Кё]
text Она сказала, что если я действительно тебя люблю, то не должна убегать...
sound BIB.aac
text @[Кё]
text ...Она злилась на меня...
text Она улыбается... кажется обеспокоенной... но счастливой.
sound BIC.aac
text @[Кё]
text Она сказала... что извиняется.
sound BID.aac
text @[Кё]
text Тебе...
sound BIE.aac
text @[Кё]
text И тоже... мне...
sound BIF.aac
text @[Кё]
text Она сказала, что сделала что‑то действительно ужасное.
sound BIG.aac
text @[Кё]
text Что она думала только о себе и обидела нас двоих...
sound BIH.aac
text @[Кё]
text Что она только и делала, что позволяла себя баловать нашей добротой...
sound BII.aac
text @[Кё]
text И что... она сделала всё так сложно для нас...
text @[Томоя]
text Нет! Я тот, кто всё усложнил!
text @[Томоя]
text И я был тем, кто был избалован и обидел всех!
text @[Томоя]
text Я был так одержим тем, чтобы оставаться в зоне комфорта, что не учитывал ваши чувства...
text @[Томоя]
text ...и принёс вам обоим такие болезненные воспоминания...
text @[Томоя]
text Это я — ужасный и коварный.
sound BIJ.aac
text @[Кё]
text Нет...
sound BIK.aac
text @[Кё]
text Нет...
sound BIL.aac
text @[Кё]
text На самом деле, никто из нас не...
sound BIM.aac
text @[Кё]
text Это ни хорошее, ни плохое...
sound BIN.aac
text @[Кё]
text Я поняла, что когда мы двое влюбились в одного и того же, один из нас обязательно будет ранен...
sound BIO.aac
text @[Кё]
text Вот почему...
sound BIP.aac
text @[Кё]
text ...Я думала, что смогу вынести это, если это позволит Рё продолжать улыбаться...
sound BIQ.aac
text @[Кё]
text Я думала, что так лучше, чем признаться тебе и быть отвергнутой...
sound BIR.aac
text @[Кё]
text Я думала, что смогу вынести это лучше, чем боль от отказа...
sound BIS.aac
text @[Кё]
text Но...
sound BIT.aac
text @[Кё]
text ...Это было бесполезно...
sound BIU.aac
text @[Кё]
text Я не могла идти вперёд, отказываясь от своих собственных чувств.
sound BIV.aac
text @[Кё]
text И это ещё не всё... Я даже не могла оставаться там, где была...
sound BIW.aac
text @[Кё]
text ...и решила убежать...
sound BIX.aac
text @[Кё]
text Я чувствовала себя подавленно...
sound BIY.aac
text @[Кё]
text А потом Рё рассердилась на меня.
sound BIZ.aac
text @[Кё]
text Она сказала мне, что я не могу убегать.
sound BJ0.aac
text @[Кё]
text Она сказала, что если мне будет грустно, то это должно быть из‑за того, что меня отвергли...
sound BJ1.aac
text @[Кё]
text И она сказала, что будет плакать со мной, если это произойдёт...
sound BJ2.aac
text @[Кё]
text Рё... почти расплакалась... но всё равно сказала это с улыбкой.
sound BJ3.aac
text @[Кё]
text Вот почему...!
sound BJ4.aac
text @[Кё]
text Именно поэтому... Я...
sound BJ5.aac
text @[Кё]
text Я больше не могу...
text @[Томоя]
text Кё...
sound BJ6.aac
text @[Кё]
text Томоя...
text Кё крепко закрыла глаза.
text Как будто она колеблется...
text И будто она сопротивляется...
text Она медленно вдыхает, и медленно выдыхает...
text Она открывает глаза.
text Тогда... с сильной решимостью за глазами, она смотрит на меня.
sound BJ7.aac
text @[Кё]
text Я тебя люблю.
sound BJ8.aac
text @[Кё]
text ...я всегда...
sound BJ9.aac
text @[Кё]
text ...я всегда любила тебя, Томоя...
text Её решительный взгляд, наполненный чувствами, пронзает меня.
text Я чувствую, как что-то тёплое внезапно поражает моё сердце и проникает по всему телу.
text Я достаю из кармана маленькую коробочку с кулоном и передаю её Кё.
text @[Томоя]
text Я купил это для Рё, но... я выбрал неправильный камень...
text @[Томоя]
text Я вспомнил только тот, который ты хотела...
text @[Томоя]
text Подумав об этом... я, возможно, уже тогда принял решение...
text @[Томоя]
text Я такой глупый... серьёзно...
sound BJA.aac
text @[Кё]
text Томоя...
text @[Томоя]
text Но...
text @[Томоя]
text Если ты не возражаешь против того, что я такой, я хочу быть рядом с тобой.
text @[Томоя]
text Нет... наверное, я сказал это неправильно...
text @[Томоя]
text Я тебя люблю.
text @[Томоя]
text Позволь мне оставаться рядом с тобой.
sound BJB.aac
text @[Кё]
text ─Томоя!
setvar strS[1000] = "FGKY09B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s111
fi
goto 113
label s111
setvar strS[1000] = ""
label 113
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text Кё притягивает своё тело ко мне и обнимает меня.
text Я тоже закрываю глаза и обнимаю её в ответ.
text Чтобы не отпускать наш первый шаг в совместном путешествии как влюблённые...
text Чтобы не отпускать эту теплоту, крепко держась...
text ...И сильно
music ~
text @... Я обнимаю её...
delay 300
cleartext
