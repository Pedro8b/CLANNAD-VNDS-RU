text Возможно, это правда...
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ITA.aac
text @[Томоё]
text Верно? Так что не говори таких вещей.
sound ITB.aac
text @[Томоё]
text Мы обе должны уметь гордиться друг другом.
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
