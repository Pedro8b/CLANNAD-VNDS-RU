setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ITD.aac
text @[Томоё]
text Постарайся изо всех сил. Я хотя бы буду за тебя болеть.
sound ITE.aac
text @[Нагиса]
text Большое вам спасибо.
sound ITF.aac
text @[Томоё]
text Хорошо. Тогда до свидания.
text Она смотрит на меня в последнюю очередь, будто спрашивая, всё ли мы уже обсудили.
text Всё, что мне остаётся, — вздохнуть и кивнуть.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
