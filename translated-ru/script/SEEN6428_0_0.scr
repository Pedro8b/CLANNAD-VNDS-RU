text ...Лично мне связываться с тобой хотелось бы меньше всего на свете.
sound IT4.aac
text @[Нагиса]
text Эм, если я могу чем-то помочь, я буду рада это сделать.
text Затем она смотрит на Нагису.
text @[Томоё]
text ...
text Её взгляд прикован к ней.
setvar strS[1001] = "CGNG23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound IT5.aac
text @[Нагиса]
text Эхехе...
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound IT6.aac
text @[Томоё]
text Хоть мне и приятно это слышать... я не хочу, чтобы ты была мне чем-то обязана.
sound IT7.aac
text @[Томоё]
text И мне не нравится, когда отношения с людьми строятся так. А тебе?
sound IT8.aac
text @[Томоё]
text Из-за этого я бы чувствовала себя слабой. Разве нет?
setvar strS[1001] = "CGNG12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG12.png
if intF[1113] == 1
