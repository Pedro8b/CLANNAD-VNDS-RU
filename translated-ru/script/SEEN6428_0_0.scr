text Если ты вступишь в ученический совет, ты больше не сможешь дурачиться и веселиться.
text @[Томоя]
text Почему бы не устроить это как последний прощальный праздник?
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоё]
text ...
sound ISN.aac
text @[Томоё]
text Последний шанс подурачиться и беззаботно провести время, значит...?
sound ISO.aac
text @[Томоё]
text Что ж, то, что вы трое пытаетесь сделать, — это уж точно глупость. Тут не поспоришь.
text @[Томоя]
text Ага.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISP.aac
text @[Томоё]
text Кто именно в команде?
text @[Томоя]
text Мы будем играть 3 на 3, так что команда из трёх человек.
text @[Томоя]
text Я, Сунохара и ты.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISQ.aac
text @[Томоё]
text Понятно...
text Томоё продолжает смотреть мне прямо в лицо, обдумывая это.
text Я просто жду, не отводя взгляда.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISR.aac
text @[Томоё]
text Дай мне подумать. Когда матч?
text @[Томоя]
text Послезавтра.
sound ISS.aac
text @[Томоё]
text Хорошо. Я дам тебе ответ к тому времени.
text @[Томоя]
text Ладно, будем на тебя рассчитывать.
music ~
if 0 == 0
	goto s50
fi
goto 47
label s50
setvar strS[1000] = "KURO"
goto 49
label 47
if 0 == 1
	goto s51
fi
goto 48
label s51
setvar strS[1000] = "SIRO"
goto 49
label 48
setvar strS[1000] = "KURO"
label 49
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG017"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s52
fi
goto 50
label s52
setvar strS[1000] = ""
label 50
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM14.mp3
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound IST.aac
text @[Нагиса]
text Ах... Сакагами-сан такая замечательная девушка.
text Нагиса в полном восторге с тех пор, как узнала, что Томоё баллотируется в председатели ученического совета.
sound ISU.aac
text @[Нагиса]
text Я знаю, что её изберут.
sound ISV.aac
text @[Нагиса]
text И тогда... я буду знакома с председателем ученического совета.
setvar strS[1001] = "CGNG17Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG17Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISW.aac
text @[Нагиса]
text Это было бы потрясающе.
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISX.aac
text @[Нагиса]
text Интересно, будет ли она по-прежнему со мной разговаривать, даже став председателем ученического совета.
sound ISY.aac
text @[Нагиса]
text Я была бы так счастлива, если бы это было так.
text @[Томоя]
text Уверен, она будет относиться к тебе точно так же, как и всегда.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ISZ.aac
text @[Сунохара]
text Значит, я тоже была бы знакома с председателем ученического совета...
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound IT0.aac
text @[Сунохара]
text Интересно, будет ли она по-прежнему меня пинать, даже став председателем ученического совета...
text @[Томоя]
text Уверен, она будет относиться к тебе точно так же, как и всегда.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound IT1.aac
text @[Сунохара]
text Я надеялась, что этого не случится, между прочим!
setvar intF[826] = 1
jump SEEN6428_0_2.scr 111
jump SEEN6428_0_1.scr 52
label 51
