label s40
text Хм, Томоё...
text Хотя она вроде не из тех, кто драматизирует по поводу чего угодно...
goto 41
jump SEEN5424_0_1.scr 64
label 46
if intF[509] == 1
	goto s41
fi
jump SEEN5424_0_1.scr 64
label s41
text Да, точно. Томоё идеальна.
text Она бы просто вынесла дверь ударом ноги. Всё бы закончилось в мгновение ока.
text *Клац──нь*
text В тот же миг, когда я об этом думаю, монеты падают на стол.
setvar strS[1001] = "CGSH10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1O.aac
text @[Сунохара]
text Ох, это значит, что заклинание завершилось?
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1P.aac
text @[Сунохара]
text Как же я завидую. Так с какой милашкой ты будешь заперт?
text @[Томоя]
text Жаль, но я тут же сбегу и вернусь сюда.
setvar strS[1001] = "CGSH20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1Q.aac
text @[Сунохара]
text Э? Ты о чём?
text @[Томоя]
text Именно то, что я сказал.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s42
fi
goto 47
label s42
setvar strS[1000] = ""
label 47
setvar strS[1001] = "NONE"
