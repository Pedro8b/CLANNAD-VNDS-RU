	fi
fi
sound F1L.aac
text @[Сунохара]
text Хм? Правда?
text @[Томоя]
text Почему это должна быть именно ты...? Разве недостаточно того, что мы каждый день видимся в школе?
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1M.aac
text @[Сунохара]
text Так, так, попробуй успокоиться.
sound F1N.aac
text @[Сунохара]
text Давай найдём, чем заняться, пока кто-нибудь не откроет дверь.
text @[Томоя]
text Хаах...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text В итоге нам приходится потратить два часа внутри тёмного сарая...
jump SEEN5424_0_2.scr 105
label 45
if intF[209] == 1
	goto s38
fi
jump SEEN5424_0_1.scr 64
label s38
choice Томоё...|Не она...
setvar intF[1089] = selected
