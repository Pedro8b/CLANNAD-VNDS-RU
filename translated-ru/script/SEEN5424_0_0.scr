text Надеюсь, тот, кто продал душу, чтобы создать эту книгу заклинаний, счастлив...
text @[Томоя]
text К-Какое совпадение увидеть тебя здесь...
if intF[507] == 0
	if intF[10] == 1
		goto s16
	fi
fi
goto 15
label s16
text В последний раз мы виделись в тот дождливый день... это неловко.
text Но Фурукаву это, кажется, не беспокоит.
label 15
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EYR.aac
text @[Фурукава]
text В чём дело? Почему ты здесь одна?
text @[Томоя]
text Ну, я тут не то чтобы что-то делаю... но знаешь, как говорят, «никогда не узнаешь, пока не попробуешь»...
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EYS.aac
text @[Фурукава]
text Да?
text Так что, меня правда запрёт с ней?
text Что вообще для этого понадобилось бы? Это невозможно...
text *Дзынь*
text Это громкий треск металлической биты.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я поворачиваюсь посмотреть в сторону, откуда донёсся звук... как раз чтобы увидеть летящий сюда мяч от удара.
music ~
text @[Томоя]
text Осторожно!
sound EYT.aac
text @[Фурукава]
text А?
text Я хватаю Фурукаву в объятия и толкаю её вперёд. Мы оба катимся на землю.
if 0 == 0
	goto s17
