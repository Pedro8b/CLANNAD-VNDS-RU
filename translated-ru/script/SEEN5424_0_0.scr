		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text В общем, я на всякий случай пришёл к сараю...
text @[Томоя]
text (Она должна появиться здесь по какой-то причине... интересно, каковы шансы, что это и правда случится.)
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1R.aac
text @[Томоё]
text Хм? Это ты, Оказаки? Что ты тут делаешь один?
text Надеюсь, тот, кто продал душу, чтобы создать эту книгу заклинаний, счастлив...
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1S.aac
text @[Томоё]
text Какое совпадение.
text @[Томоя]
text Серьёзно...
text Так что, меня правда запрёт с ней?
text Что вообще для этого понадобилось бы? Это невозможно...
music ~
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F1T.aac
text @[Томоё]
text Осторожно!
text @[Томоя]
text А?
text Она обхватывает меня руками и толкает на пол.
if 0 == 0
	goto s44
fi
goto 49
label s44
setvar strS[1000] = "KURO"
goto 51
label 49
if 0 == 1
	goto s45
fi
goto 50
label s45
setvar strS[1000] = "SIRO"
goto 51
label 50
setvar strS[1000] = "KURO"
label 51
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text *Грохот* *Треск*
text После громкого звука мы теперь лежим на земле внутри сарая.
sound F1U.aac
text @[Томоё]
text Было близко. К тебе летел бейсбольный мяч.
text ...Значит, кто-то и правда продал душу.
text Дверь, должно быть, захлопнулась. Внутри абсолютно темно.
text А Томоё всё ещё лежит на мне сверху.
text @[Томоя]
text ...
text @[Томоя]
text Так, опасность миновала, да?
sound F1V.aac
text @[Томоё]
text Наверное...
text Её голос прямо у моего уха.
text @[Томоя]
text Тогда... почему ты всё ещё на мне сверху?
sound F1W.aac
text @[Томоё]
text Не могу слезть, даже если хочу...
text @[Томоя]
text Почему...?
sound F1X.aac
text @[Томоё]
text У меня на спине что-то тяжёлое...
text @[Томоя]
text Это всё? Для тебя же это должно быть проще простого — оттолкнуть это и встать.
sound F1Y.aac
text @[Томоё]
text Оно правда тяжёлое... не говори так, будто это легко сделать...
text Как только она это говорит, раздаётся стон.
text @[Томоя]
text Ты где-то поранилась...?
sound F1Z.aac
text @[Томоё]
text Да... похоже на то...
text @[Томоя]
text Поэтому ты сейчас не можешь двигаться...?
sound F20.aac
text @[Томоё]
text Да...
text Это точно дело рук дьявола, в конце концов.
music BGM08D.mp3
text @[Томоя]
text Ты в порядке...?
sound F21.aac
text @[Томоё]
text Да...
text Мы вдвоём можем лишь продолжать лежать друг на друге в темноте.
text На самом деле, из-за веса на её спине наше объятие стало настолько тесным, что это уже неудобно.
text @[Томоя]
text (Это всё моя вина...)
text @[Томоя]
text (Ух... сейчас не время для самобичевания...)
text Мне нужно что-то сделать.
text @[Томоя]
text Так что... тогда я попробую подвигаться.
sound F22.aac
text @[Томоё]
text Ах... да... пожалуйста...
text Но в такой позе я не могу вложить никакой силы в конечности.
text Даже так, мне как-то удаётся подтянуть колени и упереться пятками в землю.
text *Трение*
text Я чувствую, как мои колени скользят по чему-то невероятно мягкому.
sound F23.aac
text @[Томоё]
text Хаах...
text Томоё издаёт глубокий вздох.
text @[Томоя]
text Я снова подвигаюсь.
sound F24.aac
text @[Томоё]
text Х-Хорошо...
text *Трееение*
text *Бонг*
text Моя голова только что стукнулась обо что-то твёрдое.
sound F25.aac
text @[Томоё]
text Ты в порядке...?
text @[Томоя]
text Да...
text @[Томоя]
text Но, похоже, нет никакого способа выбраться сверху...
sound F26.aac
text @[Томоё]
text Понятно...
text @[Томоя]
text В этот раз попробую снизу...
sound F27.aac
text @[Томоё]
text ...Да... похоже, это единственный способ...
text *Трееение*
text @[Томоя]
text Хаах... не годится... слишком тяжело двигаться так...
sound F28.aac
text @[Томоё]
text Понятно...
text Теперь мы снова в исходном положении.
sound F29.aac
text @[Томоё]
text Хаах...
text В местах, где соприкасаются наши тела, начинает выступать пот. Эти места ощущаются вдвое горячее.
text Куда бы я ни повернул голову, я не могу не вдыхать запах волос Томоё каждый раз, когда делаю вдох.
text Даже малейшая мысль о ней передаёт ещё больше жара моей нижней части тела...
text Но я не могу позволить сейчас произойти какому-нибудь неловкому физиологическому явлению...
text @[Томоя]
text Угх...
sound F2A.aac
text @[Томоё]
text Ты в порядке...?
text @[Томоя]
text Нет, вот это только что было другое...
sound F2B.aac
text @[Томоё]
text ...?
sound F2C.aac
text @[Томоё]
text Тогда попробуем вот так...
sound F2D.aac
text @[Томоё]
text Я попробую приподнять его...
sound F2E.aac
text @[Томоё]
text Когда я это сделаю, попробуй выбраться...
text @[Томоя]
text А? А ты как же?
sound F2F.aac
text @[Томоё]
text Ну...
sound F2G.aac
text @[Томоё]
text После того как ты выберешься, попробуй вытащить меня из-под всего этого...
text @[Томоя]
text Идиот... как будто я могла бы сделать что-то подобное.
sound F2H.aac
text @[Томоё]
text Почему...?
text @[Томоя]
text Сначала ты спас меня от того мяча, а теперь хочешь остаться под всем этим один...
text @[Томоя]
text Вытащить тебя отсюда?
text @[Томоя]
text Это уже слишком...
sound F2I.aac
text @[Томоё]
text @Всё нормально и так...
delay 177
text пока ты сможешь освободиться от этой ужасной ситуации...
text @[Томоя]
text Это не ужасно...
text @[Томоя]
text На самом деле, это вовсе не плохо...
sound F2J.aac
text @[Томоё]
text Правда...?
text @[Томоя]
text Да...
text @[Томоя]
text Вот почему тебе не нужно делать ничего безрассудного.
sound F2K.aac
text @[Томоё]
text Оказаки, ты и правда добрый, да...?
sound F2L.aac
text @[Томоё]
text ...
sound F2M.aac
text @[Томоё]
text У меня такое чувство, будто я сейчас в тебя влюбляюсь...
text Вместе с её шёпотом её тёплое дыхание мягко касается моего уха.
text Моё сердце бьётся всё громче и громче.
text Если вчерашнее заклинание и правда сработало...
text Разве это не значит, что я ей нравлюсь...?
sound F2N.aac
text @[Томоё]
text Слушай, Оказаки...
text Если так будет продолжаться, я...
text Нет, это плохо.
text Не говоря уже о том, что эта ситуация — просто дело рук того заклинания...
sound F2O.aac
text @[Томоё]
text Оказаки, что ты думаешь... насчёт...
text Это нечестно... совсем нехорошо...
text Я ломаю голову, пытаясь придумать способ выбраться отсюда.
text Ах...
text Точно. Перед тем как прийти сюда, я слышал от Миядзавы про способ нейтрализовать заклинание...
text Что она там говорила...?
text Я пытаюсь вспомнить её слова.
if 0 == 0
	goto s46
fi
jump SEEN5424_0_1.scr 52
label s46
setvar strS[1000] = "KURO"
jump SEEN5424_0_1.scr 54
jump SEEN5424_0_1.scr
