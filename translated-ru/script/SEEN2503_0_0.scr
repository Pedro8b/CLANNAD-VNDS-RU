bgload {$strS[1000]}.jpg 30
sound 70S.aac
text @[Томоё]
text Что теперь...? Я же прямо здесь. Не обязательно говорить мне прямо в ухо.
text @[Томоя]
text Я люблю тыквенный суп, но тебя я тоже люблю...
sound 70T.aac
text @[Томоё]
text Если честно, меня немного тревожит, что меня сравнивают с тыквенным супом...
text @[Томоя]
text Так вот, поэтому...
text Я кладу подбородок ей на плечо. Опустив взгляд, я даже не вижу разделочную доску — её закрывают собой эти две большие штуки...
text Я просовываю руку под её фартук.
text И тогда...
text *Тык*
text @[Томоя]
text ...А?
text ...Что это был за звук только что?
text *Пффшшш*
text Что-то хлещет у меня изо лба.
text Присмотревшись к этому месту повнимательнее, я вижу нечто похожее на рукоятку половника...
text @[Томоя]
text А-А-А-А-А─!! Меня и этой штукой можно проткнуть?!
text @[Томоя]
text И это ещё не всё, меня проткнули её круглой частью?!
music ~
setvar strS[1000] = "FGTM01J"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s39
fi
goto 44
label s39
setvar strS[1000] = ""
label 44
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
