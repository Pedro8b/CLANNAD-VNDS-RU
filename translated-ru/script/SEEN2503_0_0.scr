sound 70U.aac
text @[Томоё]
text Томоя...
sound 70V.aac
text @[Томоё]
text ...Ты меня недооценил, да?
text *Пффшшш*
if 0 == 0
	goto s40
fi
goto 45
label s40
setvar strS[1000] = "KURO"
goto 47
label 45
if 0 == 1
	goto s41
fi
goto 46
label s41
setvar strS[1000] = "SIRO"
goto 47
