setvar strS[1000] = "BG018"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Девушка бежит ко мне.
music ~
text И по какой‑то причине она останавливается передо мной.
music BGM04A.mp3
setvar strS[1001] = "CGFU15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 27I.aac
text @[Фемэйл Студент]
text Ты...
sound 27J.aac
text @[Фемэйл Студент]
text ...Извините.
text Повязка на её руке уже выдаёт, кто она. Опасный резчик... Фуко.
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 27K.aac
text @[Фуко]
text Вот, возьми это.
text С этими словами Фуко протягивает кубик дерева.
text Я уже видел это раньше. Это то, что используют на уроках искусства.
text @[Томоя]
text Зачем ты даёшь это мне?
sound 27L.aac
text @[Фуко]
text Сейчас оно принадлежит тебе.
sound 27M.aac
text @[Фуко]
text Ну, тогда!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сразу же после этого она проскальзывает под мою руку и убегает.
text В своей растерянности я могу лишь стоять и смотреть.
text Как только Фуко исчезает за углом, к мне бросается мужчина‑студент.
text И, как и Фуко, он останавливается передо мной.
sound 27N.aac
text @[Мейл Студент]
text Кто‑то только что... пробежал мимо...? Эй, разве это не...
text @[Томоя]
text Тебе что‑то нужно?
sound 27O.aac
text @[Мейл Студент]
text То, что ты держишь. Вот это.
text @[Томоя]
text Это?
text Я опускаю взгляд на деревянный блок.
sound 27P.aac
text @[Мэйл Студент]
text Вот так всё и случилось... Оказаки, ты настоящий виновник.
text @[Томоя]
text О чём?
sound 27Q.aac
text @[Мэйл Студент]
text Насколько низко ты можешь опуститься, используя такую девушку, чтобы украсть у нас?
sound 27R.aac
text @[Мэйл Студент]
text Ты – полное человеческое дерьмо.
text @[Томоя]
text Извини, я тебя плохо расслышал. Повтори, пожалуйста.
text Я не упущу шанс применить ослепляющую технику.
sound 27S.aac
text @[Мэйл Студент]
text Ай!
text @[Томоя]
text Ты что‑то сказал про человеческое дерьмо?
sound 27T.aac
text @[Мэйл Студент]
text Нет, вовсе нет... Оказаки‑кун всегда такой милый парень!
text Это меня совсем не радует...
sound 27U.aac
text @[Мэйл Студент]
text Но видишь ли, я в беде без кубика в твоей руке.
text @[Томоя]
text Так ты хочешь эту штуку?
text Я бросаю деревянный блок в воздух и ловлю его одной рукой.
sound 27V.aac
text @[Мэйл Студент]
text Да, да, очень.
sound 27W.aac
text @[Мэйл Студент]
text Во время моего урока рисования вдруг появилась девушка и украла его...
sound 27X.aac
text @[Мэйл Студент]
text Она просто возникла из ниоткуда, сказала мне: «Тебе это не нужно? Большое спасибо», и забрала деревянный кусок — всё это в течение одной секунды.
sound 27Y.aac
text @[Мэйл Студент]
text Нет уж, я ведь это точно нуждался, правда? Ха-ха.
text @[Томоя]
text Вот как.
sound 27Z.aac
text @[Мейл Студент]
text Да, так что, пожалуйста, отдай его.
text @[Томоя]
text Это то, что я нашёл. Видишь, оно просто лежало там.
sound 280.aac
text @[Мейл Студент]
text Что...?
text @[Томоя]
text Где это было… Точно, в мусорном баке.
text @[Томоя]
text Если бы я не подобрал его, его бы выбросили.
text @[Томоя]
text Так что, теперь можно сказать, что это принадлежит мне, верно?
text Я отворачиваюсь от студента.
sound 281.aac
text @[Мейл Студент]
text Но без него у меня серьёзные проблемы.
text Игнорируя его, я начинаю уходить.
