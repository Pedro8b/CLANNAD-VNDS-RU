text Тогда мы вырезаем их и дарим людям.
text @[Томоя]
text Как это звучит?
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 37D.aac
