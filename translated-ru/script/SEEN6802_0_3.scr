	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Усиоо!
text Когда я зову Усио по имени, она поднимает голову.
text @[Томоя]
text Нашла?
setvar strS[1001] = "CGUS23HR"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS23HR.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound P6J.aac
text @[Усио]
text ...Нет.
text Она встаёт, а потом низко опускает голову.
sound P6K.aac
text @[Усио]
text ...Я не смогла найти его...
text @[Томоя]
text А... Ну, ничего не поделаешь.
text @[Томоя]
text Я куплю тебе новую, так что...
sound P6L.aac
text @[Усио]
text ...
text Даже после этих слов она всё ещё держит голову опущенной.
sound P6M.aac
text @[Усио]
text ...Такая только одна.
text @[Томоя]
text Хм? В смысле — только одна? Ты же видела все те, что продавались в магазине, да?
sound P6N.aac
text @[Усио]
text ...Потому что ты сам её выбрал... И купил мне.
sound P6O.aac
text @[Усио]
text ...Это была моя первая игрушка от тебя, папа.
text ......
text Мне вспоминаются слова Санаэ-сан.
text ──"Усио всё время скучает по тебе".
text ──"Потому что ей никогда не доводится быть рядом с отцом".
text @[Томоя]
text ...Усио.
text @[Томоя]
text Значит... это, должно быть, было для тебя чем-то важным...
sound P6P.aac
text @[Усио]
text ...
sound P6Q.aac
text @[Усио]
text ...Да.
text А... Я же могу вернуть её.
text Меня осеняет.
text @[Томоя]
text Усио...
text @[Томоя]
text Тебе было одиноко?
sound P6R.aac
text @[Усио]
text ...Да.
text @[Томоя]
text Тебе понравилось ехать в этой поездке... даже со мной?
sound P6S.aac
text @[Усио]
text ...Ага.
text @[Томоя]
text Прости... за всё.
text @[Томоя]
text Я оставлял тебя одну... на так долго...
text @[Томоя]
text Усио?
text @[Томоя]
text Ничего, если мы теперь будем всегда вот так вместе...?
sound P6T.aac
text @[Усио]
text ...
text @[Томоя]
text ...Я знаю, что... всё это время был никудышным отцом...
text @[Томоя]
text Но с этого момента я буду стараться ради тебя, Усио...
text @[Томоя]
text Так что можно мне быть рядом с тобой...?
sound P6U.aac
text @[Усио]
text ...Да.
text @[Томоя]
text Правда?
sound P6V.aac
text @[Усио]
text ...Ага. Хочу, чтобы ты был.
text @[Томоя]
text А...
sound P6W.aac
text @[Усио]
text ...Но сегодня...
sound P6X.aac
text @[Усио]
text ...Я потеряла кое-что важное, так что...
sound P6Y.aac
text @[Усио]
text ...Мне грустно.
sound P6Z.aac
text @[Усио]
text ...Папа.
text @[Томоя]
text Что?
setvar strS[1001] = "CGUS15HR"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGUS15HR.png
if intF[1113] == 1
