setimg CGMS10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound S6N.aac
text @[Мисаэ]
text Да. Может, как-нибудь, когда мужчин не будет рядом.
setvar strS[1001] = "CGMS15H"
setvar intF[1113] = intF[1112]
