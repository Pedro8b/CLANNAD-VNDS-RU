		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound RWS.aac
text @[Мэй]
text Ну, нам это говорили постоянно с самого детства.
text @[Томоя]
text Что вы сиблинги кота-робота?
sound RWT.aac
text @[Мэй]
text Нет, я имею в виду, что всегда говорили: «Наверное, тяжело иметь такого никудышного старшего брата».
text @[Томоя]
text Ага, могу представить...
text Возможно, её растили на его примере — как не надо делать.
