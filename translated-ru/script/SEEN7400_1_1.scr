text @[Санаэ]
text Не хотите присоединиться к нам, Сагара-сан?
setvar strS[1001] = "CGMS15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound S6L.aac
text @[Мисаэ]
text Нет, я только что поела, так что всё нормально. Да и места для сидения нет, в любом случае.
text Похоже, Мисаэ-сан думает, что Санаэ-сан примерно её ровесница.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
