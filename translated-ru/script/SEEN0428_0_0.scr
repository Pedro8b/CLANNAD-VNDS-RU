text Ладно, всё равно. Да, иногда я вижу твои спортивные способности и задаюсь вопросом, действительно ли ты человек.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0YQ.aac
text @[Сунохара]
text Верно?
sound 0YR.aac
text @[Сунохара]
text И вот почему...
sound 0YS.aac
text @[Сунохара]
text ...я задумываюсь, не захотел бы ты попросить помощи у другого члена блестящей спортивной семьи Сунохара.
text @[Томоя]
text Нет, не так уж и.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0YT.aac
text @[Сунохара]
text Просто скажи, что бы ты! Как иначе я могу рассказать тебе остальное?!
text @[Томоя]
text Ладно, всё равно... Я сейчас отчаянно. Хочу их помощь!
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0YU.aac
text @[Сунохара]
text Понимаю... Хорошо.
sound 0YV.aac
text @[Сунохара]
text Хорошо, тогда я позову их...
text @[Томоя]
text Постой... ты собираешься снять магический печать с того предмета...?
sound 0YW.aac
text @[Сунохара]
text Эм...
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0YX.aac
text @[Сунохара]
text Постой, что ты имеешь в виду, «магическая печать»?!
sound 0YY.aac
text @[Сунохара]
text Ты вообще понимаешь, о чём я говорю?!
text @[Томоя]
text Мы же говорим о твоих родственниках, верно?
sound 0YZ.aac
text @[Сунохара]
text Если ты знаешь, то зачем говоришь о магических печатях?!
text @[Томоя]
text Я просто представил, что на твоей семье наложили магические печати. Понимаешь?
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text После того, как они доставляли неприятности жителям деревни или что‑то в этом роде.
sound 0Z0.aac
text @[Сунохара]
text Послушай... тебе лучше не начинать плакать и извиняться, когда ты действительно её встретишь...
sound 0Z1.aac
text @[Сунохара]
text Моя младшая сестрёнка довольно милая, знаешь...
text @[Томоя]
text Ладно, ладно. Я приму любого, кто может помочь. А теперь приведи её сюда.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z2.aac
text @[Сунохара]
text Не можешь ли ты быть чуть дружелюбнее, когда просишь?!
text @[Томоя]
text Ладно, ладно... Я сейчас просто безнадёжен. Плиз, Сунохара‑тян!
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z3.aac
text @[Сунохара]
text Тсс... ну, если ты будешь умолять.
text @[Томоя]
text Подожди секунду. Твоя младшая сестрёнка? Она младше нас. И она девочка... действительно будет такой большой помощью?
setvar strS[1001] = "CGSH10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z4.aac
text @[Сунохара]
text Да, с ней нам будет всё в порядке.
sound 0Z5.aac
text @[Сунохара]
text Что бы ты её ни заставил делать, у неё получится хорошо.
sound 0Z6.aac
text @[Сунохара]
text Даже если это спорт, о котором она понятия не имеет, она наверняка сможет посоперничать с профи!
text @[Томоя]
text Ого, похоже, от неё можно многого ожидать.
text @[Томоя]
text Ладно, тогда пошли какие там нужно ультразвуковые сигналы, чтобы она была здесь к завтрашнему дню.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z7.aac
text @[Сунохара]
text Я не могу их посылать, а она не может их принимать!
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z8.aac
text @[Сунохара]
text Я ей позвоню.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Она почти похожа на человека.
text Он встаёт и выходит из комнаты.
bgload KURO.jpg 55
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if intF[845] == 0
	goto s40
fi
goto 45
label s40
text Он плетётся обратно.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0Z9.aac
text @[Сунохара]
text Тьфу... да что с ней такое...?
text @[Томоя]
text Ты хочешь сказать, что теперь она не сможет приехать, после того как ты меня так обнадёжил?
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZA.aac
text @[Сунохара]
text Ага. Говорит, поездка туда-обратно за день — это слишком тяжело. «Постарайся»? Серьёзно?
text @[Томоя]
text Что ж, тогда придётся искать кого-то ещё.
setvar strS[1001] = "CGSH10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZB.aac
text @[Сунохара]
text Ну, раз у вас есть я, для остальной команды подойдёт кто угодно, у кого есть пульс, верно?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *БА-ТРАХ*
text Я влепляю ему апперкот прямо в челюсть, окончательно исчерпав терпение слушать эту дурацкую фразу, которую он повторяет без всякой видимой причины.
goto 46
label 45
if intF[845] == 1
	goto s41
fi
goto 46
label s41
text Сунохара неспешно возвращается.
text @[Томоя]
text Ну как?
setvar strS[1001] = "CGSH10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZC.aac
text @[Сунохара]
text Она сказала, что возьмет ночной автобус сюда.
text @[Томоя]
text Похоже, он действительно в этом увлечён.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZD.aac
text @[Сунохара]
text Но в этот раз у меня был козырь в рукаве, который привлёк её внимание.
text @[Томоя]
text А... Понятно.
text Его слова напоминают мне. Полагаю, его сестра была большим поклонником.
text @[Томоя]
text Ёсино Юсуке.
sound 0ZE.aac
text @[Сунохара]
text Точно.
sound 0ZF.aac
text @[Сунохара]
text Но всё равно...
sound 0ZG.aac
text @[Сунохара]
text Она увидит своего брата совершенно в новом свете завтра.
setvar strS[1001] = "CGSH12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZH.aac
text @[Сунохара]
text Без обид, но когда речь идёт о спорте, даже Ёсино-сэна сводят к роли моего противника.
text @[Томоя]
text Похоже, завтра будет весёлый день.
setvar strS[1001] = "CGSH25B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 0ZI.aac
text @[Сунохара]
text Ты прав в этом!!
setvar intF[847] = 1
label 46
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
