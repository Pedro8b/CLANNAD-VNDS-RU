bgload {$strS[1000]}.jpg 98
text Подножие холма, ведущего к школе.
text Она снова здесь.
text Она смотрит на школьные ворота, что возвышаются над нами.
text Я не решаюсь окликнуть её по имени.
text Но сам не знаю почему...
text О чём она думает? Она то и дело опускает взгляд на землю и вздыхает.
text Проходит немало времени.
text Она... поворачивается спиной к школьным воротам.
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
