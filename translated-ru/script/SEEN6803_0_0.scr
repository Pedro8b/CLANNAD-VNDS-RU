	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я окружён ослепительным светом.
text Мои глаза просто отвыкли от яркого света — слишком долго я пробыл в темноте.
text Вскоре они привыкают к свету, и я могу различить силуэты на заднем плане.
text Я знаю, где нахожусь.
setvar strS[1000] = "FGNG16"
setvar intA[1000] = 1
