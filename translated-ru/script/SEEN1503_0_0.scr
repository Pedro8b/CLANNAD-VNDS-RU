	setvar intA[1000] = -1
fi
if strS[0] == "Okazaki-san"
	setvar intA[1000] = 0
fi
if strS[0] > "Tomoya-kun"
	setvar intA[1001] = 1
fi
if strS[0] < "Tomoya-kun"
	setvar intA[1001] = -1
fi
if strS[0] == "Tomoya-kun"
	setvar intA[1001] = 0
fi
if intA[1000] == 0
	goto s36
fi
goto 50
label s36
sound 44C.aac
goto 51
label 50
sound 44D.aac
label 51
text @[{$lnmA}]
text Хотя ты так говоришь, ты, очевидно, тоже собираешься поменять свою руку!
text Если так будет продолжаться, игра не закончится...
text Я решаю выбрать другую руку.
sound 44E.aac
text @[{$lnmA}]
text Другая...
choice Rock|Paper
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s37
fi
jump SEEN1503_0_1.scr 52
label s37
sound 44F.aac
text @[{$lnmA}]
text Соревнование!
setvar strS[1001] = "NONE"
