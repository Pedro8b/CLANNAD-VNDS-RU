text Умоляю вас, используйте эти строчки для текстов песен, а не в обычном разговоре...
bgload KURO.jpg 55
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGYS12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWN.aac
text @[Ёсино]
text Что ж, мне уже пора возвращаться.
text @[Томоя]
text Да ладно, уже?
sound QWO.aac
text @[Ёсино]
text Ага. У меня после этого ещё есть дела. Нужно съездить в соседний город.
setvar strS[1001] = "CGNG12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWP.aac
text @[Нагиса]
text Вот как... как жаль.
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWQ.aac
text @[Нагиса]
text Но было очень весело.
setvar strS[1000] = "BG141"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s120
fi
goto 140
label s120
setvar strS[1000] = ""
label 140
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
