		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWR.aac
text @[Нагиса]
text Спасибо вам большое за сегодня.
setvar strS[1001] = "CGYS13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWS.aac
text @[Ёсино]
text Взаимно. Спасибо за угощение.
setvar strS[1001] = "CGYS12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWT.aac
text @[Ёсино]
text До встречи, Нагиса-сан.
setvar strS[1001] = "CGNG10DZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10DZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWU.aac
text @[Нагиса]
text Да. Пожалуйста, заходите ещё как-нибудь.
setvar strS[1001] = "CGYS13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWV.aac
text @[Ёсино]
text Да. Обязательно.
setvar strS[1001] = "CGYS12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWW.aac
text @[Ёсино]
text Ну, пока, Оказаки. Смотри, работай с завтрашнего дня как безумный, ладно?
text @[Томоя]
text Лады.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы с Нагисой встаём перед домом, чтобы проводить Ёсино-сана.
text Пройдя немного, он оборачивается.
setvar strS[1001] = "CGYS18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWX.aac
text @[Ёсино]
text Будьте счастливы вместе, слышите?!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Он и правда человек, от которого иногда неловко...
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWY.aac
text @[Нагиса]
text Ёсино-сан очень хороший человек.
text @[Томоя]
text Похоже, тебе они как раз по душе... эти его смущающие фразы, я имею в виду.
sound QWZ.aac
text @[Нагиса]
text Разговоры с ним такие же глубокие, как и его песни.
setvar strS[1001] = "CGNG10DZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10DZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX0.aac
text @[Нагиса]
text Меня это правда тронуло.
sound QX1.aac
text @[Нагиса]
text Он и правда замечательный человек.
text @[Томоя]
text ...
text @[Томоя]
text Как скажешь.
setvar strS[1001] = "CGNG32D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX2.aac
text @[Нагиса]
text А...
sound QX3.aac
text @[Нагиса]
text Томоя-кун...
text @[Томоя]
text Что такое?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она пристально смотрит мне в лицо...
text и нежно сжимает мою руку.
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX4.aac
text @[Нагиса]
text Ты тоже замечательный человек, Томоя-кун.
sound QX5.aac
text @[Нагиса]
text И ещё ты самый важный человек в моей жизни.
text @[Томоя]
text ...
text @[Томоя]
text Глупышка...
if 0 == 0
	goto s121
fi
goto 141
label s121
setvar strS[1000] = "KURO"
goto 143
label 141
if 0 == 1
	goto s122
fi
goto 142
