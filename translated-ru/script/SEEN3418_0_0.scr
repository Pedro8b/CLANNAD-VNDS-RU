setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Пока Сунохара смотрит на неё, Фудзибаяси тасует колоду карт
text и роняет их...
text Смутившись, она начинает собирать карты.
text Затем она раскладывает карты веером, и Сунохара вытягивает три из них.
text Фудзибаяси смотрит на три карты, а затем что-то говорит Сунохаре.
text Когда она заканчивает, он кивает.
text @[Томоя]
text ...Похоже, ему выпало хорошее предсказание.
