setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound C.aac
text @[Томоя]
text Похоже, сегодня будет дождь.
sound MJF.aac
text @[Ёсино]
text Да. Начальник говорил то же самое.
text @[Томоя]
text Что нам делать, если начнётся?
sound MJG.aac
text @[Ёсино]
text Зависит от обстоятельств. Если сильный, останавливаемся.
text @[Томоя]
text А если просто небольшой дождик?
sound MJH.aac
text @[Ёсино]
text Это опасно, но мы ставим водонепроницаемый тент и стараемся закончить побыстрее.
text @[Томоя]
text Мы можем так сделать?
sound MJI.aac
text @[Ёсино]
text Наши строительные сроки никого не ждут.
sound ~
setvar strS[1000] = "BG049C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s244
fi
goto 303
label s244
setvar strS[1000] = ""
label 303
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM28.mp3
text Хотя утром небо ясное, к полудню оно начинает затягиваться тучами.
text Осталась одна работа, но небо выглядит так, будто вот-вот разверзнется.
text @[Томоя]
text Ёсино-сан, похоже, вот-вот начнётся дождь. Мы в порядке?
setvar strS[1001] = "CGYS15H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS15H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MJJ.aac
text @[Ёсино]
text Хватит ныть и принеси мне тент. Мы почти закончили.
text Пока Ёсино-сан молча работал до этого момента, он время от времени поглядывает на небо.
text Я никогда не видел, чтобы Ёсино-сан был настолько внимателен к этому.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я чувствую что-то холодное на щеке как раз в тот момент, когда мы решаем, делать ли последний этап работы на нашем последнем объекте.
setvar strS[1001] = "CGYS17H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS17H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
