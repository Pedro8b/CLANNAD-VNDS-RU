	fi
fi
text Заметив меня, она смотрит в мою сторону.
text Она медленно раскрывает объятия.
text В последнее время её движения стали невероятно медленными.
text Я подхожу к ней и устраиваюсь в её объятиях.
text ...«Ты такой холодный...»
text Я мотаю головой. Это неважно.
text У нас нет времени.
text ...«Прости, что я ничем не могу тебе помочь...»
text Я мотаю головой.
text Хотя мне бы хотелось остаться в её объятиях навсегда, я не могу себе этого позволить.
text Поэтому я высвобождаюсь из её рук.
text ...«Ты уже уходишь?»
text Я киваю.
text ...«Я хочу, чтобы ты был рядом со мной.»
text ...«Давай будем вместе всегда.»
text Да. Именно поэтому я это и делаю.
text Именно поэтому мне нужно идти.
text Чтобы отныне мы всегда могли быть вместе.
text Она выглядит такой одинокой...
text Но я отбрасываю эту мысль и выхожу на улицу.
setvar strS[1000] = "BG313"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s55
fi
goto 57
label s55
setvar strS[1000] = ""
label 57
