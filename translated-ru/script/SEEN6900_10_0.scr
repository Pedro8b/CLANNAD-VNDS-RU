	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я подхожу к нашей горе хлама.
text Затем осторожно кладу сверху хлам, что нашёл сегодня.
text Я уже потерял счёт тому, какую форму она должна принять.
text На самом деле она уже давно ни на что не похожа.
text Как только я кладу последние куски хлама на кучу, с одной стороны раздаётся дребезжащий звук — она начинает разваливаться.
text Я понуро опускаю голову.
text Я собираю хлам и снова складываю его в большую кучу.
text Это цикл, который я повторяю раз за разом.
text Если...
text Этот хлам принимает форму только тогда, когда этого искренне желает сердце...
text Я никогда не смогу сделать это сам...
text Ведь в конце концов...
text Я не человек.
text Я смотрю на свои руки.
text Мои грубые, прямоугольные пальцы...
text На самом деле именно желание в первую очередь и собрало меня, куклу из хлама, воедино.
text У меня такое чувство, что нам больше некуда идти.
text Мы не можем покинуть это место.
text 　...Я хочу, чтобы ты был рядом со мной.
text 　...Давай будем вместе навсегда.
text Я вспоминаю слова, что она только что мне сказала.
text Как будто...
text ...она говорила мне, что... я могу больше не стараться. Эти слова ранят.
text Мне грустно.
text Мне хочется плакать.
text Не могу поверить, насколько я беспомощен.
setvar strS[1000] = "BG314"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s56
fi
goto 58
