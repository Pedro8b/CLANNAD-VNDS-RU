setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTS10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 524.aac
text @[Комура]
text Хм...
text @[Комура]
text ...
sound 525.aac
text @[Комура]
text Разве это не...
setvar strS[1001] = "CGTS11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTS11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 526.aac
text @[Комура]
text Её младшая сестра?
text Комура отвечает, всё ещё глядя вниз на баннер, который он только что закончил писать.
sound 527.aac
text @[Комура]
text Ммм... Неплохо.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Удовлетворён своим трудом, он начинает убирать инструменты, лежащие на земле.
text Наконец он складывает баннер и встаёт.
setvar strS[1001] = "CGTS10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTS10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 528.aac
text @[Комура]
text ...Я сейчас ухожу.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я просто стою там в тишине, пока он поворачивается, собираясь вернуться к зданию.
text @[Томоя]
text Подожди минутку!
text Я зову его.
text @[Томоя]
text Ты знаешь, как называется её младшая сестра?
text Мой голос заставляет его остановиться.
setvar strS[1001] = "CGTS10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTS10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 529.aac
text @[Комура]
text Имя...
setvar strS[1001] = "CGTS11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTS11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 52A.aac
text @[Комура]
text Ммм... Думаю, это было...
sound 52B.aac
text @[Комура]
text ...Фуко.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text С этими словами он наконец отходит.
text Ах...
text Как я мог даже это забыть...
text Вот и всё, за то, чтобы не забывать её, я был так решителен.
text Всё равно память возвращается ко мне...
text ...Была маленькая праздничная шляпка.
text И прямо рядом со мной...
text @[Томоя]
text Фуко...
setvar strS[1001] = "CGFU30B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU30B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Фуко]
text Так... ты всегда был рядом со мной...
text @[Томоя]
text Так... ты всегда был рядом со мной...
sound 52C.aac
text @[Фуко]
text ...Да. Всегда.
text @[Томоя]
text Я действительно самый плохой, не правда ли?
text @[Томоя]
text Забыть о кого-то так близком...
sound 52D.aac
text @[Фуко]
text Нет, ты не самый плохой.
sound 52E.aac
text @[Фуко]
text ...Это просто естественное дело.
text @[Томоя]
text Не говори...
text @[Томоя]
text ...такое грустное дело.
text @[Томоя]
text Я хочу... быть с тобой, всегда...
sound 52F.aac
text @[Фуко]
text ...Спасибо тебе очень много.
text @[Томоя]
text Так не связывайся только своей рукой и {$lnmA}'s...
text @[Томоя]
text Кладь свою руку в нашу тоже...
setvar strS[1001] = "CGFU24B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU24B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Фуко]
text ...
sound 52G.aac
text @[Фуко]
text Тогда, пожалуйста... вытяни руку.
text Она берет мою руку в свою и крепко сжимает.
sound 52H.aac
text @[Фуко]
text Фуко... не отпускает твою руку.
text @[Томоя]
text Да, я тоже не отпущу...
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 28
