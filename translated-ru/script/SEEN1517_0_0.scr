setvar strS[1000] = ""
label 29
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Никак больше морских звёзд, стоящих нам на пути, нет. Фуко опирается на меня.
text Всё пришло к концу.
text Дни, когда ей приходилось так усердно работать, несмотря на маленькое тело.
text Она действительно, действительно старалась изо всех сил.
text Всё, что осталось, — это ожидание.
text То же, что мы делаем вечно: ждать церемонии свадьбы Коко-сан.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s25
fi
goto 30
