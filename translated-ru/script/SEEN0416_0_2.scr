bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG046N"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s101
fi
goto 106
label s101
setvar strS[1000] = ""
label 106
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text Я снова навещаю комнату Суногары той ночью.
text @[Томоя]
text Эй, Суногара? Ты жив?
sound KU.aac
text @[Суногара]
text ...
text Суногара спит, опершись головой о котатсу.
text @[Томоя]
text Похоже, ты жив.
setvar strS[1001] = "CGSH26B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KV.aac
text @[Суногара]
text Разве пылевые шахты не должны быть сделаны так, чтобы в них нельзя было упасть?
text Он поднимает голову, как только я сажусь.
text @[Томоя]
text У тебя что, вывихнуты суставы?
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KW.aac
text @[Суногара]
text Как будто этого достаточно, чтобы я упал!
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KX.aac
text @[Суногара]
text В любом случае... Оказаки.
text Он подносит своё лицо к моему.
text @[Томоя]
text Что...?
sound KY.aac
text @[Суногара]
text Эта девушка действительно сильна.
text @[Томоя]
text Да, я заметил это ещё некоторое время назад.
sound KZ.aac
text @[Суногара]
text ...
text @[Томоя]
text Ну что ж, похоже, это значит, что легендарная девушка действительно существует.
setvar strS[1001] = "CGSH21B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH21B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L0.aac
text @[Суногара]
text Она не существует!
text @[Томоя]
text Вы все еще не верите?
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L1.aac
text @[Сунохара]
text Это просто невозможно, чтобы женщина была сильнее мужчины.
text @[Томоя]
text Вы только что сделали из себя врага для каждой женщины в этой стране.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L2.aac
text @[Сунохара]
text Я имею в виду, вы видели, как она выглядит, верно?
text @[Томоя]
text Ну, я согласен, если говорить о той Томoyo dziewczине.
sound L3.aac
text @[Сунохара]
text Верно? Это просто абсурд, как она сильна.
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4.aac
text @[Сунохара]
text Может быть...
text @[Томоя]
text Что?
sound L5.aac
text @[Сунохара]
text Может быть, она на самом деле парень?
text @[Томоя]
text Я действительно начинаю беспокоиться о вашей жизни.
sound L6.aac
text @[Сунохара]
text Почему?
text @[Томоя]
text Как насчет того, чтобы сказать то же самое ей в лицо?
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L7.aac
text @[Сунохара]
text ...
text Он, должно быть, представляет себе эту сцену в своем воображении.
setvar strS[1001] = "CGSH26B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH26B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L8.aac
text @[Сунохара]
text ...
text Он, скорее всего, сейчас летит через воздух.
setvar strS[1001] = "CGSH22B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH22B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L9.aac
text @[Сунохара]
text ...
text Он, наверное, сжигается прямо сейчас.
setvar strS[1001] = "CGSH24B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LA.aac
text @[Сунохара]
text ... Я, думаю, откажусь.
text @[Томоя]
text Ты не хочешь оказаться в урне?
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LB.aac
text @[Сунохара]
text Как будто я представляю себе что-то столь далёкое?
sound LC.aac
text @[Сунохара]
text Я только дошёл до части, где я выпрыгиваю из гроба в панике!
text @[Томоя]
text Это значит, ты вернулся к жизни. Это не в твоём характере, знаешь ли.
setvar strS[1001] = "CGSH27B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LD.aac
text @[Сунохара]
text Что? Правда?
text @[Томоя]
text Просто будь хорошим мальчиком и сгори.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LE.aac
text @[Сунохара]
text Почему любое из этого имеет значение?
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LF.aac
text @[Сунохара]
text Во всяком случае, я пойду проверю.
text @[Томоя]
text Пойдёшь проверять, возможно ли воскреснуть после того, как тебя сожгли в пепел?
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LG.aac
text @[Сунохара]
text Почему бы мне проверять что-то такое страшное на собственном теле!
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LH.aac
text @[Сунохара]
text Я имею в виду, мальчик она или девочка.
text @[Томоя]
text Она, то есть Томoyo?
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LI.aac
text @[Сунохара]
text Да.
text @[Томоя]
text Как это?
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LJ.aac
text @[Сунохара]
text Есть много способов. И я собираюсь проверять, пока не узнаю точно.
text На данный момент Сунохара еще не понял...
text @[Томоя]
text ...что он ступил на путь извращенца.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LK.aac
text @[Сунохара]
text Я все слышал, знаете ли.
text @[Томоя]
text Просто притворитесь, что не слышали. Это будет намного веселее.
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LL.aac
text @[Сунохара]
text Как будто я бы сделал что-то, что бы казалось извращенным!
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LM.aac
text @[Сунохара]
text Я буду вести себя гладко.
text @[Томоя]
text Ну, убедитесь, что вы останетесь в безопасности. Я хочу услышать ваши результаты.
sound LN.aac
text @[Сунохара]
text Не недооценивайте меня.
text Я не думаю, что вы можете это сказать после того, как были полностью уничтожены в драке сегодня.
text В любом случае, я сейчас брошу попытки отговорить его.
text Я поворачиваюсь к Сунохаре и даю ему большой палец вверх.
text @[Томоя]
text Удачи, развратник! (Я буду молиться за вашу извращенность!)
text Я говорю это в самой позитивной форме.
setvar strS[1001] = "CGSH25B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LO.aac
text @[Сунохара]
text Да!
text Сунохара воспринимает это как желание удачи и дает мне равно освежающий ответ.
label 107
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s102
fi
goto 108
