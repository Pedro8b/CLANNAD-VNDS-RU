music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG021B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
