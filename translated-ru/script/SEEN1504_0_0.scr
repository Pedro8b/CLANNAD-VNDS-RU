text Я даже не могу представить, насколько это должно было быть больно для неё за последние два года.
text Тогда...
text Это ещё не закончилось.
label 21
music ~
setvar strS[1000] = "BG002"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 22
label s17
setvar strS[1000] = ""
label 22
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Фуко.
text Имя просто выскальзывает у меня изо рта без видимой причины.
music BGM08D.mp3
setvar strS[1001] = "CGFU19A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU19A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 49P.aac
text @[Фуко]
text Да?
text Её руки перестают двигаться, и она поворачивается ко мне.
text Я хочу ей показать.
text Я хочу, чтобы Коуко-сан знала, что её младшая сестра больше не убегает, когда с ней разговаривают, что Фуко теперь умеет отвечать.
setvar strS[1001] = "CGFU20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 49Q.aac
text @[Фуко]
text Не звони, если тебе нечего сказать. Это очень грубо.
text ...Но её рот всё так же резок, как всегда.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 23
label s18
setvar strS[1000] = ""
label 23
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN1505_0_0.scr
