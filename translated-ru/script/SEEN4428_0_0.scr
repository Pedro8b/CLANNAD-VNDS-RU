text Кажется, на первом курсе я был куда более напряжённым.
text Наверное, это значит, что я изменился.
text Фурукава, Кё, Фудзибаяси и Котоми.
text Прошло всего три дня с тех пор, как эта компания начала собираться в комнате драмкружка.
text Кроме Фурукавы, никто из остальных даже не состоит в драмкружке.
text Сторонний наблюдатель понятия бы не имел, что это вообще за компания.
text Думаю, вещи всегда так и меняются.
text Вместо того чтобы ждать, пока всё изменится само собой, нужно брать дело в свои руки. Иначе к лучшему ничего не изменится.
setvar strS[1000] = "BG020"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s8
fi
goto 9
label s8
setvar strS[1000] = ""
label 9
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Приближаясь к драмкружку...
text Слышу какой-то звук.
text Щекочущий, но при этом знакомый звук...
text @[Томоя]
text Скрипка?
text Я останавливаюсь и прислушиваюсь.
text Ничего не слышу.
text @[Томоя]
text Может, показалось.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s9
fi
goto 10
label s9
setvar strS[1000] = ""
label 10
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG022"
setvar intA[1000] = 1
