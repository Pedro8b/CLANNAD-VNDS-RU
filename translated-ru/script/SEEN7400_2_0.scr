setvar strS[1000] = ""
label 293
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG085"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s251
fi
goto 294
label s251
setvar strS[1000] = ""
label 294
