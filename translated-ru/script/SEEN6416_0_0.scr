music ~
setvar strS[1000] = "BG020"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text Я стою перед дверью комнаты драмкружка.
text @[Томоя]
text (Ах, я снова здесь...)
text Неужели у меня и правда настолько развито чувство ответственности?
text Я даже школьными делами пренебрегаю... так зачем я захожу так далеко?
text Я слышу топот шагов и оборачиваюсь.
text Фурукава бежит трусцой в мою сторону.
setvar strS[1001] = "CGNG25Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GCY.aac
text @[Фурукава]
text Оказаки-сан!
text В её голосе слышится радость, когда она произносит моё имя. Она подбегает и встаёт рядом со мной.
