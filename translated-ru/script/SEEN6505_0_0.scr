text @[Нагиса]
text Я тоже помогала это готовить, Томоя-кун. Хочу, чтобы ты попробовал.
setvar strS[1001] = "CGNG23A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKQ.aac
text @[Нагиса]
text Тебе нравится, когда рулет из омлета сладкий?
text @[Томоя]
text Э, ага...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она тянет меня за руку вниз, чтобы я сел.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKR.aac
text @[Санаэ]
text Пожалуйста, чувствуй себя как дома.
text @[Томоя]
text Мне сложновато расслабиться, учитывая, насколько сильно мы выделяемся...
setvar strS[1001] = "CGSN11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKS.aac
text @[Санаэ]
text Ты быстро привыкнешь.
text @[Томоя]
text Вот оно как...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она наливает чай в чашку, стоящую передо мной.
text Чуть поодаль старик играет с детьми в камень-ножницы-бумагу.
text Похоже, игроков у них и так достаточно, так что меня в итоге не зовут играть.
text Впрочем, из меня всё равно плохой бейсболист.
text @[Томоя]
text (Ах... как бы это сказать...)
text @[Томоя]
text (Это меня прямо возвращает в прошлое...)
text Я и забыл, как выглядит мир отсюда, снизу.
text Сорняки, пробивающиеся из земли, покрывают мир вокруг меня, словно газон.
text Дети, топчущие их ногами, кажутся огромными.
setvar strS[1000] = "BG080"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 14
label s12
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Кладу руки за спину и смотрю вверх — и вижу силуэт самолёта высоко в небе.
text @[Томоя]
text (Блин, до чего же... хорошо.)
text Смотрю на небо, прищурившись.
text Пока смотрю, сам не замечаю, как беру Нагису за руку.
sound KKT.aac
text @[Нагиса]
text Мы снова начинаем наше состязание?
text @[Томоя]
text Это никак не связано ни с каким состязанием...
text Просто хочется держать её за руку.
sound KKU.aac
text @[Нагиса]
text Хорошо...
text Нагиса придвигается ближе ко мне.
text Старик стоит на позиции бьющего.
text Санаэ-сан громко подбадривает его.
text Мы сидим позади неё, будто прячась...
setvar strS[1000] = "FGNG05"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 15
label s13
setvar strS[1000] = ""
label 15
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
delay 60
text ...и в этот момент у нас случается первый поцелуй.
delay 180
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s14
fi
goto 16
label s14
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 0
setvar strS[1000] = "BG005N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 17
label s15
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Наступает полночь. Как раз когда я расстилаю футон...
setvar strS[1001] = "CGAK20PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKV.aac
text @[Акио]
text Эй, ты ещё не спишь?
text Старик просовывает голову в приоткрытую дверь.
text @[Томоя]
text Ага, но я как раз собирался лечь спать.
sound KKW.aac
text @[Акио]
text В таком случае я тебе помогу. Так что пошли со мной.
text @[Томоя]
text А?
setvar strS[1001] = "CGAK14PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKX.aac
text @[Акио]
text Ты же что-то ищешь, да?
text @[Томоя]
text А, точно.
setvar strS[1000] = "BG006N2"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 18
label s16
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGAK26PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK26PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KKY.aac
text @[Акио]
text Иди тихо. Плохо будет, если Нагиса проснётся...
text @[Томоя]
text Хорошо...
sound KKZ.aac
text @[Акио]
text Не жалуйся мне, если не найдём.
text @[Томоя]
text Не буду. Я и так особо не надеюсь, если начистоту.
setvar strS[1001] = "CGAK13PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL0.aac
text @[Акио]
text Тц... Всё равно не понимаю, зачем тебе это искать.
text @[Томоя]
text Искать что?
setvar strS[1001] = "CGAK14PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL1.aac
text @[Акио]
text Тот горшок, которым Нагиса пользовалась, когда была маленькой, да?
text @[Томоя]
text Нет, я не это ищу...
setvar strS[1001] = "CGAK12PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGAK12PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL2.aac
text @[Акио]
text Ты же весь дом перевернул в поисках этой штуки!
text @[Томоя]
text Да не её я ищу! Я думал, мы просто так назвали это «Кодовое имя: Горшок», хотя на самом деле я ищу совсем другое!
setvar strS[1001] = "CGAK15PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGAK15PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL3.aac
text @[Акио]
text Это как это понимать? Это же бессмыслица какая-то! Если это «Кодовое имя: Горшок», то ты, конечно, ищешь горшок!
text @[Томоя]
text Это же КОДОВОЕ имя!
sound KL4.aac
text @[Акио]
text Чего? Кодовое имя?! Это ещё что должно значить? Ты надо мной издеваешься, парень?!
text @[Томоя]
text Это ты сам его так назвал, старик!
setvar strS[1001] = "CGAK16PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGAK16PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL5.aac
text @[Акио]
text Ты меня так и доведёшь до белого каления, паршивец!!!
music BGM08A.mp3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL6.aac
text @[Голос]
text Уже поздняя ночь, мальчики. Пожалуйста, потише, ладно?
text До наших ушей долетают слова Санаэ-сан.
setvar strS[1001] = "CGAK26PT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK26PT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL7.aac
text @[Акио]
text Тише, дурак! Разбудишь Нагису.
text @[Томоя]
text Ну ты-то хорош, чтобы говорить...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Было бы чудом, если бы она не проснулась после всего этого.
text Старик идёт по коридору бессмысленно на цыпочках.
text Иду вслед за ним.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 19
label s17
setvar strS[1000] = ""
label 19
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KL8.aac
text @[Акио]
text Уф. Пришли.
sound KL9.aac
text @[Акио]
text Пора запускать в действие план «Кодовое имя: Горшок»!
text Похоже, он вспомнил, что сам придумал этому плану кодовое имя.
text @[Томоя]
text Чтобы уж совсем ясно: я ищу вовсе не детский горшок.
sound KLA.aac
text @[Акио]
text Погоди, правда?
text @[Томоя]
text Я тебе уже говорил раньше. Есть история, которую Нагиса слышала в детстве и почти не помнит.
text @[Томоя]
text Есть шанс, что она где-то в книге, вот её я и ищу.
sound KLB.aac
text @[Акио]
text Книгу...? У меня много книг. Это будет утомительно.
sound KLC.aac
text @[Акио]
text Не сказал бы, что у меня их десять тысяч, но, пожалуй, около тысячи наберётся.
text @[Томоя]
text Тысяча чего?
sound KLD.aac
text @[Акио]
text Порножурналов.
text @[Томоя]
text ...
sound KLE.aac
text @[Акио]
text Тебе лучше держать это в секрете от Санаэ, паршивец.
music ~
text Мы вдвоём ищем почти до самого рассвета, но в итоге не находим ни одной книжки с картинками.
music BGM08D.mp3
sound KLF.aac
text @[Акио]
text Знаешь, что, наверное, произошло? Она, наверное, занимала место, вот я её и выбросил.
text Похоже, у него было полно других вещей, занимавших место, которые были менее важны, впрочем.
text С другой стороны, не знаю, сколько семей на самом деле бережно хранят книжки с картинками своих детей.
sound KLG.aac
text @[Акио]
text Теперь ты доволен?
text @[Томоя]
text ...
sound KLH.aac
text @[Акио]
text Взбодрись. Я отдам тебе часть тех порножурналов, о которых говорил.
text @[Томоя]
text Не нужны они мне...
sound KLI.aac
text @[Акио]
text Тц... А ты, оказывается, неблагодарный, знаешь ли?
sound KLJ.aac
text @[Акио]
text В любом случае, давай пока ляжем спать. У тебя же завтра школа, разве нет? Так ты вообще проспишь при таком раскладе.
text @[Томоя]
text А, точно, есть такое...
text Не имея другого выбора, сдаюсь на сегодняшнюю ночь.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 20
label s18
setvar strS[1000] = ""
label 20
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6506_0_0.scr
