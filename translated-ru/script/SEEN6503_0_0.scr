text Пока я подшучиваю над её словами, внутри у меня всё будто содрогается.
text Её слова про куклу, сделанную из хлама, вызывают в моей голове яркий образ, который будто пронзает мне сердце.
text Что же это может быть за чувство?
text Мне просто необходимо узнать, откуда взялась эта история.
setvar strS[1001] = "CGNG10AZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10AZ.png
if intF[1113] == 1
