setvar intF[1112] = 0
music BGM26B.mp3
delay 120
setvar strS[1000] = "BG304"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s39
fi
goto 40
label s39
setvar strS[1000] = ""
label 40
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ...«Готово!»
text Произнося это слово, она падает на пол.
text Я толком не понимаю, что она сделала.
text Она садится.
text ...«Знаешь, что это?»
text Я мотаю головой из стороны в сторону.
text ...«Штука, которая подбрасывает тебя в воздух.»
text Я озадаченно наклоняю голову набок.
text ...«Просто подойди сюда и залезь на это.»
text Я даже не знаю, куда мне забираться.
text Ведь вся эта штука наклонена.
text Пока я стою в растерянности, она поднимает меня и сажает на верхний конец наклонной доски.
text ...«Держись вот за это, а то и правда улетишь.»
text Я хватаюсь за рукоять передо мной.
text ...«Хорошо.»
text Она обходит доску с другой стороны и садится точно так же, как я.
text Когда она это делает, моё тело взмывает в воздух.
text Теперь она подо мной.
text Она выпрямляет ноги.
text Теперь наши позиции меняются местами.
text Она повторяет это снова и снова.
text Мой мир то поднимается, то опускается.
text Она смеётся, а её волосы развеваются в воздухе, закрывая лицо.
text ...«Разве не весело?»
text Я киваю.
text Больше всего меня радует то, что мы вместе смогли сделать что-то настолько весёлое.
text Пусть временами мне и было страшно, но я по-настоящему рад, что всё так обернулось.
text ...«Может, начнём делать что-нибудь ещё?»
text Она предлагает мне это.
text ...«Ты ведь снова мне поможешь?»
text Конечно.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s40
fi
goto 41
label s40
setvar strS[1000] = ""
label 41
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы продолжаем в том же духе — собираем хлам и мастерим игрушки.
text Не успеваю я опомниться, как площадка перед нашим домом превращается в детскую площадку.
text Наконец мы строим смотровую вышку, что взмывает высоко в небо.
setvar strS[1000] = "BG310"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s41
fi
goto 42
label s41
setvar strS[1000] = ""
label 42
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я сижу у неё на коленях, и вместе мы смотрим вниз на землю.
text Я вижу площадку, которую мы построили только для нас двоих, и больше ни для кого.
text Отсюда она выглядит такой пустынной.
text И в то же время я вспоминаю, почему мир из моих воспоминаний казался таким тёплым:
text Он был полон людей.
text Я смотрю на неё снизу вверх.
text ...«Хм?»
text Она озадаченно смотрит на меня сверху.
text Знает ли она всё?
text Живёт ли она здесь, приняв всё как есть?
text И обязательно ли это должна была быть именно она?
text Или так просто вышло, что это оказалась она?
text В любом случае, куда ещё печальнее может быть этот мир?
text Как она вообще может любить этот мир?
text Если бы не я, она была бы совершенно одна.
text Она была совсем одна всё то время, пока я не родился...
text Какой была её жизнь тогда?
text Как она проводила свои дни?
text О чём она могла думать...
text Живя в таком безрадостном мире, как этот?
text ...«Что случилось?»
text Она задаёт мне вопрос.
text ...«Тебе хочется плакать?»
text Я киваю.
text ...«Ты вспомнил что-то грустное?»
text Нет.
text Грустно всё.
text Всё это трагично.
text Это место не может терпеть существование тех, у кого есть сердце.
text Это неправильно.
text Это место следовало бы оставить позади и забыть всем и всему.
text Я смотрю на края этого мира.
text Конец света.
text Он наполнен скорбным цветом.
text И именно здесь мне суждено закончиться.
text Я буду доходить до своего конца здесь целую вечность.
text Она, должно быть, поняла это уже давно.
text 　...Ты этого искал...?
text 　...Родиться в этом месте?
text Вот почему она задала мне тот вопрос, когда я впервые взглянул на внешний мир.
text Небо — единственное, что здесь простирается надо всем.
text Глядя на него, я думаю... возможно, где-то у его края найдётся конец.
text Или, возможно, именно там и находится тот мир, где я когда-то был.
text ...«Если бы мы только могли плакать.»
text Я смотрю в небо, пока она держит меня на руках.
text Если бы это небо было связано с другим, отдельным миром...
text Я бы хотел забрать её туда.
text Но как...?
text Я ищу в своём сердце способ.
text Но... я не могу придумать ни одной идеи.
text Кажется, запах ветра изменился.
text Это происходит впервые с тех пор, как я здесь родился.
text Её рука обнимает меня ещё крепче.
text Она, должно быть, тоже это заметила.
text ...«Значит, даже в этом мире... бывает зима.»
text Она произносит эти слова, не отрывая взгляда от одной и той же точки.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s42
fi
goto 43
label s42
setvar strS[1000] = ""
label 43
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6900_9_0.scr
