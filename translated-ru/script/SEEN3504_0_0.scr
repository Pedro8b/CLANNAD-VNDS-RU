setvar intF[1110] = 4
setvar intF[1112] = 1
setvar strS[1004] = "SDTA0504"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1004] = ""
label 1
bgload SCLAB00.jpg 45
delay 60
setimg SCLAP06.png 5 5
setimg SCLA0504.png 159 160
delay 120
if 0 == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = "KURO"
goto 4
label 2
if 0 == 1
	goto s2
fi
goto 3
label s2
setvar strS[1000] = "SIRO"
goto 4
label 3
setvar strS[1000] = "KURO"
label 4
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG035"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 5
label s3
setvar strS[1000] = ""
label 5
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM09A.mp3
text Воскресенье. Как и вчера, я здесь, в торговом квартале.
text Когда сегодня днём я проснулся, первое, что попалось мне на глаза, — маленький бумажный пакетик.
text Тот самый, с картами Таро, что вчера вручила мне Кё.
text Она сказала мне отдать это Фудзибаяси и сказать, что это от меня.
text В любом случае, полагаю, я подчинюсь и последую её плану.
text Однако... если это будет всё, что я ей подарю, мне станет стыдно за себя.
text Тот факт, что первый подарок моей девушке — это не то, что я купил сам.
text Более того, это ей подарила её же сестра.
text @[Томоя]
text Если я правильно помню, это должно быть где-то здесь...
text Я оглядываюсь, пытаясь найти магазин, который помню лишь смутно.
text Я замечаю магазин на углу — его витрина куда роскошнее, чем у соседних.
text @[Томоя]
text Вот он.
text Найдя пункт назначения, я направляюсь к нему.
sound AAN.aac
text @[Продавец]
text Добро пожаловать.
text Продавщица замечает меня и заговаривает.
sound AAO.aac
text @[Продавец]
text Ищете подарок?
text @[Томоя]
text А, да.
text Отвечаю я, глядя на множество сверкающих украшений, аккуратно разложенных на витрине.
text Ассортимент не тот же, что был на прошлой неделе...
sound AAP.aac
text @[Продавец]
text Ищете что-то конкретное?
sound AAQ.aac
text @[Продавец]
text Рекомендую колье или браслеты — они подойдут к лёгкой одежде следующего сезона.
text Говорит она, демонстрируя деловую улыбку.
text @[Томоя]
text Эм... я хочу кулон.
sound AAR.aac
text @[Продавец]
text Кулон, значит? В таком случае в этом месяце у нас скидка на изумруды.
sound AAS.aac
text @[Продавец]
text Хотя цепочки из платины, они очень доступны по цене.
text @[Томоя]
text ...
text Я пристально смотрю на количество нулей и считаю.
text Между получившейся суммой и тем, что сейчас у меня в кошельке, есть некоторый разрыв.
sound AAT.aac
text @[Продавец]
text Достать, чтобы вы подержали?
text @[Томоя]
text Н-нет, не нужно.
text @[Томоя]
text Кстати, а где то, что выставляли здесь на прошлой неделе?
sound AAU.aac
text @[Продавец]
text А, они вот здесь.
text С улыбкой на лице продавщица ведёт меня внутрь.
text Поскольку я не слишком привык к таким магазинам, я немного медлю, прежде чем войти.
sound AAV.aac
text @[Продавец]
text Сюда.
text Не теряя улыбки, продавщица указывает рукой на витрину.
text Я смотрю на витрину и нахожу несколько колец и кулонов, которые видел раньше.
sound AAW.aac
text @[Продавец]
text Нашли то, что искали?
text @[Томоя]
text Э-э... хм...
text Я начинаю по очереди рассматривать каждый кулон.
text Вот зелёный... синий... красный... а этот меняет цвет в зависимости от освещения...
text Свет внутри витрины освещает серебро, придавая ему сияющий блеск.
text Подумать только, что я буду всерьёз разглядывать подобные вещи...
text Я тихо и горько усмехаюсь про себя.
sound AAX.aac
text @[Продавец]
text Если что-то вас заинтересовало, достать для вас?
text @[Томоя]
text А? Э-э, дайте мне минутку.
text У меня такое чувство, что меня торопят.
text Почему продавщицы в магазинах украшений всегда так спешат?
text Я всматриваюсь в кулоны на витрине и сравниваю их.
text Если я правильно помню, тот, о котором она говорила в прошлый раз...
text Мой взгляд останавливается на сверкающем камне.
sound AAY.aac
text @[Продавец]
text Нашли то, что искали?
text @[Томоя]
text Да, покажите мне, пожалуйста, вот этот кулон с камнем.
sound AAZ.aac
text @[Продавец]
text Хм... это танзанит или аметист?
text @[Томоя]
text Э-э... хм... ну...
text Какой же из них был...?
choice Танзанит|Аметист
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s4
fi
goto 6
label s4
text @[Томоя]
text Можно мне кулон с танзанитом?
setvar intF[311] = 1
label 6
if intF[1089] == 1
	goto s5
fi
goto 7
label s5
text @[Томоя]
text Можно мне кулон с аметистом?
setvar intF[310] = 1
label 7
sound AB0.aac
text @[Продавец]
text Да, сейчас же.
text Она достаёт его из футляра и протягивает мне.
sound AB1.aac
text @[Продавец]
text Что скажете?
text @[Томоя]
text Хм, да, я возьму это.
sound AB2.aac
text @[Продавец]
text Да, сейчас же.
sound AB3.aac
text @[Продавец]
text Устроит ли вас такая длина цепочки?
text @[Томоя]
text А? В смысле, длина?
sound AB4.aac
text @[Продавец]
text Сейчас её длина сорок пять сантиметров. Если её надеть, камень окажется примерно на уровне ключиц.
sound AB5.aac
text @[Продавец]
text Она покажется немного короткой, и если вы не привыкли носить такое, может быть слегка трудно дышать...
text @[Томоя]
text Эм, вообще-то носить его буду не я...
sound AB6.aac
text @[Продавец]
text А, это подарок?
text @[Томоя]
text Ага, вроде того...
sound AB7.aac
text @[Продавец]
text Для девушки?
text @[Томоя]
text Да...
sound AB8.aac
text @[Продавец]
text В таком случае, думаю, такая длина будет в самый раз.
text @[Томоя]
text Понятно. Тогда я его возьму.
sound AB9.aac
text @[Продавец]
text Да, сейчас же.
text Продавщица достаёт кулон из витрины и очень аккуратно протирает его фетровой тряпочкой, вынутой из кармана. Затем показывает его мне.
text Наверное, эта ткань предназначена для полировки серебра. Металлические части теперь блестят ещё ярче.
sound ABA.aac
text @[Продавец]
text Подойдёт?
text @[Томоя]
text Да.
sound ABB.aac
text @[Продавец]
text У нас также есть подарочные футляры за 500 иен. Хотите один?
text @[Томоя]
text А, тогда положите его в футляр, пожалуйста.
sound ABC.aac
text @[Продавец]
text Хорошо.
text Продавщица снова смотрит на меня с уже привычной мне улыбкой и направляется к кассе.
text Я иду следом за ней.
text Глядя, как продавщица аккуратно вручную упаковывает кулон, я представляю, как вручаю его ей.
text Интересно, обрадуется ли она такому подарку.
text Сегодня я узнал, что покупка подарка для кого-то может быть неожиданно увлекательным занятием.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s6
fi
goto 8
label s6
setvar strS[1000] = ""
label 8
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
jump SEEN3505_0_0.scr
