text @[Кё]
text Ах...ахаха... похоже, она не смогла.
sound 9VK.aac
text @[Рё]
text Эм... эхх... прости меня...
text @[Томоя]
text Не-а, это не так уж важно.
text Меня бы больше смутило, если бы у тебя получилось.
sound 9VL.aac
text @[Кё]
text Ну... наверное, это было слишком внезапно.
sound 9VM.aac
text @[Рё]
text Эхх... прости...
text @[Томоя]
text В любом случае, давайте есть. Иначе мы не успеем до конца обеденного перерыва.
sound 9VN.aac
text @[Кё]
text Именно так. Старайся изо всех сил, Томоя!
text @[Томоя]
text Эй, ты тоже поешь немного!
text Мы ускоряем темп работы палочками.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 27
label s24
setvar strS[1000] = ""
label 27
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text К тому моменту, как начинает звенеть звонок...
text Мне как-то удаётся проглотить последнюю сосиску.
setvar strS[1000] = "BG021A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s25
fi
goto 28
label s25
setvar strS[1000] = ""
label 28
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08B.mp3
text Пятый урок. Мой живот совершенно набит, и меня ужасно клонит в сон.
text Учитель английского проводит перекличку.
sound 9VO.aac
text @[Учитель]
text Сунохара. Сунохара ушёл раньше?
text Что с ним такое...? Он уже ушёл?
text В том, что он опаздывает, нет ничего необычного, но вот чтобы он уходил раньше — это уж точно редкость.
sound 9VP.aac
text @[Учитель]
text Какой же он безнадёжный тип... Секигути!
sound 9VQ.aac
text @[Сэкигути]
text Здесь.
text Учитель отмечает Сунохару отсутствующим и называет следующее имя по списку.
sound 9VR.aac
text @[Ученик]
setvar intA[1000] = 2300
setvar intA[1001] = 23
if 50 <= 0
	goto s26
fi
goto 29
label s26
setvar intA[1001] + 1
label 29
text Слушай, ты слышал странную историю про мужской туалет?
sound 9VS.aac
text @[Ученик]
setvar intA[1000] = 2300
setvar intA[1001] = 23
if 50 <= 0
	goto s27
fi
goto 30
label s27
setvar intA[1001] + 1
label 30
text Ага, там какой-то парень написал что-то вроде «Моя личная комната» и заперся внутри, да?
sound 9VT.aac
text @[Ученик]
setvar intA[1000] = 2300
setvar intA[1001] = 23
if 50 <= 0
	goto s28
fi
goto 31
label s28
setvar intA[1001] + 1
label 31
text Это так жутко, я даже близко к этому месту подходить не хочу.
text @[Томоя]
text Ах...
text Я про него забыл...
text И всё же, раз уж урок уже начался... ну, наверное, выпущу его на следующей перемене.
text Я киваю сам себе и поддаюсь вызванной едой сонливости, опустив голову на руки.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s29
fi
goto 32
label s29
setvar strS[1000] = ""
label 32
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text .........
text ......
text ...
setvar strS[1000] = "BG021A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s30
fi
goto 33
label s30
setvar strS[1000] = ""
label 33
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text К тому моменту, как я просыпаюсь, уже начался шестой урок.
text Учитель языка проводит перекличку.
text @[Томоя]
text ...Прости меня, Сунохара.
text Я решаю, что вызволю Сунохару после уроков.
music ~
if 0 == 0
	goto s31
fi
goto 34
label s31
setvar strS[1000] = "KURO"
goto 36
label 34
if 0 == 1
	goto s32
fi
goto 35
label s32
setvar strS[1000] = "SIRO"
goto 36
label 35
setvar strS[1000] = "KURO"
label 36
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
jump SEEN3501_0_0.scr
