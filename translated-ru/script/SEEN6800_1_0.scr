text Ты не можешь принимать такие важные решения, полагаясь на предчувствие, идиот!
text @[Томоя]
text Ты вечно твердишь о своей дурацкой удаче или своих дурацких предчувствиях...
text @[Томоя]
text Я не знаю, что ты обо мне думаешь...
text @[Томоя]
text И я сам едва ли это чувствую, но...
text @[Томоя]
text Но знаешь что...
text @[Томоя]
text Я твоя семья!!
setvar strS[1001] = "CGNY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound N4M.aac
text @[Отец]
text ...
text Он стоит так какое-то время, неподвижно.
text Он подносит руку к подбородку.
text Затем начинает поглаживать щетину.
sound N4N.aac
text @[Отец]
text Томоя-кун...
sound N4O.aac
text @[Отец]
text Слушай, сегодня...
sound N4P.aac
text @[Отец]
text Ты привёл девушку и всё такое...
text Что...?
text Это его отговорка на сегодня?
text Так он уклоняется от того, чтобы согласиться со мной, что мы семья?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text ...
text Я хочу что-нибудь ударить. Мне всё равно, что.
text Стену, окно ─ что угодно.
choice Ударить что-нибудь|Сдержаться
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s478
fi
jump SEEN6800_1_1.scr 595
label s478
text Я замахиваюсь рукой.
text Комнату наполняет грохот.
text Я не очень помню, что было после этого.
text Тыльная сторона моей руки горячая.
text Нагиса обнимает меня.
setvar strS[1001] = "CGNG33B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound N4Q.aac
text @[Нагиса]
text Так нельзя, Томоя-кун...
sound N4R.aac
text @[Нагиса]
text Ты порежешь руку...
sound N4S.aac
text @[Нагиса]
text Нам нужно в больницу...
music ~
if 0 == 0
	goto s479
fi
goto 589
label s479
setvar strS[1000] = "KURO"
jump SEEN6800_1_1.scr 591
label 589
if 0 == 1
	goto s480
fi
jump SEEN6800_1_1.scr 590
label s480
setvar strS[1000] = "SIRO"
jump SEEN6800_1_1.scr 591
jump SEEN6800_1_1.scr
