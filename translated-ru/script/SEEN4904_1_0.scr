setvar strS[1000] = "BG009"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я просыпаюсь, как обычно.
text Первое, о чём я думаю, — что сегодня у меня свидание с Котоми.
text Вчера я был так взволнован, а сегодня утром гораздо спокойнее.
text Я смотрю на часы.
text До встречи ещё есть время, но бессмысленно тянуть в доме.
text @[Томоя]
text (Я могу просто позавтракать по пути туда...)
text Я встаю с кровати.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text Я приезжаю в место нашей встречи в 9:30.
text Я чувствовал, что она будет здесь, и она действительно здесь.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHL.aac
text @[Котоми]
text Томоя-кун, привет.
text @[Томоя]
text "Привет" не совсем уместно. Тебе следовало сказать "Доброе утро".
text Я отвечаю без разбору и дважды оглядываюсь на наряд Котоми.
text На ней черное платье с низким вырезом.
text Я ожидал, что она наденет что‑то более детское или простое, поэтому это меня действительно удивило.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Я понесу твои вещи.
text Я беру её тканевую сумку с ланч-боксами.
text Она кажется довольно большой для двоих, но легче, чем выглядит.
text @[Томоя]
text Бутерброды?
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHM.aac
text @[Котоми]
text Да.
text @[Томоя]
text Ох. Ну, мы можем есть бутерброды где угодно...
text После ответа я понимаю, что мы ещё не решили, куда пойдём.
text @[Томоя]
text Есть ли место, куда ты хочешь пойти?
sound EHN.aac
text @[Котоми]
text Эм...
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHO.aac
text @[Котоми]
text Если тебе удобно, Томоя-кун...
text Она смотрит на меня, пока говорит.
sound EHP.aac
text @[Котоми]
text Мне бы подошла школьная библиотека.
text @[Томоя]
text …
text Я не ожидал этого.
setvar strS[1001] = "CGKT21D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT21D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHQ.aac
text @[Котоми]
text Можем ли мы?
text @[Томоя]
text Хм, мне всё равно, но...
text Мне бы хотелось избежать туристических мест в отпуске, но поход в школу кажется просто обычным.
text Тем не менее, у меня не было собственных планов...
text @[Томоя]
text Да, мы можем пойти в библиотеку.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она, кажется, улыбается и вздыхает с облегчением, услышав мой ответ.
text Похоже, библиотека – особое место для Котоми.
text Мы сможем устроить более обычное "свидание" в другой раз.
text @[Томоя]
text Давай пойдем.
setvar strS[1001] = "CGKT17C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT17C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHR.aac
text @[Котоми]
text Хорошо.
text Мы оба начинаем идти.
jump SEEN4904_3_0.scr
jump SEEN4904_2_0.scr
