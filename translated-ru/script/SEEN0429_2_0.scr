setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1II.aac
text @[Акио]
text Я не собираюсь просить тебя играть в мелкую игру. Делай удар по‑крупному.
text @[Томоя]
text ...Почему?
setvar strS[1001] = "CGAK13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM01.mp3
sound 1IJ.aac
text @[Акио]
text Потому что всё это началось с тебя.
sound 1IK.aac
text @[Акио]
text Ты тот, кто довёл меня до этой точки.
sound 1IL.aac
text @[Акио]
text Я теперь признаю тебя как мужчину.
sound 1IM.aac
text @[Акио]
text Я не могу допустить, чтобы ты не попал в мяч.
setvar strS[1001] = "CGAK14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1IN.aac
text @[Акио]
text Теперь покажи, на что ты способен.
sound 1IO.aac
text @[Акио]
text Не бойся.
sound 1IP.aac
text @[Акио]
text Нет ничего, чего бояться.
sound 1IQ.aac
text @[Акио]
text Я смотрю на тебя как на мужчину прямо сейчас...
sound 1IR.aac
text @[Акио]
text Так что выходи туда.
setvar strS[1001] = "CGAK13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1IS.aac
text @[Акио]
text И...
