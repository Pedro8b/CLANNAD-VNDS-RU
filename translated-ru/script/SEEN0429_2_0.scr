text @[Санаэ]
text Ты сможешь!
text Эти слова звучат так фальшиво...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Дополнительные иннинги.
music BGM28.mp3
text В центре поля Томойо теперь присоединяется к Ёсино Юскэ на левом поле — оба просто стоят, ошеломлённые и растерянные.
text @[Томоя]
text (Ах, Фуко... сейчас именно ты — краеугольный камень нашей защиты...)
text *КЛЭЭЭНК*
text Высокая свеча летит к ней на правое поле.
text Как всегда, Фуко суетится, закрывает глаза и бестолково прыгает.
text Но мяч падает совсем в другом месте.
setvar strS[1001] = "CGFU22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1HO.aac
text @[Фуко]
text Ваааа?!
text Вообще-то, именно так обычно и должно быть.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Пока она бегает за мячом, бэттер успевает добежать до третьей базы.
text *КЛЭНК*
text Следующий бэттер выбивает неуверенный удар по земле во внутреннее поле.
text Бегун с третьей базы бросается к домашней базе.
text Мэй-тян бросается к мячу, подбирает его и одним слитным движением кидает на домашнюю базу.
text Сунохара ловит мяч, и они с бегуном сталкиваются на домашней базе.
sound 1HP.aac
text @[Судья]
text Аут!!
setvar strS[1001] = "CGME14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGME14.png
if intF[1113] == 1
