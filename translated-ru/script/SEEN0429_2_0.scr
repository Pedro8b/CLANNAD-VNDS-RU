setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Пока это происходит, я стою спокойно.
text Я хватаю биту.
setvar strS[1001] = "CGSH17B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH17B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1IE.aac
text @[Сунохара]
text Оказаки, жертвенный бант в этот раз! Жертвенный бант! Так бы поступил настоящий мужчина!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Если я смогу продвинуть обоих бегунов бантой, у Фуко будут бегуны на второй и третьей базе.
text Даже если Фуко будет выбита, Сунохара получит шанс выйти на биту с бегунами на базах.
text Но у Сунохары всё ещё нет ни одного удара.
