setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK23A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 1IT.aac
text @[Акио]
text ...принеси победу этому городу.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я медленно шагаю вперёд, слова толкают меня вперёд.
text Давай победим.
text Я стою в бокс для бэттера и наблюдаю за солнцем, которое садится вдалеке.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s101
fi
goto 104
label s101
setvar strS[1000] = ""
label 104
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 301
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 0
text Я не знаю, когда это произошло, но мы все разошлись по разным путям...
text Все пошли в колледж после окончания старшей школы.
text Мисаэ-сан всё ещё домохозяйка общежития, так же занята, как всегда. Поскольку у меня нет причин приходить туда, я больше её не вижу.
text Что касается Фурукава Брейд, я не слишком требователен к хлебу, поэтому перестал покупать у них.
text Ёсино Юсуке, вероятно, всё ещё занимается электрикой где-нибудь в этом городе.
text Я поражён тем, что столько раз встречал его, когда был студентом. После выпуска перестал видеть его по городу.
text Сунохара и Мэй-чан вернулись в семейный дом.
text И даже несмотря на то, что мы разбросаны...
text Время от времени я вспоминаю ту одну игру в grass-lot бейсбол.
text Это заставляет меня улыбаться.
text Это было приятно.
text И не потому, выиграли мы или проиграли.
text Немного улыбнувшись, я успокаиваюсь.
text Вот так я восстанавливаю силы духа.
text Ради всех дней, что ещё ждут меня впереди.
text Ну что, вперёд.
music ~
text Я снова поднимаюсь на ноги.
jump SEEN0429_3_0.scr
