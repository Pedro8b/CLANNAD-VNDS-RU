sound J8M.aac
text @[Нагиса]
text Мэй-чан тоже, кажется, выглядит облегчённой.
sound J8N.aac
text @[Нагиса]
text Рада, что привезла её.
label 25
text @[Томоя]
text Она идеально подходит, чтобы вымотать Сунохара до костей.
setvar strS[1001] = "CGSH16B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8O.aac
text @[Сунохара]
text Я не оставлю ничего на завтра!
text @[Томоя]
text Завтра матч, ты идиот. Сохрани немного энергии.
sound J8P.aac
text @[Сунохара]
text Да, но Мэй...
setvar strS[1001] = "CGME19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGME19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8Q.aac
text @[Мэй]
text Онии-чан, ты опять отдыхаешь!
sound J8R.aac
text @[Сунохара]
text Тебе бы просто вернуться домой!
setvar strS[1001] = "CGME10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGME10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8S.aac
text @[Мэй]
text Так что я могу зайти в твою комнату и копаться в твоих ящиках?
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8T.aac
text @[Сунохара]
text ЧАРРРРРРГЕ─────!!
text @[Томоя]
text Посмотри, как он рычит вокруг.
setvar strS[1001] = "CGNG25"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8U.aac
text @[Нагиса]
text Эти двое так хорошо ладят.
text Интересно, как так.
goto 27
label 26
if intF[27] == 0
	goto s23
fi
goto 27
label s23
text Я начинаю двигаться от отчаяния.
text Единственное спасение здесь — то, что рядом есть Нагиса.
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8V.aac
text @[Нагиса]
text Вот пас.
setvar strS[1001] = "CGNG25Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8W.aac
text @[Нагиса]
text Это было хорошо? Хехе.
text Хотя я и ненавижу играть в баскетбол, она делает это терпимым.
text @[Томоя]
text Если возможно, можешь постараться ограничиться максимум одним отскоком?
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound J8X.aac
text @[Нагиса]
text Окей. Я попробую.
text Но, конечно, наша команда не могла бы стать хуже...
label 27
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы проводим весь день на тренировках, пытаясь найти способы компенсировать наши очевидные недостатки.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 28
label s24
setvar strS[1000] = ""
label 28
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6430_0_0.scr
