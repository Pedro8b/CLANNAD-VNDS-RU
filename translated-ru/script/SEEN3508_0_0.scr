		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound APR.aac
text @[Рё]
text Ты права... это и правда немного смущает.
setvar strS[1001] = "CGRY22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Слегка покраснев, Фудзибаяси улыбается, а затем пьёт из коробки апельсинового сока, которую держит в руках.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
