music ~
setvar strS[1000] = "BG031Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 16
label s15
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Устав смотреть, как Сунохара переживает из-за проигрыша в игре, я выхожу на улицу — сменить обстановку.
text К моему возвращению он всё равно уже придёт в норму.
text @[Томоя]
text М?
music BGM09A.mp3
text Навстречу идёт знакомый мне человек, держа перед собой раскрытый журнал.
text @[Томоя]
text Привет.
setvar strS[1001] = "CGKP18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUJ.aac
text @[Каппэй]
text А... Томоя-кун.
text @[Томоя]
text Как дела с работой курьером по доставке пиццы? Тебя взяли?
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUK.aac
text @[Каппэй]
text ...
text Не говоря ни слова, он показывает мне журнал, который держит в руках.
text Это журнал с объявлениями о работе.
sound UUL.aac
text @[Каппэй]
text Вот тебе и ответ.
text @[Томоя]
text Не взяли, значит?
sound UUM.aac
text @[Каппэй]
text Не обязательно говорить это так прямо...
text @[Томоя]
text Просто хотел убедиться.
setvar strS[1001] = "CGKP17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUN.aac
text @[Каппэй]
text Ты такой злюка, Томоя-кун...
text @[Томоя]
text Просто не люблю такую неопределённость.
text @[Томоя]
text Ну и? Почему тебе отказали?
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUO.aac
text @[Каппэй]
text Ах да! Дай мне рассказать!
sound UUP.aac
text @[Каппэй]
text И всё из-за такой мелочи! Ну блин!
text @[Томоя]
text Что случилось? Ты злишься?
sound UUQ.aac
text @[Каппэй]
text Да, злюсь. Я, между прочим, тоже умею злиться.
text @[Томоя]
text Что произошло? Тебя домогались на собеседовании?
music ~
setvar strS[1001] = "CGKP14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM11.mp3
sound UUR.aac
text @[Каппэй]
text Нет!
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUS.aac
text @[Каппэй]
text Меня спросили, есть ли у меня права, и когда я честно ответил, что нет, мне сказали уходить.
sound UUT.aac
text @[Каппэй]
text В наши дни водить мопед без прав вообще-то не так уж и сложно!
sound UUU.aac
text @[Каппэй]
text Для скутера нужно всего лишь чуть повернуть правую руку — и он едет, разве нет?
sound UUV.aac
text @[Каппэй]
text Нельзя же вот так вот издеваться над человеком.
music ~
text @[Томоя]
text По-моему, это ты сейчас издеваешься над ними.
setvar strS[1001] = "CGKP18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM09A.mp3
sound UUW.aac
text @[Каппэй]
text А? Почему?
text @[Томоя]
text Если ездить на мопеде без прав, тебя поймают.
sound UUX.aac
text @[Каппэй]
text Да ну, не поймают. Было бы проблемой, если бы узнала полиция, но пока не облажаешься, тебя и не заметят.
text @[Томоя]
text А их как раз и беспокоило, что будет, если тебя поймают.
setvar strS[1001] = "CGKP17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUY.aac
text @[Каппэй]
text Как узколобо.
text @[Томоя]
text По-моему, это скорее у тебя слишком широкие взгляды.
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUZ.aac
text @[Каппэй]
text В общем, работа, где нужны права? Я пас.
sound UV0.aac
text @[Каппэй]
text По-мужски — заниматься работой, которую можно делать голыми руками.
text @[Томоя]
text Э-э... ну, удачи.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Вяло подняв руку на прощание, я собираюсь уйти─
music ~
text *Хвать*!
text ─Или нет.
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text Тонкие пальцы Каппэя сжимают мою руку.
text @[Томоя]
text Что?
setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV1.aac
text @[Каппэй]
text Ну вообще, у меня сейчас ещё одно собеседование.
text @[Томоя]
text Ну тогда удачи.
text *Тряс* *Тряс*
text Я пытаюсь вытряхнуть руку, но Каппэй не отпускает.
sound UV2.aac
text @[Каппэй]
text Я подумал попробовать себя в фастфуде.
text @[Томоя]
text Желаю тебе удачи.
text *Тряс* *Тряс*
sound UV3.aac
text @[Каппэй]
text Слышал про «МОФ Бургер»? Это довольно известная общенациональная сеть.
text @[Томоя]
text Всего наилучшего.
text *Тряс* *Тряс*
sound UV4.aac
text @[Каппэй]
text Я буду нервничать, если пойду один. Составишь мне компанию?
text @[Томоя]
text Удачи тебе одному.
text *Тряс* *Тряс*
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV5.aac
text @[Каппэй]
text Да брось, не говори так. Будет весело.
text @[Томоя]
text У меня нет времени на подработку!
sound UV6.aac
text @[Каппэй]
text Я слышал, что случайные встречи часто бывают судьбой!
text @[Томоя]
text Хватит нести чушь!
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV7.aac
text @[Каппэй]
text Платят 730 иен в час, между прочим. Если продержишься там два часа, считай, ты уже заработал 1460 иен!
text @[Томоя]
text Иди уже и работай по-настоящему.
sound UV8.aac
text @[Каппэй]
text Давай работать вместе. Будем вместе с утра до вечера!
text @[Томоя]
text У меня школа.
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV9.aac
text @[Каппэй]
text Раз уж до этого дошло, просто не беспокойся об этом.
text @[Томоя]
text Какой же ты эгоист...
sound UVA.aac
text @[Каппэй]
text Лучше называй это честностью.
text @[Томоя]
text В общем, иди подрабатывай сам.
text @[Томоя]
text К тому же, если приведёшь с собой друга, у тебя меньше шансов, что тебя возьмут.
setvar strS[1001] = "CGKP18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVB.aac
text @[Каппэй]
text А? Правда, что ли?
text @[Томоя]
text Ага, потому что если один из них уволится, скорее всего, и друг за ним уволится.
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVC.aac
text @[Каппэй]
text Томоя-кун, это будет проблемой, так что не ходи за мной, ладно?
text @[Томоя]
text Ну ты и правда редкостный эгоист...
setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVD.aac
text @[Каппэй]
text Ну, от этого зависит моя жизнь. Я должен относиться к этому очень серьёзно.
text @[Томоя]
text Понятно...
setvar strS[1001] = "CGKP10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVE.aac
text @[Каппэй]
text Ну ладно, я пошёл туда.
sound UVF.aac
text @[Каппэй]
text В следующий раз, когда встретимся, обязательно зови меня Мистер Бургер.
text @[Томоя]
text Пока, Мистер Бургер.
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVG.aac
text @[Каппэй]
text Ахахаха, ещё рано!
text Он и правда идиот...
sound UVH.aac
text @[Каппэй]
text Если зайдёшь в магазин, я подкину тебе два лишних огурчика!
sound UVI.aac
text @[Каппэй]
text Разве не приятно получить пару лишних огурчиков, а?
sound UVJ.aac
text @[Каппэй]
text Ахахахаха!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Каппэй уходит на собеседование, радостно смеясь всю дорогу.
text Каппэй, работающий в бургерной, значит...? Не хочу оказаться рядом с этим...
text ......
text Впрочем, вряд ли его вообще возьмут.
music ~
setvar intF[320] = 4
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN7600_4_0.scr
