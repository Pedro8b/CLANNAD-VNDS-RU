text Уже после заката я иду по дороге один, проводив Фудзибаяси до дома.
text Это был весёлый день.
text Правда так думаю.
setvar strS[1000] = "BG009N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s32
fi
goto 33
label s32
setvar strS[1000] = ""
label 33
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
