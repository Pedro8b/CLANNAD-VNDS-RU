	fi
fi
text Вернувшись к себе в комнату, я смотрю на поверхность стола.
text Там лежит аккуратно упакованный пакетик.
text Это тот самый кулон, который я купил вчера...
text Подумать только, я про него забыл, хотя положил его на такое заметное место...
text ...Ну... ничего страшного. Я могу подарить его в любой момент.
text Если бы я подарил ей сразу обе вещи, это могло бы лишь ещё больше смутить Фудзибаяси.
text В конце концов, она и от одних только карт таро была в таком восторге.
if intF[312] == 1
	if intF[311] == 1
		if intF[308] == 0
			goto s33
		fi
	fi
fi
goto 35
