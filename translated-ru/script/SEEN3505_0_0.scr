text Я решаюсь и вытягиваю одну карту.
text Самая первая карта ─ можно сказать, памятная ─ которую я вытянул, это...
setvar strS[1001] = "CGRY12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
