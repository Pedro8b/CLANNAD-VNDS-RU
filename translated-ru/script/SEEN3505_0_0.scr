text Ах... э... н-не думай об этом слишком много, ладно?
text @[Томоя]
text Просто сейчас... эм... кажется, я немного поспешила... я совсем не подумала о твоих чувствах...
setvar strS[1001] = "CGRY14E"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY14E.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AE6.aac
text @[Рё]
text Н-нет! Я─ Ну... эм... мне было слишком неловко...
text @[Томоя]
text ...
setvar strS[1001] = "CGRY23D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
