text @[Томоя]
text ...
text Почему-то эта карта кажется мне неприятной.
setvar strS[1001] = "CGRY11D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11D.png
if intF[1113] == 1
