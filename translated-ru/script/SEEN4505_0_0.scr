text Она широко улыбается.
text @[Томоя]
text Но я вообще-то не читаю такие книги...
text Видя, как я не решаюсь принять книгу, Котоми говорит нечто неожиданное.
setvar strS[1001] = "CGKT10C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOE.aac
text @[Котоми]
text Пожалуйста, не читай её.
text @[Томоя]
text Что?
setvar strS[1001] = "CGKT10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOF.aac
text @[Котоми]
text Пожалуйста, не читай её.
text Видя моё замешательство, она продолжает.
sound DOG.aac
text @[Котоми]
text Я просто хочу, чтобы ты подержал её у себя.
text @[Томоя]
text Но...
setvar strS[1001] = "CGKT18C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT18C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOH.aac
text @[Котоми]
text ...
text Глаза Котоми мерцают.
text Это чувство снова возвращается.
text Взрослая философия и детская невинность.
text И спрятанная между ними та Котоми, которую я не знаю...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Хорошо.
text Я принимаю книгу.
text Прикоснувшись к потёртому кожаному переплёту, я кое-что понимаю.
text @[Томоя]
text Слушай, Котоми, ты хотела...
text Ты хотела почитать её вместе со мной?
text Я оставляю эти слова при себе.
text Котоми встаёт прежде, чем я успеваю их произнести.
text Она идёт на своих тонких ногах к окну, выходящему на запад, и медленно поворачивается ко мне.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOI.aac
text @[Котоми]
text Я решила.
sound DOJ.aac
text @[Котоми]
text Я постараюсь приходить сюда как можно реже.
sound DOK.aac
text @[Котоми]
text Быть здесь уже не будет так весело, как раньше.
sound DOL.aac
text @[Котоми]
text Гораздо веселее быть со всеми.
sound DOM.aac
text @[Котоми]
text Гораздо веселее быть с тобой, Томоя-кун.
sound DON.aac
text @[Котоми]
text Вот почему я буду со всеми.
sound DOO.aac
text @[Котоми]
text Я буду ходить на уроки, слушать учителей и постараюсь подружиться со всеми в классе.
setvar strS[1001] = "CGKT15C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOP.aac
text @[Котоми]
text Я уже давно знала, что должна так поступить.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она обращается не ко мне.
text Книжные полки на просвет выглядят так, будто принадлежат древним руинам.
text Эти десятки тысяч корешков всё это время наблюдали за Котоми.
text Они слушали голос Котоми.
text В конце концов Котоми слегка кланяется.
setvar strS[1001] = "CGKT13C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT13C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOQ.aac
text @[Котоми]
text Томоя-кун, пойдём домой.
text Она улыбается мне.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s22
fi
goto 22
label s22
setvar strS[1000] = ""
label 22
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG020Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 23
label s23
setvar strS[1000] = ""
label 23
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Обязательно запри это место.
setvar strS[1001] = "CGKT31C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT31C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOR.aac
text @[Котоми]
text Хорошо...
text Я слышу щелчок откуда-то рядом с рукой Котоми.
text Теперь библиотека закрыта для нас и погружается в сон до завтрашнего обеда.
sound DOS.aac
text @[Котоми]
text Всё сделано.
text Она убирает ключ со своим именем, будто это драгоценное сокровище.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Теперь он будет использоваться гораздо реже.
text Но это также значит, что у Котоми появится больше друзей.
text Тьма окутывает опустевший коридор.
text В терминах книги это как будто только что закончилась одна из глав.
text Теперь посмотрим, что ждёт нас впереди...
text @[Томоя]
text Пойдём.
setvar strS[1001] = "CGKT13D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT13D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DOT.aac
text @[Котоми]
text Да.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я невольно протягиваю руку Котоми, и она мягко берёт её.
text Я осознаю, что мы впервые держимся за руки.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 24
label s24
setvar strS[1000] = ""
label 24
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 120
jump SEEN4506_0_0.scr
