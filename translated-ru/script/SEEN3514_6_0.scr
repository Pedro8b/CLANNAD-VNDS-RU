delay 120
music BGM08D.mp3
setvar strS[1000] = "BG021Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s112
fi
goto 114
label s112
setvar strS[1000] = ""
label 114
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Внутри класса, залитого закатным светом, я стою у окна, успокаивая себя.
text Есть кое-что, что я должен сделать…
text Если я убегу от этого, я не смогу идти дальше…
text Я должен сказать ей… иначе я буду лишь продолжать быть трусом…
text *Грохот*
text Тихо открывается дверь класса.
text Услышав звук, я оборачиваюсь.
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJC.aac
text @[Рё]
text …
text @[Томоя]
text Эй…
sound BJD.aac
text @[Рё]
text Томоя…‑кун…
text Интересно, сколько дней прошло с тех пор, как мы в последний раз стояли друг перед другом так…
text С тех пор как я начал встречаться с Кё, я не могу смотреть ей прямо в глаза.
text Полагаю, у неё тоже самое…
text До сегодняшнего дня мы вообще не разговаривали.
text @[Томоя]
text Вернулся со школьного комитета? Как прошло?
setvar strS[1001] = "CGRY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJE.aac
text @[Рё]
text Да… неплохо.
text @[Томоя]
text Понятно…
setvar strS[1001] = "CGRY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJF.aac
text @[Рё]
text О, ты ждёшь онээ‑чан? Если так, я думаю, она скоро вернётся в свой класс.
text @[Томоя]
text Нет… я ждал тебя вместо этого, Рё…
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJG.aac
text @[Рё]
text …Меня…?
setvar strS[1001] = "CGRY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я киваю, и лицо Рё немного напрягается.
text Мягко... я глубоко вдыхаю.
text Затем я сильно опускаю голову.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s113
fi
goto 115
label s113
setvar strS[1000] = ""
label 115
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Прости.
sound BJH.aac
text @[Рё]
text Томоя-кун...?
text @[Томоя]
text Я... был очарован твоей нежностью... и продолжал делать то, что лишь в итоге причиняло тебе боль...
text @[Томоя]
text Это не то, за что я заслуживаю прощения, даже если извинюсь... но... мне жаль...
text С головой всё ещё опущенной, я говорю.
text Я собираюсь принять всю вину, которую она возложит на меня.
text Мне будет всё равно, если она ударит меня, но я всё равно должен извиниться.
sound BJI.aac
text @[Рё]
text ...
sound BJJ.aac
text @[Рё]
text ...Нет...
text @[Томоя]
text ...
text Её слова схватывают моё сердце.
text Тем не менее, моя голова остаётся опущенной.
text Потому что я ничего не могу сделать, кроме как извиниться...
text Потому что это начало...
sound BJK.aac
text @[Рё]
text Я не хочу тебя прощать...
sound BJL.aac
text @[Рё]
text ...Так что, пожалуйста... не извиняйся...
text @[Томоя]
text ...
sound BJM.aac
text @[Рё]
text Если ты извинишься, мне захочется тебя простить.
text @[Томоя]
text Ээ...?
music ~
setvar strS[1000] = "BG021Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s114
fi
goto 116
label s114
setvar strS[1000] = ""
label 116
setvar strS[1001] = "CGRY26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Услышав в её тоне нотку спокойствия, я, не задумываясь, поднимаю голову.
music BGM25B.mp3
sound BJN.aac
text @[Рё]
text ...Я... действительно наслаждалась временем, проведённым с тобой, Томоя-кун.
sound BJO.aac
text @[Рё]
text Мы побывали во многих разных местах.
sound BJP.aac
text @[Рё]
text Мы обедали вдвоём, только вдвоём.
sound BJQ.aac
text @[Рё]
text И ты подарил мне кулон.
sound BJR.aac
text @[Рё]
text Мы также целовались...
sound BJS.aac
text @[Рё]
text Ты дал мне столько воспоминаний...
setvar strS[1001] = "CGRY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJT.aac
text @[Рё]
text Если ты извинишься... а я тебя прощу... тогда мне кажется, что всё время, проведённое вместе, было ложью...
sound BJU.aac
text @[Рё]
text Все они очень дорогие мне воспоминания...
setvar strS[1001] = "CGRY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJV.aac
text @[Рё]
text Так что, пожалуйста, не извиняйся.
text Да... понимаю...
text Если я так извинюсь... это будет лишь самодовольство...
text ...Тогда всё закончится тем, что я только наврежу ей...
text @[Томоя]
text Рё...
sound BJW.aac
text @[Рё]
text Да.
text @[Томоя]
text Спасибо.
setvar strS[1001] = "CGRY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJX.aac
text @[Рё]
text Да.
sound BJY.aac
text @[Рё]
text Томоя-кун, я тоже хочу поблагодарить тебя.
text Рё говорит и слегка наклоняет голову ко мне.
text Снова опускаю голову.
setvar strS[1000] = "BG084"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s115
fi
goto 117
label s115
setvar strS[1000] = ""
label 117
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Вместо того, чтобы говорить что-то столь отстранённое, как «извини», нам следует завершить это, ожидая того, что будет дальше.
text Сейчас мы снова возвращаемся к дружбе.
music ~
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s116
fi
goto 118
label s116
setvar strS[1000] = ""
label 118
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 180
jump SEEN3514_7_0.scr
