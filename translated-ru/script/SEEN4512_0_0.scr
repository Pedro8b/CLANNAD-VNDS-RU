if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text После этого я почти каждый день приходил к ней в гости.
text Много солнца из сада освещало пол её гостиной.
text Я чувствовал стойкий запах табачной трубки.
sound E5Q.aac
text @[Котоми]
text Это запах папиного табака.
text Даже в детстве это казалось мне чем-то изысканным. Не таким, как курили другие взрослые.
text Больше всего она любила играть в дочки-матери.
text Но игра в дочки-матери с ней была... немного другой.
text Она указывала своим пухлым пальчиком на каждое блюдо и называла его.
text После этого она складывала ладони вместе.
sound E5R.aac
text @[Котоми]
text Приступим к трапезе.
text @[Томоя]
text Приступим...
sound E5S.aac
text @[Котоми]
text Прошу, угощайся.
text Она сделала из этого целое событие и уставилась на меня.
sound E5T.aac
text @[Котоми]
text Скажи «а-а».
text Она подцепила «еду» одноразовыми палочками и протянула мне.
text А когда я не положил это в рот, она выглядела так, будто вот-вот заплачет.
text @[Томоя]
text Я не могу это есть.
text Угощение было сделано из глины.
text @[Томоя]
text Нечестно. Тебе тоже нужно это съесть, Котоми-тян.
text @[Томоя]
text Вот твоя половина, Котоми-тян.
text Я положил много глиняной стряпни на её бумажную тарелку.
sound E5U.aac
text @[Котоми]
text Да. Это моя половина.
sound E5V.aac
text @[Котоми]
text Пополам с Томоей-куном.
text Она широко улыбнулась.
delay 60
text В итоге я так и не рассказал другим друзьям про тот сад.
text Мне всё равно никогда особо не нравилось играть в больших компаниях...
text Я хотел сохранить этот секрет только для себя.
delay 60
setvar strS[1000] = "BG051S"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s14
fi
goto 15
label s14
setvar strS[1000] = ""
label 15
