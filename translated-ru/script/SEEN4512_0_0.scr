setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Когда была хорошая погода, мы играли в саду.
text Бегали босиком по газону, играли в салки или в прятки.
text Но для салок нас было слишком мало, а она всегда была готова расплакаться, если я находил отличное место для пряток.
text На маленькой клумбе росло множество разных цветов.
text Она знала названия всех до единого.
sound E5W.aac
text @[Котоми]
text Это калифорнийский мак, это бегония, это анютины глазки...
sound E5X.aac
text @[Котоми]
text А это...
sound E5Y.aac
text @[Котоми]
text Хри...
text @[Томоя]
text Хри?
sound E5Z.aac
text @[Котоми]
text Эм...
sound E60.aac
text @[Мать]
text Хризантема болотная.
sound E61.aac
text @[Мать]
text Её ещё называют «Северный полюс».
text Её мама, развешивавшая бельё в саду, мягко нас поправила.
text На ней был её обычный ярко-белый фартук.
text Она всегда улыбалась.
text Я завидовал.
text Это было то, чего я хотел больше всего на свете.
sound E62.aac
text @[Мать]
text Слушай, Котоми-тян. Раз уж погода такая хорошая, почему бы тебе не поиграть на улице с Томоей-куном?
text Котоми всегда выглядела растерянной, когда ей это говорили.
sound E63.aac
text @[Котоми]
text Но мы уже на улице.
sound E64.aac
text @[Мать]
text Это же просто наш сад, разве нет?
sound E65.aac
text @[Котоми]
text Сад — это на улице.
sound E66.aac
text @[Мать]
text Но...
sound E67.aac
text @[Котоми]
text Это на улице.
text Она не сдвинулась с места.
text Её мама вздохнула и заглянула Котоми в лицо.
sound E68.aac
text @[Мать]
text «Улица» — это за изгородью.
sound E69.aac
text @[Мать]
text Внешний мир очень большой, и там много всего, чего ты никогда не видела, Котоми-тян.
sound E6A.aac
text @[Котоми]
text Это страшно, так что я не хочу.
text @[Томоя]
text Там совсем не страшно.
text Я сказал это как тот, кто пришёл «снаружи».
sound E6B.aac
text @[Мать]
text Вот как...
sound E6C.aac
text @[Мать]
text Томоя-кун очень хороший мальчик.
sound E6D.aac
text @[Мать]
text Котоми-тян плохая девочка.
sound E6E.aac
text @[Котоми]
text Я не плохая девочка.
sound E6F.aac
text @[Котоми]
text Я хочу пойти на улицу, но...
sound E6G.aac
text @[Котоми]
text В следующий раз схожу.
text После этих слов её мама рассмеялась.
text Я не понимал, что тут смешного.
sound E6H.aac
text @[Мать]
text ...Что ж, давайте перекусим.
text Она принесла нам свежеиспечённый бисквит и какой-то загадочный чай с цветочным ароматом.
sound E6I.aac
text @[Котоми]
text Это мама испекла.
sound E6J.aac
text @[Котоми]
text Очень вкусно.
sound E6K.aac
text @[Котоми]
text Приступим к трапезе.
text @[Томоя]
text Приступим...
text Повторив за ней, я откусил от кусочка в середине.
sound E6L.aac
text @[Котоми]
text Томоя-кун, эм...
sound E6M.aac
text @[Котоми]
text Кусочки с краю самые вкусные.
text Она сказала это с большей уверенностью, чем когда называла имена цветов.
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 16
label s15
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 60
text В холодные дни мы читали вместе.
text Я сразу понял, что она отличается от других детей.
text Она легко читала книги со сложными словами и иероглифами.
sound E6N.aac
text Писать трудно, а вот читать легко.
text Её улыбка была окрашена гордостью, когда она это сказала.
text Её любимой книгой была вот эта новенькая, красивая книга с коричневым кожаным переплётом.
text Она сказала, что папа купил её, когда она пошла в начальную школу.
text Мне она показалась скучной, потому что была слишком сложной для чтения.
sound E6O.aac
text @[Котоми]
text Неинтересно?
text Заметив, что мне совсем не весело, она спросила это, склонив голову набок.
text @[Томоя]
text Я не понимаю.
sound E6P.aac
text @[Котоми]
text У меня то же самое...
sound E6Q.aac
text @[Котоми]
text Но папа сказал мне читать много книг.
text @[Томоя]
text Это слишком сложно.
sound E6R.aac
text @[Котоми]
text Он сказал, что не страшно, если я пока не понимаю.
sound E6S.aac
text @[Котоми]
text Он сказал, что однажды я пойму.
sound E6T.aac
text @[Котоми]
text Он сказал, это потому, что мне ещё многому нужно научиться.
sound E6U.aac
text @[Котоми]
text Я хочу прочитать все книги в мире.
sound E6V.aac
text @[Котоми]
text Если я смогу узнать много всего, это будет очень, очень здорово.
sound E6W.aac
text @[Котоми]
text Тебе так не кажется, Томоя-кун?
text @[Томоя]
text Ага, наверное...
text Она улыбнулась мне, несмотря на мой вялый ответ.
text Она и правда выглядела счастливой.
sound E6X.aac
text @[Котоми]
text О, придумала. У меня хорошая идея.
sound E6Y.aac
text @[Котоми]
text Давай просто читать самые замечательные места.
sound E6Z.aac
text @[Котоми]
text Будем читать их снова и снова, пока не запомним наизусть.
sound E70.aac
text @[Котоми]
text А потом когда-нибудь сможем вспоминать их даже без книги.
sound E71.aac
text @[Котоми]
text Так что давай начнём с самого начала.
text Она неловко начала читать свои любимые отрывки.
text Я попытался следить за ней.
text Я чувствовал себя ужасным учеником...
text Она была старательной и продолжала снова и снова пытаться меня научить...
delay 60
setvar strS[1000] = "BG051S"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 17
label s16
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound E72.aac
text @[Котоми]
text У меня скоро будет день рождения.
text Она сказала мне это, а закатное солнце освещало её щёки.
text Мы устали от игр и сидели, глядя на сад.
sound E73.aac
text @[Котоми]
text Хочу, чтобы ты пришёл, Томоя-кун.
text @[Томоя]
text А сколько там будет людей?
text Мне не хотелось встречаться с незнакомыми людьми.
sound E74.aac
text @[Котоми]
text Будет четверо.
text Она сказала это с гордостью.
sound E75.aac
text @[Котоми]
text Томоя-кун, я, мама, и...
text @[Томоя]
text А кто последний?
sound E76.aac
text @[Котоми]
text Папа.
text @[Томоя]
text Это не называется вечеринкой.
text Я сказал ей это, втайне почувствовав облегчение.
sound E77.aac
text @[Котоми]
text ?
text @[Томоя]
text На вечеринках намного больше людей.
text После моих слов она начала выглядеть грустной.
sound E78.aac
text @[Котоми]
text Ох...
sound E79.aac
text @[Котоми]
text Но это всё равно день рождения.
sound E7A.aac
text @[Котоми]
text Папа сказал, что подарит мне огромного плюшевого мишку.
sound E7B.aac
text @[Котоми]
text Мама сказала, что приготовит для нас огромный пир.
sound E7C.aac
text @[Котоми]
text И...
text @[Томоя]
text ...Мне уже пора домой.
text Становилось темно, и я встал.
text Может, это потому, что мне стало завидно, что она так гордо говорит о родителях.
text Я надел ботинки и носки, потом прошёл через сад.
sound E7D.aac
text @[Котоми]
text Томоя-кун, увидимся завтра.
text Она сказала мне это, как обычно.
text @[Томоя]
text Может, завтра я не приду.
text И, как обычно, именно так я и ответил.
text Она посмотрела прямо на меня и, казалось, о чём-то задумалась.
sound E7E.aac
text @[Котоми]
text Тебе не обязательно приходить завтра.
text @[Томоя]
text А?
text Это был первый раз, когда она сказала что-то подобное.
sound E7F.aac
text @[Котоми]
text Я постараюсь быть в порядке, даже если ты завтра не придёшь.
sound E7G.aac
text @[Котоми]
text Но, пожалуйста, пожалуйста, приходи на мой день рождения.
sound E7H.aac
text @[Котоми]
text Ты правда, правда должен.
sound E7I.aac
text @[Котоми]
text Я буду тебя ждать.
sound E7J.aac
text @[Котоми]
text Я буду ждать...
delay 60
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 18
label s17
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 60
text Я подумал про себя, что стоит подарить ей подарок.
text Её день рождения.
text У меня не было ничего, что бы ей понравилось, и купить я ничего не мог.
text Я решил привести ей друзей.
text Она могла бы обрадоваться, даже если бы я был единственным гостем.
text Даже если бы я пришёл один, я мог бы отпраздновать с ней, даже без подарка.
text Но мне нужно было сделать для неё хоть что-то.
text Я обошёл всех девочек по соседству.
text Рассказывал им о прекрасном саде, вкусных сладостях и немного странной девочке.
text Приглашал их на день рождения, который скоро должен был состояться.
text Все девочки улыбались, хоть и немного настороженно, но ни одна не согласилась пойти.
text Я рассказал своим обычным друзьям.
text Они дразнили меня за то, что я «играю с девчонками».
text Я обошёл всех, кого знал. Все мне отказали.
text После того как мой самый последний друг отказался, я понял, что солнце уже село.
text Я решил, что её день рождения, наверное, уже закончился.
text Мне было слишком стыдно смотреть ей в глаза.
text Тяжёлыми шагами я пошёл домой.
text Слёзы навернулись на глаза от звука моих одиноких шагов.
text Она мне очень нравилась.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 19
label s18
setvar strS[1000] = ""
label 19
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 60
text Минула полночь, а я всё ещё не мог уснуть.
text После того как отец лёг спать, я выскользнул из дома.
text Мне казалось, что нужно извиниться за то, что не пришёл на её вечеринку.
text Мне казалось, что нужно извиниться за то, что не подарил ей подарок.
text Но на самом деле мне было всё равно на всё это.
text Я просто хотел её увидеть.
text Хотел увидеть девочку, которая всегда, без исключений, говорила «увидимся завтра».
delay 120
text Её дом был окутан тьмой, ни единого огонька. Он был похож на дом с привидениями.
text Собрав всё своё мужество, я протиснулся сквозь просвет в изгороди.
text В этот час сад выглядел пугающе тёмным.
text Казалось, будто всё вокруг мертво.
text Стол, стулья, клумба... казалось, будто всё это подменили на искусственную копию.
text Насекомые стрекотали, будто механизмы, и звук этот, казалось, становился всё громче и громче.
text @[Томоя]
text Котоми-тян.
text Я прошептал её имя в темноте.
text @[Томоя]
text Котоми-тян, Котоми-тян... Котоми-тян.
text Сколько бы я ни ждал, казалось, она не появится.
text Стеклянная дверь была приоткрыта на щёлочку.
text Чувствуя, что меня тянет туда, я отодвинул её и вошёл в гостиную.
text Внутри было ещё темнее, чем в саду.
text Воздух был застоявшимся и холодным, будто дом пустовал уже долгое время.
text Я тихо шёл, продвигаясь всё глубже.
text Чувство вины за то, что делаю что-то плохое, и неописуемая тревога смешивались во мне.
text Неужели прошли десятилетия за то короткое время, что меня здесь не было?
text Может, всё это было сном?
text Неужели я больше никогда её не увижу?
text И тут я почувствовал запах гари.
text Услышал звуки рыданий.
text Она плакала!
text Я побежал наверх.
text Чуть не споткнувшись на крутой лестнице, я взбежал наверх.
text Я ворвался в дверь в конце коридора.
text Она была там.
text Сидела на полу и плакала.
text Перед ней горело что-то похожее на книгу.
text Оранжевое пламя плясало, будто живое.
text Я попытался потушить огонь.
text Побежал на кухню, наполнил чашку водой и раз за разом бегал вверх-вниз по лестнице.
text Несмотря на все мои усилия, пламя не утихало. Вскоре оно перекинулось на ковёр.
text Стиснув зубы, я несколько раз заливал огонь водой.
text Как раз когда я начал думать, что всё потеряно, в комнату вбежала толпа незнакомых взрослых.
text Они тушили огонь своей одеждой.
text Она плакала всё это время.
text Она закрывала лицо крошечными ладошками и сидела, плача.
text Казалось, будто она забыла, как делать что-либо, кроме как плакать.
text Пытаясь её защитить, я встал между ней и взрослыми.
text Я ожидал, что они накричат на неё за игры с огнём.
text Взрослые попытались собрать обгоревшие клочки бумаги.
text Потом они склонились и тихо заговорили с ней.
sound VYS.aac
text «Это была не она».
sound VYT.aac
text «Тебе не нужно плакать».
sound VYV.aac
text «Это было для тебя».
text Но она не переставала плакать.
text Все они выглядели очень грустными.
text У меня не было способа узнать, что случилось.
text Но одно я знал точно...
text Запах табачной трубки, ярко-белый фартук...
text Прекрасный сад, загадочная девочка...
text Всё это исчезло.
delay 60
setvar strS[1000] = "BG051S"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s19
fi
goto 20
label s19
setvar strS[1000] = ""
label 20
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я больше никогда не возвращался в тот дом.
text Я снова стал играть с соседскими мальчишками, будто ничего не случилось.
text Ни тот сад, ни та девочка больше никогда не приходили мне на ум.
text И вскоре я совсем забыл о ней.
text Почему я забыл о ней?
text Почему я забыл...?
delay 60
music ~
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s20
fi
goto 21
label s20
setvar strS[1000] = ""
label 21
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 301
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM05E.mp3
text Сон...?
text Это сон?
text Где... я?
text Слышу откуда-то звук.
text Звук, которого я никогда раньше не слышал.
text И всё же он кажется странно знакомым, будто из детства.
text Медленно открываю глаза.
delay 60
setvar strS[1000] = "FGKT06A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s21
fi
goto 22
label s21
setvar strS[1000] = ""
label 22
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 301
delay 60
sound E7K.aac
text @[Девушка]
text Эм...
sound E7L.aac
text @[Девушка]
text Кто ты?
sound E7M.aac
text @[Девушка]
text Мне сказали, что нельзя пускать в дом незнакомцев.
text @[Томоя]
text Что это за место?
sound E7N.aac
text @[Девушка]
text Мой дом.
text @[Томоя]
text Кто ты?
sound E7O.aac
text @[Девушка]
text Котоми...
sound E7P.aac
text @[Девушка]
text Три буквы хираганы, Котоми.
sound E7Q.aac
text @[Девушка]
text Зови меня Котоми-тян.
text @[Томоя]
text Что это?
sound E7R.aac
text @[Девушка]
text Скрипка.
text @[Томоя]
text Звучит смешно.
sound E7S.aac
text @[Девушка]
text Я пока не умею хорошо на ней играть.
setvar strS[1000] = "FGKT06B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s22
fi
goto 23
label s22
setvar strS[1000] = ""
label 23
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
sound E7T.aac
text @[Девушка]
text Но звучит очень, очень красиво, когда играет учитель.
text Она слегка улыбается.
text Это та самая неловкая улыбка, которую Котоми впервые мне показала.
text Точно.
text Я знаю.
text Это сон.
text Это сон о том времени, когда мы были ещё детьми.
text О том времени, когда весь наш мир был построен из крошечных кусочков счастья.
text О том времени, когда мы ещё не понимали, что такое грусть.
text Я чувствую, что вот-вот проснусь.
text Есть кое-что, что я должен сделать.
text Мне нужно пойти к Котоми.
text Она всё ещё плачет одна в той комнате.
text Вот почему...
text Медленно открываю глаза...
music ~
bgload SIRO.jpg 180
setvar strS[1000] = "FGKT07A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 24
label s23
setvar strS[1000] = ""
label 24
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 301
delay 60
sound E7U.aac
text @[Котоми]
text Ты проснулся?
text @[Томоя]
text Нет...
text @[Томоя]
text Может, я всё ещё сплю.
music BGM25B.mp3
text Котоми улыбается передо мной.
text Она стоит на том же самом месте, смотрит на тот же самый сад, с той же самой неловкой улыбкой.
text Будто это продолжение моего сна.
text Она выглядит такой счастливой.
sound E7V.aac
text @[Котоми]
text Я всегда помнила.
sound E7W.aac
text @[Котоми]
text Мальчика, который забрёл в сад.
