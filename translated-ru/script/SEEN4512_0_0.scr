text @[Томоя]
text Котоми.
text @[Томоя]
text Давай выйдем на улицу вместе.
text @[Томоя]
text Не бойся. Это не страшно.
text @[Томоя]
text Я всегда буду с тобой.
text Котоми кивает мне.
delay 60
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s37
fi
goto 38
label s37
setvar strS[1000] = ""
label 38
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG050Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s38
fi
goto 39
label s38
setvar strS[1000] = ""
label 39
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 60
text На улице садится солнце.
text Дороги жилого квартала окрашены светом позднего дня.
text Настороженно наблюдаю за Котоми, стоящей там босиком.
text Она похожа на маленького ребёнка, впервые вышедшего из дома.
text Будто она впервые на пляже и позволяет волнам омывать её ноги.
setvar strS[1001] = "CGKT31D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT31D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EA5.aac
text @[Котоми]
text ...Это странное чувство.
text Она мягко улыбается.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Потом она поднимает взгляд.
text Щурится от яркого света и раскрывает руки навстречу бескрайнему небу.
setvar strS[1000] = "BG084"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s39
fi
goto 40
label s39
setvar strS[1000] = ""
label 40
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Рваные облака окрашены в красный и отражаются в глазах Котоми.
text Котоми остаётся в этой позе какое-то время.
text Будто она только что вспомнила, что небо существует.
text Внешний мир.
text Бескрайнее небо, что кажется, тянется вечно.
text Неизвестное будущее ждёт нас там.
sound EA6.aac
text @[Котоми]
text Небо такое красивое.
text @[Томоя]
text Ага.
text @[Томоя]
text Оно красивое.
text Улыбаюсь Котоми.
text Улыбаюсь той, с кем отныне буду вместе.
text Даже если ты не сможешь видеть меня, я смогу видеть тебя.
text Даже если мы не сможем встретиться, я всегда буду рядом с тобой.
text До того дня, когда мы расстанемся...
text В этот миг, по крайней мере... в этом мире...
text Я могу чувствовать Котоми, и Котоми может чувствовать меня.
delay 60
delay 60
music ~
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s40
fi
goto 41
label s40
setvar strS[1000] = ""
label 41
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
delay 120
jump SEEN4513_0_0.scr
