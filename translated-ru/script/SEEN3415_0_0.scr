	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Говорит она и семенит к своему месту.
text @[Томоя]
text ...
text Может, она и правда пытается со мной поссориться...
text После такого странного гадания мне почему-то грустно.
setvar intF[300] = 1
label 2
if intF[1089] == 1
	goto s2
fi
goto 3
label s2
sound 8EX.aac
text @[Ученик]
text Эй, Оказаки, не доводи старосту до слёз, ладно? А то за тебя её сестра возьмётся.
setvar strS[1001] = "CGRY24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8EY.aac
text @[Рё]
text ...Всё в порядке... я не плачу...
text Нельзя так говорить, когда сама вот-вот расплачешься.
text Впрочем, раз слёзы так и не потекли, будем считать, что она не плачет.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я подпираю подбородок рукой и смотрю в окно.
text Даю понять, что обсуждать больше нечего.
text Похоже, она понимает намёк и, понурив плечи, направляется на своё место.
text ...Может, она хотела сказать что-то ещё...
label 3
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
