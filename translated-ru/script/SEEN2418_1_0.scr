		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MY.aac
text @[Томойо]
text На самом деле, я тоже никого не встречаюсь.
text @[Томоя]
text Нет, я имею в виду, ты же собираешься вступить в студенческий совет?
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MZ.aac
text @[Томойо]
text Да.
text @[Томоя]
text В таком случае тебе бы не хотелось, чтобы сейчас вокруг тебя ходили странные слухи, так?
sound 5N0.aac
text @[Томойо]
text Зачем такие слухи вообще важны?
text @[Томоя]
text Понимаю. Ну, если ты так считаешь, делай, что хочешь.
