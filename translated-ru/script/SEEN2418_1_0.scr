text По коридору несколько студентов издают пронзительный шум.
text @[Томоя]
text Чувак, уже заткнись...
music ~
text Я пытаюсь пройти мимо них, когда...
text Кто‑то хватает меня за руку.
music BGM09A.mp3
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5M7.aac
text @[Томойо]
text Эй, можешь мне здесь помочь?
text Это Томойо.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Два студента хватают её другую руку.
sound 5M8.aac
text @[Студентка]
text Давай, вступай в дзюдо‑клуб!
sound 5M9.aac
text @[Студент]
text Я, как капитан мужского дзюдо‑клуба, тоже хочу пригласить тебя присоединиться.
text Её снова уговаривают вступить в дзюдо‑клуб. К тому же их стало больше.
setvar strS[1001] = "CGTM14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MA.aac
text @[Томойо]
text Эти парни действительно настойчивы.
choice Help her|Shake off her hand
setvar intF[1089] = selected
sound 02.aac
setvar intF[1089] - 1
if intF[1089] == 0
	goto s10
fi
goto 11
label s10
goto 12
label 11
if intF[1089] == 1
	goto s11
fi
goto 12
label s11
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я изо всех сил трясу своей рукой, пытаясь заставить её отпустить.
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ...Но она не отходит. Томойо всё ещё держится за мою руку.
text *Тряска*
text ...*Тряска*
text ......*Тряска*
sound 5MB.aac
text @[Томойо]
text Что ты делаешь?
text @[Томоя]
text Пытаюсь избавиться от захвата.
sound 5MC.aac
text @[Томойо]
text А, так оно значит...
setvar strS[1001] = "CGTM15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MD.aac
text @[Томойо]
text То есть, что, ты не поможешь мне?
text @[Томоя]
text Да. Тебе не стоит полагаться на других. Ты справишься с этим сам, как бы то ни было...
sound 5ME.aac
text @[Tomoyo]
text Это капитаны мужского и женского дзюдо-клубов, понимаешь?
text @[Tomoya]
text Тогда тебе всё будет в порядке.
text @[Tomoya]
text Так… дай мне уйти, ладно?
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MF.aac
text @[Tomoyo]
text Я думаю, ты меня неправильно понимаешь.
text Нет, просто у тебя нет самосознания.
text Конечно, я не произношу это вслух.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MG.aac
text @[Female Captain]
text Ничего страшного, если сначала просто заглянешь к нам на минутку, чтобы увидеть, как тебе это понравится!
text Когда я отступаю, они сразу же возобновляют своё принуждение.
sound 5MH.aac
text @[Male Captain]
text Просто попробуй на один день. Это всё, чего мы просим!
setvar strS[1001] = "CGTM31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MI.aac
text @[Tomoyo]
text Ты говоришь правду, верно…?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text И вот так они её забирают.
text Интересно, начнёт ли она участвовать в дзюдо-клубе уже завтра…
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
label 12
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text Вам уже надо замолчать.
text @[Male Student]
text ...
text Парень смотрит мне в лицо.
text Я стою и пристально смотрю на него.
text В момент, когда он сдаётся и отворачивает взгляд…
sound 5MJ.aac
text @[Male Student]
text Сакагами-сан, давай поедем куда-нибудь.
text Он пытается схватить Томою и уйти.
text @[Томоя]
text Пойдём, Томойо.
text Я зову её сзади.
text Он останавливается.
text @[Томоя]
text Пойдём, Томойо.
text Я медленно повторяю это ещё раз.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MK.aac
text @[Томойо]
text Ах...
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5ML.aac
text @[Томойо]
text Хорошо.
text Томойо кивает и...
text Рука мальчика‑студента, которая держалась за неё, слабо опускается.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
