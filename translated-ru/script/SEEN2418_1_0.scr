setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5MW.aac
text @[Томойо]
text Тебе это беспокоит?
