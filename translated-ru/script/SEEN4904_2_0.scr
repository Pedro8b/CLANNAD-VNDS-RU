setvar strS[1000] = "BG009"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 4
label s3
setvar strS[1000] = ""
label 4
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я просыпаюсь, как обычно.
text Кажется, мне снился сон.
text По крайней мере, такое ощущение, что мне снился сон.
text Первое, о чём я думаю, — что сегодня у меня свидание с Котоми.
text Вчера я из-за этого так волновался, но этим утром я гораздо спокойнее.
text Может быть, дело в том, что вчера я встретил того джентльмена.
text Я смотрю на часы.
text До встречи ещё есть время, но нет смысла убивать его дома.
text @[Томоя]
text (Позавтракать можно и по дороге...)
text Я встаю с кровати.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s4
fi
goto 5
label s4
setvar strS[1000] = ""
label 5
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s5
fi
goto 6
label s5
setvar strS[1000] = ""
label 6
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text Я прихожу на место встречи в 9:30.
text У меня было предчувствие, что она уже будет там, и так и есть.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHS.aac
text @[Котоми]
text Томоя-кун, здравствуй.
text @[Томоя]
text «Здравствуй» — это неправильно. Надо было сказать «доброе утро».
text Я отвечаю невпопад и пристальнее вглядываюсь в наряд Котоми.
text На ней чёрное платье с глубоким вырезом.
text Я ожидал, что она наденет что-то более по-детски простое, так что это стало настоящим сюрпризом.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Я понесу твои вещи.
text Я беру её тканевую сумку с коробочками для обеда.
text Она кажется довольно большой для двоих, но легче, чем выглядит.
text @[Томоя]
text Сэндвичи?
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHT.aac
text @[Котоми]
text Да.
text @[Томоя]
text А. Ну, сэндвичи можно съесть где угодно...
text Ответив, я понимаю, что мы ещё не решили, куда пойти.
text @[Томоя]
text Есть какое-то место, куда ты хочешь пойти?
setvar strS[1001] = "CGKT15C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHU.aac
text @[Котоми]
text Эм...
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHV.aac
text @[Котоми]
text Я знаю одно очень чудесное место.
sound EHW.aac
text @[Котоми]
text Уверена, тебе оно тоже понравится, Томоя-кун.
text Должно быть, она уже всё решила — её глаза блестят, когда она это говорит.
text @[Томоя]
text Я не против, если это место, куда ты хочешь пойти.
text @[Томоя]
text Правда, мне бы хотелось избежать людных мест.
sound EHX.aac
text @[Котоми]
text Сегодня там должно быть пусто.
text @[Томоя]
text О? Не знал, что здесь есть такое скрытое сокровище.
sound EHY.aac
text @[Котоми]
text Нет, не в этом дело.
sound EHZ.aac
text @[Котоми]
text Это место, которое ты хорошо знаешь, Томоя-кун.
text @[Томоя]
text Правда?
text Я снова задумываюсь об этом.
text Поблизости нет ни большого парка, ни парка развлечений.
text Меня охватывает смутное беспокойство, будто я улавливаю отголоски своего сна.
text Почему Котоми так уверена, что я это видел?
text @[Томоя]
text Извини. Я не знаю, где это.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI0.aac
text @[Котоми]
text Эм...
text Всё ещё смущённая, Котоми приближает губы к моему уху.
sound EI1.aac
text @[Котоми]
text Это школьная библиотека.
text @[Томоя]
text ...
text Я такого не ожидал.
setvar strS[1001] = "CGKT21D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT21D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI2.aac
text @[Котоми]
text Разве нет?
text @[Томоя]
text Хм, я не против, но...
text Мне хотелось бы избежать туристических мест в выходной, но идти в школу — это как-то уж слишком обыденно.
text Впрочем, у меня и своих планов не было...
text @[Томоя]
text Да, можем сходить в библиотеку.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Услышав мой ответ, она, кажется, улыбается и облегчённо вздыхает.
text Похоже, библиотека — особенное место для Котоми.
text У нас ещё будет случай для более обычного «свидания».
text @[Томоя]
text Идём.
setvar strS[1001] = "CGKT17C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT17C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI3.aac
text @[Котоми]
text Хорошо.
text Мы вместе трогаемся в путь.
jump SEEN4904_3_0.scr
