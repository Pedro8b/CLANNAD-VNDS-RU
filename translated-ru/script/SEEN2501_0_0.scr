text @[Томоя]
text Ну, до такого я заходить не буду.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6VK.aac
text @[Томоё]
text Хорошо. Если честно, мне было бы затруднительно, если бы ты попросил и то, и другое.
sound 6VL.aac
text @[Томоё]
text У меня нет такого богатого кулинарного репертуара.
text @[Томоя]
text Тогда только обед.
text @[Томоя]
text Давай пообедаем вместе, а потом проведём вдвоём весь день.
text @[Томоя]
text Правда, у меня нет денег... так что вряд ли мы куда-то сможем сходить.
sound 6VM.aac
text @[Томоё]
text Мне достаточно просто быть вместе с тобой. Я и так не люблю тратить деньги попусту.
text @[Томоя]
text Как же я благодарен, что у меня такая девушка.
text @[Томоя]
text Так что давай просто отдохнём и проведём каникулы вместе.
sound 6VN.aac
text @[Томоё]
text Хорошо.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s23
fi
goto 27
label s23
setvar strS[1000] = ""
label 27
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2502_0_0.scr
