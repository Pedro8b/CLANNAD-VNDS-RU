text Девушка, с которой я уже давно хотел встретиться, стояла у школьных ворот.
text Она то и дело вставала на цыпочки, будто высматривая кого-то в толпе расходящихся по домам учеников.
text Я подхожу поближе и встаю рядом с ней.
setvar strS[1001] = "CGMS42"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS42.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TZF.aac
text @[Мисаэ]
text ...
text Взгляд девушки скользит слева направо, затем, после короткой паузы, снова справа налево, следуя за толпой.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я пробую помахать рукой прямо у неё перед лицом, когда она смотрит в мою сторону, но она никак не реагирует.
text ......
text ...И вот, наконец.
text Её глаза радостно загораются — она находит того, кого искала.
text Девушка бросается к нему.
text Я иду следом за ней.
setvar strS[1001] = "CGMS31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGMS31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound TZG.aac
text @[Мисаэ]
text Ах, Игараси-кун, ты тоже сейчас домой?
text окликает она парня.
sound TZH.aac
text @[Ученик]
text Ага. Ты тоже, Сагара?
setvar strS[1001] = "CGMS42"
setvar intF[1113] = intF[1112]
