		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KYD.aac
text @[Нагиса]
text ...Большое тебе спасибо.
sound KYE.aac
text @[Нагиса]
text Но думаю, что это была бы очень плохая ситуация, если бы мой папа узнал, что мы так делаем...
text @[Томоя]
text Да, это правда...
