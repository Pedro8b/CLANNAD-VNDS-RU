setvar intF[1112] = 0
bgload SFWEC00.jpg 60
delay 8
setimg SFWEC25.png 148 172
delay 229
bgload SIRO.jpg 47
music BGM26B.mp3
text Этот мир действительно подошёл к концу.
text Здесь больше не родится новая жизнь.
text Теперь я хорошо это понимаю.
text В тех зверьках нет жизни. Это просто «вещи», принявшие форму живых существ.
text Единственное живое здесь существо — она.
text Но если это действительно так... тогда что же я?
text У меня, конечно, есть воля; в этом смысле я, наверное, не такой, как они.
text Я люблю её. Я хочу быть с ней навсегда.
text Куда бы она ни пошла, я последую за ней.
text Даже если она возненавидит меня, я всё равно последую за ней.
text Это моя воля, и это мои чувства.
text Это доказательство того, что я — это я.
text Но тогда откуда же я взялся?
text Откуда взялась эта моя «воля»?
text Я ищу в своей памяти.
text Я нахожу воспоминание из времени до моего рождения.
text Оно лежит на дне моего вялого сознания.
text То ли давным-давно, то ли в далёком будущем — я не совсем уверен... Но так или иначе, я там.
text В месте, от которого на сердце становится тепло.
text ...«Там было лучше, чем здесь?»
text ...«Тебе там нравилось?»
text ...«Там было не так одиноко, как здесь?»
text Да...
text Это было место, полное веселья, место, где я не был одинок.
text Я был там.
text Если бы только у меня не было этого тела... смог бы я вернуться туда?
text Но теперь у меня есть тело, что привязывает моё сознание к месту.
text Тело, которое она сделала для меня.
text Я живу здесь, на краю этого мира.
text Хотя я и не знаю, как так вышло...
text Меня это устраивает.
text Потому что теперь она хотя бы не одна.
setvar strS[1000] = "BG306"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s30
fi
goto 31
label s30
setvar strS[1000] = ""
label 31
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мы кладём неподвижную куклу из хлама в землю.
text Это что-то вроде похорон.
text Девочка всё это время молчит.
text Когда работа закончена, я беру её за руку и тяну.
text ...«Хм?»
text Она смотрит на меня сверху вниз.
text Я вкладываю свою руку в её.
text ...«Хочешь сделать новую?»
text Я киваю.
text ...«Но она не будет двигаться.»
text ...«Мы не можем сделать... нового друга.»
text Она говорит это с грустью в голосе.
text Я качаю головой.
text ...«Хочешь сделать что-то другое?»
text Кивок.
text ...«Что?»
text Я стою совершенно неподвижно.
text Если честно, я и сам не знаю.
text Я просто чувствую, что так нужно поступить.
text Она способна взять кучу хлама и сделать из него что-то.
text Это то, чего не могу я.
text Это что-то особенное, доступное только ей.
text А значит, я уверен, в этом должен быть какой-то смысл.
text Я оборачиваюсь.
text Даже хижина, в которой мы вдвоём живём, была построена ею, не так ли?
text ...«Такое большое я сделать не смогу.»
text Во всяком случае, так она мне говорит.
text ...«Но, может быть, если будет достаточно времени, у меня получится.»
text Я киваю.
text ...«Тогда что же нам делать?»
text Я начинаю подпрыгивать на месте.
text Я хочу что-то, что будет вызывать во мне такой же восторг.
text Она сможет это сделать, а я помогу.
text Кажется, это будет очень весело.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s31
fi
goto 32
label s31
setvar strS[1000] = ""
label 32
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[1112] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6900_7_0.scr
