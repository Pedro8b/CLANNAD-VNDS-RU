text Ах... подождите секунду.
text @[Томоя]
text А?
sound GMS.aac
text @[Фурукава]
text Я сама нарисую.
setvar strS[1001] = "CGNG17Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG17Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMT.aac
text @[Фурукава]
text В конце концов, я президент клуба.
text @[Томоя]
text Да, так будет лучше всего.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я снова сажусь.
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMU.aac
text @[Фурукава]
text Что мне нарисовать?
text Спрашивает меня Фурукава с маркерами в руках.
text @[Томоя]
text Придумай сама.
setvar strS[1001] = "CGNG12Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG12Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMV.aac
text @[Фурукава]
text Хм...
text @[Томоя]
text Что вы хорошо умеете рисовать?
sound GMW.aac
text @[Фурукава]
text Интересно...
text @[Томоя]
text Карри?
setvar strS[1001] = "CGNG33"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMX.aac
text @[Фурукава]
text Нет!
text Она меня напрочь отвергла. Должно быть, для неё это правда ужасное воспоминание.
setvar strS[1001] = "CGNG30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMY.aac
text @[Фурукава]
text Можно я нарисую что-то простое? Если это подойдёт, есть кое-что, что я хорошо умею рисовать.
text @[Томоя]
text Конечно, лишь бы было симпатично.
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GMZ.aac
text @[Фурукава]
text Это невероятно мило!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Как только она заканчивает говорить, её рука начинает двигаться, пока она напевает песенку.
text Это мелодия, которую я уже где-то слышал. Правда, не могу вспомнить где.
text Любопытствуя, я смотрю, что она рисует. Вижу маленький кружок с лицом.
text Едва закончив рисовать один такой, она рисует всё больше и больше таких же.
text Объявление о наборе в клуб быстро оказывается заполнено странными существами...
setvar strS[1001] = "CGNG25Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN0.aac
text @[Фурукава]
text Готово.
text Она гордо показывает мне листовку.
music ~
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text Ах...
music BGM08A.mp3
text ...Весь плакат практически полностью покрыт загадочными существами.
text @[Томоя]
text Ты что, идиотка какая-то?!
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN1.aac
text @[Фурукава]
text Простите?
text @[Томоя]
text Смотри, тут даже текст невозможно прочитать!
sound GN2.aac
text @[Фурукава]
text Вы правы... его стало очень сложно читать.
text @[Томоя]
text Зачем ты нарисовала тут всех этих странных существ...?
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN3.aac
text @[Фурукава]
text Они не странные. Они очень знаменитые.
text @[Томоя]
text Кто это вообще такие?
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN4.aac
text @[Фурукава]
text Большая семья Данго.
text @[Томоя]
text Б-большая семья Данго...
text Это название песни, которая когда-то стала огромным хитом.
text Кажется, её использовали в детской передаче.
text @[Томоя]
text (Ах, так вот что за мелодию она сейчас напевала...)
text Любой в Японии знает эту песню.
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN5.aac
text @[Фурукава]
text Большая семья Данго — это большая семья. Вот почему их так много.
text @[Томоя]
text Давай будем откровенны, Фурукава.
sound GN6.aac
text @[Фурукава]
text Да?
text @[Томоя]
text У тебя правда не получается это дело.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN7.aac
text @[Фурукава]
text Чтоо...
text @[Томоя]
text Большая семья Данго? Когда это вообще было?
text @[Томоя]
text Это уже давно мертво и забыто.
setvar strS[1001] = "CGNG31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GN8.aac
text @[Фурукава]
text Что...? Неважно, старое это или нет. Что-то милое всегда милое, неважно, когда на это смотреть.
text @[Томоя]
text Признаю, это может быть и мило, но это уже вышло из моды.
text @[Томоя]
text Ты правда не в курсе того, что сейчас популярно, да...?
sound GN9.aac
text @[Фурукава]
text Разве...?
sound GNA.aac
text @[Фурукава]
text Для меня они всё ещё милые...
text @[Томоя]
text Правда? Что ж, рад это слышать...
text Я начинаю тереть виски.
text Глядя на то, что она нарисовала, может, нам было бы лучше, если бы я просто нарисовал свою кэтчерскую перчатку.
text @[Томоя]
text Любой обычный человек, увидев это, будет отпугнут... было бы одно дело, если бы она нарисовала это в шутку, но она серьёзно так считает...
setvar strS[1001] = "CGNG34"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG34.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GNB.aac
text @[Фурукава]
text Так что, никакой Большой семьи Данго...?
text Настроение Фурукавы начинает стремительно падать, пока она наблюдает за моей реакцией.
text @[Томоя]
text (Это плохо...)
text Я не могу позволить ей провалиться в полную бездну отчаяния... нужно что-то сделать.
text @[Томоя]
text Что ж... наверное, не так уж и плохо...
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GNC.aac
text @[Фурукава]
text Но вы же сами сказали. У меня это не получается...
text @[Томоя]
text Да, но это не значит, что Большая семья Данго не подходит для драмкружка.
text Это начинает требовать какой-то мысленной акробатики.
sound GND.aac
text @[Фурукава]
text Правда? Не знаю, как теперь к этому относиться.
text Её эта идея, похоже, особо не убедила, но мне вроде как удалось спасти ситуацию.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Томоя]
text (Хм-м...)
text Глядя на листовку, я начинаю думать, что она и правда показывает, что за человек Фурукава, президент клуба. В этом смысле, может, это намного лучше, чем листовка, украшенная ложью.
text @[Томоя]
text В любом случае, мы закончили делать объявление. У него, эм, есть своя изюминка.
text @[Томоя]
text Всё хорошо, что хорошо кончается.
text После моей натянутой попытки подвести итог, я хватаю лист бумаги и встаю.
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GNE.aac
text @[Фурукава]
text Куда ты?
text @[Томоя]
text К копировальному аппарату. Сделаю кучу копий и расклею их после уроков.
text @[Томоя]
text Думаю, это максимум, что мы сегодня можем сделать.
setvar strS[1001] = "CGNG14Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG14Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GNF.aac
text @[Фурукава]
text Ах, хорошо.
if 0 == 0
	goto s19
fi
goto 21
label s19
setvar strS[1000] = "KURO"
goto 23
label 21
if 0 == 1
	goto s20
fi
goto 22
label s20
setvar strS[1000] = "SIRO"
goto 23
label 22
setvar strS[1000] = "KURO"
label 23
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text После этого мы пользуемся копировальным аппаратом в учительской, а потом идём обратно.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6417_1_0.scr
