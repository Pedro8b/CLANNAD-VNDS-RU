sound 18Y.aac
text @[Сунохара]
text Ну же, давай.
text Сунохара протягивает мне биту рукоятью вперёд.
text @[Томоя]
text А? А... точно.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
