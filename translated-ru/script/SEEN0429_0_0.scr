bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 18Y.aac
text @[Sunohara]
text C'mon, now.
text Sunohara points a bat my way grip-first.
text @[Tomoya]
text Huh? Oh... right.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I'm leading our offense off this inning.
text I take it and stand in the batter's box.
text @[Томоя]
text Что мне делать с таким плечом?
text Больше мне не о чем думать, кроме как коснуться мяча битой и отправить его в пространство между внутренним и внешним полем.
text Но передо мной питчер с отличной точностью. Сумеет ли любитель вроде меня выбить у него хит?
text С самого первого броска я жду ломаного.
text Это очень сильный кёрвбол.
text Я машу битой, но полностью промахиваюсь.
text @[Томоя]
text (Должно быть, с такой махотней я выгляжу ужасно.)
text Во власти этой мысли я и со вторым броском промахиваюсь.
text Я смотрю, как мимо меня пролетает третий бросок — высокий фастбол.
sound 18Z.aac
text @[Судья]
text Страйк!
text @[Томоя]
text Ч-что...?
sound 190.aac
text @[Судья]
text Аут!
text К сожалению, я пропускаю третий страйк, не сделав замаха.
text Теперь я понимаю: когда оказываешься в бите, зона удара кажется куда менее определённой.
if intF[846] == 0
	goto s48
fi
goto 51
label s48
text Я передаю биту Санаэ-сан и возвращаюсь на скамейку.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 191.aac
text @[Томоё]
text Так значит, ты из тех, кто учит других тому, чего сам не умеет?
text @[Томоя]
text Оставь меня в покое...
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 192.aac
text @[Синохара]
text Эх. Пусть хоть кто-нибудь добьётся базы до моего хода!
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 193.aac
text @[Синохара]
text Не сомневаюсь, она тоже проведёт свой ход плохо. А если мой выпадет при двух аутах, я уже точно не смогу отбиться.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Лязг*
text Низкий флай-бол поднимается в воздух. Это мощно выбитый флай-бол.
setvar strS[1001] = "CGAK25AT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK25AT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 194.aac
text @[Акио]
text Беги!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Мяч падает прямо между второй базой и левым флангом. К моменту, когда он падает, Санаэ-сан уже находится на первой базе.
jump SEEN0429_0_1.scr 52
label 51
if intF[846] == 1
	goto s49
fi
jump SEEN0429_0_1.scr 52
label s49
text Я передаю биту Фуко, а затем направляюсь к скамейке.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 195.aac
text @[Томоё]
text Так ты из тех, кто учит других делать то, что сам делать не умеешь?
text @[Томоя]
text Отстань...
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 196.aac
text @[Синохара]
text Э-э! Нужно вывести на базу ещё кого-нибудь, пока я выйду к тарелке!
setvar strS[1001] = "CGSH18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 197.aac
text @[Синохара]
text Я уверен: она тоже не справится с подачей. Если я буду бить при двух аутах, то у меня ничего не получится.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Лязг*
text Мяч, летевший низко, поднимается в воздух. Это уверенно выбитый флайбол.
sound 198.aac
text @[Акио]
text Беги!
text Мяч падает прямо между второй базой и левым флангом. К моменту, когда он падает, Фуко уже находится на первой базе.
jump SEEN0429_0_1.scr
