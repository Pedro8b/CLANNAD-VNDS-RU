		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 18W.aac
text @[Томоё]
text Меня интересует только студсовет.
text Чтооо...? Все ошарашены таким ответом.
setvar strS[1001] = "CGAK22AT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK22AT.png
if intF[1113] == 1
