		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Начинается практика подачи.
text Не могу поверить, насколько высоко её подачи дугой. Они похожи на высокие подачки в волейболе снизу.
text Тем не менее, они всё же слегка касаются зоны удара. Возможно, она более атлетична, чем я ожидал.
text У неё просто нет силы, и всё.
text Игра перезапускается.
setvar strS[1001] = "CGNG18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 18O.aac
text @[Фурукава]
text ...
text Она прижимает руку к телу, принимая готовую позицию.
text @[Томоя]
text (Не могу поверить, как странно это выглядит, когда она так делает…)
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Сделав небольшую паузу, она бросает мяч.
text *Трель*
text Мяч раздражающе медленный.
text Бэттер терпеливо ждёт его, и…
text *ТКАНК*
text Сильно замахивается.
text Мяч взмывает высоко в воздух, пролетая над головой Фурукавы и падает в мелкую центральную часть поля.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Томойо поднимает его голой рукой, а затем… бросает.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *ВУШ*
text Он воет в воздухе к мне низкой, прямой линией.
text *ШМАК*
text Я ловлю его прямо перед собой.
music ~
sound 18P.aac
text @[Судья]
text Ты выбыл!
text Судья делает своё решение.
sound 18Q.aac
text @[Бьющий]
text А?
text Бегун стоит перед первой базой в полном недоумении.
text Знаешь, я думал, что мне конец.
text Удивительно, что я смог его поймать...
sound 18R.aac
text @[Бьющий]
text Что только что случилось?
text @[Томоя]
text Мяч пойман в центре поля.
