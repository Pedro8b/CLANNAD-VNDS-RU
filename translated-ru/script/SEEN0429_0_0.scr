	fi
fi
sound 18C.aac
text @[Акио]
text Проще всего отбивать подачи, которые летят быстро, но не слишком быстро.
sound 18D.aac
text @[Акио]
text По сравнению с тобой им было бы куда труднее отбивать мячи, летящие по высокой дуге, которые бросает человек, напрочь лишённый спортивных талантов.
setvar strS[1001] = "CGAK14AT"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14AT.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 18E.aac
text @[Акио]
text Нагиса, тебе поручается важная миссия...
sound 18F.aac
text @[Акио]
text Ты ведь сделаешь это для меня, правда?
text Старик смотрит Нагисе в глаза.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Знаешь... возможно, старик прав.
text Если наша защита будет неприступной... возможно, этот план сработает ещё лучше.
text @[Томоя]
text Пожалуйста, ты ведь согласишься?
text Я тоже прошу её об этом.
music ~
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
