text Разве послезавтра не... Фестиваль основателей?
text @[Томоя]
text А, точно, классный руководитель что-то такое говорил...
text @[Томоя]
text Но, ну, нам, третьекурсникам, ничего делать не нужно, так что для нас это неважно.
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7MY.aac
text @[Сунохара]
text Нет, тебе не кажется, что для нас-то это как раз важно?
text @[Томоя]
text Почему?
sound 7MZ.aac
text @[Сунохара]
text Разве это не организует совет учеников?
text @[Томоя]
text Но её же только вчера назначили.
sound 7N0.aac
text @[Сунохара]
text Ну, я не особо знаю подробностей...
sound 7N1.aac
text @[Сунохара]
text Но тебе не кажется, что именно этим она сегодня и занята?
text @[Томоя]
text Понятно...
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7N2.aac
text @[Сунохара]
text Ну, раз это Томоё-тян, наверняка всё закончится успехом.
text @[Томоя]
text Ага, наверное, так и будет.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s14
fi
goto 17
label s14
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2510_0_0.scr
