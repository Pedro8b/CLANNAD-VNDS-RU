text ...И составляю для них простой график до полного выздоровления, наверное.
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VE6.aac
text @[Каппэй]
text А, ещё, наверное, показываю, как растягиваться, и делаю массаж.
text Он загибает пальцы один за другим, пока говорит, отсчитывая каждый пункт.
text @[Томоя]
text У тебя раньше была такая работа?
setvar strS[1001] = "CGKP18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VE7.aac
text @[Каппэй]
text А?
text @[Томоя]
text Да не, просто звучит так, будто ты неплохо разбираешься в том, чем занимаются такие ассистенты.
setvar strS[1001] = "CGKP15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP15A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VE8.aac
text @[Каппэй]
text Э-э... ну, это вроде как общие знания.
text @[Томоя]
text Хм...
setvar strS[1001] = "CGKP10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VE9.aac
text @[Каппэй]
text В общем, вот так вот, так что сегодня — последний день, когда я останусь в комнате Сунохары-куна.
text @[Томоя]
text Ты нашёл жильё?
sound VEA.aac
text @[Каппэй]
text Да, нашёл дешёвое местечко.
text @[Томоя]
text ...Как-то это внезапно.
sound VEB.aac
text @[Каппэй]
text Лучшего времени, чем сейчас, не бывает!
text @[Томоя]
text Это где-то рядом?
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VEC.aac
text @[Каппэй]
text Конечно! Иначе Рё-сан было бы тяжело до меня добираться.
text Он показывает мне большой палец и расплывается в улыбке.
text @[Томоя]
text ...А, понятно...
setvar strS[1001] = "CGKP16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP16A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VED.aac
text @[Каппэй]
text Рё-сан сказала, что как только я обустроюсь, она придёт готовить мне еду.
sound VEE.aac
text @[Каппэй]
text Домашняя еда! Домашняя еда от Рё-сан!
sound VEF.aac
text @[Каппэй]
text А-ах... еда, приготовленная теми тонкими, как мальки, пальчиками...
text Каппэй вскидывает кулак и смотрит в небо.
sound VEG.aac
text @[Каппэй]
text У меня наверняка от этого лицо расплавится!
sound VEH.aac
text @[Каппэй]
text А, а как же десерт?! Должно же быть что-то вроде... ну, «съешь меня, пожалуйста»? Ого! Я бы с радостью, но нельзя же!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Пока он так распаляется, окружающие начинают коситься в нашу сторону.
text Я отступаю на шаг и смотрю на него так, будто мы незнакомы.
text Небо сегодня снова такое голубое...
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s77
fi
goto 82
label s77
setvar strS[1000] = ""
label 82
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN7600_12_0.scr
