text Спросил, что я тут делаю, раз я отстранён от занятий.
sound 6YZ.aac
text @[Томоё]
text Это правда, что ты был здесь?
text @[Томоя]
text Ага.
setvar strS[1001] = "CGTM11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Z0.aac
text @[Томоё]
text Ну... тогда он был прав.
sound 6Z1.aac
text @[Томоё]
text Отстранение — это то же самое, что домашний арест. Тебе нельзя выходить.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6Z2.aac
text @[Томоё]
text Я рад, что ты пришла меня повидать, но тебе стоит делать всё по правилам.
sound 6Z3.aac
text @[Томоё]
text Почему бы тебе просто не сидеть смирно и не ждать меня дома?
text @[Томоя]
text Потому что я хотела увидеть тебя как можно скорее.
text Почему я так становлюсь таким покладистым перед Томоё?
text Даже моя злость улеглась.
sound 6Z4.aac
text @[Томоё]
text Да... Я тоже.
sound 6Z5.aac
text @[Томоё]
text Но знаешь, Томоя.
sound 6Z6.aac
text @[Томоё]
text Тебе стоит постараться исправить своё поведение.
text @[Томоя]
text ...
text @[Томоя]
text Ага...
text Просто потому что это она, я в итоге лишь киваю и соглашаюсь с этим.
music ~
if 0 == 0
	goto s15
fi
goto 19
