text Я поднимаю её руку.
setvar strS[1001] = "CGNG18Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQ.aac
text @[Фурукава]
text Эм... Ты же сказал улыбнуться, верно?
text @[Томоя]
text Да. Широкая улыбка.
setvar strS[1001] = "CGNG22Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG22Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GR.aac
text @[Фурукава]
text Эм... хехе!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Она размахивает рукой взад и вперёд, ухмыляясь.
text Фигура у окна исчезает без предупреждения.
sound GS.aac
text @[Фурукава]
text Ах...
text Её выражение замерзает.
setvar strS[1001] = "CGNG33"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GT.aac
text @[Фурукава]
text Сэндвич с котлетой.
if intF[7] == 1
	goto s51
fi
goto 50
label s51
text @[Томоя]
text ...Прости за это.
setvar strS[1001] = "CGNG15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GU.aac
text @[Фурукава]
text О, нет...
setvar strS[1001] = "CGNG33"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV.aac
text @[Фурукава]
text Я не хотела звучать нуждающейся, говоря это, я просто...
text Она снова и снова повторяет одно и то же оправдание.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text *Хрум* *Хрум*
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GW.aac
text @[Фурукава]
text Это удивительно вкусно!
sound GX.aac
text @[Фурукава]
text Хехе...
text @[Томоя]
text ...
goto 51
label 50
if intF[7] == 0
	goto s52
fi
goto 51
label s52
text @[Томоя]
text Как я говорил, ты сейчас ешь один.
setvar strS[1001] = "CGNG31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GY.aac
text @[Фурукава]
text О, вы правы.
text *Жевание* *Жевание*
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GZ.aac
text @[Фурукава]
text Вы очень интересный человек, не правда ли, Окадзаки-сан?
text @[Томоя]
text Интересный человек здесь... это вы.
sound H0.aac
text @[Фурукава]
text Я не интересен.
sound H1.aac
text @[Фурукава]
text Совсем нет.
label 51
setvar strS[1000] = "BG080"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s53
fi
jump SEEN0416_0_1.scr 52
label s53
setvar strS[1000] = ""
jump SEEN0416_0_1.scr
