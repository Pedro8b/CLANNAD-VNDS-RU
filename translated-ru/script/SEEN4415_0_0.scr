	fi
fi
text Я нахожу стул, сажусь и полностью на него опираюсь.
text За окнами без штор я вижу то же самое небо, что и всегда.
text @[Томоя]
text Я трачу силы на прогулы, а в итоге только теряю время…
text Воздух пустой комнаты поглощает мои бормотания.
text Когда же моя жизнь изменится?
text Настанет ли день, когда она изменится?
text Кто‑то, кого я знал, говорил об этом однажды…
text Этот парень, должно быть, очень женственный, — подумал я. Затем я понял, что это же я и сказал.
if 0 == 0
	goto s5
fi
goto 6
label s5
setvar strS[1000] = "KURO"
goto 8
label 6
if 0 == 1
	goto s6
fi
goto 7
label s6
setvar strS[1000] = "SIRO"
goto 8
label 7
setvar strS[1000] = "KURO"
label 8
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text Я закрываю глаза.
text Как было бы здорово, если бы можно было перемотать время вперёд.
text .........
text ......
text ...
setvar strS[1000] = "BG023"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s7
fi
goto 9
