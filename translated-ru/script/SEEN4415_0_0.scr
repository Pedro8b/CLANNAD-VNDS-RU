text Бесцельно спускаюсь по лестнице.
text Скользящая дверь в конце коридора привлекает мой взгляд.
text Это библиотека.
text На двери висит табличка с надписью «Закрыто».
text При более тщательном рассмотрении дверь приоткрыта.
text Это привлекло моё внимание, хотя я не мог объяснить почему.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s9
fi
goto 11
label s9
setvar strS[1000] = ""
label 11
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG027"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s10
fi
goto 12
