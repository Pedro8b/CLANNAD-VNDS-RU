		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AWE.aac
text @[Рё]
text Эм... всё в порядке, если у тебя уже есть планы. Но если ты не против... ну... мне бы хотелось... побыть с тобой...
text Она говорит это застенчиво... с тем самым покрасневшим лицом, к которому я уже успел привыкнуть.
text @[Томоя]
text ...Да, у меня нет никаких планов, так что я не против.
