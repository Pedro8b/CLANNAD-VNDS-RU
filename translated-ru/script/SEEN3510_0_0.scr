text Честно говоря... это довольно смешанное чувство...
text То, что я сделал...
text ...действительно ли это правильно...?
text Я делаю это только потому, что мои чувства колеблются...
setvar strS[1001] = "CGRY21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AUU.aac
