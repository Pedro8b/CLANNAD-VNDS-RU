bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM26A.mp3
text Мир окутан белизной...
text ...
text Снег...
