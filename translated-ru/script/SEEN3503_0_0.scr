text Кё говорит и зовёт Ботана.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Слушая приказ своего хозяина, Ботан с радостью мчится к нам.
setvar strS[1001] = "CGBT11"
sound A9T.aac
text @[Ботан]
text Пухи пухи♪
text Тогда он подпрыгивает у моих ног.
setvar strS[1001] = "CGKY15C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound A9U.aac
text @[Кё]
text А, хорошо, Ботан. Пора идти домой.
setvar strS[1001] = "CGBT11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGBT11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound A9V.aac
text @[Ботан]
text Пухи пухи♪
text ...Он хрюкает, цепляясь за мою ногу.
text @[Томоя]
text Похоже, он меня очень любит.
setvar strS[1001] = "CGKY25C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY25C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound A9W.aac
text @[Кё]
text Ты прав. Похоже, у вас двоих хорошая химия.
setvar strS[1001] = "CGKY11C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound A9X.aac
text @[Кё]
text Ладно, Ботан, пора идти!
sound A9Y.aac
text @[Ботан]
text Пухи пухи♪
setvar strS[1001] = "CGKY13C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound A9Z.aac
text @[Кё]
text Эй, подойди сюда.
sound AA0.aac
text @[Ботан]
text Пухи~
text @[Томоя]
text ...Может, мне тоже пойти с вами.
setvar strS[1001] = "CGKY15C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY15C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA1.aac
text @[Кё]
text Э?
text @[Томоя]
text Мне нечего делать, так что могу же проводить вас обоих домой.
sound AA2.aac
text @[Кё]
text Это довольно далеко, знаешь?
text @[Томоя]
text Похоже, Ботан не пойдёт, если я не пойду.
setvar strS[1001] = "CGBT11"
sound AA3.aac
text @[Ботан]
text Пухи♪
setvar strS[1001] = "CGKY26C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY26C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA4.aac
text @[Кё]
text Эх... эм... да... вроде бы так...
text Кё чешет щеку и говорит побитым тоном.
text @[Томоя]
text Эй, Ботан, отодвинься немного от моих ног. Иначе я могу наступить на тебя.
setvar strS[1001] = "CGBT10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGBT10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA5.aac
text @[Ботан]
text Пухи~
text В ответ Ботан послушно делает несколько шагов назад.
text @[Томоя]
text Он удивительно умён.
setvar strS[1001] = "CGKY12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA6.aac
text @[Кё]
text Ну конечно! Он мой питомец!
text @[Томоя]
text И это делает всё ещё более удивительным.
setvar strS[1001] = "CGKY24C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY24C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA7.aac
text @[Кё]
text Что это должно значить?
text @[Томоя]
text Не задумывайся об этом слишком сильно. Пойдём.
setvar strS[1001] = "CGBT11"
sound AA8.aac
text @[Ботан]
text Пухихи~♪
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Я начинаю идти, а Ботан начинает отставать позади меня.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 18
label s17
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AA9.aac
text @[Кё]
text ...Томоя.
text @[Томоя]
text Хм?
sound AAA.aac
text @[Кё]
text ...Спасибо.
text @[Томоя]
text Я просто иду с вами, потому что мне нечего делать. Вам действительно не стоит меня благодарить.
sound AAB.aac
text @[Кё]
text …Это не только то…
text @[Томоя]
text …?
sound AAC.aac
text @[Кё]
text В любом случае, спасибо за многое.
text @[Томоя]
text Я не уверен, что понимаю, но пожалуйста.
sound AAD.aac
text @[Ботан]
text Пухи~?
text Когда он смотрит на меня и Кё, Ботан наклоняет голову.
setvar intF[309] = 1
label 19
if intF[1089] == 1
	goto s18
fi
goto 20
label s18
setvar strS[1001] = "CGKY21D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY21D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AAE.aac
text @[Кё]
text А… Э… ну, не беспокойся об этом.
sound AAF.aac
text @[Кё]
text Полагаю, я слишком настойчив, или назовём это…
sound AAG.aac
text @[Кё]
text К тому же, поцелуй – это не то, что нужно практиковать. Да, совсем не нужно.
text \"Ахахаха,\" она смеётся в одиночку, создавая неловкую атмосферу.
text Что касается меня, я не знаю, что сказать.
text Возможно, не успев улавливать атмосферу, Кё опускает голову с тревожным видом.
setvar strS[1001] = "CGKY16D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY16D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AAH.aac
text @[Кё]
text Э… ну… извини.
text @[Томоя]
text Ни… ничего, за что нужно извиняться…
sound AAI.aac
text @[Кё]
text Но… всё равно, извини…
text @[Томоя]
text …Да…
text В ответ я могу лишь слегка кивнуть.
setvar strS[1001] = "CGKY22D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY22D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AAJ.aac
text @[Кё]
text Ну… я ухожу.
text @[Томоя]
text Хм? А, ладно.
sound AAK.aac
text @[Кё]
text Ботан!
text Вдалеке Ботан дергается в ответ на крик Кё и бросается сюда.
setvar strS[1001] = "CGKY11D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY11D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound AAL.aac
text @[Кё]
text Спасибо, что прогулял Ботана со мной.
sound AAM.aac
text @[Кё]
text Ну, увидимся завтра.
text @[Томоя]
text А?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Добежав до ног Кё, Ботан бросает своему хозяину озадаченный взгляд, тяжело дыша.
label 20
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s19
fi
goto 21
label s19
setvar strS[1000] = ""
label 21
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN3504_0_0.scr
