text Что... я вообще пытаюсь сделать...?
text Что я... здесь делаю...?
text То цветочное поле так далеко и недостижимо...
text Тот образ резвящейся и играющей там Усио — вне досягаемости...
text Мне так сильно хотелось на этот раз быть там вместе с ней, играть рядом с ней...
text Мы с ней...
text ...смогли бы играть и ладить друг с другом гораздо лучше, чем тогда, тем летним днём...
text Потому что теперь... мы отец и дочь.
text Мы живём вместе.
text Но всё же...
text И тем не менее...
setvar strS[1000] = "FGNG18B"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s354
fi
goto 404
label s354
setvar strS[1000] = ""
label 404
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
sound PQQ.aac
text @[Усио]
text ...Папа.
text В какой-то момент Усио очнулась.
text На её лице — гримаса боли, пока она смотрит на меня.
text @[Томоя]
text Что такое...?
sound PQR.aac
text @[Усио]
text ...Где мы?
text @[Томоя]
text ...
sound PQS.aac
text @[Усио]
text ...Мы уже в поезде...?
text @[Томоя]
text ...
text @[Томоя]
text Д-да.
text @[Томоя]
text Мы уже в поезде...
sound PQT.aac
text @[Усио]
text ...А.
text @[Томоя]
text ...
sound PQU.aac
text @[Усио]
text ...
sound PQV.aac
text @[Усио]
text ...Папа.
text @[Томоя]
text Да...?
sound PQW.aac
text @[Усио]
text ...Я люблю тебя...
text @[Томоя]
text ...
text Из глаз начинают литься слёзы... и я ничего не могу с этим поделать.
text @[Томоя]
text А...
text @[Томоя]
text Папа тоже тебя любит...
setvar strS[1000] = "FGNG18A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s355
fi
goto 405
label s355
setvar strS[1000] = ""
label 405
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 55
text ......
text Снег продолжает сыпать на нас.
text Каждая снежинка вырезает ещё один миг вечности.
text Я теряю чувствительность в кончиках пальцев...
text И мир вокруг меня начинает сужаться...
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s356
fi
goto 406
label s356
setvar strS[1000] = ""
label 406
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 301
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Город исчезает...
text На его месте — иллюзорное видение...
text Я уже даже не знаю, где нахожусь...
text ......
music ~
delay 30
delay 300
music BGM26A.mp3
delay 240
if rtf0 != ""
	setvar rtf1 = "SEEN6802_4_0.scr"
	setvar rtl1 = "rtl2"
fi
if rtf0 == ""
	setvar rtf0 = "SEEN6802_4_0.scr"
	setvar rtl0 = "rtl2"
fi
jump SEEN6900_12_0.scr
label rtl2
if rtf1 == ""
	setvar rtf0 = ""
fi
if rtf1 != ""
	setvar rtf1 = ""
fi
gsetvar intG[35] = 1
delay 120
cleartext
jump main.scr
