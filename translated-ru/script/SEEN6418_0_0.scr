setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG024"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Обеденное время. Мы едим хлеб на нашем обычном месте.
setvar strS[1001] = "CGNG30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQ9.aac
text @[Фурукава]
text Через две недели... Интересно, появятся ли вообще кто-нибудь.
text Через две недели... В тот день будет проходить информационная сессия драмкружка.
text @[Томоя]
text (Ну... на листовках же изображена Большая Семья Данго...)
text Я на мгновение колеблюсь, не в силах ответить.
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQA.aac
text @[Фурукава]
text Оказаки‑сан...?
text @[Томоя]
text Эм, я уверен, всё будет в порядке...
text @[Томоя]
text Все эти данго, что ты разослал по школе, сидят на своих билбордах, усердно работают. Доверься им.
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQB.aac
text @[Фурукава]
text Ты права. Их ведь целых сто!
text @[Томоя]
text (Эм, думаю, в этом и наша проблема…)
text Я тихо подколю чрезмерную уверенность Фурукавы.
text Но, серьёзно, почему эти штуки вообще были популярны? Оглядываясь назад, это не имеет никакого смысла.
text И тем более бессмысленно продолжать быть их фанатом.
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQC.aac
text @[Фурукава]
text Кстати…
text @[Томоя]
text Что?
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQD.aac
text @[Фурукава]
text Что именно ты планируешь делать на информационной сессии?
text @[Томоя]
text …
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQE.aac
text @[Фурукава]
text Оказаки‑сан?
text ...Я забыл:
text Она не из тех, кто может просто собраться и справиться с этим сама.
text @[Томоя]
text Фурукава.
sound GQF.aac
text @[Фурукава]
text Да?
text @[Томоя]
text Давай сейчас проведём практику.
music ~
setvar strS[1000] = "BG022"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text @[Томоя]
text Говори о чём угодно.
text Я сижу на полу и даю указания Фурукаве, стоящей перед доской.
text Она, кажется, осознавала, что является лидером клуба, поэтому проявила инициативу и решила встать там.
text Если бы это было пару дней назад, она, вероятно, попросила бы меня встать на её месте.
text Она действительно пытается проявлять инициативу в этом.
text Очевидно, что это многое для неё значит; её действия подтверждают это.
text @[Томоя]
text (Ты сможешь, Фурукава.)
text Я подбадриваю её в мыслях.
text Но...
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQG.aac
text @[Фурукава]
text Эм, ну...
text Вместо того чтобы начать речь, она просто машет руками туда-сюда, явно ёрзая.
text В таком темпе первый звонок прозвенит ещё до того, как она начнёт.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQH.aac
text @[Фурукава]
text А...
sound GQI.aac
text @[Фурукава]
text ...
text @[Томоя]
text Эй, Фурукава.
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQJ.aac
text @[Фурукава]
text Да?
text @[Томоя]
text Смотря на тебя сейчас, меня это заставляет задуматься... Как ты умеешь играть в пьесах...?
text Если она так плохо умеет разговаривать и так подвержена давлению...
text Может ли она действительно ожидать, что будущие члены клуба воспримут её всерьёз? Я имею в виду, кто бы захотел вступить в драматический клуб, если президент не может даже преодолеть собственные нервы? Это явно противоречие.
text Итак, эти фантомные, теоретические претенденты... столкнутся не с одной, а с двумя ярко выраженными проблемами.
text Во-первых, очевидная одержимость Большой семьей Данго.
text А во-вторых, президент, который не умеет говорить.
text @[Томоя]
text *Вздох*
text И эти проблемы вовсе не мелкие, легко упускаемые из виду сомнения.
text @[Томоя]
text (Не то чтобы они хотели их игнорировать с самого начала...)
sound GQK.aac
text @[Фурукава]
text Эм... Оказакі-сан?
text @[Томоя]
text Позволь быть прямым с тобой, Фурукава.
sound GQL.aac
text @[Фурукава]
text Ладно...
text @[Томоя]
text У тебя нет никаких актерских навыков.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQM.aac
text @[Фурукава]
text Че...?
text @[Томоя]
text Итак, тебе придётся пытаться как безумный.
sound GQN.aac
text @[Фурукава]
text А-Ладно.
text @[Томоя]
text Это значит, что тебе придётся тренироваться перед информационной сессией некоторое время... И я действительно имею в виду некоторое время.
setvar strS[1001] = "CGNG33"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GQO.aac
text @[Фурукава]
text Ладно. Я сделаю всё, что смогу!
text Она сжимает руки в кулаки. По крайней мере, выглядит мотивированной.
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6418_1_0.scr
