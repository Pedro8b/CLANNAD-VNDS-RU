text Мои руки широко раскрыты, чтобы обнять её маленькое, мягкое тело.
sound FVZ.aac
text @[Миядзава]
text ...
text Я продолжаю наслаждаться ароматом её шёлковых волос...
text @[Томоя]
text (Интересно, что бы сделали её друзья, если бы увидели нас вот так...)
text @[Томоя]
text (Эти объятия буквально... смертельно опасны...)
text Эта мысль проплывает сквозь мой опустевший разум.
music ~
if 0 == 0
	goto s41
fi
goto 50
label s41
setvar strS[1000] = "KURO"
jump SEEN5430_0_1.scr 52
label 50
if 0 == 1
	goto s42
fi
goto 51
label s42
setvar strS[1000] = "SIRO"
jump SEEN5430_0_1.scr 52
label 51
setvar strS[1000] = "KURO"
jump SEEN5430_0_1.scr
