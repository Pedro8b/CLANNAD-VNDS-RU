	goto s3
fi
goto 5
label s3
setvar strS[1000] = "KURO"
goto 7
label 5
if 0 == 1
	goto s4
fi
goto 6
label s4
setvar strS[1000] = "SIRO"
goto 7
label 6
setvar strS[1000] = "KURO"
label 7
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
delay 120
