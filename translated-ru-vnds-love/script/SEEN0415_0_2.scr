		setimg {$strS[1004]}.t3x -7 -7
	fi
fi
sound CN.aac
text @[Сунохара]
text Одна девушка справилась с двумя парнями в одиночку?
sound CO.aac
text @[Сунохара]
text Такого не бывает.
text @[Томоя]
text Ты же сам смотрел, не так ли? Нельзя отрицать реальность.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.t3x 30
setimg CGSH13B.t3x
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.t3x -7 -7
	fi
fi
sound CP.aac
text @[Сунохара]
text Это точно был спектакль. Спорю, эти парни были просто подставными.
sound CQ.aac
text @[Сунохара]
text Вот почему всё произошло так далеко от всех. Чтобы никто не догадался.
sound CR.aac
text @[Сунохара]
text К тому же, это было идеальное место, чтобы привлечь внимание. Даже слишком идеальное.
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.t3x 30
setimg CGSH15B.t3x
if intF[1113] == 1
