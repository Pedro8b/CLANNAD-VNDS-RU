sound CL.aac
text @[Сунохара]
text Мне не нравится, когда кто-то так старается выделиться.
sound CM.aac
text @[Сунохара]
text Это просто один большой фарс.
text @[Томоя]
text А? Что ты имеешь в виду?
setvar strS[1001] = "CGSH15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.t3x 30
setimg CGSH15B.t3x
if intF[1113] == 1
