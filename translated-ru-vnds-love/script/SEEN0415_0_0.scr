		setimg {$strS[1004]}.t3x -7 -7
	fi
fi
sound 62.aac
text @[Суногара]
text Ха! Значит, ты уже умер!
text @[Томоя]
text Всё верно. Ты сейчас разговариваешь с голограммой.
