setvar strS[1000] = "BG008C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text The sky is overcast.
text My mood drops like an anvil out of a third-floor window.
text @[Tomoya]
text (Maybe it's the weather's fault...)
setvar strS[1000] = "BG033AC"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I hear the sound of approaching footsteps.
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GUZ.aac
text @[Furukawa]
text Okazaki-san!
sound GV0.aac
text @[Furukawa]
text Good morning.
text Furukawa naturally walks up by my side.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text Yeah, 'morning...
text Those are the only words I say to her before falling silent.
setvar strS[1000] = "BG011C"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV1.aac
text @[Furukawa]
text I have a proposal, Okazaki-san.
text When we get to the bottom of the hill, Furukawa starts to talk.
text @[Tomoya]
text What is it?
sound GV2.aac
text @[Furukawa]
text We should play basketball after school today.
text @[Tomoya]
text What? Who's this "we"?
sound GV3.aac
text @[Furukawa]
text You and I, Okazaki-san.
text @[Tomoya]
text Huh?
sound GV4.aac
text @[Furukawa]
text I'll be waiting for you by the athletic grounds after school.
sound GV5.aac
text @[Furukawa]
text I'll be there waiting with basketball in-hand.
text What a foolish idea.
text @[Tomoya]
text What are you, stupid?
setvar strS[1001] = "CGNG23Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV6.aac
text @[Furukawa]
text I may not seem like it, but I'm actually quite athletic.
text @[Tomoya]
text That's not what I meant...
sound GV7.aac
text @[Furukawa]
text I can even shoot the ball, as long as I throw it underhanded.
sound GV8.aac
text @[Furukawa]
text And if I'm standing still, I can dribble too.
text @[Tomoya]
text ...
text @[Tomoya]
text ...That would make you unathletic.
setvar strS[1001] = "CGNG13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GV9.aac
text @[Furukawa]
text What? Really?
text @[Tomoya]
text Yeah...
text @[Tomoya]
text So don't bother. You're not cut out for it.
text @[Tomoya]
text Just focus on the drama club.
setvar strS[1001] = "CGNG18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GVA.aac
text @[Furukawa]
text But I want you to know too.
text @[Tomoya]
text Know what?
sound GVB.aac
text @[Furukawa]
text That you can put your all into something.
text A concept that's further removed from my life than just about anything else I can think of.
text The idea of working hard toward something seems unimaginable to me after what I've gone through.
text Which one of us here ended up with a whole lot of nothing to show for all their efforts?
text The thought makes me sick.
text @[Tomoya]
text If you want to play, go play on your own.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound GVC.aac
text @[Furukawa]
text No, I'd rather play together.
text @[Tomoya]
text I'm going straight home today, all right?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text After telling her that, I head to my class.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6419_1_0.scr
