fi
sound 9JS.aac
text @[Kyou]
text W-Well, that...
text @[Tomoya]
text That's not right, yes?
setvar strS[1001] = "CGKY16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
