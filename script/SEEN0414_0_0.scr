if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text But one day, our relationship took a turn for the worse.
text He got violent with me.
text Ever since then, my father's stopped showing his emotions.
text He's also stopped calling me just Tomoya, instead calling me Tomoya-kun as if we're nothing more than strangers.
text And indeed, he's turned into just that at this point.
text It's like he's retreating into some kind of shell.
text As if he's trying to sever the present from the past.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 20
label s18
setvar strS[1000] = ""
label 20
