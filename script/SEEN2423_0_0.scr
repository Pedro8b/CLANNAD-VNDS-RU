setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65C.aac
text @[Tomoyo]
text Is that so...
sound 65D.aac
text @[Tomoyo]
text But you know, Tomoya...
sound 65E.aac
text @[Tomoyo]
text Even I am weak.
sound 65F.aac
text @[Tomoyo]
text Getting told something like that... hurts me.
text Without thinking, I burst into laughter.
text It was just funny, seeing Tomoyo desperately appeal to her femininity.
setvar strS[1001] = "CGTM24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65G.aac
text @[Tomoyo]
text What, why are you laughing? Did I say something funny?
text @[Tomoya]
text No, not really.
text @[Tomoya]
text Just that, although a lot of guys do think like that...
text @[Tomoya]
text I only feel that way occasionally.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65H.aac
text @[Tomoyo]
text Occasionally, meaning usually you feel differently about this?
text @[Tomoya]
text Yeah.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65I.aac
text @[Tomoyo]
text I see. That's interesting.
sound 65J.aac
text @[Tomoyo]
text So what kind of girl are you really charmed by, Tomoya?
text She comes up close to me when she asks this.
sound 65K.aac
text @[Tomoyo]
text I'll be sure to keep it a secret.
text She smells surprisingly feminine.
text @[Tomoya]
text Sharing secrets, huh? Why, that's sure feminine of you.
sound 65L.aac
text @[Tomoyo]
text Right?
text @[Tomoya]
text However, I'm a man. And men have to stay silent.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65M.aac
text @[Tomoyo]
text Idiot. If you're a man, you should just give away everything without constraint, like men always do.
text @[Tomoya]
text Someone who says just about anything without constraint would just be a pervert.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65N.aac
text @[Tomoyo]
text Really?
text @[Tomoya]
text Now come on, make some distance, or strange rumors will start sprouting up again.
text I say this, noticing the amount of students increasing in my field of vision.
setvar strS[1001] = "CGTM31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65O.aac
text @[Tomoyo]
text Even though I've been telling you I don't really care...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
text She backs away after expressing her complaint.
setvar strS[1000] = "BG012"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 4
label s3
setvar strS[1000] = ""
label 4
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM01.mp3
text Then she stops and looks up.
text @[Tomoya]
text What's wrong?
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65P.aac
text @[Tomoyo]
text No, nothing.
text She says, glancing back at me.
text What Tomoyo is looking at is... the sakura tree.
text @[Tomoya]
text You were staring up like that a while ago too, weren't you?
text @[Tomoya]
text Do you like sakura that much?
sound 65Q.aac
text @[Tomoyo]
text I guess so. I might have actually grown to like them.
sound 65R.aac
text @[Tomoyo]
text Before all this, I didn't like them at all, though...
text @[Tomoya]
text Well, it's fine and all if you like them, but we'll be late if you keep standing here.
sound 65S.aac
text @[Tomoyo]
text Yeah, sorry for stopping like that. Let's go.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text We start climbing the hill.
setvar strS[1000] = "BG015"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s4
fi
goto 5
label s4
setvar strS[1000] = ""
label 5
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65T.aac
text @[Tomoyo]
text Do you think it'll be lonely, Tomoya?
text @[Tomoya]
text Lonely, what?
sound 65U.aac
text @[Tomoyo]
text When the cherry trees standing here get cut down.
text @[Tomoya]
text Eh? They're being cut down?
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65V.aac
text @[Tomoyo]
text Are you really a student from this school?
text @[Tomoya]
text Just occasionally.
sound 65W.aac
text @[Tomoyo]
text How does a student who only transferred here this spring know more about this than you?
text @[Tomoya]
text I'm pretty estranged from these kinds of things.
sound 65X.aac
text @[Tomoyo]
text So it seems.
setvar strS[1001] = "CGTM32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 65Y.aac
text @[Tomoyo]
text But it's true. That's what's been decided.
text @[Tomoya]
text Really...?
sound 65Z.aac
text @[Tomoyo]
text That's why I asked if you thought it'd be lonely.
text @[Tomoya]
text Well... if something goes away that's been here the whole time, I probably would.
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 660.aac
text @[Tomoyo]
text You think so too?
sound 661.aac
text @[Tomoyo]
text I'm sure every student in this school would agree too.
text @[Tomoya]
text Well, I dunno about that.
text @[Tomoya]
text Sunohara used to always piss on them while laughing, you know?
setvar strS[1001] = "CGTM14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 662.aac
text @[Tomoyo]
text Th-That guy...
text She staggers as though she's dizzy.
text @[Tomoya]
text Come on, we'll be late if we don't hurry.
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 663.aac
text @[Tomoyo]
text O-Okay.
