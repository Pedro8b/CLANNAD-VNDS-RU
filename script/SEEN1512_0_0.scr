setvar intF[1110] = 12
setvar intF[1112] = 0
setvar strS[1004] = "SDTA0512"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1004] = ""
label 1
bgload SCLAB00.jpg 45
delay 60
setimg SCLAP07.png 5 5
setimg SCLA0512.png 159 160
delay 120
if 0 == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = "KURO"
goto 4
label 2
if 0 == 1
	goto s2
fi
goto 3
label s2
setvar strS[1000] = "SIRO"
goto 4
label 3
setvar strS[1000] = "KURO"
label 4
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text The next evening, I get a call from Koumura.
setvar strS[1000] = "BG010N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 5
label s3
setvar strS[1000] = ""
label 5
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08D.mp3
sound 4OY.aac
text @[Koumura]
text Is this Tomoya-kun?
text @[Tomoya]
text Yeah.
sound 4OZ.aac
text @[Koumura]
text Tell Kouko-san she can hold her wedding on campus.
text @[Tomoya]
text So you managed to convince them?
sound 4P0.aac
text @[Koumura]
text Hmm...
sound 4P1.aac
text @[Koumura]
text But only on a Sunday this month...
text @[Tomoya]
text Gracias.
text *click*
text I put down the receiver without waiting for his reply and quickly dial Kouko-san's number.
text I asked for her contact info the other day.
sound 4P2.aac
text @[Voice]
text Hello.
text @[Tomoya]
text Kouko-san? It's me, Okazaki.
sound 4P3.aac
text @[Kouko]
text Oh, good evening, Okazaki-san.
text She always takes the time for polite greetings.
text @[Tomoya]
text I have another favor to ask.
sound 4P4.aac
text @[Kouko]
text Sure. What is it?
text @[Tomoya]
text Please hold your wedding... at school.
sound 4P5.aac
text @[Kouko]
text Sorry, what do you mean?
text @[Tomoya]
text The location of the ceremony. Please hold it on campus.
sound 4P6.aac
text @[Kouko]
text That is... I mean, can I really do that?
text @[Tomoya]
text I just got the "go ahead" from the top. Not to mention, who could say "no" to Kouko-san's wedding?
sound 4P7.aac
text @[Kouko]
text Haha... I wonder.
text @[Tomoya]
text So that's fine with you, right? Please tell me it's okay.
sound 4P8.aac
text @[Kouko]
text I must say... I would be more than grateful to.
sound 4P9.aac
text @[Kouko]
text If everyone is fine with it, I really want to hold my wedding there.
text @[Tomoya]
text I already said no one's gonna say "no" to you.
sound 4PA.aac
text @[Kouko]
text In that case... please let me take up the offer.
text @[Tomoya]
text Is next Sunday okay with you?
sound 4PB.aac
text @[Kouko]
text Well...
text And after a moment of hesitation...
sound 4PC.aac
text @[Kouko]
text Yes. I understand.
text I'm relieved at her answer.
text I'm so glad it's going well. I really am.
sound 4PD.aac
text @[Kouko]
text Okazaki-san.
text @[Tomoya]
text Yes?
sound 4PE.aac
text @[Kouko]
text Can you tell me the names of the people who helped give me this opportunity?
text @[Tomoya]
text Huh?
sound 4PF.aac
text @[Kouko]
text I want to say thanks.
text @[Tomoya]
text I see...
text Kouko-san, this is just like you.
text @[Tomoya]
text It's Koumura.
sound 4PG.aac
text @[Kouko]
text Can you tell me more about this Koumura...-san?
text @[Tomoya]
text It's the teacher, Koumura-sensei.
text Guess it was a bad idea to refer to him by name to Kouko-san.
sound 4PH.aac
text @[Kouko]
text You mean that Koumura-sensei?!
text Unexpectedly, she doesn't seem to mind my over-the-top politeness toward the old teacher. Instead, she just asks me back with a voice filled with joy.
text @[Tomoya]
text Are you close with him?
sound 4PI.aac
text @[Kouko]
text Very much so... Koumura-sensei is the teacher I've always respected most of all.
sound 4PJ.aac
text @[Kouko]
text It's all thanks to him that even a pampered child like me could somehow take care of a whole class.
sound 4PK.aac
text @[Kouko]
text He taught me how to take control of a classroom.
text @[Tomoya]
text Are you serious?
sound 4PL.aac
text @[Kouko]
text Despite how he looks, Koumura-sensei is actually very stern.
text Are we even talking about the same Koumura here...?
sound 4PM.aac
text @[Kouko]
text Ah... Is it okay if I get going?
text @[Tomoya]
text Ah, sorry. I'm taking too much of your time.
sound 4PN.aac
text @[Kouko]
text Of course not. I want to talk a lot more with you.
sound 4PO.aac
text @[Kouko]
text But this is not my house, so...
text @[Tomoya]
text Yes, I understand. Sorry.
sound 4PP.aac
text @[Kouko]
text I haven't had such good news in a while. Thank you so much for calling me today.
text @[Tomoya]
text It's no big deal...
sound 4PQ.aac
text @[Kouko]
text Well, good night.
text @[Tomoya]
text Yeah, good night.
text I put the receiver down.
text Yeah... It will be the best wedding ever.
text The confidence builds up in me.
text That's the one thing she's sacrificed everything else for...
text There's absolutely no way her tremendous effort will be in vain.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s4
fi
goto 6
label s4
setvar strS[1000] = ""
label 6
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN1513_0_0.scr
