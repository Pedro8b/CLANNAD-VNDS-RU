gsetvar intG[43] = 1
delay 60
music ~
setvar strS[1000] = "BG244BM"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 13
label s13
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ...
text ...I'm grasping it.
text Nagisa's hand.
text The hand I thought had disappeared.
text Ahead of it... I see Nagisa, staring at me.
setvar strS[1000] = "FGNG15A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s14
fi
goto 14
label s14
setvar strS[1000] = ""
label 14
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
music BGM02B.mp3
sound PRG.aac
text @[Nagisa]
text Tomoya-kun...
text Nagisa's voice.
text The voice of the woman I love.
text @[Tomoya]
text Nagisa...
text My voice is hoarse as I reply.
sound PRH.aac
text @[Nagisa]
text What's the matter, Tomoya-kun?
text @[Tomoya]
text No, it's nothing...
text I hold her hand tightly.
text Nagisa grips my hand in return.
sound PRI.aac
text @[Nagisa]
text Thank you, Tomoya-kun.
text @[Tomoya]
text For what...?
sound PRJ.aac
text @[Nagisa]
text For always holding my hand...
text @[Tomoya]
text No... This is all I could ever do for you, anyway...
sound PRK.aac
text @[Nagisa]
text Thank you...
text She repeats the words.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 15
label s15
setvar strS[1000] = ""
label 15
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG244BM"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 16
label s16
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound PRL.aac
text @[Voice]
text You did a good job.
text I hear Yagi-san's voice behind me.
text "And same to you, you did a good job," I hear the old man say behind me.
sound PRM.aac
text @[Sanae]
text Will you give Ushio her first bath, Tomoya-san?
text @[Tomoya]
text Oh, okay.
text Yes, that is what my first duty as a father should be.
text I gently place Ushio in the baby bath drawn by the old man.
sound PRN.aac
text @[Nagisa]
text Do your best, Tomoya-kun.
text Nagisa is there watching me too.
text @[Tomoya]
text Don't worry, I got this.
text I may say that, but I feel nervous...
sound PRO.aac
text @[Sanae]
text Be sure to hold her neck with your hand.
sound PRP.aac
text @[Sanae]
text Support her with your left hand and put water on her with your right.
text Sanae-san teaches me how to do it.
text I pour the lukewarm water on the small body in my hands, just as I'm told.
sound PRQ.aac
text @[Sanae]
text You shouldn't get her head wet yet.
sound PRR.aac
text @[Sanae]
text Now wipe her with gauze, please.
text I'm done cleaning Ushio's body.
text I wipe her with a soft towel as if I'm caressing her, then dress her.
text The life in my hands is so small and fragile...
text Yet there's life within it.
text New, robust life.
text @[Tomoya]
text (Ah...)
text As the realization grips my heart, I notice something else.
text @[Tomoya]
text (I can't believe how strong she must be...)
text She now has a path ahead of her.
text It may be a treacherous one...
text And regardless of how long it may be...
text I know she'll travel it living with strength.
text That's how it's starting to feel.
text @[Tomoya]
text (Yeah... She's Nagisa's child, after all...)
text @[Tomoya]
text (Of course she's strong...)
sound PRS.aac
text @[Nagisa]
text Good work, Tomoya-kun.
text Nagisa's words of gratitude.
sound PRT.aac
text @[Nagisa]
text Tomoya-kun.
text After them, she says my name as if she's noticed something.
text @[Tomoya]
text What is it?
sound PRU.aac
text @[Nagisa]
text Look outside the window.
sound PRV.aac
text @[Nagisa]
text It's beautiful.
text @[Tomoya]
text What...?
text I walk toward the window and part the curtains.
setvar strS[1000] = "FGNG19"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 17
label s17
setvar strS[1000] = ""
label 17
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text Snow...
text In spring?
text No...
text ...Light.
text Light, everywhere.
sound PRW.aac
text @[Nagisa]
text If...
sound PRX.aac
text @[Nagisa]
text If this town has a will and a heart, just like a person...
sound PRY.aac
text @[Nagisa]
text And if it wished for the people who live in it to be happy...
sound PRZ.aac
text @[Nagisa]
text If it really thought that way...
sound PS0.aac
text @[Nagisa]
text Then perhaps the town is responsible for this miracle.
text Oh... There are a lot of other miracles waiting for us from now on.
text At least, that's how I'm starting to feel.
sound PS1.aac
text @[Nagisa]
text But actually, I guess that wouldn't be a miracle.
sound PS2.aac
text @[Nagisa]
text People who love the town live in it...
sound PS3.aac
text @[Nagisa]
text And the town loves those people back...
sound PS4.aac
text @[Nagisa]
text Those kinds of thoughts come from the emotions that we all have.
sound PS5.aac
text @[Nagisa]
text Not just this town.
sound PS6.aac
text @[Nagisa]
text It's true for any town.
sound PS7.aac
text @[Nagisa]
text We love the town, and the town nurtures us.
sound PS8.aac
text @[Nagisa]
text That's what I think.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s18
fi
goto 18
label s18
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6803_2_0.scr
