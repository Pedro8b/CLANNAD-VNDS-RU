text I chew on the bread.
text For some reason, her tears remind me of something I tasted long ago.
text It's the same taste as the tears I once cried as a kid.
setvar intF[11] = 1
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s13
fi
goto 14
label s13
setvar strS[1000] = ""
label 14
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN6421_1_0.scr
