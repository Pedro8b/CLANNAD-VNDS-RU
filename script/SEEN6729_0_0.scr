text @[Nagisa]
text I'll come later and bring something for you two to enjoy during break.
if intF[28] == 1
	goto s37
fi
goto 46
label s37
text @[Tomoya]
text Nagisa...
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LVD.aac
text @[Nagisa]
text Yes.
if intF[30] == 1
	goto s38
fi
goto 44
label s38
text @[Tomoya]
text Please. Do the "haaah" to me.
goto 45
label 44
if intF[30] == 0
	goto s39
fi
goto 45
label s39
text @[Tomoya]
text Please. Do the "foooo" to me.
label 45
setvar strS[1001] = "CGNG33A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG33A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LVE.aac
text @[Nagisa]
text I don't want to. I won't do that weird thing ever again.
text ...Mei-chan. It may be too late already, but I've come to realize the importance of your being here.
label 46
text In the end, Nagisa will probably be just Nagisa forever...
label 47
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s40
fi
goto 48
label s40
setvar strS[1000] = ""
label 48
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN6430_0_0.scr
