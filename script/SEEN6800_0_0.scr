text I'm sorry, could you do it after I get home?
text Her eyes move straight back to her notes.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text (So she's okay with it if it's after she gets home...?)
text @[Tomoya]
text (Hold on, she was like this the morning of her play rehearsal too...)
text A wry smile finds its way onto my face when I think back to what happened last year.
setvar strS[1000] = "BG001"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s41
fi
goto 51
label s41
setvar strS[1000] = ""
label 51
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1001] = "CGNG18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LZV.aac
text @[Nagisa]
text Okay, I'll be going now.
text @[Tomoya]
text All right, see you later.
sound LZW.aac
text @[Nagisa]
text ...
text @[Tomoya]
text Good luck.
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound LZX.aac
text @[Nagisa]
text ...Okay!
text She replies with a smile before leaving.
if 0 == 0
	goto s42
fi
jump SEEN6800_0_1.scr 52
label s42
setvar strS[1000] = "KURO"
jump SEEN6800_0_1.scr 54
jump SEEN6800_0_1.scr
