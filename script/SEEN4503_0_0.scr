text I inadvertently walk toward it, but stop myself.
text Someone is standing next to a wall along the path, blending into the twilight.
text It's a middle-aged gentleman wearing a coat unusual for this season.
text I know him.
text He's the "bad guy" who was talking with Kotomi the other day.
setvar strS[1000] = "BG033Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s9
fi
goto 10
label s9
