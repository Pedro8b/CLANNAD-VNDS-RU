text @[Tomoya]
text (Everything just keeps on changing like this...)
text @[Tomoya]
text (I haven't gotten to know her for long...)
text But there's something I've got to do now... It's not the time to get depressed.
text @[Tomoya]
text Are you in a hurry?
setvar strS[1001] = "CGKO10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO10.png
if intF[1113] == 1
