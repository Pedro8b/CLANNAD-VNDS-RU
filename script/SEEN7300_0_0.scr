	fi
fi
sound R6S.aac
text @[Ibuki]
text I guess so.
setvar strS[1001] = "CGKO10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKO10.png
if intF[1113] == 1
