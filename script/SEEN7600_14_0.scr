fi
sound VN9.aac
text @[Kappei]
text Then, I reached this town, and met you, Tomoya-kun.
sound VNA.aac
text @[Kappei]
text And Ryou-san, too.
text He says, and looks at the door.
text @[Tomoya]
text What about that Fujibayashi?
setvar strS[1001] = "CGKP18B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound VNB.aac
text @[Kappei]
text Eh?
text @[Tomoya]
text If you die, she's not going to be able to stand back up.
sound VNC.aac
text @[Kappei]
text ...
text @[Tomoya]
text Can't living for her sake become the thing that supports you?
sound VND.aac
text @[Kappei]
text ...
setvar strS[1001] = "CGKP10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
