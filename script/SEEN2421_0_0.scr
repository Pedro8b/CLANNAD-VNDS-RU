	fi
fi
sound 5PY.aac
text @[Tomoyo]
text Ah...
sound 5PZ.aac
text @[Tomoyo]
text What time is it right now?
text @[Tomoya]
text The bell's about to ring.
sound 5Q0.aac
text @[Tomoyo]
text I see. That's pretty bad.
setvar strS[1001] = "CGTM10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
