setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text He gives me a quick thumbs up, and goes off toward another underclassman.
sound RJ2.aac
text @[Sunohara]
text Heeey, girl!
sound RJ3.aac
text @[Girl]
text Excuse me...?
sound RJ4.aac
text @[Sunohara]
text You're cute, aren't you?
sound RJ5.aac
text @[Girl]
text O-Okay...?
sound RJ6.aac
text @[Sunohara]
text Are you free right now? I kinda want you to hear me out real quick.
sound RJ7.aac
text @[Girl]
text No, I'm in a bit of a hurry, so...
sound RJ8.aac
text @[Sunohara]
text Actually, I've got this part-time job that pays amazingly good...
sound RJ9.aac
text @[Girl]
text I'm not really...
sound RJA.aac
text @[Sunohara]
text Nono, don't worry. We won't tell anyone your name.
sound RJB.aac
text @[Sunohara]
text Ah, of course, it'll be a secret from your parents, too.
sound RJC.aac
text @[Girl]
text Huh? S-So you mean...?
sound RJD.aac
text @[Sunohara]
text Just being with an unattractive guy like me, you can earn quite a bit of pocket money!
sound RJE.aac
text @[Sunohara]
text And don't worry, everyone else is doing the same thing!
sound RJF.aac
text @[Girl]
text E-Eeeeeeeek!
sound RJG.aac
text @[Girl]
text I'm sorry! I'm sorry...!
text The girl brushes Sunohara away, and runs off like the wind.
setvar strS[1001] = "CGSH23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 0
setimg CGSH23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound RJH.aac
text @[Sunohara]
text Wait, I just look like some shady scout right now!
text @[Tomoya]
text You didn't just look like one. You WERE a shady scout, no matter how you look at it.
sound RJI.aac
text @[Sunohara]
text If you know how it looks, why don't you stop me?!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound RJJ.aac
text @[Teacher]
text HEY! Just who is it that's trying to do suspicious things here in our school?!
text @[Tomoya]
text Crap! Run!
jump SEEN7400_1_0.scr
