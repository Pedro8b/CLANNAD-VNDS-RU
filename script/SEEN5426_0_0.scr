text @[Sunohara]
text Haah... If my strike on Yukine-chan had been a success, there would have been something to brag about to Mei...
text @[Tomoya]
text Who's Mei?
setvar strS[1001] = "CGSH18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
