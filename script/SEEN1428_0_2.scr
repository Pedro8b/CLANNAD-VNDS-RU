	fi
fi
sound 3AD.aac
text @[{$lnmA}]
text It's already dark outside.
text {$lnmA} says as she looks out the window.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text (In the end, just what have we done today...)
music ~
text Without any other plan, we decide to call it a day.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s86
fi
goto 111
