text We need to surround her, or else she'll never stop.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MQM.aac
text @[Sanae]
text Waaaaahh!!
text Sanae-san dashes across the park.
sound MQN.aac
text @[Housewife]
text Oh dear... Look at how fast Sanae-san is going today...
text A housewife in a neighboring yard shows up and comments to us.
setvar strS[1001] = "CGAK14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MQO.aac
text @[Akio]
text Listen, you go over that way. I'll chase behind her. Got it?
text @[Tomoya]
text O-Oh...
sound MQP.aac
text @[Akio]
text Good. Now let's go.
setvar strS[1001] = "CGAK15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MQQ.aac
text @[Akio]
text Heeeey! Sanaeeee!! That wasn't me just now!!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text The old man goes running after her.
text @[Tomoya]
text Dammit...
text @[Tomoya]
text I'm sorry, Sanae-saaaaan!
text I also take off running and screaming.
music ~
if 0 == 0
	goto s332
fi
goto 411
label s332
setvar strS[1000] = "KURO"
goto 413
label 411
if 0 == 1
	goto s333
fi
goto 412
label s333
setvar strS[1000] = "SIRO"
goto 413
label 412
setvar strS[1000] = "KURO"
label 413
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
text I'm told that the cries of three people were heard flying through the air around the entire city until sundown.
setvar strS[1000] = "BG044N1"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s334
fi
goto 414
label s334
setvar strS[1000] = ""
label 414
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text @[Tomoya]
text Hold on, one of those people was me...
setvar strS[1001] = "CGNG32A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MQR.aac
text @[Nagisa]
text I was very surprised.
sound MQS.aac
text @[Nagisa]
text My mother was running in front of the house when I came home.
text @[Tomoya]
text Listen, I'm really sorry about it.
text And it turned out that the spider had fallen straight to the ground in the spot that Sanae-san was first standing.
setvar strS[1001] = "CGNG17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound MQT.aac
text @[Nagisa]
text I know it must have been something my father said to do, anyway.
if intF[42] == 0
	goto s335
fi
goto 415
label s335
text @[Tomoya]
text Well, I got carried away too... Or I guess you could say I was being stubborn...
jump SEEN6800_0_8.scr 416
label 415
if intF[42] == 1
	goto s336
fi
jump SEEN6800_0_8.scr 416
label s336
text @[Tomoya]
text Well, I was being stubborn too...
