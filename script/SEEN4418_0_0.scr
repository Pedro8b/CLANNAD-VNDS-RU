fi
text As if to remove all self-doubt, she looks at me head-on.
text Then she says...
setvar strS[1001] = "CGKT15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15A.png
