text The moment I open the wooden door...
sound BRY.aac
text @[Kotomi]
text Tomoya-kun.
text She stops me.
text Her voice has a serious tone I haven't heard before.
text @[Tomoya]
text What... is it?
text Confused, I turn around.
setvar strS[1001] = "CGKT10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10B.png
if intF[1113] == 1
	if strS[1000] < "C"
