	fi
fi
text No answer.
text She slowly turns to me.
text She presses her slender bare legs together.
setvar strS[1001] = "CGKT10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10A.png
if intF[1113] == 1
	if strS[1000] < "C"
