text Don't say that!
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7HG.aac
text @[Tomoyo]
text See, things always end up like this! This is exactly why I didn't want to do this!
sound 7HH.aac
text @[Tomoyo]
text Tomoya, do something.
text @[Tomoya]
text But we've already achieved our objective here.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7HI.aac
text @[Tomoyo]
text Objective? Did we have an objective for doing this?
text @[Tomoya]
text These guys'll definitely vote for you now. Their captain is like THAT, after all.
sound 7HJ.aac
text @[Tomoyo]
text Ah...
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7HK.aac
text @[Tomoyo]
text So that's how it was...
sound 7HL.aac
text @[Tomoyo]
text So you were doing this for me...
text @[Tomoya]
text Don't worry about it.
text @[Tomoya]
text I mean, you're the one who actually did it.
text @[Tomoya]
text All I did was watch.
sound 7HM.aac
text @[Tomoyo]
text Tomoya...
sound 7HN.aac
text @[Tomoyo]
text Thank you.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text Hey, you guys! Just so you know, Tomoyo's a candidate for student council president!
text @[Tomoya]
text You'd better remember!
label 43
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s37
fi
goto 44
label s37
setvar strS[1000] = ""
label 44
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN2507_0_0.scr
