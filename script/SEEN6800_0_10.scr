	fi
fi
sound MXE.aac
text @[Yoshino]
text If you do everything you can, there are always going to be people who respect that.
sound MXF.aac
text @[Yoshino]
text That's one of the things I like about this job.
setvar strS[1001] = "CGYS12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS12.png
if intF[1113] == 1
	if strS[1000] < "C"
