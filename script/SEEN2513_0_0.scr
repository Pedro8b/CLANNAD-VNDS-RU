fi
sound 7Y0.aac
text @[Tomoyo]
text Yeah, I have no idea who you are, but thank you.
setvar strS[1001] = "CGFU12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU12.png
if intF[1113] == 1
