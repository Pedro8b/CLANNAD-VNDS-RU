	fi
fi
text @[Tomoya]
text He was pretty frank about it...
setvar strS[1001] = "CGTM32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7XO.aac
text @[Tomoyo]
text Really...? I didn't really know what he was talking about.
text @[Tomoya]
text Are you seriously saying this?
text @[Tomoya]
text You're an idiot if you are.
sound 7XP.aac
text @[Tomoyo]
text I'd be fine being an idiot.
sound 7XQ.aac
text @[Tomoyo]
text I wouldn't mind at all.
sound 7XR.aac
text @[Tomoyo]
text I bet things would be easier that way...
setvar strS[1001] = "CGTM30H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7XS.aac
text @[Tomoyo]
text I don't want to think about anything anymore. I don't want to worry anymore...
text @[Tomoya]
text In that case, what...?
text @[Tomoya]
text Does that mean you don't care anymore what happens?
setvar strS[1001] = "CGTM15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7XT.aac
text @[Tomoyo]
text That's not it...
text @[Tomoya]
text Isn't that it exactly...? All you want to do is wait things out like a child?
setvar strS[1001] = "CGTM31"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM31.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoyo]
text ...
text Tomoyo keeps her mouth shut.
text She looks like a child, trying to not cry.
text @[Tomoya]
text Maybe I went a bit overboard...
text @[Tomoya]
text I'm sure things will work themselves out again, somehow.
text @[Tomoya]
text Things have worked out up until now, after all.
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 7XU.aac
text @[Tomoyo]
text No... I was in the wrong here for saying childish things...
sound 7XV.aac
text @[Tomoyo]
text I mean, the one who really got hurt here is you.
text @[Tomoya]
text I'm used to that kind of thing. I'll be fine.
if intF[128] == 1
	if intG[22] == 1
		if intG[45] == 1
