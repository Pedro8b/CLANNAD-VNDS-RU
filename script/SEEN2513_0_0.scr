text @[Fuko]
text This may be the last time Fuko can appear before you, so she's come to say goodbye.
text @[Tomoya]
text Huh? Oh...
setvar strS[1001] = "CGFU12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
