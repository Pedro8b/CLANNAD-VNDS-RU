music ~
setvar strS[1000] = "BG033"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s0
fi
goto 1
label s0
setvar strS[1000] = ""
label 1
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM14.mp3
text I walk down the usual path all alone.
text There is nobody wearing the same uniform as me around.
text Well of course. First period has already started after all.
text I see this road empty more frequently than I see it filled with students wearing school uniforms.
text @[Tomoya]
text ...
text Maybe I should just ditch and hang somewhere.
text I'll just be sleeping anyway if I go to school...
text @　　　
setvar intA[1000] = 1380
setvar intA[1001] = 13
if 50 <= 80
	goto s1
fi
goto 2
label s1
setvar intA[1001] + 1
label 2
text *Vrroom*
text Even so, since I'm wearing a uniform I can't really go anywhere public...
text @　　
setvar intA[1000] = 1840
setvar intA[1001] = 18
if 50 <= 40
	goto s2
fi
goto 3
label s2
setvar intA[1001] + 1
label 3
text *Vrroom*
text Going to Sunohara's room to kill time wouldn't be a bad choice...
text @　
setvar intA[1000] = 2300
setvar intA[1001] = 23
if 50 <= 0
	goto s3
fi
goto 4
label s3
setvar intA[1001] + 1
label 4
text *Vrroom*
text But hey, if I sleep in class at least I'll be counted as present.
text *Vrroom*
music ~
bgload SIRO.jpg 0
