text And then it begins.
sound DTX.aac
text @[Kotomi]
text Ahhhhh... Ahh. Ugh. Ahhhhhhhhhhh... Ahhhh...
text A tremendous sobbing, as if her body is splitting apart.
text This is beyond the crying of a child.
text Kotomi twists her upper body, convulsing and screaming.
text Tears completely soak her face and she shrieks as she violently shakes.
text It's as if being here is becoming a punishment for her.
sound DTY.aac
text @[Kotomi]
text Heaaaaa... Ugh... Ahhhhh! Ahhhhhhh...
sound DTZ.aac
text @[Kyou]
text Kotomi, what's wrong? Kotomi!
sound DU0.aac
text @[Furukawa]
text Get ahold of yourself! Kotomi-chan! Kotomi-chan?
sound DU1.aac
text @[Ryou]
text K-Kotomi-chan, please snap out of it... Why are you shaking like this...?
sound DU2.aac
text @[Kyou]
text Get her to a hospital! An ambulance! Actually, the nurse's office!
sound DU3.aac
text @[Kyou]
text Oh, geez! What's going on?!
sound DU4.aac
text @[Furukawa]
text What should we do, Okazaki-san?! What should we do?
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s5
fi
goto 6
