if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DU6.aac
text @[Furukawa]
text I'll go with you.
setvar strS[1001] = "CGRY26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DU7.aac
text @[Ryou]
text I want to help too.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text They both get into position to the left and right of Kotomi.
setvar strS[1001] = "CGKY14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DU8.aac
text @[Kyou]
text This ain't a show! Get out of the way!
text Kyou scatters the gathering crowd.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DU9.aac
text @[Kotomi]
text Ugh... Ah... Ah...
text @[Tomoya]
text Stop talking. I'm taking you to the nurse's office.
text Her eyes are drowning in tears, but I know she's looking at me.
text Or so I assume. Her eyes don't have their usual sparkle.
sound DUA.aac
text @[Kotomi]
text I'll be a good girl...
text @[Tomoya]
text What?!
sound DUB.aac
text @[Kotomi]
text I'll be a good girl... I'll be good, so...
text Whatever she's trying to say is wiped out by more explosive sobbing.
text Her arms and legs have gone limp, but she's still trying to move.
text I pick Kotomi up by cradling my arms under her back and knees.
text She feels so much heavier than the time I picked her up as a joke.
text I sense a continuous throbbing feeling on my arm.
text My left arm feels hot, as if a small snake is coiled around it.
text It's the tears dripping from Kotomi's neck onto me.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
