	fi
fi
sound DU5.aac
text @[Kyou]
text Snap out of it!
text Kyou's shout brings me back to the real world.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Kotomi is curled up on the ground.
text She's in the fetal position, her arms hugging her knees.
text She's sweating profusely and her hair is sticking to her forehead.
text Wheezing noises are coming from her throat along with the sobs wracking her body.
text She must be having difficulty breathing.
text @[Tomoya]
text I'll take her to the nurse's office.
setvar strS[1001] = "CGNG16Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
