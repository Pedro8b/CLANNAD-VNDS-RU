	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound DUL.aac
text @[Kyou]
text I did that earlier.
text @[Tomoya]
text And what did she say?
setvar strS[1001] = "CGKY13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY13.png
