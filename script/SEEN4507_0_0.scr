text I don't know either.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text We all go silent.
text There are two things we know right now.
text Kotomi left early of her own accord.
text And the teacher knows about what happened and doesn't think it should be disclosed.
setvar strS[1001] = "CGKY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
