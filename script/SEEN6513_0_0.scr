text The next morning.
text Nagisa's fever refused to drop overnight, so she ends up having to miss school.
setvar strS[1000] = "BG003"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM08D.mp3
text @[Tomoya]
text I'll be on my way, Nagisa.
text I call out to her; she's still bedridden.
sound L4D.aac
text @[Nagisa]
text Okay, have a nice day.
text She turns her face and sees me off with a smile.
setvar strS[1000] = "BG006"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s3
fi
goto 4
label s3
setvar strS[1000] = ""
label 4
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text As I return to the hallway, the old man is standing there holding a tray with a bowl of rice porridge on it.
setvar strS[1001] = "CGAK11T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4E.aac
text @[Akio]
text What are you two, newlyweds?
text Seems like he was listening in on us.
setvar strS[1001] = "CGAK14T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4F.aac
text @[Akio]
text Tch. Keeping all the fun to yourself. Let me go back to living like a newlywed with Sanae, punk!
text @[Tomoya]
text That'd be impossible.
setvar strS[1001] = "CGAK11T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4G.aac
text @[Akio]
text I know that, stupid. But Sanae and I still keep that fire hot, so it doesn't matter, punk.
text @[Tomoya]
text Then don't say things like that.
setvar strS[1001] = "CGAK14T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4H.aac
text @[Akio]
text Gah... If I keep wasting time talking to you, Nagisa's breakfast is going to get cold. Move out of the way, punk.
text @[Tomoya]
text I'd leave even if you didn't tell me.
setvar strS[1001] = "CGAK11T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK11T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4I.aac
text @[Akio]
text Hold on, don't you have eyes? Both of my hands are full, so I can't get in unless you open the door, punk.
text I consider taking the opportunity to slug him.
sound L4J.aac
text @[Akio]
text By the way, I'm going to be talking to Nagisa today, so you'd better not feel jealous, punk.
text @[Tomoya]
text What're you gonna talk to her about?
setvar strS[1001] = "CGAK14T"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGAK14T.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L4K.aac
text @[Akio]
text About the family. This is one thing I'm not letting you handle. I'll kill you even if you try to, punk.
text @[Tomoya]
text Okay, sure. I'll let you take care of it.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text You know, it is this family. Maybe it won't be too hard for them to patch everything up.
text The thought keeps lingering in me as I walk outside, leaving the two behind.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
