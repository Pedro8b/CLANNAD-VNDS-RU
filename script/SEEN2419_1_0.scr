music ~
sound 5PA.aac
text @[Voice]
text Hey.
text On my way to the shoe lockers, a voice calls out to me.
music BGM06.mp3
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text ...It's Tomoyo.
sound 5PB.aac
text @[Tomoyo]
text So you really made him stop.
text ...I guess she's talking about Sunohara.
text @[Tomoya]
text Yeah, things'll be all right from now on.
text @[Tomoya]
text (Since it's been proven that you're the stronger one...)
text ...I wonder what kind of expression she would make if I said something like that.
sound 5PC.aac
text @[Tomoyo]
text Oh, thanks a lot.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PD.aac
text @[Tomoyo]
text Then again, it was so lively, I feel like I'm going to be a bit lonely without you two around.
text @[Tomoya]
text Why's that? I mean, you have friends of your own, right?
sound 5PE.aac
text @[Tomoyo]
text Of course I do. And they're all good people.
sound 5PF.aac
text @[Tomoyo]
text And I don't mean to say anything bad about them.
sound 5PG.aac
text @[Tomoyo]
text ...But they're a bit refined.
setvar strS[1001] = "CGTM21"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM21.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PH.aac
text @[Tomoyo]
text And you guys are nice and stupid.
text ...Is that supposed to be a compliment?
text @[Tomoya]
text Didn't you come to this school in order to become one of them?
text @[Tomoya]
text You should just ignore people like us.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PI.aac
text @[Tomoyo]
text Aren't I already involved with "people like you?"
text @[Tomoya]
text Even though we're bad people?
sound 5PJ.aac
text @[Tomoyo]
text Even though you're bad people. I can at least still say hi.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PK.aac
text @[Tomoyo]
text Oh, also, I'm not harboring any ill will or anything, you know.
text @[Tomoya]
text You mean toward Sunohara?
sound 5PL.aac
text @[Tomoyo]
text No, well... Him, too.
text @[Tomoya]
text You sure are big-hearted.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PM.aac
text @[Tomoyo]
text That's right. Very big-hearted.
sound 5PN.aac
text @[Tomoyo]
text I'm brimming with motherly love.
sound 5PO.aac
text @[Tomoyo]
text Don't you think that is truly girlish of me?
text @[Tomoya]
text Girl? ...No, it's more like old woman-ish.
setvar strS[1001] = "CGTM18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PP.aac
text @[Tomoyo]
text That's pretty rude. I'm younger than you.
text @[Tomoya]
text Ah, you're right. I completely forgot.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PQ.aac
text @[Tomoyo]
text You seem dissatisfied somehow.
text @[Tomoya]
text Not really...
setvar strS[1001] = "CGTM20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PR.aac
text @[Tomoyo]
text Ah, I'll have to leave things off here.
sound 5PS.aac
text @[Tomoyo]
text I'm walking home with some classmates today.
sound 5PT.aac
text @[Tomoyo]
text It'd be bad to make them wait.
text @[Tomoya]
text Yeah, you should get going quickly.
setvar strS[1001] = "CGTM13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PU.aac
text @[Tomoyo]
text It almost sounds like you want to get rid of me. Why don't you try sounding sadder about me leaving?
text @[Tomoya]
text In that case, don't go. Stay.
setvar strS[1001] = "CGTM16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5PV.aac
text @[Tomoyo]
text Yeah, I feel a little better hearing that. I'm afraid I can't, though.
sound 5PW.aac
text @[Tomoyo]
text I have to keep my promise.
sound 5PX.aac
text @[Tomoyo]
text See you later.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She turns and walks away gallantly.
text I don't want to stay too long in front of the staff room, so I hurry off toward the shoe lockers.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
