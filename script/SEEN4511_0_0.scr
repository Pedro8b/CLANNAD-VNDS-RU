text I can see many more stars here than in town.
text As if playing to a soundless melody, they twinkle in the sky.
text My eyelids feel heavy and I'm tempted to close them.
text The stars blur and appear to come closer to me.
text I open my eyes wide and the stars go back to their original distance.
text I play this little game for a while.
if intG[5] == 0
	goto s29
fi
goto 33
label s29
sound ~
music BGM01.mp3
setvar strS[1000] = "BG051H"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s30
fi
goto 30
label s30
setvar strS[1000] = ""
label 30
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 301
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text One of the stars falls onto the grass.
text @[Tomoya]
text What the...?
text I get up from the grass.
text A light is floating above the cut grass, as small as a bean.
text @[Tomoya]
text A firefly?
text A transient flickering, as if it wants to tell me something.
text It's weightless.
text I can't even tell if it's warm or cold.
text All I know is that it exists.
text Light in its purest form.
text If I had to compare it to something... I'd say it's like a fragment of a star.
text Is this... a dream?
text Is this an omen? Or an afterimage?
text The light soon dims.
text Unknowingly, I reach out...
music ~
setvar strS[1000] = "BG051G"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s31
fi
goto 31
label s31
setvar strS[1000] = ""
label 31
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound U.aac -1
delay 240
sound ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s32
fi
goto 32
label s32
setvar strS[1000] = ""
label 32
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
goto 35
