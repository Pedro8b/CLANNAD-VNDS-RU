if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text We enter the library and experience the familiar fragrances.
text We were just here on Friday, but it feels like we left it behind long ago.
text Kotomi mops the floor and sheds her socks.
text Naturally, she takes out her usual cushion.
text @[Tomoya]
text You really love the library, don't you?
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI4.aac
text @[Kotomi]
text Yes. I love it.
sound EI5.aac
text @[Kotomi]
text I feel so happy being surrounded by books again today.
text She says that with her usual big smile.
text @[Tomoya]
text And you're going to start reading right now?
sound EI6.aac
text @[Kotomi]
text Yes.
text She smiles from ear to ear.
text @[Tomoya]
text So what should I be doing?
setvar strS[1001] = "CGKT11C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT11C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI7.aac
text @[Kotomi]
text ??
sound EI8.aac
text @[Kotomi]
text Um...
sound EI9.aac
text @[Kotomi]
text ...
text She's thinking of something.
setvar strS[1001] = "CGKT10C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EIA.aac
text @[Kotomi]
text ...
text The more you have to think about it, the more pitiful it makes me feel.
setvar strS[1001] = "CGKT10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EIB.aac
text @[Kotomi]
text Why don't we read together?
text She's so predictable.
text @[Tomoya]
text Give me a break...
sound EIC.aac
text @[Kotomi]
text ...
text She looks a little disappointed.
text Now I'm starting to feel guilty...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Just as I'm about to respond, my stomach growls.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EID.aac
text @[Kotomi]
text Tomoya-kun, are you hungry?
text @[Tomoya]
text I guess so. I skipped breakfast...
sound EIE.aac
text @[Kotomi]
text Then let's have lunch.
text @[Tomoya]
text It's a little early, but that sounds great.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Kotomi starts preparing.
text I sit down and wait for the lunch table to be ready.
