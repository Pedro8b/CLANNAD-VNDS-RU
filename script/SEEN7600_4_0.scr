setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXC.aac
text @[Kappei]
text Oh, that's right. I'm heading to the office now.
text @[Tomoya]
text What kind of job is it this time?
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXD.aac
text @[Kappei]
text A moving company.
text @[Tomoya]
text Manual labor, huh...? Think you'll be okay?
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXE.aac
text @[Kappei]
text I'll be fine, definitely! The key characteristics are balance and timing.
setvar strS[1001] = "CGKP16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXF.aac
text @[Kappei]
text Besides, don't you think manual labor is really manly?
sound UXG.aac
text @[Kappei]
text It has manliness written all over it!
sound UXH.aac
text @[Kappei]
text Besides, you get the paid the same day you do the job. Sounds pretty awesome, no?
sound UXI.aac
text @[Kappei]
text Even the recruiter has that manly vibe!
text @[Tomoya]
text Yeah... hang in there.
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UXJ.aac
text @[Kappei]
text Yeah, once I get paid, I'll treat you to something as thanks for helping dry me off.
text @[Tomoya]
text Yeah.
sound UXK.aac
text @[Kappei]
text Well, see ya!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I bet he's not making it through the interview anyway...
text I hide what I truly think in my head behind my smile, and watch Kappei walk away to his interview.
music ~
if 0 == 0
	goto s17
fi
goto 18
label s17
setvar strS[1000] = "KURO"
goto 20
label 18
if 0 == 1
	goto s18
fi
goto 19
label s18
setvar strS[1000] = "SIRO"
goto 20
label 19
setvar strS[1000] = "KURO"
label 20
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
jump SEEN7600_5_0.scr
