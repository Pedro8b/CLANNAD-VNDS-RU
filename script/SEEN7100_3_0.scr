setvar strS[1001] = "CGNG10DZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10DZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWU.aac
text @[Nagisa]
text Yes. Please come by again sometime.
setvar strS[1001] = "CGYS13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWV.aac
text @[Yoshino]
text Yes. Definitely.
setvar strS[1001] = "CGYS12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWW.aac
text @[Yoshino]
text Well, see you, Okazaki. You'd better work like mad starting tomorrow, all right?
text @[Tomoya]
text A'ight.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Nagisa and I line up in front of the apartment to see Yoshino-san off.
text After he walks for a while, he turns around.
setvar strS[1001] = "CGYS18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYS18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWX.aac
text @[Yoshino]
text You two be happy together, all right?!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text He really is an embarrassing person...
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QWY.aac
text @[Nagisa]
text Yoshino-san is a really good person.
text @[Tomoya]
text They do seem like they'd fit you... these embarrassing things he says, I mean.
sound QWZ.aac
text @[Nagisa]
text The conversations with him are just as deep as his lyrics.
setvar strS[1001] = "CGNG10DZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10DZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX0.aac
text @[Nagisa]
text I was really moved.
sound QX1.aac
text @[Nagisa]
text He's really a wonderful person.
text @[Tomoya]
text ...
text @[Tomoya]
text Whatever you say.
setvar strS[1001] = "CGNG32D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX2.aac
text @[Nagisa]
text Ah...
sound QX3.aac
text @[Nagisa]
text Tomoya-kun...
text @[Tomoya]
text What's up?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She looks fixedly at my face...
text and gently joins hands with me.
setvar strS[1001] = "CGNG10D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound QX4.aac
text @[Nagisa]
text You're a wonderful person, too, Tomoya-kun.
sound QX5.aac
text @[Nagisa]
text And you're also the most important person in my life.
text @[Tomoya]
text ...
text @[Tomoya]
text Silly...
if 0 == 0
	goto s121
fi
goto 141
label s121
setvar strS[1000] = "KURO"
goto 143
label 141
if 0 == 1
	goto s122
fi
goto 142
label s122
setvar strS[1000] = "SIRO"
goto 143
label 142
setvar strS[1000] = "KURO"
label 143
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 30
setvar strS[1000] = "BG144"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s123
fi
goto 144
label s123
setvar strS[1000] = ""
label 144
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text And so now...
text Yoshino-san's new song could be heard far and wide in our small apartment.
setvar strS[1000] = "FGCD07"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s124
fi
goto 145
label s124
setvar strS[1000] = ""
label 145
setvar strS[1001] = ""
setvar intF[1113] = 0
bgload {$strS[1000]}.jpg 98
text ─Love & Spanner
text This title track had truly been my song.
text And it was also... Yoshino-san's song.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s125
fi
goto 146
label s125
setvar strS[1000] = ""
label 146
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
if intG[11] == 0
	goto s126
fi
goto 147
