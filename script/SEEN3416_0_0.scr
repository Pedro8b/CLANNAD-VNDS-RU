text @[Tomoya]
text Again, why are you looking at me like that?
text As she takes a breath, Kyou shakes her head, and lays her hand on my shoulder.
setvar strS[1001] = "CGKY17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY17.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She then nods.
text Her eyes conceal a hint of pity.
setvar strS[1001] = "CGKY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8HY.aac
text @[Kyou]
text Well, hang in there.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She says, and then leaves the classroom.
text @[Tomoya]
text ...What's that supposed to mean?
setvar strS[1001] = "CGRY16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY16A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 8HZ.aac
text @[Ryou]
text ...I wonder.
text Fujibayashi and I were left to puzzle over this mystery during the short time before the next bell.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music ~
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
