if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 3PA.aac
text @[Fuko]
text It's not a joke.
sound 3PB.aac
text @[Mitsui]
text Ibuki-san, I'm the class representative, so please let me say this.
sound 3PC.aac
text @[Mitsui]
text Please don't bother the students of this class.
sound 3PD.aac
text @[Mitsui]
text And please restrain yourself from entering this classroom.
setvar strS[1001] = "CGFU17A"
setvar intF[1113] = intF[1112]
