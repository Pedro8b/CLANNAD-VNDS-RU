text That's because I'm sure he's a kind father to you, but...
text @[Tomoya]
text In any case, I'm not emotionally ready for that yet... Could you not tell them?
setvar strS[1001] = "CGNG32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICN.aac
text @[Nagisa]
text I see. That's kind of unfortunate.
sound ICO.aac
text @[Nagisa]
text But I won't try to insist.
text @[Tomoya]
text You're a good girl, you know that?
setvar strS[1001] = "CGNG18Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG18Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICP.aac
text @[Nagisa]
text No, I just don't want to do something that would upset you.
text @[Tomoya]
text I'm simply acting selfish, that's all.
text @[Tomoya]
text I don't mind if you argue with me or get mad at me from time to time, you know.
setvar strS[1001] = "CGNG10Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICQ.aac
text @[Nagisa]
text Okay... Then I'll say those kinds of things when I think I need to say them.
text @[Tomoya]
text Yeah. I'd like it better that way.
setvar strS[1001] = "CGNG23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICR.aac
text @[Nagisa]
text Okay, then I'll be sure to say them. I am older than you, after all.
text That's right... I'd totally forgotten.
text In fact, it really hits me when I think about that fact again.
setvar strS[1001] = "CGNG13Z"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG13Z.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICS.aac
text @[Nagisa]
text ...?
text If Nagisa hadn't repeated a year, the two of us would have never met. Nagisa would have stayed as nothing more than a nameless senior to me.
text @[Tomoya]
text (My senior...)
text If there was ever a word I wouldn't think of using to describe her, that would be it.
setvar strS[1001] = "CGNG10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICT.aac
text @[Nagisa]
text I'll see you tomorrow, then.
text @[Tomoya]
text Yeah. I'll be over some time after noon.
setvar strS[1001] = "CGNG23"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound ICU.aac
text @[Nagisa]
text All right. I'll be waiting for you.
text @[Tomoya]
text See you.
music ~
setvar strS[1000] = "KURO"
