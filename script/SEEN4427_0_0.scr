label 1
bgload SCLAB00.jpg 45
delay 60
setimg SCLAP06.png 5 5
setimg SCLA0427.png 159 160
delay 120
setvar strS[1000] = "BG009"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s1
fi
goto 2
label s1
setvar strS[1000] = ""
label 2
setvar strS[1001] = "NONE"
