		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text By the time I wake up, it's already past noon.
text I'd usually force myself to get up, but I don't feel like it today.
text I stare at the ceiling and think about yesterday.
text @[Tomoya]
text (I think I went overboard...)
text I think the days will be even more exhausting starting tomorrow.
text @[Tomoya]
text (I'd better get enough sleep while I can...)
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s2
fi
goto 3
label s2
setvar strS[1000] = ""
label 3
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I roll back over and close my eyes again.
text All the while, I'm thinking about how long it's been since I've stayed home all day.
music ~
jump SEEN4428_0_0.scr
