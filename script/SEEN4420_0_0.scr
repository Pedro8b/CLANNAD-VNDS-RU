setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BXV.aac
text @[Kotomi]
text I'm that way.
text We point in opposite directions.
text The area isn't entirely deserted, so I think it'll be fine.
text @[Tomoya]
text All right, take care.
setvar strS[1001] = "CGKT12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BXW.aac
text @[Kotomi]
text See you tomorrow.
text @[Tomoya]
text Yeah. See you tomorrow, Kotomi.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I wave and start walking.
text Kotomi remains standing still.
text Holding onto her bag filled with nine books, she stares at me.
text @[Tomoya]
text What?
setvar strS[1001] = "CGKT12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BXX.aac
text @[Kotomi]
text It's nothing.
sound BXY.aac
text @[Kotomi]
text I'll be waiting for you tomorrow.
sound BXZ.aac
text @[Kotomi]
text I'll make lunch, too.
text @[Tomoya]
text Yeah, I know.
text I answer her.
text @[Tomoya]
text I'll be looking forward to it.
setvar strS[1001] = "CGKT15A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text In the evening light, Kotomi smiles bashfully.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She then starts walking.
text She probably walks faster when she's alone. She shrinks into the distance right away.
text It's exactly like yesterday evening when she held her umbrella.
text She probably went straight home afterward.
text @[Tomoya]
text I wonder if she really doesn't have any friends...
text I mumble that and shake my head.
text I don't like to be nosy.
text I raise my left hand and stretch to the evening sky.
text School starts again tomorrow.
if intF[3] == 1
	goto s20
fi
goto 21
label s20
text I'll be eating lunch with Kotomi now.
text Thinking about how Furukawa will react when I tell her, I feel a little down.
text I find it hard to believe that Furukawa will invite someone else in my place.
text But I can't tell her to skip class so we can eat together.
text Thinking that reminds me of something.
goto 23
label 21
if intF[3] == 0
	goto s21
fi
goto 23
label s21
text For some reason, I think of the girl I met at the bottom of the hill.
if intF[2] == 0
	goto s22
fi
goto 22
label s22
text She's a student who was trying to form a drama club.
text @[Tomoya]
text (First of all...)
text @[Tomoya]
text (Isn't the drama club at this school defunct?)
text This topic came up once during idle chatter.
text Will she be acting in a play by herself...?
text Thinking of that reminds me of something.
goto 23
label 22
if intF[2] == 1
	goto s23
fi
goto 23
label s23
text Will she be able to revive the drama club by herself?
text Thinking of that reminds me of something.
label 23
text I recall my conversation with Kotomi today.
text @[Tomoya]
text She said she's not in a club...
text I smile at my idea.
text I better tell her before I go to the library.
text @[Tomoya]
text (Meaning, I have to get to school on time...)
text Out of habit, I become melancholic.
text @[Tomoya]
text Now then...
text I stretch a bit more and start walking.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s24
fi
goto 24
label s24
setvar strS[1000] = ""
label 24
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar intF[410] = 1
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
