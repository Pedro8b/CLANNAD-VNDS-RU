text @[Tomoya]
text Is that something even more important than spending time with me like this?
sound 6IQ.aac
text @[Tomoyo]
text It's not a matter of which is more important.
sound 6IR.aac
text @[Tomoyo]
text I've made up my mind. I don't want to give up halfway.
sound 6IS.aac
text @[Tomoyo]
text But I guess... from the bottom of my heart, this is also something very important to me.
text @[Tomoya]
text Then, what? What do you want me to do?
text @[Tomoya]
text Shall I just pray for you to lose in the election?
setvar strS[1001] = "CGTM15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IT.aac
text @[Tomoyo]
text Tomoya... do you really hate people in the student council that much?
text @[Tomoya]
text One year ago, I'm sure you would have been the same.
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IU.aac
text @[Tomoyo]
text That's true...
text @[Tomoya]
text Not to mention you'd also get very busy if you entered the council.
text @[Tomoya]
text You won't have the time to do stupid stuff like this anymore.
text Someone like her with a goal in life... is already in a completely different league from me and Sunohara.
setvar strS[1001] = "CGTM31H"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM31H.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IV.aac
text @[Tomoyo]
text I'll just work very hard so we can.
text @[Tomoya]
text ...
text @[Tomoya]
text ...By that time, things will already be different.
setvar strS[1001] = "CGTM15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IW.aac
text @[Tomoyo]
text In what way?
text @[Tomoya]
text ...
text I didn't answer that question.
text @[Tomoya]
text As I thought...
text @[Tomoya]
text Looks like all I can do is pray that you lose the election.
setvar strS[1001] = "CGTM30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IX.aac
text @[Tomoyo]
text That's unfortunate...
sound 6IY.aac
text @[Tomoyo]
text Then from now on, we'd be enemies?
text @[Tomoya]
text Well, no...
text @[Tomoya]
text I prefer it if we're lovers.
setvar strS[1001] = "CGTM19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6IZ.aac
text @[Tomoyo]
text ...Eh?
text @[Tomoya]
text I feel like that might weaken your resolve a bit.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 6J0.aac
text @[Tomoyo]
text Is that so...
sound 6J1.aac
text @[Tomoyo]
text In that case, I'll be looking forward to it.
text @[Tomoya]
text So, you don't mind?
sound 6J2.aac
text @[Tomoyo]
text No... You sure are a hopeless guy...
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text With a finger, I draw in Tomoyo's chin.
text And then, our lips meet once again.
if 0 == 0
	goto s43
fi
goto 48
label s43
setvar strS[1000] = "KURO"
goto 50
label 48
if 0 == 1
	goto s44
fi
goto 49
label s44
setvar strS[1000] = "SIRO"
