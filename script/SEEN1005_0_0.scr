fi
goto 33
label s33
text I can't think of anything new...
goto 34
label 33
if intF[124] >= 1
	goto s34
fi
goto 34
label s34
text I guess that's it for this prank...
label 34
delay 60
sound F.aac
text @You have mastered the "Switch the carving Fuko\'s holding" skill!
delay 312
setvar intF[124] + 1
if intF[124] == 1
	goto s35
fi
goto 35
label s35
text ...Am I dumb or something?
label 35
setvar intF[104] = 2
label 36
text @[Tomoya]
text Well, you should learn from this and stop daydreaming constantly.
setvar strS[1001] = "CGFU20A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 20M.aac
text @[Fuko]
text Fuko has already said it many times before, but Fuko doesn't daydream.
text ...How can I make her aware of that?
label 37
setvar strS[1001] = "CGFU30A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU30A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 20N.aac
text @[Fuko]
text Fuko has wasted time on something meaningless again.
sound 20O.aac
text @[Fuko]
text Well, then.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text Yeah.
text I watch until she vanishes around the corner before returning to the classroom.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
