delay 120
music BGM08D.mp3
setvar strS[1000] = "BG021Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s112
fi
goto 114
label s112
setvar strS[1000] = ""
label 114
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 98
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Inside the sunset-soaked classroom, I am standing next to the window, calming myself down.
text There is something I have to do...
text If I run away from this, I won't be able to go further...
text I have to tell her... otherwise I would only continue to be a coward...
text *Clatter*
text Gently, the classroom door opens.
text Hearing the sound, I turn around.
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJC.aac
text @[Ryou]
text ...
text @[Tomoya]
text Hey...
sound BJD.aac
text @[Ryou]
text Tomoya... -kun...
text I wonder how many days it has been since we faced each other like this...
text Ever since I started going out with Kyou, I haven't been able to look her straight in the eye.
text I suppose it's also the same for her...
text Up until today, we have not talked to each other at all.
text @[Tomoya]
text Back from the school committee? How did it go?
setvar strS[1001] = "CGRY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJE.aac
text @[Ryou]
text Yeah... it wasn't bad.
text @[Tomoya]
text I see...
setvar strS[1001] = "CGRY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJF.aac
text @[Ryou]
text Oh, are you waiting for Onee-chan? If that's the case, I think she will be back to her classroom soon.
text @[Tomoya]
text No... I've been waiting for you instead, Ryou...
setvar strS[1001] = "CGRY15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJG.aac
text @[Ryou]
text ...Me...?
setvar strS[1001] = "CGRY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I nod, causing Ryou's face to stiffen up a little.
text Gently... I take a deep breath.
text Then, I lower my head deeply.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s113
fi
goto 115
label s113
setvar strS[1000] = ""
label 115
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text Sorry.
sound BJH.aac
text @[Ryou]
text Tomoya-kun...?
text @[Tomoya]
text I... was spoiled by how gentle you are... and kept doing things that only ended up hurting you...
text @[Tomoya]
text It's not something that I deserve to be forgiven for even if I apologize... but... I'm sorry...
text With my head still hanging down, I say.
text I plan on taking in whatever blame she lays on me.
text I won't even mind if she hits me, but I had to apologize.
sound BJI.aac
text @[Ryou]
text ...
sound BJJ.aac
text @[Ryou]
text ...No...
text @[Tomoya]
text ...
text Her words grip my heart.
text Even so, my head remains down.
text That's because there is nothing I can do but to apologize...
text Because this is the beginning...
sound BJK.aac
text @[Ryou]
text I don't want to forgive you...
sound BJL.aac
text @[Ryou]
text ...So please... don't apologize...
text @[Tomoya]
text ...
sound BJM.aac
text @[Ryou]
text If you apologize, it makes me want to forgive you.
text @[Tomoya]
text Eh...?
music ~
setvar strS[1000] = "BG021Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s114
fi
goto 116
label s114
setvar strS[1000] = ""
label 116
setvar strS[1001] = "CGRY26"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY26.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Feeling a sense of calmness from her tone, I lift my head up without a thought.
music BGM25B.mp3
sound BJN.aac
text @[Ryou]
text ...I... really enjoyed the time I spent together with you, Tomoya-kun.
sound BJO.aac
text @[Ryou]
text We went to many different places.
sound BJP.aac
text @[Ryou]
text We had lunch together, just the two of us.
sound BJQ.aac
text @[Ryou]
text And you bought me a pendant.
sound BJR.aac
text @[Ryou]
text We also kissed...
sound BJS.aac
text @[Ryou]
text You gave me so many memories...
setvar strS[1001] = "CGRY18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJT.aac
text @[Ryou]
text If you apologize... and I forgive you... then it makes me feel that the time we spent together was all a lie...
sound BJU.aac
text @[Ryou]
text They are all very precious memories to me...
setvar strS[1001] = "CGRY11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJV.aac
text @[Ryou]
text So please don't apologize.
text Yeah... I see...
text If I apologize like this... then this would only be self-satisfaction...
text ...Then it would actually have ended with me hurting her...
text @[Tomoya]
text Ryou...
sound BJW.aac
text @[Ryou]
text Yes.
text @[Tomoya]
text Thanks.
setvar strS[1001] = "CGRY12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGRY12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound BJX.aac
text @[Ryou]
text Yes.
sound BJY.aac
text @[Ryou]
text Tomoya-kun, I would like to thank you too.
text Ryou says, and lightly bows her head toward me.
text Once again, I lower my head.
setvar strS[1000] = "BG084"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s115
fi
goto 117
label s115
setvar strS[1000] = ""
label 117
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Instead of saying something as backward as "sorry," we should bring this to an end in anticipation of what's to come.
text Right now, we go back to being friends again.
music ~
setvar strS[1000] = "SIRO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s116
fi
goto 118
