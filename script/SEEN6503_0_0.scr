text @[Nagisa]
text It was a very moving story.
text @[Tomoya]
text Seriously...?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
