text I think she'd be less of a waste that way, though.
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5Y9.aac
text @[Sunohara]
text Just don't worry and leave it to me. I'll show you something fun, that's for sure.
setvar strS[1000] = "BG021A"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s12
fi
goto 13
label s12
setvar strS[1000] = ""
label 13
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 88
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text A short time later, when classes have started...
sound 5YA.aac
text @[Sunohara]
text Heheheh...
text I wonder if he's thought up something, because I can hear him letting out an ominous laugh.
sound 5YB.aac
text @[Sunohara]
text Heheh... hahahaha...
sound 5YC.aac
text @[Sunohara]
text FWAAHAHAHAHAH!
sound 5YD.aac
text @[Teacher]
text You there! Be quiet if you don't want me to pick you out.
sound 5YE.aac
text @[Sunohara]
text Ah, I'm sorry.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
jump SEEN2422_2_0.scr
