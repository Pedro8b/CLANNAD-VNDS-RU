	fi
fi
sound 4R6.aac
text @[Sunohara]
text It's you who forced me to tell you!
text @[Tomoya]
text Now that I know the story, it really doesn't matter any more.
setvar strS[1001] = "CGSH14B"
setvar intF[1113] = intF[1112]
