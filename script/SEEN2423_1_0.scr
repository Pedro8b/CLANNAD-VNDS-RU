text @[Tomoyo]
text See you later. It was fun.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 69P.aac
text @[Sunohara]
text Ugh... When did our peaceful lives end up like this...?
text The moment Tomoyo is gone, Sunohara falls flat on his desk.
sound 69Q.aac
text @[Sunohara]
text Okazaki... I want to go back to when it was just the two of us...
text @[Tomoya]
text Don't say these disgusting things.
if rtf1 != ""
	jump $rtf1 $rtl1
fi
jump $rtf0 $rtl0
