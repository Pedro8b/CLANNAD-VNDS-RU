setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 69H.aac
text @[Sunohara]
text Well, let's just keep on doing whatever we want, like we always do.
setvar strS[1001] = "CGTM22"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGTM22.png
if intF[1113] == 1
	if strS[1000] < "C"
