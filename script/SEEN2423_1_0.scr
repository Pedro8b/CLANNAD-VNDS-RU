text @[Sunohara]
text Hey, wait, why am I cheering you up all friendly-like─?!
text Sunohara stuffs the bread, still wrapped in paper, into his mouth.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
