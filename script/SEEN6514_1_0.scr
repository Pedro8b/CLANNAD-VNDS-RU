setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6S.aac
text @[Nagisa]
text Congratulations on graduating.
text Nagisa is waiting for me in front.
text She's wearing her favorite outfit, the one she wore on our first date.
text @[Tomoya]
text You shouldn't be outside when it's this cold, stupid.
setvar strS[1001] = "CGNG10BZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10BZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6T.aac
text @[Nagisa]
text What I really wanted to do was go to the school gate.
text @[Tomoya]
text Do it after you regain your strength.
sound L6U.aac
text @[Nagisa]
text I really wanted to see you....
setvar strS[1001] = "CGNG23BZ"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23BZ.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6V.aac
text @[Nagisa]
text ...in your school uniform for the very last time.
text @[Tomoya]
text ...
text @[Tomoya]
text Oh...
text @[Tomoya]
text I guess that's right...
text @[Tomoya]
text Hey, Nagisa...
setvar strS[1001] = "CGNG10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6W.aac
text @[Nagisa]
text Yes?
text @[Tomoya]
text I graduated.
text @[Tomoya]
text I'm never able to go back to that school again.
text @[Tomoya]
text I'm never going to be able to make your dream come true.
text @[Tomoya]
text To hold hands... and walk together in school.
text @[Tomoya]
text There were lots of other things I wanted to do too.
text @[Tomoya]
text Not just in the spring, but in the summer, the fall, the winter...
text @[Tomoya]
text I wanted to be with you always.
text @[Tomoya]
text I wanted to make lots of memories together.
text @[Tomoya]
text I hated being at school, but...
text @[Tomoya]
text I felt like I could stay there as long as I was with you.
text @[Tomoya]
text I never imagined... that I'd ever feel that way.
text @[Tomoya]
text So much of my life at school was a horrible experience...
text @[Tomoya]
text But that one month that I spent with you...
text @[Tomoya]
text ...was fun.
music ~
text My vision wavers for some reason... and I can't help myself.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I turn my face away and to the ground.
music BGM25B.mp3
text @[Tomoya]
text I was happy...
text @[Tomoya]
text I want things to always be that way...
text @[Tomoya]
text I want to be at that awful school together with you forever...
text Unable to hold them back any longer, tears begin to trail down my cheeks.
text @[Tomoya]
text N-Nagisa...
text @[Tomoya]
text That's... what I wanted to do...
text @[Tomoya]
text That...
text I keep talking... in my tearful, hard-to-understand voice.
text @[Tomoya]
text But...
text @[Tomoya]
text Now, I...
text Now...
text @[Tomoya]
text ...
text ...The words don't come out.
text Instead, a stream of tears bursts forth.
text One tear after the other begins to drop to the ground.
text I'm crying like a child.
sound L6X.aac
text @[Nagisa]
text Tomoya-kun.
text @[Tomoya]
text ...
sound L6Y.aac
text @[Nagisa]
text Tomoya-kun.
text @[Tomoya]
text What is it...
setvar strS[1001] = "CGNG23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6Z.aac
text @[Nagisa]
text May I hold your hand?
text @[Tomoya]
text Why...?
sound L70.aac
text @[Nagisa]
text I want to walk.
setvar strS[1001] = "CGNG10B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L71.aac
text @[Nagisa]
text I want to hold hands with you and walk, Tomoya-kun.
text @[Tomoya]
text You shouldn't... You'll make your fever worse again...
sound L72.aac
text @[Nagisa]
text It's okay. I just want to walk for a little bit.
setvar strS[1001] = "CGNG25B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG25B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L73.aac
text @[Nagisa]
text Is that all right?
text @[Tomoya]
text ...
text @[Tomoya]
text ...Do whatever you want.
sound L74.aac
text @[Nagisa]
text Okay. Then I will.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text A hand far colder than mine...
text Grabs my hand and squeezes.
setvar strS[1001] = "CGNG23B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG23B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L75.aac
text @[Nagisa]
text Let's walk, Tomoya-kun.
text Nagisa says this with a calm expression... while my tear-drenched face doesn't even smile.
setvar strS[1000] = "BG087"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s35
fi
goto 45
