music BGM18A.mp3
text A day in March.
text The wind outside is still cold.
text And it's on this day that our graduation ceremony is held.
text @[Tomoya]
text Hey, Sunohara.
setvar strS[1001] = "CGSH19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6O.aac
text @[Sunohara]
text Yeah?
text @[Tomoya]
text You wanna go around and break some windows real fast?
setvar strS[1001] = "CGSH15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6P.aac
text @[Sunohara]
text What? Why would we do that?
text @[Tomoya]
text Eh, I just thought they might make us repeat the year if we did.
sound L6Q.aac
text @[Sunohara]
text They wouldn't make us repeat, they'd expel us.
text @[Tomoya]
text Oh... I guess there wouldn't be any point, then.
setvar strS[1001] = "CGSH19"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH19.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound L6R.aac
text @[Sunohara]
text ...?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I graduate on this day.
text And as I do, I leave something important behind.
if 0 == 0
	goto s32
fi
goto 41
label s32
setvar strS[1000] = "KURO"
goto 43
label 41
if 0 == 1
	goto s33
fi
goto 42
