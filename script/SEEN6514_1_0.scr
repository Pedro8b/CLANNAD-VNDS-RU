		setimg {$strS[1004]}.png -7 -7
	fi
fi
text We walk together...
text Within the spring light.
text Slowly and steadily.
text Our hands connected the entire time.
text Nagisa's tiny little hand is so precious... I can't stand it.
text I love Nagisa so much that I can't stand it.
text I... freeze in place.
text @[Tomoya]
text I knew it... I should've repeated too...
sound L76.aac
text @[Nagisa]
text No, Tomoya-kun.
sound L77.aac
text @[Nagisa]
text You shouldn't let something like that stop you.
sound L78.aac
text @[Nagisa]
text If you can do your best, you should do your best.
sound L79.aac
text @[Nagisa]
text If you can keep going, you should keep going forward.
sound L7A.aac
text @[Nagisa]
text I want you to move forward, Tomoya-kun.
text @[Tomoya]
text ...
text @[Tomoya]
text ...You've gotten stronger, Nagisa.
sound L7B.aac
text @[Nagisa]
text Yes.
sound L7C.aac
text @[Nagisa]
text And that's why...
setvar strS[1000] = "BG001"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s36
