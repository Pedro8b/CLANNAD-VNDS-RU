		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound KB8.aac
text @[Nagisa]
text No, not every day. But I would like to.
text @[Tomoya]
text You oughta be a little more careful. Out alone in a dark place like this?
sound KB9.aac
text @[Nagisa]
text It's okay. I'm in front of my home. My dad will come right away if I call for him.
text @[Tomoya]
text That may be true, but you seem slow. I'm worried that someone might take advantage of that and sneak up on you.
setvar strS[1001] = "CGNG16A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG16A.png
if intF[1113] == 1
