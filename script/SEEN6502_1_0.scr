text In the center of the park, I see Nagisa, practicing her play.
text @[Tomoya]
text Have you been reciting your lines here every night?
setvar strS[1001] = "CGNG10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGNG10A.png
if intF[1113] == 1
