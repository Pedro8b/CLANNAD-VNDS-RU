text @[Nagisa]
text What?
text Nagisa looks at me.
sound KBB.aac
text @[Nagisa]
text Do I... seem slow to you?
text @[Tomoya]
text Huh?
text Now I look back at her.
text @[Tomoya]
text You... never thought that people might think that about you?
setvar strS[1001] = "CGNG12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
