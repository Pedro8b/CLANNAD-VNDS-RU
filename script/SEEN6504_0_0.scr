	fi
fi
sound KHY.aac
text @[Akio]
text See you, kid. Let's have fun tomorrow.
text @[Tomoya]
text Sure thing, old man.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text He spits out an annoyed sound, then leaves the room.
text I'm alone now.
text @[Tomoya]
text ...
text I feel uncomfortable, maybe because of what I just heard.
text An outsider like me is now in the Furukawa home.
text I can't stand the fact that I'm encroaching on their family time.
text How could I not feel like some sort of insensitive jerk?
text @[Tomoya]
text (Maybe I should refrain from going tomorrow...)
text I want them to enjoy tomorrow as a family. Without having to worry about any outsiders.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 21
