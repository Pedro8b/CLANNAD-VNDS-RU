text I open the sliding door and head inside.
text Curtains are fluttering beside a half-open window.
text Kotomi smiles at me as if she had been waiting for me.
music BGM05A.mp3
setvar strS[1001] = "CGKT12A"
setvar intF[1113] = intF[1112]
