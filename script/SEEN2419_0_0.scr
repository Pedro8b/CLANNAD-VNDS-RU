text She's definitely not stronger than a man.
text @[Tomoya]
text Didn't you just admit it?
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OY.aac
text @[Sunohara]
text I only said she's pretty good. My real investigation has only just started.
text @[Tomoya]
text Well, if you're at the point you'd do something so cowardly as take a hostage, she's stronger than YOU, at least.
setvar strS[1001] = "CGSH24"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OZ.aac
