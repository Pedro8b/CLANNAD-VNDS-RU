text No, I wasn't!
text He says, all the while rubbing his eyes.
label 2
text @[Tomoya]
text So? What kind of plan did you think up this time?
setvar strS[1001] = "CGSH13"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13.png
if intF[1113] == 1
