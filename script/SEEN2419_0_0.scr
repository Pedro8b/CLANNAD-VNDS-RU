music ~
text When first period ends, Sunohara appears with bloodshot eyes.
music BGM08A.mp3
setvar strS[1001] = "CGSH17"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH17.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5O9.aac
text @[Sunohara]
text All right, time to get Doronjo on Tomoyo!
text @[Tomoya]
text You're steadily getting further and further away from "revenge," you know.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 5OA.aac
text @[Sunohara]
text I don't care what it is, seriously...
if intF[9] == 0
	goto s0
fi
goto 2
label s0
if intF[302] == 0
	goto s1
fi
goto 1
label s1
text @[Tomoya]
text Man, you look really tired.
