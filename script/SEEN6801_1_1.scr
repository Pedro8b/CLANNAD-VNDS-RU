text @[Tomoya]
text I wonder if... you actually resent me, Sanae-san.
setvar strS[1001] = "CGSN15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTH.aac
text @[Sanae]
text What? Why do you say that?
text @[Tomoya]
text Because I changed Nagisa.
setvar strS[1001] = "CGSN14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTI.aac
text @[Sanae]
text "Changed" her...? What do you mean?
text @[Tomoya]
text Nagisa was truly weak the first time I met her.
text @[Tomoya]
text She really did seem like she was always crying...
text @[Tomoya]
text And that if it wasn't for me, she'd always be standing at the bottom of the hill to school...
text @[Tomoya]
text She couldn't even make herself take a single step.
text @[Tomoya]
text But after she met me... she became stronger.
text @[Tomoya]
text So I doubt that any of this would be happening if she hadn't met me.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTJ.aac
text @[Sanae]
text That's not true, Tomoya-san.
text @[Tomoya]
text Yeah... I knew you'd say that, Sanae-san. You're a kind person.
setvar strS[1001] = "CGSN14"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN14.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTK.aac
text @[Sanae]
text That's how I really feel in my heart.
text @[Tomoya]
text Yeah... Thank you.
text Could it be that... I wanted to be forgiven by her like this?
text Is that all this is...?
text @[Tomoya]
text I don't have a mother...
setvar strS[1001] = "CGSN15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTL.aac
text @[Sanae]
text Oh, yes.
text @[Tomoya]
text So I really do sometimes think of you as my own mom.
setvar strS[1001] = "CGSN10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound OTM.aac
text @[Sanae]
text It's an honor to hear that.
setvar strS[1001] = "CGSN11H"
setvar intF[1113] = intF[1112]
