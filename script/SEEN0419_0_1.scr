	fi
fi
text She raises a hand and closes the door.
setvar strS[1001] = "CGSH12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound W8.aac
text @[Sunohara]
text It wouldn't be bad to catch a cold and have Misae-san play nurse for you, though.
text @[Tomoya]
text Don't say things like that. I could actually see her doing it.
setvar strS[1001] = "CGSH13B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH13B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound W9.aac
text @[Sunohara]
text What's the matter with that?
sound WA.aac
text @[Sunohara]
text She'd do things like press her forehead to yours to take your temperature.
setvar strS[1001] = "CGSH12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound WB.aac
text @[Sunohara]
text You could even take the opportunity to mess around and sneak a kiss. She couldn't get mad at a sick man, right?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I look at the umbrella I just got from her. It's a scarlet women's umbrella. It must be Misae-san's.
text @[Tomoya]
text (I would've preferred a cheap plastic one. I'd feel less nervous about using it...)
text But at the same time, I'd feel awkward about turning down Misae-san's kindness.
text Despite the constant trouble the students in the dorm cause her, she's still able to be considerate. Even to someone like me.
music ~
text *Bang* *Bang*
text More knocking. This time it sounds violent.
text The door opens before either of us get a chance to respond.
music BGM09A.mp3
sound WC.aac
text @[Rugby club]
text Hey!
text The rugby team is there, looking into the room.
setvar strS[1001] = "CGSH23B"
setvar intF[1113] = intF[1112]
