setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound WE.aac
text @[Rugby club]
text Okazaki.
text They're all looking my way.
text @[Tomoya]
text Huh? Me?
sound WF.aac
text @[Rugby club]
text Get out here for a second. We need to talk.
setvar strS[1001] = "CGSH27B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH27B.png
