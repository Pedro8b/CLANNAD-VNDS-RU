	fi
fi
sound WH.aac
text @[Sunohara]
text If they seem like they're about to attack, bow down until your forehead is against the floor and apologize. That's what I always do.
text @[Tomoya]
text Do you have any pride at all...?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound WI.aac
text @[Rugby club]
text C'mon, hurry up.
text @[Tomoya]
text Yeah, I'm coming. Don't rush me.
text I stand up and leave the room.
setvar strS[1000] = "BG045N"
setvar intA[1000] = 1
