setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH24.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8F.aac
text @[Sunohara]
text Seriously...?
setvar strS[1001] = "CGYK16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8G.aac
text @[Miyazawa]
text What's wrong? Is that strange?
text "So that's how it is," Sunohara and I nod in agreement.
text @[Tomoya]
text "Strange" may not be the right word here, but isn't there a saying that tells you to choose your friends wisely...?
text @[Tomoya]
text Well, I don't think I'm in any position to say that to anyone, though...
setvar strS[1001] = "CGYK10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8H.aac
text @[Miyazawa]
text Sorry, but... my friend just now... he's a very good person.
sound F8I.aac
text @[Miyazawa]
text He's very kind.
text @[Tomoya]
text Yes, I understand. I do understand. But, you see...
setvar strS[1001] = "CGSH12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8J.aac
text @[Sunohara]
text Isn't that fine? You must have a big heart to have a friend like that.
setvar strS[1001] = "CGYK15"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK15.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8K.aac
text @[Miyazawa]
text That's not how it is.
setvar strS[1001] = "CGYK11A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGYK11A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8L.aac
text @[Miyazawa]
text It has nothing to do with my heart being big or not. It's because he is a good person.
sound F8M.aac
text @[Miyazawa]
text That's all there is.
setvar strS[1001] = "CGSH16"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSH16.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound F8N.aac
text @[Sunohara]
text Really?
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I wonder what could have happened for a normal girl like her to cross paths with such a delinquent.
text Not to mention, I can't bring myself to understand how she could stay so calm seeing something like that.
text @[Tomoya]
text (Then there was that adoring attitude of his toward her...)
music ~
