	fi
fi
text She puts her palms together, trying to scoop up the sunlight.
sound E9W.aac
text @[Kotomi]
text It's not visible, but I can still see it.
sound E9X.aac
text @[Kotomi]
text I can't touch it, but it still feels warm.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound E9Y.aac
text @[Kotomi]
text It's so mysterious...
text She says each and every thing that comes to mind.
text And she notices the book with the leather cover sitting on the table.
text She doesn't even need to turn the old, tattered pages.
text From this point on, we'll write our own continuation of the story.
setvar strS[1001] = "CGKT13C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT13C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound E9Z.aac
text @[Kotomi]
text "Day before yesterday I saw a rabbit..."
sound EA0.aac
text @[Kotomi]
text "...and yesterday a deer..."
sound EA1.aac
text @[Kotomi]
text "...and today, you."
text Our eyes lock.
sound EA2.aac
text @[Kotomi]
text You are Tomoya-kun.
text A light comes back into her.
sound EA3.aac
text @[Kotomi]
text Tomoya-kun is Tomoya-kun.
text She whispers my name.
setvar strS[1001] = "CGKT16C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT16C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EA4.aac
text @[Kotomi]
text My dearest one.
text We hold hands.
text So that we'll never again be apart.
text @[Tomoya]
text Kotomi.
text @[Tomoya]
text Let's go outside together.
text @[Tomoya]
text Don't worry. It's not scary.
text @[Tomoya]
text I'll always be with you.
text Kotomi nods to me.
delay 60
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
