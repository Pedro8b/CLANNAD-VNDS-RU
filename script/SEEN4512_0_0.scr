delay 60
text Outside, the sun is setting.
text The roads of the residential district are stained by the late afternoon light.
text I watch Kotomi cautiously as she stands there barefoot.
text She's like a small child who has just left her house for the first time.
text It's as if this is her first time on a beach and she's letting the waves wash over her feet.
setvar strS[1001] = "CGKT31D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT31D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EA5.aac
text @[Kotomi]
text ...It feels strange.
text She smiles gently.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Then she looks up.
text She squints in the bright light and opens her arms to the vast sky.
setvar strS[1000] = "BG084"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s39
fi
goto 40
label s39
setvar strS[1000] = ""
