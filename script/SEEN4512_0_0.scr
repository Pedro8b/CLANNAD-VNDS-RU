text The sounds of the birds.
sound E9U.aac
text @[Kotomi]
text The sounds of the swaying leaves.
sound E9V.aac
text @[Kotomi]
text The sun feels warm...
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
