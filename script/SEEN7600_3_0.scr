music ~
setvar strS[1000] = "BG031Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s15
fi
goto 16
label s15
setvar strS[1000] = ""
label 16
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Having gotten tired of watching Sunohara feeling depressed for losing the game, I walk outside for a change of pace.
text He'll have returned to normal after I get back anyway.
text @[Tomoya]
text Hm?
music BGM09A.mp3
text Someone I recognize is walking with a magazine held up in front of him.
text @[Tomoya]
text Hey.
setvar strS[1001] = "CGKP18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUJ.aac
text @[Kappei]
text Ah... Tomoya-kun.
text @[Tomoya]
text How did the pizza delivery job go? Did you get hired?
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUK.aac
text @[Kappei]
text ...
text Without saying a thing, he shows me the magazine he's holding.
text It's a job listings magazine.
sound UUL.aac
text @[Kappei]
text Here's your answer.
text @[Tomoya]
text Didn't make it, huh?
sound UUM.aac
text @[Kappei]
text You don't have to come right out and say it...
text @[Tomoya]
text Just wanted to make sure.
setvar strS[1001] = "CGKP17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUN.aac
text @[Kappei]
text You're such a meanie, Tomoya-kun...
text @[Tomoya]
text I just don't like that kind of ambiguity.
text @[Tomoya]
text So? Why did they turn you down?
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUO.aac
text @[Kappei]
text Yeah, that! Hear me out!
sound UUP.aac
text @[Kappei]
text And it was for such a trifle! Geez!
text @[Tomoya]
text What's going on? Are you mad?
sound UUQ.aac
text @[Kappei]
text I am mad. Even I get mad too, you know.
text @[Tomoya]
text What happened? Were you sexually harassed during the interview?
music ~
setvar strS[1001] = "CGKP14A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP14A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM11.mp3
sound UUR.aac
text @[Kappei]
text No!
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUS.aac
text @[Kappei]
text They asked me if I have a license, and after I honestly told them no, they told me to leave.
sound UUT.aac
text @[Kappei]
text These days, it's not that hard to ride a bike without a license, you know!
sound UUU.aac
text @[Kappei]
text For a scooter, you just need to turn your right hand a little and it moves, right?
sound UUV.aac
text @[Kappei]
text They can't just mock someone like this.
music ~
text @[Tomoya]
text I think you're the one who's making a mockery out of them here.
setvar strS[1001] = "CGKP18A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM09A.mp3
sound UUW.aac
text @[Kappei]
text Huh? Why?
text @[Tomoya]
text If you ride a bike without a license, you'll be caught.
sound UUX.aac
text @[Kappei]
text Of course not. It'd be a problem if the cops found out, but as long as you don't mess up, you aren't really going to be caught.
text @[Tomoya]
text And they were worried about what would happen if you get caught.
setvar strS[1001] = "CGKP17A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP17A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUY.aac
text @[Kappei]
text How narrow-minded.
text @[Tomoya]
text I think it's more like you're too open-minded.
setvar strS[1001] = "CGKP13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP13A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UUZ.aac
text @[Kappei]
text Anyway, jobs that need me to have a license? I'll pass.
sound UV0.aac
text @[Kappei]
text It's manly to do jobs that can be done solely with your bare hands.
text @[Tomoya]
text Uhh... well, good luck.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Spiritlessly, I raise my hand to wave, and leave─
music ~
text *Grab*!
text ─Or not.
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM10.mp3
text Kappei's slender fingers grasp onto my hand.
text @[Tomoya]
text What?
setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV1.aac
text @[Kappei]
text Well, actually, I have another job interview after this.
text @[Tomoya]
text Good luck then.
text *Shake* *Shake*
text I try to shake my hand free, but Kappei does not let go.
sound UV2.aac
text @[Kappei]
text I thought I would try a fast food place.
text @[Tomoya]
text I wish you good luck.
text *Shake* *Shake*
sound UV3.aac
text @[Kappei]
text Have you heard of MOF Burger? It's a pretty famous national chain.
text @[Tomoya]
text Best of luck to you.
text *Shake* *Shake*
sound UV4.aac
text @[Kappei]
text I'd be nervous if I was all by myself. Would you come with me?
text @[Tomoya]
text Good luck going on your own.
text *Shake* *Shake*
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV5.aac
text @[Kappei]
text Come on, don't say things like that. It'll be fun.
text @[Tomoya]
text I don't have enough time to be doing part-time work!
sound UV6.aac
text @[Kappei]
text I've heard that chance encounters are often fate!
text @[Tomoya]
text Quit babbling nonsense!
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV7.aac
text @[Kappei]
text You get 730 yen an hour, you know? If you space out there for two hours, you'll get 1460 yen!
text @[Tomoya]
text Go actually do work.
sound UV8.aac
text @[Kappei]
text Let's work together. Let's be together from morning to evening!
text @[Tomoya]
text I have school.
setvar strS[1001] = "CGKP12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UV9.aac
text @[Kappei]
text Now that it's come to this, just don't worry about that.
text @[Tomoya]
text You're so self-centered...
sound UVA.aac
text @[Kappei]
text You should call it being honest.
text @[Tomoya]
text Anyway, go work part-time by yourself.
text @[Tomoya]
text Besides, you're more likely to not get the job if you bring a friend with you.
setvar strS[1001] = "CGKP18"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP18.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVB.aac
text @[Kappei]
text Eh? Is that so?
text @[Tomoya]
text Yeah, since it's more likely that when one of them quits, the friend would quit too.
setvar strS[1001] = "CGKP11"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP11.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVC.aac
text @[Kappei]
text Tomoya-kun, it'd be a problem, so don't follow me, okay?
text @[Tomoya]
text Man, you really are very self-centered...
setvar strS[1001] = "CGKP10"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVD.aac
text @[Kappei]
text Well, it impacts my livelihood. I have to take this very seriously.
text @[Tomoya]
text I see...
setvar strS[1001] = "CGKP10A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP10A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVE.aac
text @[Kappei]
text Okay then, I'm going there now.
sound UVF.aac
text @[Kappei]
text The next time we meet, be sure to call me Mr. Burger.
text @[Tomoya]
text Later, Mr. Burger.
setvar strS[1001] = "CGKP12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKP12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound UVG.aac
text @[Kappei]
text Ahahaha, not yet!
text He's really an idiot...
sound UVH.aac
text @[Kappei]
text If you come to the store, I'll throw in two extra pickles for you!
sound UVI.aac
text @[Kappei]
text Just getting those extra pickles would make you feel slightly happier, don't you agree?
sound UVJ.aac
text @[Kappei]
text Ahahahaha!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Kappei heads off to the interview, laughing joyfully all the while.
text Him working at a burger joint, huh...? I don't want to be anywhere near it...
text ......
text Well, he's probably not getting the job anyway.
