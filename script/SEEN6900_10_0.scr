	fi
fi
delay 120
text The snow begins to fall.
text We need to hurry.
text I pick up the last piece of junk I can find, place it in the bag on my back, and hurry home.
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s53
fi
goto 55
