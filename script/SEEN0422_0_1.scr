	fi
fi
sound 03E.aac
text @[Father]
text Did you make this, Tomoya-kun?
text @[Tomoya]
text Make what...?
text I narrow my eyes.
text In his hands... is a wooden star.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text After I got it from Fuko, I just tossed it in this room when I came home after school to change clothes.
text I think it was in the cloth bag where I keep my gym shoes, though... So he took it out without asking me...?
text And then he was staring at it because he thought I made it? All this time...?
setvar strS[1001] = "CGNY10"
setvar intF[1113] = intF[1112]
