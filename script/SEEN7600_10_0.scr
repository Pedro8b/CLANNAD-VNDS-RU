text It's probably going to melt my face!
sound VEH.aac
text @[Kappei]
text Ah, what about dessert?! It has to be that, right? Like, "Please eat me"? Whoa! I would love that, but we can't!
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text As he works himself up, the people around us start glancing this way.
text I take a step back, and start staring at him as though we are strangers.
text The sky today is so blue yet again...
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s77
fi
goto 82
label s77
setvar strS[1000] = ""
label 82
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
jump SEEN7600_12_0.scr
