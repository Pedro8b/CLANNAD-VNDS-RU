text Her childish hair decoration dances up and down to the rhythm of her footsteps.
text @[Tomoya]
text Are you tired?
setvar strS[1001] = "CGKT12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C5X.aac
text @[Kotomi]
text A little bit.
text She whispers those words.
text @[Tomoya]
text Sorry, Kotomi.
text @[Tomoya]
text The people I know are generally pretty weird...
sound C5Y.aac
text @[Kotomi]
text No.
sound C5Z.aac
text @[Kotomi]
text They're all very nice.
text I feel like she's straining herself to be nice.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I look at the side of her face.
text Just looking at her, anyone would think she's a "quiet, mysterious girl."
text I think about what Kotomi did today.
text To be honest, she was as shy as a kindergartner.
text Which is the real Kotomi?
text I can't explain it very well, but I don't think either of them is her real self.
text I think the real Kotomi is hidden deep down inside. She's in a place where she hasn't been found yet.
text Am I the only one who thinks this?
text When I first met Kotomi, she was more...
setvar strS[1001] = "CGKT30A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT30A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C60.aac
text @[Kotomi]
text ...?
text @[Tomoya]
text Oh, sorry.
text @[Tomoya]
text I was charmed by you.
sound C61.aac
text @[Kotomi]
text Huh...?
setvar strS[1001] = "CGKT31A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT31A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C62.aac
text @[Kotomi]
text Um...
text Both of us are silent.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s16
fi
goto 17
label s16
setvar strS[1000] = ""
label 17
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
setvar strS[1000] = "BG034Y"
setvar intA[1000] = 1
if intA[1000] == 0
	goto s17
fi
goto 18
label s17
setvar strS[1000] = ""
label 18
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text We've arrived at the student dorm.
setvar strS[1001] = "CGKT12B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C63.aac
text @[Kotomi]
text We can part ways here today.
text @[Tomoya]
text Do you have something to do?
setvar strS[1001] = "CGKT15B"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15B.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C64.aac
text @[Kotomi]
text Yes...
text She's being ambiguous on purpose by not saying where she's going.
text It must be part of her that I don't know.
text @[Tomoya]
text See you, then. Take care.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text I hand over her bag and she grips it with her slender fingers.
setvar strS[1001] = "CGKT12A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12A.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound C65.aac
text @[Kotomi]
text See you tomorrow.
text @[Tomoya]
text Yeah. See you tomorrow.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Kotomi walks off and eventually vanishes from view.
text If I can do better tomorrow...
text I sluggishly start walking, too.
music ~
setvar strS[1000] = "KURO"
setvar intA[1000] = 1
