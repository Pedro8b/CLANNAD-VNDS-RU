text @[Fuko]
text Yes, actually, her name is...
sound 2UD.aac
text @[Fuko]
text Kimiko.
sound 2UE.aac
text @[Sanae]
text So it's Kimiko-san.
sound 2UF.aac
text @[Fuko]
text Yes.
text That's another way to read the characters for "Kouko."
setvar strS[1001] = "CGSN11HE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN11HE.png
if intF[1113] == 1
