text @[Fuko]
text Her name is Taguchi.
text @[Tomoya]
text WHY THE FAMILY NAME─?!
setvar strS[1001] = "CGSN12HE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGSN12HE.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2U9.aac
text @[Sanae]
text So your sister's name is Isogai Taguchi?
text @[Tomoya]
text Don't you find it strange?!
setvar strS[1001] = "CGFU32"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU32.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound 2UA.aac
text @[Fuko]
text Mmm. Sorry, it was a different name...
sound 2UB.aac
text @[Sanae]
text A different name?
setvar strS[1001] = "CGFU12"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU12.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
