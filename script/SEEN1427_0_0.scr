text @[Sanae]
text Is something wrong?
setvar strS[1001] = "CGFU30"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU30.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text Fuko frantically looks around the room. She must be looking for a fake name to use.
text @[Tomoya]
text (Don't tell me she's going to use the first name she sees again...)
text Her eyes stop at the newspaper stand.
text There, the front page of one paper has the headline "Dietwoman Taguchi Makiko's replacement."
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text (I guess "Makiko" would work...)
setvar strS[1001] = "CGFU20"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGFU20.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
