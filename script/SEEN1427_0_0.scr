text @[Fuko]
text Yes.
text @[Tomoya]
text But since your sister is going on a trip with the family, it will take some time. Right, Fuko?
text ...Fuko nods.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
