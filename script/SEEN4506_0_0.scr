		setimg {$strS[1004]}.png -7 -7
	fi
fi
text This is the path to Kotomi's house.
text The boundary that separates the two of us.
text Our entwined hands unlink.
text Like a custom of her departure, I return the bag I'm carrying for her.
text It isn't as heavy as it used to be.
text That's because there's no need for her to hole up in the library and read all day long.
setvar strS[1001] = "CGKT13A"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT13A.png
if intF[1113] == 1
