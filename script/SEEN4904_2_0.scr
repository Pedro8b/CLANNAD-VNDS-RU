setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 55
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
music BGM15.mp3
text I arrive at our meeting place at 9:30.
text I had a feeling she'd be there, and she is.
setvar strS[1001] = "CGKT12C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHS.aac
text @[Kotomi]
text Tomoya-kun, hello.
text @[Tomoya]
text "Hello" isn't right. You should've said "good morning."
text I answer haphazardly and do a double take at Kotomi's outfit.
text She's wearing a black dress with a low neckline.
text I expected her to wear something more childish or plain, so this is really surprising.
setvar strS[1001] = "NONE"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text @[Tomoya]
text I'll carry your stuff.
text I take her cloth bag containing the lunch boxes.
text It seems kind of large for two people, but it's lighter than it looks.
text @[Tomoya]
text Sandwiches?
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHT.aac
text @[Kotomi]
text Yes.
text @[Tomoya]
text Oh. Well, we can eat sandwiches anywhere...
text After responding, I realize that we haven't decided where to go.
text @[Tomoya]
text Is there anywhere you want to go?
setvar strS[1001] = "CGKT15C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15C.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHU.aac
text @[Kotomi]
text Um...
setvar strS[1001] = "CGKT12D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT12D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EHV.aac
text @[Kotomi]
text I know a very wonderful place.
sound EHW.aac
text @[Kotomi]
text I'm sure you'd like it too, Tomoya-kun.
text She must have already decided because her eyes glitter as she says that.
text @[Tomoya]
text I don't mind if it's somewhere you want to go.
text @[Tomoya]
text I want to avoid going somewhere crowded, though.
sound EHX.aac
text @[Kotomi]
text It should be empty today.
text @[Tomoya]
text Oh? I didn't know there was a hidden gem like that around here.
sound EHY.aac
text @[Kotomi]
text No, it's not that.
sound EHZ.aac
text @[Kotomi]
text It's somewhere you're familiar with, Tomoya-kun.
text @[Tomoya]
text Is it?
text I think about it again.
text There isn't a large park or amusement park nearby.
text A vague sense of worry creeps over me, as if I'm feeling echoes of my dream.
text Why is Kotomi so sure that I've seen it?
text @[Tomoya]
text Sorry. I don't know where it is.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI0.aac
text @[Kotomi]
text Um...
text Still confused, Kotomi puts her lips close to my ear.
sound EI1.aac
text @[Kotomi]
text It's the school library.
text @[Tomoya]
text ...
text I didn't expect that.
setvar strS[1001] = "CGKT21D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT21D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
sound EI2.aac
text @[Kotomi]
text Can't we?
text @[Tomoya]
text Hmm, I don't mind, but...
text I'd like to avoid any touristy spots on a holiday, but going to school just seems so ordinary.
text Still, I didn't have any plans of my own...
text @[Tomoya]
text Yeah, we can go to the library.
setvar strS[1001] = "CGKT15D"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT15D.png
if intF[1113] == 1
	if strS[1000] < "C"
		setimg {$strS[1004]}.png -7 -7
	fi
fi
text She seems to smile and sigh with relief at hearing my answer.
text I guess the library is a special place to Kotomi.
text We can have a more normal "date" another time.
text @[Tomoya]
text Let's go.
setvar strS[1001] = "CGKT17C"
setvar intF[1113] = intF[1112]
bgload {$strS[1000]}.jpg 30
setimg CGKT17C.png
if intF[1113] == 1
